// het aantal toegekende besluiten van de Jutter
function Object waarde_telDePenningbesluiten(Object $aantal_vouw_15) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_15), Integer.valueOf(0), "aantal penningbesluiten", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "tel de penningbesluiten"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_12 : Contribution( fold == "tel de penningbesluiten: vouw 0", subject == $onderwerp ); $aantal_vouw_15 : count() )
then
    Object v = waarde_telDePenningbesluiten($aantal_vouw_15);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "tel de penningbesluiten", ComputeHelpers.designate(v, "tel de penningbesluiten")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aantal penningbesluiten", false), v, "tel de penningbesluiten"));
        }
    }
end

function boolean beta_stelHetPenningbesluitVast(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// hij penninggerechtigd is
function boolean toets_stelHetPenningbesluitVast(Object $penninggerechtigd) {
    return ComputeHelpers.characteristic($penninggerechtigd, Boolean.TRUE);
}

// het penningbedrag
function Object creatie_stelHetPenningbesluitVast(Object $penningbedrag, Object $fase, Object $herkomsten_creatie_21, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("stel het penningbesluit vast", 0, "Jutter", (java.util.List) $herkomsten_creatie_21, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($penningbedrag, Integer.valueOf(0), "besluitbedrag", "stel het penningbesluit vast"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Penningbesluit");
    ComputeHelpers.set(nieuw, "besluitbedrag", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("stel het penningbesluit vast", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("penningtoekenning", $onderwerp, nieuw, fase));
    return feiten;
}

rule "stel het penningbesluit vast"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( toegekendBesluit == null )
    $parameter_1 : ParameterState( parameter == "penningbedrag", $penningbedrag : value )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("jutter", "penninggerechtigd", true), subject == $onderwerp, $penninggerechtigd : holds )
    accumulate( $herkomst_creatie_20 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_21 : collectList($herkomst_creatie_20) )
    not( $gemaakt_creatie_23 : CreationStamp( rule == "stel het penningbesluit vast", subject == $onderwerp ) )
    not( $nieuw_creatie_24 : CreationStamp( object == $onderwerp, beta_stelHetPenningbesluitVast(this, $fase) ) )
    eval( toets_stelHetPenningbesluitVast($penninggerechtigd) )
    not( $eigen_fout : Fault( rule == "stel het penningbesluit vast", subject == $onderwerp ) )
then
    Object v = creatie_stelHetPenningbesluitVast($penningbedrag, $fase, $herkomsten_creatie_21, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "stel het penningbesluit vast", ComputeHelpers.designate(v, "stel het penningbesluit vast")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

rule "tel de penningbesluiten: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Penningbesluit()
    exists( $koppeling_bereik_8 : RelationLink( relation == "penningtoekenning", second == $onderwerp, first == $vouwonderwerp ) )
then
    insertLogical(new Contribution("tel de penningbesluiten: vouw 0", $vouwonderwerp, $onderwerp, null));
end

