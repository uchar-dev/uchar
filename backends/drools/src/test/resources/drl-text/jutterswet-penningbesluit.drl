global java.math.BigDecimal vondstdrempel;
global java.math.BigDecimal penningbedrag;

// zijn aantal aangemelde vondsten groter of gelijk is aan de vondstdrempel
function boolean toets_penningrechtBijDrempel(Object $aantalAangemeldeVondsten, Object $vondstdrempel) {
    return RegelSpraakRuntime.rsAggVergelijk($aantalAangemeldeVondsten, $vondstdrempel, ">=");
}

rule "penningrecht bij drempel"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $aantalAangemeldeVondsten : aantalAangemeldeVondsten )
    $parameter_1 : ParameterState( parameter == "vondstdrempel", $vondstdrempel : value )
    eval( toets_penningrechtBijDrempel($aantalAangemeldeVondsten, $vondstdrempel) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "penninggerechtigd", true)));
end

// het penningjaar van zijn begunstigde
function Object waarde_besluitjaarVanHetPenningbesluit(Object $begunstigdePenningjaar) {
    try {
        return ComputeHelpers.fitTarget($begunstigdePenningjaar, Integer.valueOf(0), "besluitjaar", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "besluitjaar van het penningbesluit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penningbesluit()
    $padstand_0 : PathState( path == "Penningbesluit:begunstigde" && member == ElementKey.of("jutter", "penningjaar", false), subject == $onderwerp, $begunstigdePenningjaar : value )
then
    Object v = waarde_besluitjaarVanHetPenningbesluit($begunstigdePenningjaar);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "besluitjaar van het penningbesluit", ComputeHelpers.designate(v, "besluitjaar van het penningbesluit")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("penningbesluit", "besluitjaar", false), v, "besluitjaar van het penningbesluit"));
        }
    }
end

