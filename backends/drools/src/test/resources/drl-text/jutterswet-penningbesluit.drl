function boolean beta_koppelingPenningtoekenningTweedeVullingVanToegekendBesluit(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "second");
}

rule "koppeling penningtoekenning: tweede vulling van toegekend besluit"
    dialect "mvel"
when
    $een : RelationLink( relation == "penningtoekenning", $nabij : first )
    $twee : RelationLink( relation == "penningtoekenning", first != null, first == $een.first, beta_koppelingPenningtoekenningTweedeVullingVanToegekendBesluit(this, $een) )
then
    insertLogical(new Fault($nabij, "penningtoekenning", new SecondFillingFault("toegekend besluit", $nabij)));
end

function boolean beta_koppelingPenningtoekenningTweedeVullingVanBegunstigde(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling penningtoekenning: tweede vulling van begunstigde"
    dialect "mvel"
when
    $een : RelationLink( relation == "penningtoekenning", $nabij : second )
    $twee : RelationLink( relation == "penningtoekenning", second != null, second == $een.second, beta_koppelingPenningtoekenningTweedeVullingVanBegunstigde(this, $een) )
then
    insertLogical(new Fault($nabij, "penningtoekenning", new SecondFillingFault("begunstigde", $nabij)));
end

