package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

function Object pad_sluitsomVanEenVondst(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("bewarendeJutter"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "ijkloon");
}

// de laatste van haar meldloon en het ijkloon van de bewarende jutter
function Object waarde_sluitsomVanEenVondst(Object $meldloon, Object $bewarendeJutterIjkloon) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.largest(ComputeHelpers.largest(null, $meldloon), $bewarendeJutterIjkloon), Integer.valueOf(0), "sluitsom", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "sluitsom van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $meldloon : meldloon, $bewarendeJutterIjkloon : (pad_sluitsomVanEenVondst(this)) )
then
    Object v = waarde_sluitsomVanEenVondst($meldloon, $bewarendeJutterIjkloon);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "sluitsom van een vondst", ComputeHelpers.designate(v, "sluitsom van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "sluitsom", false), v, "sluitsom van een vondst"));
        }
    }
end

