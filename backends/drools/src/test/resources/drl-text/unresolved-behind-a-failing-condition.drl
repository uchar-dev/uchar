function boolean samengesteld1_bijzondereVondstFoutInDeVoorwaarde(Object $actief) {
    var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, 2, null);
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.characteristic($actief, Boolean.FALSE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(((Boolean) ComputeHelpers.fail("Unresolved condition reached in evaluation")));
    return lezing.verdict();
}

// hij aan ten minste een van de volgende voorwaarden voldoet
function Object fout_bijzondereVondstFoutInDeVoorwaarde(Object $actief) {
    try {
        boolean uitkomst = samengesteld2_bijzondereVondstFoutInDeVoorwaarde($actief);
        return null;
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// hij aan ten minste een van de volgende voorwaarden voldoet
function boolean samengesteld2_bijzondereVondstFoutInDeVoorwaarde(Object $actief) {
    var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, 2, null);
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.characteristic($actief, Boolean.FALSE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(((Boolean) ComputeHelpers.fail("Unresolved condition reached in evaluation")));
    return lezing.verdict();
}

rule "bijzondere vondst: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $actief : (ComputeHelpers.holds(actief)) )
    eval( toets_bijzondereVondstFoutInDeVoorwaarde($actief) )
then
    Object f = fout_bijzondereVondstFoutInDeVoorwaarde($actief);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"bijzondere vondst\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "bijzondere vondst", ComputeHelpers.designate(f, "bijzondere vondst")));
end

// hij aan ten minste een van de volgende voorwaarden voldoet
function boolean toets_zwareVondst(Object $actief) {
    try {
        var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, 2, null);
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(ComputeHelpers.characteristic($actief, Boolean.FALSE));
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.fail("Unresolved reached in evaluation: this rule fails observably"), new java.math.BigDecimal("5"), ">"));
        return lezing.verdict();
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "zware vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $actief : (ComputeHelpers.holds(actief)) )
    eval( toets_zwareVondst($actief) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "zwaar", true)));
end

