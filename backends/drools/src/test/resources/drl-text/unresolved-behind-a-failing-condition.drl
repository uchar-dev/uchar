rule "bijzondere vondst: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $actief : (ComputeHelpers.holds(actief)) )
    eval( toets_bijzondereVondstFoutInDeVoorwaarde($actief) )
then
    Object f = fout_bijzondereVondstFoutInDeVoorwaarde($actief);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("de voorwaarde van \"bijzondere vondst\" faalde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    insertLogical(new Fault($onderwerp, "bijzondere vondst", ComputeHelpers.designate(f, "bijzondere vondst")));
end

// hij aan ten minste een van de volgende voorwaarden voldoet
function boolean toets_zwareVondst(Object $actief) {
    try {
        int raak = 0;
        Boolean vast;
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 0, 2);
        if (vast != null) {
            return vast;
        }
        if (ComputeHelpers.characteristic($actief, Boolean.FALSE)) {
            raak++;
        }
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 1, 1);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.fail("Unresolved reached in evaluation: this rule fails observably"), new java.math.BigDecimal("5"), ">")) {
            raak++;
        }
        return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 2);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "zware vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $actief : (ComputeHelpers.holds(actief)) )
    eval( toets_zwareVondst($actief) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "zwaar", true)));
end

