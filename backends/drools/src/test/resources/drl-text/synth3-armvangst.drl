    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(let1_wikkelheffingVanEenJutter($inkomen, $restpost, $drempel, $basisheffing, sonde), Integer.valueOf(2), java.math.RoundingMode.HALF_UP), Integer.valueOf(2), "wikkelheffing", null);
