function Object let3_wikkelheffingVanEenJutter(Object $inkomen, Object $restpost, Object $drempel, Object $basisheffing, Object sonde, Object cel_1, Object cel_4) {
    Object cel_5 = ComputeHelpers.binderCell();
    try {
        return (RegelSpraakRuntime.rsAggVergelijk(binder1_wikkelheffingVanEenJutter($inkomen, $restpost, $drempel, $basisheffing, sonde, cel_1), ComputeHelpers.required($drempel, "parameter \"drempel\" is unbound in this case (binding is fail-fast, ch. 5.7)"), ">") ? (Object) new java.math.BigDecimal("0") : (Object) binder3_wikkelheffingVanEenJutter($inkomen, $restpost, $drempel, $basisheffing, sonde, cel_1, cel_4, cel_5));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_5);
    }
}

