rule "wikkelheffing van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $inkomen : inkomen, $restpost : restpost )
    $parameter_6 : ParameterState( parameter == "drempel", $drempel : value )
    $parameter_7 : ParameterState( parameter == "basisheffing", $basisheffing : value )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_wikkelheffingVanEenJutter($inkomen, $restpost, $drempel, $basisheffing, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "wikkelheffing van een jutter", ComputeHelpers.designate(v, "wikkelheffing van een jutter")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
