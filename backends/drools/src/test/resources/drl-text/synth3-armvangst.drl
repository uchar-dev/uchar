// de z is z
function Object let2_wikkelheffingVanEenJutter(Object $inkomen, Object $restpost, Object $drempel, Object $basisheffing, Object sonde, Object cel_1) {
    Object cel_4 = ComputeHelpers.binderCell();
    try {
        return RegelSpraakRuntime.rsPlus(let3_wikkelheffingVanEenJutter($inkomen, $restpost, $drempel, $basisheffing, sonde, cel_1, cel_4), ComputeHelpers.required($basisheffing, "parameter \"basisheffing\" is unbound in this case (binding is fail-fast, ch. 5.7)"));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_4);
    }
}

// de grondslag gedeeld door zijn restpost
function Object binder2_wikkelheffingVanEenJutter(Object $inkomen, Object $restpost, Object $drempel, Object $basisheffing, Object sonde, Object cel_1, Object cel_4) {
    if (!ComputeHelpers.binderCellFilled(cel_4)) {
        ComputeHelpers.fillBinderCell(cel_4, ComputeHelpers.divided(binder1_wikkelheffingVanEenJutter($inkomen, $restpost, $drempel, $basisheffing, sonde, cel_1), $restpost, sonde));
    }
    return ComputeHelpers.binderValue(cel_4);
