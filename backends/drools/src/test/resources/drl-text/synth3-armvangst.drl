function Object binder3_wikkelheffingVanEenJutter(Object $inkomen, Object $restpost, Object $drempel, Object $basisheffing, Object sonde, Object cel_1, Object cel_4, Object cel_5) {
    if (!ComputeHelpers.binderCellFilled(cel_5)) {
        ComputeHelpers.fillBinderCell(cel_5, RegelSpraakRuntime.rsPlus(binder2_wikkelheffingVanEenJutter($inkomen, $restpost, $drempel, $basisheffing, sonde, cel_1, cel_4), new java.math.BigDecimal("1")));
    }
    return ComputeHelpers.binderValue(cel_5);
