// 2 maal zijn gewicht
function Object afloop_defaultsAWrakvondstBergloonDefault2(Object $gewicht) {
    try {
        return RegelSpraakRuntime.rsMaal(new java.math.BigDecimal("2"), $gewicht);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "defaults A:Wrakvondst.bergloon: default 2"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Wrakvondst"), ComputeHelpers.readProperty(this, "bergloon") == null, $gewicht : gewicht )
    not( $hoger_13 : Decides( stack == "defaults A:Wrakvondst.bergloon" && index < 2, subject == $onderwerp ) )
    eval( toets_defaultsAWrakvondstBergloonDefault2($gewicht) )
then
    Object v = afloop_defaultsAWrakvondstBergloonDefault2($gewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "defaults A:Wrakvondst.bergloon", ComputeHelpers.designate(v, "defaults A:Wrakvondst.bergloon")));
    } else if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "bergloon");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Wrakvondst.bergloon", ComputeHelpers.designate(passend, "defaults A:Wrakvondst.bergloon")));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakvondst.bergloon", 2));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), passend, "defaults A:Wrakvondst.bergloon"));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakvondst.bergloon", 2));
        }
    }
end

