rule "defaults A:Wrakvondst.bergloon: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakvondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Wrakvondst"), $gewicht : gewicht )
    not( $hoger_8 : Decides( stack == "defaults A:Wrakvondst.bergloon" && index < 1, subject == $onderwerp ) )
    eval( toets_defaultsAWrakvondstBergloonDefault1($gewicht) )
then
    // 5,00
    Object v = new java.math.BigDecimal("5");
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "bergloon");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Wrakvondst.bergloon", ComputeHelpers.designate(passend, "defaults A:Wrakvondst.bergloon")));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakvondst.bergloon", 1));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), passend, "defaults A:Wrakvondst.bergloon"));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakvondst.bergloon", 1));
        }
    }
end

