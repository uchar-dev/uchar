// hij beschadigd is en hij betwist is
function Object oordeel_defaultsAVondstStrandloonDefault000(Object $beschadigd, Object open_invoer, Object $onderwerp, Object $betwist) {
    return ComputeHelpers.judge(() -> {
        var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, 2, null);
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(() -> ComputeHelpers.characteristic(ComputeHelpers.readInput($beschadigd, open_invoer, $onderwerp, ElementKey.of("vondst", "beschadigd", true)), Boolean.TRUE));
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(() -> ComputeHelpers.characteristic(ComputeHelpers.readInput($betwist, open_invoer, $onderwerp, ElementKey.of("vondst", "betwist", true)), Boolean.TRUE));
        return lezing.verdict();
    }, false);
}

