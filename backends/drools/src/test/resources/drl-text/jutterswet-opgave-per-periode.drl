// 20
function Object waarde_strandloonInHetVoorjaar() {
    try {
        return PeriodArithmetic.written(PeriodArithmetic.clipped(PeriodCondition.window(java.time.LocalDate.parse("2025-03-01"), Boolean.TRUE, java.time.LocalDate.parse("2025-06-01"), Boolean.TRUE, Boolean.FALSE), PeriodArithmetic.scalar(new java.math.BigDecimal("20"))), Integer.valueOf(0), "berekende strandloon");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "strandloon in het voorjaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
then
    Object v = waarde_strandloonInHetVoorjaar();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "strandloon in het voorjaar", ComputeHelpers.designate(v, "strandloon in het voorjaar")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "berekende strandloon", false), v, "strandloon in het voorjaar"));
        }
    }
end

