then
    insertLogical(new PathState($onderwerp, "Vondst:vinder", ElementKey.of("jutter", "bonus", false), ComputeHelpers.input($v, open_invoer, $bereikt, ElementKey.of("jutter", "bonus", false)), $bereikt));
