// zijn waarde plus de bonus van de vinder van de Vondst
function Object waarde_vindpremie(Object $waarde2, Object open_invoer, Object $onderwerp, Object $vinderBonus) {
    return ComputeHelpers.valued(() -> ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus(ComputeHelpers.readInput($waarde2, open_invoer, $onderwerp, ElementKey.of("vondst", "waarde", false)), ComputeHelpers.read($vinderBonus)), Integer.valueOf(0), "vindpremie", null), null);
}

rule "vindpremie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $waarde2 : waarde )
    $padstand_3 : PathState( path == "Vondst:vinder" && member == ElementKey.of("jutter", "bonus", false), subject == $onderwerp, $vinderBonus : value )
then
    Object v = waarde_vindpremie($waarde2, open_invoer, $onderwerp, $vinderBonus);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vindpremie", ComputeHelpers.designate(v, "vindpremie")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "vindpremie", false), "vindpremie"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vindpremie", false), v, "vindpremie"));
        }
    }
end

// hij een vondst is
function Object oordeel_toegewezen(Object $vinder, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.roleFieldOpen($vinder, "", Boolean.FALSE, open_invoer, $onderwerp, ElementKey.role("vinding", 0, "vinder")), false);
}

rule "toegewezen"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $vinder : vinder )
    eval( ComputeHelpers.acts(oordeel_toegewezen($vinder, open_invoer, $onderwerp)) )
then
    if (ComputeHelpers.decides(oordeel_toegewezen($vinder, open_invoer, $onderwerp))) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "toegewezen", true)));
    } else {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "toegewezen", true), "toegewezen"));
    }
end

rule "vondstenaantal: bijdrage aan vouw 0"
    dialect "mvel"
