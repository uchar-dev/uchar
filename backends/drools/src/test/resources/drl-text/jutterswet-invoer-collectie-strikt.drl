package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactMinimumFunction exactMin;
import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.FoldOpen;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.LeftOpen;
import dev.uchar.regelspraak.transpiler.tms.OpenInput;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.RangeOpen;
import dev.uchar.regelspraak.transpiler.tms.Value;

global OpenInput open_invoer;

// het aantal vondsten van de Jutter
function Object waarde_vondstenaantal(Object $aantal_vouw_6, Object $eerste_bereikopen_vouw_11) {
    return ComputeHelpers.valued(() -> ComputeHelpers.fitTarget(vouwlezing_vondstenaantal($aantal_vouw_6, $eerste_bereikopen_vouw_11), Integer.valueOf(0), "vondstenaantal", null), null);
}

// het aantal vondsten van de Jutter
function Object vouwlezing_vondstenaantal(Object $aantal_vouw_6, Object $eerste_bereikopen_vouw_11) {
    ComputeHelpers.beforeFoldOutcome($eerste_bereikopen_vouw_11, null, null, null, null);
    return ComputeHelpers.countOf($aantal_vouw_6);
}

rule "vondstenaantal"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_3 : Contribution( fold == "vondstenaantal: vouw 0", subject == $onderwerp ); $aantal_vouw_6 : count() )
    accumulate( $bereikopen_vouw_7 : RangeOpen( fold == "vondstenaantal: vouw 0", subject == $onderwerp ); $bereikopen_aantal_vouw_10 : count(), $eerste_bereikopen_vouw_11 : exactMin($bereikopen_vouw_7) )
then
    Object v = waarde_vondstenaantal($aantal_vouw_6, $eerste_bereikopen_vouw_11);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vondstenaantal", ComputeHelpers.designate(v, "vondstenaantal")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("jutter", "vondstenaantal", false), "vondstenaantal"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vondstenaantal", false), v, "vondstenaantal"));
        }
    }
end

// de som van de waarde van alle vondsten van de Jutter
function Object waarde_totaleWaarde(Object $aantal_vouw_18, Object $vouw_vouw_20, Object $openleden_vouw_24, Object $eerste_bereikopen_vouw_29) {
    return ComputeHelpers.valued(() -> ComputeHelpers.fitTarget(vouwlezing_totaleWaarde($aantal_vouw_18, $vouw_vouw_20, $openleden_vouw_24, $eerste_bereikopen_vouw_29), Integer.valueOf(0), "totale waarde", null), null);
}

// de som van de waarde van alle vondsten van de Jutter
function Object vouwlezing_totaleWaarde(Object $aantal_vouw_18, Object $vouw_vouw_20, Object $openleden_vouw_24, Object $eerste_bereikopen_vouw_29) {
    ComputeHelpers.beforeFoldOutcome($eerste_bereikopen_vouw_29, null, null, null, null);
    return ComputeHelpers.foldValue(ComputeHelpers.standingCount($aantal_vouw_18, $openleden_vouw_24), $vouw_vouw_20, null);
}

rule "totale waarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_15 : Contribution( fold == "totale waarde: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_19 : value ); $aantal_vouw_18 : count(), $vouw_vouw_20 : exactSum($bijdragewaarde_vouw_19) )
    accumulate( $openlid_vouw_21 : FoldOpen( fold == "totale waarde: vouw 1", subject == $onderwerp ); $openleden_vouw_24 : collectList($openlid_vouw_21) )
    accumulate( $bereikopen_vouw_25 : RangeOpen( fold == "totale waarde: vouw 1", subject == $onderwerp ); $bereikopen_aantal_vouw_28 : count(), $eerste_bereikopen_vouw_29 : exactMin($bereikopen_vouw_25) )
then
    Object v = waarde_totaleWaarde($aantal_vouw_18, $vouw_vouw_20, $openleden_vouw_24, $eerste_bereikopen_vouw_29);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "totale waarde", ComputeHelpers.designate(v, "totale waarde")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("jutter", "totale waarde", false), "totale waarde"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "totale waarde", false), v, "totale waarde"));
        }
    }
end

// het aantal verrichte keuringen van de Jutter
function Object waarde_keuringenaantal(Object $aantal_vouw_34) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_34), Integer.valueOf(0), "keuringenaantal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "keuringenaantal"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_31 : Contribution( fold == "keuringenaantal: vouw 2", subject == $onderwerp ); $aantal_vouw_34 : count() )
then
    Object v = waarde_keuringenaantal($aantal_vouw_34);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "keuringenaantal", ComputeHelpers.designate(v, "keuringenaantal")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "keuringenaantal", false), v, "keuringenaantal"));
        }
    }
end

