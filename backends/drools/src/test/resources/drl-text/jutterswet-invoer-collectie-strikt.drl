// hij een vondst heeft
function Object oordeel_actief(Object $vullers_rol_47, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.roleCountOpen($vullers_rol_47, Boolean.FALSE, open_invoer, $onderwerp, ElementKey.role("vinding", 1, "vondst")), false);
}

rule "actief"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $vuller_rol_46 : dev.uchar.regelspraak.facts.Vondst( vinder == $onderwerp ); $vullers_rol_47 : count() )
    eval( ComputeHelpers.acts(oordeel_actief($vullers_rol_47, open_invoer, $onderwerp)) )
then
    if (ComputeHelpers.decides(oordeel_actief($vullers_rol_47, open_invoer, $onderwerp))) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "actief", true)));
    } else {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("jutter", "actief", true), "actief"));
    }
end

// hij geen vondst heeft
function Object oordeel_vondstloos(Object $vullers_rol_51, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.roleCountOpen($vullers_rol_51, Boolean.TRUE, open_invoer, $onderwerp, ElementKey.role("vinding", 1, "vondst")), false);
}

rule "vondstloos"
    dialect "mvel"
when
