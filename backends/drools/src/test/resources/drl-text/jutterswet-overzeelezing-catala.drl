rule "kenmerkstand Eigenaar.overzees: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Eigenaar( ComputeHelpers.holds(overzees) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("eigenaar", "overzees", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("eigenaar", "overzees", true), false));
