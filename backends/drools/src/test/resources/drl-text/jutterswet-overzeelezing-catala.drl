rule "kenmerkstand Eigenaar.overzees: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Eigenaar()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("eigenaar", "overzees", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("eigenaar", "overzees", true), true));
