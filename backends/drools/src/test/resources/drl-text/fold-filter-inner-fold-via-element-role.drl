function boolean toets_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0(Object $overlading, Object $maand, Object $aantal_vouw_24, Object $vouw_vouw_26) {
    try {
        boolean uitkomst = samengesteld1_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0($overlading, $maand, $aantal_vouw_24, $vouw_vouw_26);
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

