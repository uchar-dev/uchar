function boolean samengesteld2_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0(Object $lijstplaatsen_plaats_15, Object $plaats_plaats_16, Object $overlading, Object $maand, Object $aantal_vouw_24, Object $vouw_vouw_26, Object $onderwerp) {
    int raak = 0;
