function java.util.List plaats_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0(Object $onderwerp, Object $lijstplaatsen_plaats_15, Object $plaats_plaats_16) {
    return ComputeHelpers.foldPlace(dev.uchar.regelspraak.transpiler.tms.plan.Consequence.PlaceReason.FILTER_FAULT, "eerste schone maand vanaf de eindmaand: vouw 0", $onderwerp, 0, java.util.Arrays.asList("schuit"), java.util.Arrays.asList($lijstplaatsen_plaats_15), java.util.Arrays.asList($plaats_plaats_16));
}

rule "eerste schone maand vanaf de eindmaand: filterfout in vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Schuit()
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand( schuit == $vouwonderwerp, $maand : maand )
    accumulate( $lijstplaats_plaats_13 : ListPlace( field == "schuit", beta_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0(this, $onderwerp), $lijstplaatswaarde_plaats_14 : place ); $lijstplaatsen_plaats_15 : count(), $plaats_plaats_16 : exactMin($lijstplaatswaarde_plaats_14) )
    $stand_2 : CharacteristicState( characteristic == ElementKey.of("lading in-een-maand", "overlading", true), subject == $onderwerp, $overlading : holds )
    accumulate( $bijdrage_vouw_21 : Contribution( fold == "eerste schone maand vanaf de eindmaand: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_25 : value ); $aantal_vouw_24 : count(), $vouw_vouw_26 : exactMax($bijdragewaarde_vouw_25) )
    eval( toets_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0($overlading, $maand, $aantal_vouw_24, $vouw_vouw_26) )
then
    RuntimeException f = fout_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0($lijstplaatsen_plaats_15, $plaats_plaats_16, $overlading, $maand, $aantal_vouw_24, $vouw_vouw_26, $onderwerp);
    if (f == null) {
        ComputeHelpers.contractBreach("the filter of eerste schone maand vanaf de eindmaand: vouw 0 failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new FilterFault("eerste schone maand vanaf de eindmaand: vouw 0", $vouwonderwerp, $onderwerp, f, plaats_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0($onderwerp, $lijstplaatsen_plaats_15, $plaats_plaats_16)));
end

function boolean beta_eersteSchoneMaandVanafDeEindmaandBijdrageAanVouw1(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("beklaagdeSchuit"), java.util.Arrays.asList("schuit"));
}

rule "eerste schone maand vanaf de eindmaand: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand()
    $onderwerp : dev.uchar.regelspraak.facts.Klacht( beta_eersteSchoneMaandVanafDeEindmaandBijdrageAanVouw1(this, $vouwonderwerp), $einddag : einddag )
then
    Object v = ComputeHelpers.contribution("eerste schone maand vanaf de eindmaand: vouw 1", $vouwonderwerp, $onderwerp, $einddag, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "kenmerkstand Lading in-een-maand.overlading: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand( ComputeHelpers.holds(overlading) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("lading in-een-maand", "overlading", true), true));
end

rule "kenmerkstand Lading in-een-maand.overlading: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("lading in-een-maand", "overlading", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("lading in-een-maand", "overlading", true), true));
end

rule "kenmerkstand Lading in-een-maand.overlading: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand( ComputeHelpers.holds(overlading) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("lading in-een-maand", "overlading", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("lading in-een-maand", "overlading", true), false));
end

