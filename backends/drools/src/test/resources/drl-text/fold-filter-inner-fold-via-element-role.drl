// aan alle volgende voorwaarden voldoen: - hij heeft geen overlading - zijn maand plus 1 mnd is later dan de laatste van de einddag van alle klachten van de schuit van de Lading in-een-maand
function RuntimeException fout_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0(Object $lijstplaatsen_plaats_15, Object $plaats_plaats_16, Object $overlading, Object $maand, Object $aantal_vouw_24, Object $vouw_vouw_26, Object $onderwerp) {
