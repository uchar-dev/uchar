// hij aan ten minste één van de volgende voorwaarden voldoet: - de minimale waarde van het gewicht van alle vondsten van de Jutter is kleiner dan 2 - de maximale waarde van het gewicht van alle vondsten van de Jutter is kleiner dan 5
function boolean toets_defaultsKJutterIjverigDefault0(Object $aantal_vouw_56, Object $vouw_vouw_58, Object $aantal_vouw_63, Object $vouw_vouw_65) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.foldValue($aantal_vouw_56, $vouw_vouw_58, null), new java.math.BigDecimal("2"), "<")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.foldValue($aantal_vouw_63, $vouw_vouw_65, null), new java.math.BigDecimal("5"), "<")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 2);
}

