// zijn aantal geborgen wrakken groter of gelijk is aan 2
function boolean toets_defaultsAJutterBergingstoeslagDefault0(Object $aantalGeborgenWrakken) {
    return RegelSpraakRuntime.rsAggVergelijk($aantalGeborgenWrakken, new java.math.BigDecimal("2"), ">=");
}

// de bergingsgrond is zijn bergingsgrondslag
function Object afloop_defaultsAJutterBergingstoeslagDefault0(Object $bergingsgrondslag) {
    try {
        return let_defaultsAJutterBergingstoeslagDefault0($bergingsgrondslag);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// de bergingsgrond is zijn bergingsgrondslag
function Object let_defaultsAJutterBergingstoeslagDefault0(Object $bergingsgrondslag) {
    Object cel_2 = ComputeHelpers.binderCell();
    try {
        return RegelSpraakRuntime.rsPlus(binder_defaultsAJutterBergingstoeslagDefault0($bergingsgrondslag, cel_2), new java.math.BigDecimal("100"));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_2);
    }
}

// zijn bergingsgrondslag
function Object binder_defaultsAJutterBergingstoeslagDefault0(Object $bergingsgrondslag, Object cel_2) {
    if (!ComputeHelpers.binderCellFilled(cel_2)) {
        ComputeHelpers.fillBinderCell(cel_2, $bergingsgrondslag);
    }
    return ComputeHelpers.binderValue(cel_2);
}

rule "defaults A:Jutter.bergingstoeslag: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $aantalGeborgenWrakken : aantalGeborgenWrakken, $bergingsgrondslag : bergingsgrondslag )
    eval( toets_defaultsAJutterBergingstoeslagDefault0($aantalGeborgenWrakken) )
then
    Object v = afloop_defaultsAJutterBergingstoeslagDefault0($bergingsgrondslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "defaults A:Jutter.bergingstoeslag", ComputeHelpers.designate(v, "defaults A:Jutter.bergingstoeslag")));
    } else if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "bergingstoeslag");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Jutter.bergingstoeslag", ComputeHelpers.designate(passend, "defaults A:Jutter.bergingstoeslag")));
            insertLogical(new Decides($onderwerp, "defaults A:Jutter.bergingstoeslag", 0));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "bergingstoeslag", false), passend, "defaults A:Jutter.bergingstoeslag"));
            insertLogical(new Decides($onderwerp, "defaults A:Jutter.bergingstoeslag", 0));
        }
    }
end

