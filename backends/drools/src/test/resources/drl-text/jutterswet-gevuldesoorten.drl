rule "aantal aangemelde vondsten: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( aanmelder == $vouwonderwerp )
then
    insertLogical(new Contribution("aantal aangemelde vondsten: vouw 0", $vouwonderwerp, $onderwerp, null));
end

rule "aantal gevulde vindplaatsen: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( aanmelder == $vouwonderwerp, $vindplaats : vindplaats )
then
    Object v = ComputeHelpers.contribution("aantal gevulde vindplaatsen: vouw 1", $vouwonderwerp, $onderwerp, $vindplaats, null, null, true, false);
    if (v != null) {
        insertLogical(v);
    }
end

