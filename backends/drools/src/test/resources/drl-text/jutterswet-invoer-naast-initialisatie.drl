        }
    }
end

// hij gemeld is
function boolean toets_standaardtaxatie(Object $gemeld) {
    return ComputeHelpers.characteristic($gemeld, Boolean.TRUE);
}

// 25
function Object waarde_standaardtaxatie() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("25"), Integer.valueOf(0), "taxatie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "standaardtaxatie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( taxatie == null, $gemeld : (ComputeHelpers.holds(gemeld)) )
    eval( toets_standaardtaxatie($gemeld) )
    not( $andere_schrijver : Value( attribute == ElementKey.of("vondst", "taxatie", false) && writer != "standaardtaxatie", subject == $onderwerp ) )
then
    Object v = waarde_standaardtaxatie();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "standaardtaxatie", ComputeHelpers.designate(v, "standaardtaxatie")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "taxatie", false), v, "standaardtaxatie"));
        }
    }
end

function boolean toets_schrijversVondstTaxatieVerschil(Object $waarden) {
    return ComputeHelpers.differ($waarden);
}

rule "schrijvers Vondst.taxatie: verschil"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    accumulate( $waarde : Value( attribute == ElementKey.of("vondst", "taxatie", false), subject == $onderwerp ); $waarden : collectList($waarde) )
    eval( toets_schrijversVondstTaxatieVerschil($waarden) )
then
    insertLogical(ComputeHelpers.writersConflict($onderwerp, $waarden, "taxatie", ComputeHelpers.list3("taxatie uit opgave", "taxatie uit schatting", "standaardtaxatie"), ComputeHelpers.list1("Vondst"), ComputeHelpers.list1("Vondst")));
end

