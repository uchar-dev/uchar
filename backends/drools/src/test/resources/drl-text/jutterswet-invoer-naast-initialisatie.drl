package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// hij gemeld is
function boolean toets_taxatieUitOpgave(Object $gemeld) {
    return ComputeHelpers.characteristic($gemeld, Boolean.TRUE);
}

// zijn opgave
function Object waarde_taxatieUitOpgave(Object $opgave) {
    try {
        return ComputeHelpers.fitTarget($opgave, Integer.valueOf(0), "taxatie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "taxatie uit opgave"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gemeld : (ComputeHelpers.holds(gemeld)), $opgave : opgave )
    eval( toets_taxatieUitOpgave($gemeld) )
then
    Object v = waarde_taxatieUitOpgave($opgave);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "taxatie uit opgave", ComputeHelpers.designate(v, "taxatie uit opgave")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "taxatie", false), v, "taxatie uit opgave"));
        }
    }
end

// hij erkend is
function boolean toets_taxatieUitSchatting(Object $erkend) {
