// hij aan alle volgende voorwaarden voldoet: - zijn opgegeven teruggavedatum is gevuld - zijn berekende teruggavedatum is gevuld - zijn opgegeven teruggavedatum is ongelijk aan zijn berekende teruggavedatum
function boolean toets_afwijkingOpgaveTeruggavedatum(Object $opgegevenTeruggavedatum, Object $berekendeTeruggavedatum) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($opgegevenTeruggavedatum, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($berekendeTeruggavedatum, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.textEqual($opgegevenTeruggavedatum, $berekendeTeruggavedatum, Boolean.FALSE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

rule "afwijking opgave teruggavedatum"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opgegevenTeruggavedatum : opgegevenTeruggavedatum )
    $stand_1 : State( attribute == ElementKey.of("vondst", "berekende teruggavedatum", false), subject == $onderwerp, $berekendeTeruggavedatum : value )
    eval( toets_afwijkingOpgaveTeruggavedatum($opgegevenTeruggavedatum, $berekendeTeruggavedatum) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true)));
end

