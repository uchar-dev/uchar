// zijn claimdatum
function Object waarde_teruggaveOpDeClaimdatum(Object $claimdatum) {
    try {
        return ComputeHelpers.construct("waarde", $claimdatum);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "teruggave op de claimdatum"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $claimdatum : claimdatum )
then
    Object v = waarde_teruggaveOpDeClaimdatum($claimdatum);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "teruggave op de claimdatum", ComputeHelpers.designate(v, "teruggave op de claimdatum")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "berekende teruggavedatum", false), v, "teruggave op de claimdatum"));
        }
    }
end

