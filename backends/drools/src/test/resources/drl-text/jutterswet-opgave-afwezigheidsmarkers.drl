when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst") )
    $stand_0 : State( attribute == ElementKey.of("vondst", "opgegeven opslagkosten", false), subject == $onderwerp, $tijdlijn_0 : value )
