    accumulate( $waarde : Value( attribute == ElementKey.of("vondst", "berekende opslagkosten", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("vondst", "berekende opslagkosten", false), $waarden, $invoer, ComputeHelpers.list6("teruggave op de claimdatum", "geen teruggave van drijfhout", "teruggave bij een onleesbaar etiket", "opslag onbekend in de winter", "opslag in het voorjaar", "afwijking opgave teruggavedatum")));
end

rule "stand Vondst.berekende opslagkosten: de vereniging van de schrijvers, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("vondst", "berekende opslagkosten", false), subject == $onderwerp ) )
    exists( $schrijver : Value( attribute == ElementKey.of("vondst", "berekende opslagkosten", false), subject == $onderwerp ) )
    accumulate( $waarde : Value( attribute == ElementKey.of("vondst", "berekende opslagkosten", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("vondst", "berekende opslagkosten", false), $waarden, null, ComputeHelpers.list6("teruggave op de claimdatum", "geen teruggave van drijfhout", "teruggave bij een onleesbaar etiket", "opslag onbekend in de winter", "opslag in het voorjaar", "afwijking opgave teruggavedatum")));
end

rule "stand Vondst.berekende opslagkosten: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : (ComputeHelpers.periods(berekendeOpslagkosten)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("vondst", "berekende opslagkosten", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "berekende opslagkosten", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekende opslagkosten", false), $invoer));
end

rule "stand Vondst.berekende opslagkosten: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : (ComputeHelpers.periods(berekendeOpslagkosten)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("vondst", "berekende opslagkosten", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "berekende opslagkosten", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekende opslagkosten", false), ComputeHelpers.bucketScalarOf($invoer)));
end

