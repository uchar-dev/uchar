// hij aan alle volgende voorwaarden voldoet: - zijn opgegeven teruggavedatum is gevuld - zijn berekende teruggavedatum is gevuld - zijn opgegeven teruggavedatum is ongelijk aan zijn berekende teruggavedatum
function boolean toets_afwijkingOpgaveTeruggavedatum(Object $opgegevenTeruggavedatum, Object $berekendeTeruggavedatum) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($opgegevenTeruggavedatum, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($berekendeTeruggavedatum, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.textEqual($opgegevenTeruggavedatum, $berekendeTeruggavedatum, Boolean.FALSE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

rule "afwijking opgave teruggavedatum"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opgegevenTeruggavedatum : opgegevenTeruggavedatum )
    $stand_1 : State( attribute == ElementKey.of("vondst", "berekende teruggavedatum", false), subject == $onderwerp, $berekendeTeruggavedatum : value )
    eval( toets_afwijkingOpgaveTeruggavedatum($opgegevenTeruggavedatum, $berekendeTeruggavedatum) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true)));
end

// hij heeft geen afwijkende opgave teruggavedatum
function boolean toets_controleOpgaveTeruggavedatum(Object $afwijkendeOpgaveTeruggavedatum) {
    return ComputeHelpers.not(ComputeHelpers.characteristic($afwijkendeOpgaveTeruggavedatum, Boolean.FALSE));
}

rule "controle opgave teruggavedatum"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true), subject == $onderwerp, $afwijkendeOpgaveTeruggavedatum : holds )
    eval( toets_controleOpgaveTeruggavedatum($afwijkendeOpgaveTeruggavedatum) )
then
    insertLogical(ComputeHelpers.inconsistency("controle opgave teruggavedatum", $onderwerp, ComputeHelpers.list1("EF-025")));
end

rule "defaults A:Vondst.teruggavedatum: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $opgegevenTeruggavedatum : opgegevenTeruggavedatum )
then
    // zijn opgegeven teruggavedatum
    Object v = $opgegevenTeruggavedatum;
    if (v != null) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "teruggavedatum", false), v, "defaults A:Vondst.teruggavedatum"));
        insertLogical(new Decides($onderwerp, "defaults A:Vondst.teruggavedatum", 0));
    }
end

rule "defaults A:Vondst.teruggavedatum: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst") )
    $stand_0 : State( attribute == ElementKey.of("vondst", "berekende teruggavedatum", false), subject == $onderwerp, $berekendeTeruggavedatum : value )
    not( $hoger_13 : Decides( stack == "defaults A:Vondst.teruggavedatum" && index < 1, subject == $onderwerp ) )
then
    // zijn berekende teruggavedatum
    Object v = $berekendeTeruggavedatum;
    if (v != null) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "teruggavedatum", false), v, "defaults A:Vondst.teruggavedatum"));
        insertLogical(new Decides($onderwerp, "defaults A:Vondst.teruggavedatum", 1));
    }
end

function boolean toets_defaultsAVondstOpslagkostenDefault0() {
    return PeriodDefaults.atTurn(PeriodDefaults.reach(null));
}

function Object afloop_defaultsAVondstOpslagkostenDefault0(Object $tijdlijn_0, Object $onderwerp) {
    try {
        return let_defaultsAVondstOpslagkostenDefault0($tijdlijn_0, $onderwerp);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

function Object let_defaultsAVondstOpslagkostenDefault0(Object $tijdlijn_0, Object $onderwerp) {
    Object cel_2 = ComputeHelpers.binderCell();
    try {
        return PeriodDefaults.decided(binder_defaultsAVondstOpslagkostenDefault0($tijdlijn_0, $onderwerp, cel_2), ComputeHelpers.complete($tijdlijn_0, "the period arithmetic of ch. 3.4/3.5 reads the temporal attribute \"opgegeven opslagkosten\" of ", $onderwerp, "; the case supplies only the asOfDate-bucket scalar, which carries no period", "opgegeven opslagkosten", Boolean.TRUE));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_2);
    }
}

function Object binder_defaultsAVondstOpslagkostenDefault0(Object $tijdlijn_0, Object $onderwerp, Object cel_2) {
    // altijd
    if (!ComputeHelpers.binderCellFilled(cel_2)) {
        ComputeHelpers.fillBinderCell(cel_2, PeriodDefaults.within(PeriodDefaults.reach(null), PeriodCondition.always(Boolean.valueOf(ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, 0, 0)))));
    }
    return ComputeHelpers.binderValue(cel_2);
}

