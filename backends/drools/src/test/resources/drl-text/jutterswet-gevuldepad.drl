package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het aantal gevulde waarden van het vangstgewicht van alle losplaatsen van alle gevoerde boten van de Jutter
function Object waarde_aantalGevuldeBergplaatsen(Object $aantal_vouw_6) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_6), Integer.valueOf(0), "aantal gevulde bergplaatsen", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aantal gevulde bergplaatsen"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_3 : Contribution( fold == "aantal gevulde bergplaatsen: vouw 0", subject == $onderwerp ); $aantal_vouw_6 : count() )
then
    Object v = waarde_aantalGevuldeBergplaatsen($aantal_vouw_6);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aantal gevulde bergplaatsen", ComputeHelpers.designate(v, "aantal gevulde bergplaatsen")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aantal gevulde bergplaatsen", false), v, "aantal gevulde bergplaatsen"));
        }
    }
end

function boolean beta1_aantalGevuldeBergplaatsenBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("schipper"), java.util.Arrays.asList());
}

function boolean beta2_aantalGevuldeBergplaatsenBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("losplaats"), java.util.Arrays.asList());
}

rule "aantal gevulde bergplaatsen: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Bergplaats( $vangstgewicht : vangstgewicht )
    exists( $tussen_pad_0 : dev.uchar.regelspraak.facts.Boot( beta1_aantalGevuldeBergplaatsenBijdrageAanVouw0(this, $vouwonderwerp), beta2_aantalGevuldeBergplaatsenBijdrageAanVouw0(this, $onderwerp) ) )
then
    Object v = ComputeHelpers.contribution("aantal gevulde bergplaatsen: vouw 0", $vouwonderwerp, $onderwerp, $vangstgewicht, null, null, true, false);
    if (v != null) {
        insertLogical(v);
    }
end

