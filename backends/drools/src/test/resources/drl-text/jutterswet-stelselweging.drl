package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het ruwgewicht van de Vangst, met een minimum van 1 t
function Object waarde_ondergewichtVanEenVangst(Object $ruwgewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsBegrens($ruwgewicht, ComputeHelpers.restateExact(new java.math.BigDecimal("1"), new java.math.BigDecimal("1000"), new java.math.BigDecimal("1")), null), Integer.valueOf(2), "ondergewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "ondergewicht van een vangst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vangst( $ruwgewicht : ruwgewicht )
then
    Object v = waarde_ondergewichtVanEenVangst($ruwgewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "ondergewicht van een vangst", ComputeHelpers.designate(v, "ondergewicht van een vangst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vangst", "ondergewicht", false), v, "ondergewicht van een vangst"));
        }
    }
end

// het ruwgewicht van de Vangst
function Object waarde_spiegelgewichtVanEenVangst(Object $ruwgewicht) {
    try {
        return ComputeHelpers.fitTarget($ruwgewicht, Integer.valueOf(2), "spiegelgewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "spiegelgewicht van een vangst"
