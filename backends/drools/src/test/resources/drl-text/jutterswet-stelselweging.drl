// het ruwgewicht van de Vangst plus het spiegelgewicht van de Vangst
function Object waarde_somgewichtVanEenVangst(Object $ruwgewicht, Object $spiegelgewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($ruwgewicht, $spiegelgewicht), Integer.valueOf(2), "somgewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "somgewicht van een vangst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vangst( $ruwgewicht : ruwgewicht )
    $stand_1 : State( attribute == ElementKey.of("vangst", "spiegelgewicht", false), subject == $onderwerp, $spiegelgewicht : value )
then
    Object v = waarde_somgewichtVanEenVangst($ruwgewicht, $spiegelgewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "somgewicht van een vangst", ComputeHelpers.designate(v, "somgewicht van een vangst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vangst", "somgewicht", false), v, "somgewicht van een vangst"));
        }
    }
end

