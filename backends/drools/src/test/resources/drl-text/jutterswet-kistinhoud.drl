then
    Object v = waarde_inhoudVanEenWrakkist($ribbe);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "inhoud van een wrakkist", ComputeHelpers.designate(v, "inhoud van een wrakkist")));
    } else {
