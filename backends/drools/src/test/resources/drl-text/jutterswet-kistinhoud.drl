    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(RegelSpraakRuntime.rsMacht($ribbe, Integer.valueOf(3)), Integer.valueOf(2), java.math.RoundingMode.FLOOR), Integer.valueOf(2), "inhoud", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
