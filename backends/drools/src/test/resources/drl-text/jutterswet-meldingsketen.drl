rule "padstand Vondst.vinder naar Jutter.erkend: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( pad_padstandVondstVinderNaarJutterErkendLinkAfwezig(this) == null )
then
    insertLogical(new PathState($onderwerp, "Vondst:vinder", ElementKey.of("jutter", "erkend", true), null, null));
end

rule "stand Jutter.erkende meldingsdatum: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "erkende meldingsdatum", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "erkende meldingsdatum", false), $v));
end

rule "stand Jutter.erkende meldingsdatum: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : erkendeMeldingsdatum )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "erkende meldingsdatum", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "erkende meldingsdatum", false), $invoer));
end

rule "kenmerkstand Jutter.erkend: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.holds(erkend) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "erkend", true), true));
end

rule "kenmerkstand Jutter.erkend: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("jutter", "erkend", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "erkend", true), true));
end

rule "kenmerkstand Jutter.erkend: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.holds(erkend) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("jutter", "erkend", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "erkend", true), false));
end

rule "parameterstand meldtermijngrens"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("meldtermijngrens", meldtermijngrens));
end

