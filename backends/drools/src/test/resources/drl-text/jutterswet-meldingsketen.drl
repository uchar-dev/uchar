global java.time.LocalDate meldtermijngrens;

// de erkende meldingsdatum van de vinder van de Vondst gevuld is
function boolean toets_aanmelddatumVanEenVondst(Object $vinderErkendeMeldingsdatum) {
    return ComputeHelpers.emptyTest($vinderErkendeMeldingsdatum, Boolean.FALSE);
}

rule "aanmelddatum van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $vinddag : vinddag )
    $padstand_0 : PathState( path == "Vondst:vinder" && member == ElementKey.of("jutter", "erkende meldingsdatum", false), subject == $onderwerp, $vinderErkendeMeldingsdatum : value )
    eval( toets_aanmelddatumVanEenVondst($vinderErkendeMeldingsdatum) )
then
    // de vinddag van de Vondst
    Object v = $vinddag;
    if (!ComputeHelpers.isEmpty(v)) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "aanmelddatum", false), v, "aanmelddatum van een vondst"));
    }
end

// hij aan alle volgende voorwaarden voldoet: - het gewicht van de Vondst is groter dan 0 - de erkende meldingsdatum van de vinder van de Vondst is later dan de vinddag van de Vondst
function boolean toets_controledatumVanEenVondst(Object $gewicht, Object $vinderErkendeMeldingsdatum, Object $vinddag) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($gewicht, new java.math.BigDecimal("0"), ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.dateCompare($vinderErkendeMeldingsdatum, $vinddag, dev.uchar.regelspraak.ir.Condition.Operator.LATER)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

// de vinddag van de Vondst plus 14 dagen
function Object waarde_controledatumVanEenVondst(Object $vinddag) {
    try {
        return ComputeHelpers.dateStep($vinddag, new java.math.BigDecimal("14"), "DAYS", Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "controledatum van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht, $vinddag : vinddag )
    $padstand_1 : PathState( path == "Vondst:vinder" && member == ElementKey.of("jutter", "erkende meldingsdatum", false), subject == $onderwerp, $vinderErkendeMeldingsdatum : value )
    eval( toets_controledatumVanEenVondst($gewicht, $vinderErkendeMeldingsdatum, $vinddag) )
then
    Object v = waarde_controledatumVanEenVondst($vinddag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "controledatum van een vondst", ComputeHelpers.designate(v, "controledatum van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "controledatum", false), v, "controledatum van een vondst"));
        }
    }
end

// de erkende meldingsdatum van de vinder van de Vondst eerder is dan de meldtermijngrens
function boolean toets_tijdigeAanmelding(Object $vinderErkendeMeldingsdatum, Object $meldtermijngrens) {
    try {
        return ComputeHelpers.dateCompare($vinderErkendeMeldingsdatum, ComputeHelpers.required($meldtermijngrens, "parameter \"meldtermijngrens\" is unbound in this case (binding is fail-fast, ch. 5.7)"), dev.uchar.regelspraak.ir.Condition.Operator.EERDER);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "tijdige aanmelding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $parameter_1 : ParameterState( parameter == "meldtermijngrens", $meldtermijngrens : value )
    $padstand_0 : PathState( path == "Vondst:vinder" && member == ElementKey.of("jutter", "erkende meldingsdatum", false), subject == $onderwerp, $vinderErkendeMeldingsdatum : value )
    eval( toets_tijdigeAanmelding($vinderErkendeMeldingsdatum, $meldtermijngrens) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "tijdig aangemeld", true)));
end

// de erkende meldingsdatum van de vinder van de Vondst eerder is dan de meldtermijngrens
function boolean toets_tijdigeAanmeldingFoutInDeVoorwaarde(Object $vinderErkendeMeldingsdatum, Object $meldtermijngrens) {
    try {
        boolean uitkomst = ComputeHelpers.dateCompare($vinderErkendeMeldingsdatum, ComputeHelpers.required($meldtermijngrens, "parameter \"meldtermijngrens\" is unbound in this case (binding is fail-fast, ch. 5.7)"), dev.uchar.regelspraak.ir.Condition.Operator.EERDER);
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

// de erkende meldingsdatum van de vinder van de Vondst eerder is dan de meldtermijngrens
function Object fout_tijdigeAanmeldingFoutInDeVoorwaarde(Object $vinderErkendeMeldingsdatum, Object $meldtermijngrens) {
    try {
        boolean uitkomst = ComputeHelpers.dateCompare($vinderErkendeMeldingsdatum, ComputeHelpers.required($meldtermijngrens, "parameter \"meldtermijngrens\" is unbound in this case (binding is fail-fast, ch. 5.7)"), dev.uchar.regelspraak.ir.Condition.Operator.EERDER);
        return null;
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "tijdige aanmelding: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $parameter_1 : ParameterState( parameter == "meldtermijngrens", $meldtermijngrens : value )
    $padstand_0 : PathState( path == "Vondst:vinder" && member == ElementKey.of("jutter", "erkende meldingsdatum", false), subject == $onderwerp, $vinderErkendeMeldingsdatum : value )
    eval( toets_tijdigeAanmeldingFoutInDeVoorwaarde($vinderErkendeMeldingsdatum, $meldtermijngrens) )
then
    Object f = fout_tijdigeAanmeldingFoutInDeVoorwaarde($vinderErkendeMeldingsdatum, $meldtermijngrens);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"tijdige aanmelding\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "tijdige aanmelding", ComputeHelpers.designate(f, "tijdige aanmelding")));
end

// zijn vinder erkend is
function boolean toets_meldingsgewichtVanEenVondst(Object $vinderErkend) {
    return ComputeHelpers.characteristicCheckAlongPath($vinderErkend, Boolean.TRUE);
}

// het gewicht van de Vondst gedeeld door de weegfactor van de Vondst rekenkundig afgerond op 2 decimalen
function Object waarde_meldingsgewichtVanEenVondst(Object $gewicht, Object $weegfactor, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($gewicht, $weegfactor, sonde), Integer.valueOf(2), java.math.RoundingMode.HALF_UP), Integer.valueOf(2), "meldingsgewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "meldingsgewicht van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht, $weegfactor : weegfactor )
    $padstand_0 : PathState( path == "Vondst:vinder" && member == ElementKey.of("jutter", "erkend", true), subject == $onderwerp, $vinderErkend : value )
    eval( toets_meldingsgewichtVanEenVondst($vinderErkend) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_meldingsgewichtVanEenVondst($gewicht, $weegfactor, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldingsgewicht van een vondst", ComputeHelpers.designate(v, "meldingsgewicht van een vondst")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("meldingsgewicht van een vondst", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "meldingsgewicht", false), v, "meldingsgewicht van een vondst"));
        }
    }
end

// zijn vinder niet erkend is
function boolean toets_ongemeldeVondst(Object $vinderErkend) {
    return ComputeHelpers.characteristicCheckAlongPath($vinderErkend, Boolean.FALSE);
}

rule "ongemelde vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $padstand_0 : PathState( path == "Vondst:vinder" && member == ElementKey.of("jutter", "erkend", true), subject == $onderwerp, $vinderErkend : value )
    eval( toets_ongemeldeVondst($vinderErkend) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "ongemeld", true)));
end

// de erkende meldingsdatum van de Jutter gevuld is
function boolean toets_erkenningVanDeMelder(Object $erkendeMeldingsdatum) {
    return ComputeHelpers.emptyTest($erkendeMeldingsdatum, Boolean.FALSE);
}

rule "erkenning van de melder"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $stand_0 : State( attribute == ElementKey.of("jutter", "erkende meldingsdatum", false), subject == $onderwerp, $erkendeMeldingsdatum : value )
    eval( toets_erkenningVanDeMelder($erkendeMeldingsdatum) )
