    return ComputeHelpers.along(o, java.util.Arrays.asList("vinder"));
}

rule "padstand Vondst.vinder naar Jutter.erkende meldingsdatum: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( pad_padstandVondstVinderNaarJutterErkendeMeldingsdatumLinkAanwezig(this) != null, $bereikt : vinder )
    $stand : State( attribute == ElementKey.of("jutter", "erkende meldingsdatum", false), subject != null, subject == $bereikt, $v : value )
then
    insertLogical(new PathState($onderwerp, "Vondst:vinder", ElementKey.of("jutter", "erkende meldingsdatum", false), $v, $bereikt));
end

