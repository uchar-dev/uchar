    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( pad_padstandVondstVinderNaarJutterErkendeMeldingsdatumLinkAfwezig(this) == null )
then
    insertLogical(new PathState($onderwerp, "Vondst:vinder", ElementKey.of("jutter", "erkende meldingsdatum", false), null, null));
end

function Object pad_padstandVondstVinderNaarJutterErkendLinkAanwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("vinder"));
}

rule "padstand Vondst.vinder naar Jutter.erkend: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( pad_padstandVondstVinderNaarJutterErkendLinkAanwezig(this) != null, $bereikt : vinder )
    $stand : CharacteristicState( characteristic == ElementKey.of("jutter", "erkend", true), subject != null, subject == $bereikt, $v : holds )
