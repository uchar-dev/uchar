// de herstelde meldingsdatum van de Jutter gevuld is
function boolean toets_defaultsAJutterErkendeMeldingsdatumDefault0(Object $hersteldeMeldingsdatum) {
    return ComputeHelpers.emptyTest($hersteldeMeldingsdatum, Boolean.FALSE);
}

rule "defaults A:Jutter.erkende meldingsdatum: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $hersteldeMeldingsdatum : hersteldeMeldingsdatum )
    eval( toets_defaultsAJutterErkendeMeldingsdatumDefault0($hersteldeMeldingsdatum) )
then
    // de herstelde meldingsdatum van de Jutter
    Object v = $hersteldeMeldingsdatum;
    if (v != null) {
        insertLogical(new Value($onderwerp, ElementKey.of("jutter", "erkende meldingsdatum", false), v, "defaults A:Jutter.erkende meldingsdatum"));
        insertLogical(new Decides($onderwerp, "defaults A:Jutter.erkende meldingsdatum", 0));
    }
end

rule "defaults A:Jutter.erkende meldingsdatum: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $meldingsdatum : meldingsdatum )
    not( $hoger_26 : Decides( stack == "defaults A:Jutter.erkende meldingsdatum" && index < 1, subject == $onderwerp ) )
then
    // de meldingsdatum van de Jutter
    Object v = $meldingsdatum;
    if (v != null) {
        insertLogical(new Value($onderwerp, ElementKey.of("jutter", "erkende meldingsdatum", false), v, "defaults A:Jutter.erkende meldingsdatum"));
        insertLogical(new Decides($onderwerp, "defaults A:Jutter.erkende meldingsdatum", 1));
    }
end

