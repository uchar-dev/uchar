rule "premiewaardig bij keurvergoeding: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Keurploeg()
    accumulate( $bijdrage_vouw_17 : Contribution( fold == "premiewaardig bij keurvergoeding: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_21 : value ); $aantal_vouw_20 : count(), $vouw_vouw_22 : collectList($bijdragewaarde_vouw_21) )
    eval( toets_premiewaardigBijKeurvergoedingFoutInDeVoorwaarde($aantal_vouw_20, $vouw_vouw_22) )
then
    Object f = fout_premiewaardigBijKeurvergoedingFoutInDeVoorwaarde($aantal_vouw_20, $vouw_vouw_22);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("de voorwaarde van \"premiewaardig bij keurvergoeding\" faalde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    insertLogical(new Fault($onderwerp, "premiewaardig bij keurvergoeding", ComputeHelpers.designate(f, "premiewaardig bij keurvergoeding")));
end

