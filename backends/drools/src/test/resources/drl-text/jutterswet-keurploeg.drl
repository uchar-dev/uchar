rule "keurtal van een keurploeg"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Keurploeg()
    accumulate( $bijdrage_vouw_49 : Contribution( fold == "keurtal van een keurploeg: vouw 2", subject == $onderwerp ); $aantal_vouw_52 : count() )
then
    Object v = waarde_keurtalVanEenKeurploeg($aantal_vouw_52);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "keurtal van een keurploeg", ComputeHelpers.designate(v, "keurtal van een keurploeg")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("keurploeg", "keurtal", false), v, "keurtal van een keurploeg"));
        }
    }
end

