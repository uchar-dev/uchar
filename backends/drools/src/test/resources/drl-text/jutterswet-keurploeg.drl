// de keurvergoeding van alle keurmeesters van de Keurploeg die aangemeld zijn gedurende het gehele jaar groter is dan 40
function Object lidtoets_premiewaardigBijKeurvergoedingBijdrageAanVouw0(Object $onderwerp, Object $tijdlijn_2, Object $lijstplaatsen_plaats_5, Object $plaats_plaats_6) {
    java.util.List plaats = plaats_premiewaardigBijKeurvergoedingBijdrageAanVouw0($onderwerp, $lijstplaatsen_plaats_5, $plaats_plaats_6);
    Boolean waar = null;
    RuntimeException fout = null;
    try {
        waar = Boolean.valueOf(ComputeHelpers.wholePeriod(ComputeHelpers.complete($tijdlijn_2, "the whole-period qualifier over \"keurvergoeding\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "keurvergoeding", Boolean.TRUE), new java.math.BigDecimal("40"), "JAAR", Integer.valueOf(2), Boolean.FALSE));
    } catch (RuntimeException e) {
        fout = ComputeHelpers.caught(e);
    }
    return new MemberTest(plaats, waar, fout, ComputeHelpers.reported(null), ComputeHelpers.depositCodes(null));
}

