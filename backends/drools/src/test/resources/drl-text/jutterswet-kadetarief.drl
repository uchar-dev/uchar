    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit( $invoer : (ComputeHelpers.periods(kadetarief)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("schuit", "kadetarief", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("schuit", "kadetarief", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("schuit", "kadetarief", false), ComputeHelpers.bucketScalarOf($invoer)));
