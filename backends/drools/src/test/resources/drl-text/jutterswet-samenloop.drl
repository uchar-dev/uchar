when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $wachter : (ComputeHelpers.holds(wachter)), $wachtgeld : wachtgeld )
    not( $hoger_7 : Decides( stack == "defaults A:Jutter.vergoeding" && index < 2, subject == $onderwerp ) )
    eval( toets_defaultsAJutterVergoedingDefault2($wachter) )
then
    // zijn wachtgeld
    Object v = $wachtgeld;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "vergoeding");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Jutter.vergoeding", ComputeHelpers.designate(passend, "defaults A:Jutter.vergoeding")));
            insertLogical(new Decides($onderwerp, "defaults A:Jutter.vergoeding", 2));
