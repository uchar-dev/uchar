rule "ploegvoorjaarsgewicht van een ploeg"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg()
    accumulate( $bijdrage_vouw_7 : Contribution( fold == "ploegvoorjaarsgewicht van een ploeg: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_11 : value ); $aantal_vouw_10 : count(), $vouw_vouw_12 : exactSum($bijdragewaarde_vouw_11) )
then
    Object v = waarde_ploegvoorjaarsgewichtVanEenPloeg($aantal_vouw_10, $vouw_vouw_12);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "ploegvoorjaarsgewicht van een ploeg", ComputeHelpers.designate(v, "ploegvoorjaarsgewicht van een ploeg")));
