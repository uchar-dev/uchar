package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactMaximumFunction exactMax;
import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn vondstgewicht in zomer maal 2
function Object waarde_najaarsgewichtVanEenJutter(Object $vondstgewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal(ComputeHelpers.cell($vondstgewicht, java.util.Arrays.asList("zomer")), new java.math.BigDecimal("2")), Integer.valueOf(2), "vondstgewicht[najaar]", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "najaarsgewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstgewicht : vondstgewicht )
then
    Object v = waarde_najaarsgewichtVanEenJutter($vondstgewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "najaarsgewicht van een jutter", ComputeHelpers.designate(v, "najaarsgewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vondstgewicht[najaar]", false), v, "najaarsgewicht van een jutter"));
        }
    }
end

function Object pad_leidersvoorjaarsgewichtVanEenPloeg(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("leider"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "vondstgewicht");
}

