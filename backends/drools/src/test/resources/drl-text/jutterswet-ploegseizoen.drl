rule "leidersnajaarsgewicht van een ploeg"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg()
    $padstand_0 : PathState( path == "Ploeg:leider" && member == ElementKey.of("jutter", "vondstgewicht[najaar]", false), subject == $onderwerp, $leiderVondstgewicht : value )
then
    Object v = waarde_leidersnajaarsgewichtVanEenPloeg($leiderVondstgewicht);
