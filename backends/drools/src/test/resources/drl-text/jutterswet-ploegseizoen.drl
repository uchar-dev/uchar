    }
end

function Object pad_padstandPloegLeiderNaarJutterVondstgewichtLinkAanwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("leider"));
}

rule "padstand Ploeg.leider naar Jutter.vondstgewicht: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg( pad_padstandPloegLeiderNaarJutterVondstgewichtLinkAanwezig(this) != null, $bereikt : leider )
    $stand : State( attribute == ElementKey.of("jutter", "vondstgewicht[najaar]", false), subject != null, subject == $bereikt, $v : value )
then
    insertLogical(new PathState($onderwerp, "Ploeg:leider", ElementKey.of("jutter", "vondstgewicht[najaar]", false), $v, $bereikt));
end

function Object pad_padstandPloegLeiderNaarJutterVondstgewichtLinkAfwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("leider"));
}

rule "padstand Ploeg.leider naar Jutter.vondstgewicht: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg( pad_padstandPloegLeiderNaarJutterVondstgewichtLinkAfwezig(this) == null )
then
    insertLogical(new PathState($onderwerp, "Ploeg:leider", ElementKey.of("jutter", "vondstgewicht[najaar]", false), null, null));
end

rule "stand Jutter.vondstgewicht[najaar]: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "vondstgewicht[najaar]", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "vondstgewicht[najaar]", false), $v));
end

rule "stand Jutter.vondstgewicht[najaar]: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : vondstgewicht )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "vondstgewicht[najaar]", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "vondstgewicht[najaar]", false), ComputeHelpers.cell($invoer, java.util.Arrays.asList("najaar"))));
end

