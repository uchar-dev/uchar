rule "ploegvoorjaarsgewicht van een ploeg: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Ploeg()
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ploeg == $vouwonderwerp, $vondstgewicht : vondstgewicht )
then
    Object v = ComputeHelpers.contribution("ploegvoorjaarsgewicht van een ploeg: vouw 0", $vouwonderwerp, $onderwerp, ComputeHelpers.cell($vondstgewicht, java.util.Arrays.asList("voorjaar")), null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "zwaarste ledennajaarsgewicht van een ploeg: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Ploeg()
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ploeg == $vouwonderwerp )
    $stand_1 : State( attribute == ElementKey.of("jutter", "vondstgewicht[najaar]", false), subject == $onderwerp, $vondstgewicht : value )
then
    Object v = ComputeHelpers.contribution("zwaarste ledennajaarsgewicht van een ploeg: vouw 1", $vouwonderwerp, $onderwerp, $vondstgewicht, null, null, false, false);
