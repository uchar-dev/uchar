// de som van het vondstgewicht van de leider van de Ploeg over alle seizoenen
function Object waarde_leidersjaargewichtVanEenPloeg(Object $leiderVondstgewicht, Object $leiderVondstgewicht2) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsDimSom(ComputeHelpers.map(ComputeHelpers.withCell($leiderVondstgewicht, java.util.Arrays.asList("najaar"), $leiderVondstgewicht2)), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar"))), Integer.valueOf(2), "leidersjaargewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "leidersjaargewicht van een ploeg"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg( $leiderVondstgewicht : (pad_leidersjaargewichtVanEenPloeg(this)) )
    $padstand_1 : PathState( path == "Ploeg:leider" && member == ElementKey.of("jutter", "vondstgewicht[najaar]", false), subject == $onderwerp, $leiderVondstgewicht2 : value )
then
    Object v = waarde_leidersjaargewichtVanEenPloeg($leiderVondstgewicht, $leiderVondstgewicht2);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "leidersjaargewicht van een ploeg", ComputeHelpers.designate(v, "leidersjaargewicht van een ploeg")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("ploeg", "leidersjaargewicht", false), v, "leidersjaargewicht van een ploeg"));
        }
    }
end

