package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// hij aan ten hoogste twee van de volgende voorwaarden voldoet: - het aandeel is groter dan 0 - zijn ploegomvang is gelijk aan 0
function boolean toets_vacuumtekenVanEenVacuumwacht(Object $vangstwaarde, Object $ploegomvang) {
    try {
        int raak = 0;
        Boolean vast;
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 0, 2);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($vangstwaarde, $ploegomvang, null), Integer.valueOf(0), java.math.RoundingMode.FLOOR), new java.math.BigDecimal("0"), ">")) {
            raak++;
        }
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 1, 1);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("0"), "==")) {
            raak++;
        }
        return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 2);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

// 1
function Object waarde_vacuumtekenVanEenVacuumwacht(Object sonde) {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "vacuumteken", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vacuumteken van een vacuumwacht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vacuumwacht( $vangstwaarde : vangstwaarde, $ploegomvang : ploegomvang )
    eval( toets_vacuumtekenVanEenVacuumwacht($vangstwaarde, $ploegomvang) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_vacuumtekenVanEenVacuumwacht(sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vacuumteken van een vacuumwacht", ComputeHelpers.designate(v, "vacuumteken van een vacuumwacht")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("vacuumteken van een vacuumwacht", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vacuumwacht", "vacuumteken", false), v, "vacuumteken van een vacuumwacht"));
        }
    }
end

// hij aan ten hoogste twee van de volgende voorwaarden voldoet: - het aandeel is groter dan 0 - zijn ploegomvang is gelijk aan 0
function boolean toets_vacuumtekenVanEenVacuumwachtFoutInDeVoorwaarde(Object $vangstwaarde, Object $ploegomvang) {
    try {
        boolean uitkomst = samengesteld1_vacuumtekenVanEenVacuumwachtFoutInDeVoorwaarde($vangstwaarde, $ploegomvang);
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

