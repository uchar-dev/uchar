rule "vacuumteken van een vacuumwacht: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vacuumwacht( $vangstwaarde : vangstwaarde, $ploegomvang : ploegomvang )
    eval( toets_vacuumtekenVanEenVacuumwachtFoutInDeVoorwaarde($vangstwaarde, $ploegomvang) )
then
    Object f = fout_vacuumtekenVanEenVacuumwachtFoutInDeVoorwaarde($vangstwaarde, $ploegomvang);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"vacuumteken van een vacuumwacht\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "vacuumteken van een vacuumwacht", ComputeHelpers.designate(f, "vacuumteken van een vacuumwacht")));
end

