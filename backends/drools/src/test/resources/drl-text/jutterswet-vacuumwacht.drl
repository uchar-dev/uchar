    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("0"), "==")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 4);
}

// hij aan ten hoogste twee van de volgende voorwaarden voldoet: - zijn ploegomvang is groter dan 100 - zijn vangstwaarde is groter dan 100000 - het aandeel is groter dan 0 - zijn ploegomvang is gelijk aan 0
function java.util.List deponering_stoptekenVanEenVacuumwachtDeponeringInDeVoorwaarde(Object $ploegomvang, Object $vangstwaarde, Object sonde) {
    try {
        boolean uitkomst = samengesteld2_stoptekenVanEenVacuumwachtDeponeringInDeVoorwaarde($ploegomvang, $vangstwaarde, sonde);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
    }
    if (!ComputeHelpers.reported(sonde)) {
        ComputeHelpers.contractBreach("the condition of \"stopteken van een vacuumwacht\" deposited in the test and not in the consequence, over the same bound values");
    }
    return ComputeHelpers.depositCodes(sonde);
}

// hij aan ten hoogste twee van de volgende voorwaarden voldoet: - zijn ploegomvang is groter dan 100 - zijn vangstwaarde is groter dan 100000 - het aandeel is groter dan 0 - zijn ploegomvang is gelijk aan 0
function boolean samengesteld2_stoptekenVanEenVacuumwachtDeponeringInDeVoorwaarde(Object $ploegomvang, Object $vangstwaarde, Object sonde) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 0, 4);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("100"), ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 1, 3);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($vangstwaarde, new java.math.BigDecimal("100000"), ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 2, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($vangstwaarde, $ploegomvang, sonde), Integer.valueOf(0), java.math.RoundingMode.FLOOR), new java.math.BigDecimal("0"), ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 3, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("0"), "==")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 2, raak, 4);
}

rule "stopteken van een vacuumwacht: deponering in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vacuumwacht( $ploegomvang : ploegomvang, $vangstwaarde : vangstwaarde )
    eval( toets_stoptekenVanEenVacuumwachtDeponeringInDeVoorwaarde($ploegomvang, $vangstwaarde, ComputeHelpers.depositFlag()) )
then
    insertLogical(ComputeHelpers.inconsistency("stopteken van een vacuumwacht", $onderwerp, deponering_stoptekenVanEenVacuumwachtDeponeringInDeVoorwaarde($ploegomvang, $vangstwaarde, ComputeHelpers.depositFlag())));
end

