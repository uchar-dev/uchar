package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Decides;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn gewenste afhaal-dag leeg is
function boolean toets_directeVrijgave(Object $gewensteAfhaalDag) {
    return ComputeHelpers.emptyTest($gewensteAfhaalDag, Boolean.TRUE);
}

rule "directe vrijgave"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewensteAfhaalDag : gewensteAfhaalDag )
    eval( toets_directeVrijgave($gewensteAfhaalDag) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "direct vrijgegeven", true)));
end

// zijn taxatie groter is dan 1000
function boolean toets_vindloon(Object $taxatie) {
    return RegelSpraakRuntime.rsAggVergelijk($taxatie, new java.math.BigDecimal("1000"), ">");
}

// 10
function Object waarde_vindloon() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("10"), Integer.valueOf(0), "vindloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vindloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $taxatie : taxatie )
    eval( toets_vindloon($taxatie) )
then
    Object v = waarde_vindloon();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vindloon", ComputeHelpers.designate(v, "vindloon")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vindloon", false), v, "vindloon"));
        }
    }
end

