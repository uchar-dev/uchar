function Object waarde_wachtkortingVanEenJutter(Object $dienstjaren) {
    try {
        return ComputeHelpers.fitTarget($dienstjaren, Integer.valueOf(0), "wachtkorting", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "wachtkorting van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $dienstjaren : dienstjaren )
    $padstand_0 : PathState( path == "Jutter:standpost" && member == ElementKey.of("strandpost", "bemand", true), subject == $onderwerp, $standpostBemand : value )
    eval( toets_wachtkortingVanEenJutter($standpostBemand) )
then
