package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de standpost van de Jutter gedurende het gehele jaar bemand is
function boolean toets_wachtvergoedingVanEenJutter(Object $standpostBemand) {
    return ComputeHelpers.wholePeriod($standpostBemand, null, "JAAR", Integer.valueOf(7), Boolean.FALSE);
}

// zijn dienstjaren
function Object waarde_wachtvergoedingVanEenJutter(Object $dienstjaren) {
    try {
        return ComputeHelpers.fitTarget($dienstjaren, Integer.valueOf(0), "wachtvergoeding", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "wachtvergoeding van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $dienstjaren : dienstjaren )
    $padstand_0 : PathState( path == "Jutter:standpost" && member == ElementKey.of("strandpost", "bemand", true), subject == $onderwerp, $standpostBemand : value )
    eval( toets_wachtvergoedingVanEenJutter($standpostBemand) )
then
    Object v = waarde_wachtvergoedingVanEenJutter($dienstjaren);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "wachtvergoeding van een jutter", ComputeHelpers.designate(v, "wachtvergoeding van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "wachtvergoeding", false), v, "wachtvergoeding van een jutter"));
        }
    }
end

// de standpost van de Jutter niet gedurende het gehele jaar bemand is
function boolean toets_wachtkortingVanEenJutter(Object $standpostBemand) {
    return ComputeHelpers.wholePeriod($standpostBemand, null, "JAAR", Integer.valueOf(7), Boolean.TRUE);
}

