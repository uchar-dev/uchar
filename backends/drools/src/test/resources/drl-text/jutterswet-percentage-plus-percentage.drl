package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn basistarief plus zijn toeslag
function Object waarde_tarief(Object $basistarief, Object $toeslag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($basistarief, $toeslag), Integer.valueOf(0), "tarief", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "tarief"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $basistarief : basistarief, $toeslag : toeslag )
then
    Object v = waarde_tarief($basistarief, $toeslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "tarief", ComputeHelpers.designate(v, "tarief")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "tarief", false), v, "tarief"));
        }
    }
end

