package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het ruwbedrag van de Jutter begrensd op minimaal 10
function Object waarde_ondergrensVanEenJutter(Object $ruwbedrag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsBegrens($ruwbedrag, new java.math.BigDecimal("10"), null), Integer.valueOf(2), "ondergrens", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "ondergrens van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $ruwbedrag : ruwbedrag )
then
    Object v = waarde_ondergrensVanEenJutter($ruwbedrag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "ondergrens van een jutter", ComputeHelpers.designate(v, "ondergrens van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "ondergrens", false), v, "ondergrens van een jutter"));
        }
    }
end

