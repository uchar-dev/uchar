// "Bedrag: «zijn basis» voor «zijn soort», gemeld «zijn bevestiging» op «zijn vinddatum»"
function Object waarde_verslag(Object $basis, Object $soort, Object $bevestiging, Object $vinddatum) {
    try {
        return ComputeHelpers.textComposition(java.util.Arrays.asList("Bedrag: ", RegelSpraakRuntime.rsTekst($basis, Integer.valueOf(2), null), " voor ", RegelSpraakRuntime.rsTekst($soort, null, null), ", gemeld ", RegelSpraakRuntime.rsTekst($bevestiging, null, null), " op ", RegelSpraakRuntime.rsTekst($vinddatum, null, null)));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "verslag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $basis : basis, $soort : soort, $bevestiging : bevestiging, $vinddatum : vinddatum )
then
    Object v = waarde_verslag($basis, $soort, $bevestiging, $vinddatum);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "verslag", ComputeHelpers.designate(v, "verslag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "verslag", false), v, "verslag"));
        }
    }
end

