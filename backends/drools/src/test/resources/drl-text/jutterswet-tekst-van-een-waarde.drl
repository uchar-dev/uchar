package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.EmptyBarrier;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// "Bedrag: «zijn basis»"
function Object waarde_omschrijving(Object $basis) {
    try {
        return ComputeHelpers.textComposition(java.util.Arrays.asList("Bedrag: ", RegelSpraakRuntime.rsTekst($basis, Integer.valueOf(2), null)));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "omschrijving"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $basis : basis )
then
    Object v = waarde_omschrijving($basis);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "omschrijving", ComputeHelpers.designate(v, "omschrijving")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "omschrijving", false), v, "omschrijving"));
        }
    }
end

// "Deel: «zijn basis gedeeld door 3»"
function Object waarde_deeltekst(Object $basis, Object sonde) {
    try {
        return ComputeHelpers.textComposition(java.util.Arrays.asList("Deel: ", RegelSpraakRuntime.rsTekst(ComputeHelpers.divided($basis, new java.math.BigDecimal("3"), sonde), null, null)));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "deeltekst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $basis : basis )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_deeltekst($basis, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "deeltekst", ComputeHelpers.designate(v, "deeltekst")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("deeltekst", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "deeltekst", false), v, "deeltekst"));
        }
    }
end

