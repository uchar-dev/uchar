// de heffing is zijn basis maal 1,1
function Object waarde_heffingtekst(Object $basis) {
    try {
        return let_heffingtekst($basis);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// de heffing is zijn basis maal 1,1
function Object let_heffingtekst(Object $basis) {
    Object cel_1 = ComputeHelpers.binderCell();
    try {
        return ComputeHelpers.textComposition(java.util.Arrays.asList("Heffing: ", RegelSpraakRuntime.rsTekst(binder_heffingtekst($basis, cel_1), Integer.valueOf(3), null)));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_1);
    }
}

// zijn basis maal 1,1
function Object binder_heffingtekst(Object $basis, Object cel_1) {
    if (!ComputeHelpers.binderCellFilled(cel_1)) {
        ComputeHelpers.fillBinderCell(cel_1, RegelSpraakRuntime.rsMaal($basis, new java.math.BigDecimal("1.1")));
    }
    return ComputeHelpers.binderValue(cel_1);
}

rule "heffingtekst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $basis : basis )
then
    Object v = waarde_heffingtekst($basis);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffingtekst", ComputeHelpers.designate(v, "heffingtekst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "heffingtekst", false), v, "heffingtekst"));
        }
    }
end

// "Bedrag: «zijn basis (eenheid)», aandeel «zijn aandeel (eenheid)», toeslag «zijn basis maal 1,1 (eenheid)», zonder eenheid «zijn basis»"
function Object waarde_eenheidtekst(Object $basis, Object $aandeel) {
    try {
        return ComputeHelpers.textComposition(java.util.Arrays.asList("Bedrag: ", RegelSpraakRuntime.rsTekst($basis, Integer.valueOf(2), "EUR"), ", aandeel ", RegelSpraakRuntime.rsTekst($aandeel, Integer.valueOf(2), "%"), ", toeslag ", RegelSpraakRuntime.rsTekst(RegelSpraakRuntime.rsMaal($basis, new java.math.BigDecimal("1.1")), Integer.valueOf(3), "EUR"), ", zonder eenheid ", RegelSpraakRuntime.rsTekst($basis, Integer.valueOf(2), null)));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "eenheidtekst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $basis : basis, $aandeel : aandeel )
then
    Object v = waarde_eenheidtekst($basis, $aandeel);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "eenheidtekst", ComputeHelpers.designate(v, "eenheidtekst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "eenheidtekst", false), v, "eenheidtekst"));
        }
    }
end

