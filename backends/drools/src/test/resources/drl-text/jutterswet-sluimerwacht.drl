package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.Value;

// ten hoogste één van: bemand, verlicht, meldingen boven 2
function boolean toets_sluimerstandBijBeperkteDienst(Object $bemand, Object $verlicht, Object $meldingen) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($bemand, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($verlicht, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($meldingen, new java.math.BigDecimal("2"), ">")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 3);
}

rule "sluimerstand bij beperkte dienst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Seinpost( $bemand : (ComputeHelpers.holds(bemand)), $verlicht : (ComputeHelpers.holds(verlicht)), $meldingen : meldingen )
    eval( toets_sluimerstandBijBeperkteDienst($bemand, $verlicht, $meldingen) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("seinpost", "sluimerend", true)));
end

// de meldingen van de Seinpost
function Object waarde_afschriftVanDeMeldingen(Object $meldingen) {
    try {
        return ComputeHelpers.fitTarget($meldingen, Integer.valueOf(0), "meldingsafschrift", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "afschrift van de meldingen"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Seinpost( $meldingen : meldingen )
then
    Object v = waarde_afschriftVanDeMeldingen($meldingen);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "afschrift van de meldingen", ComputeHelpers.designate(v, "afschrift van de meldingen")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("seinpost", "meldingsafschrift", false), v, "afschrift van de meldingen"));
        }
    }
end

