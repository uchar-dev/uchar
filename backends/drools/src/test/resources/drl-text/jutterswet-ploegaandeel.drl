function java.util.List deponering_bergingsaandeelVanEenJutterDeponeringInDeVoorwaarde(Object $ploegomvang, Object $vangstwaarde, Object sonde) {
    try {
        boolean uitkomst = samengesteld2_bergingsaandeelVanEenJutterDeponeringInDeVoorwaarde($ploegomvang, $vangstwaarde, sonde);
