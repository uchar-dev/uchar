rule "bergingsaandeel van een jutter: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $ploegomvang : ploegomvang, $vangstwaarde : vangstwaarde )
    eval( toets_bergingsaandeelVanEenJutterFoutInDeVoorwaarde($ploegomvang, $vangstwaarde) )
then
    Object f = fout_bergingsaandeelVanEenJutterFoutInDeVoorwaarde($ploegomvang, $vangstwaarde);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"bergingsaandeel van een jutter\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "bergingsaandeel van een jutter", ComputeHelpers.designate(f, "bergingsaandeel van een jutter")));
end

