rule "bergingsaandeel van een jutter: deponering in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $ploegomvang : ploegomvang, $vangstwaarde : vangstwaarde )
    eval( toets_bergingsaandeelVanEenJutterDeponeringInDeVoorwaarde($ploegomvang, $vangstwaarde, ComputeHelpers.depositFlag()) )
then
    insertLogical(ComputeHelpers.inconsistency("bergingsaandeel van een jutter", $onderwerp, deponering_bergingsaandeelVanEenJutterDeponeringInDeVoorwaarde($ploegomvang, $vangstwaarde, ComputeHelpers.depositFlag())));
end

