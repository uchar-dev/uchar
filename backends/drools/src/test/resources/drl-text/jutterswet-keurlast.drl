    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

function java.util.List plaats_keurlastVanEenJutterLidfoutInVouw0OverEenOpenSegment(Object $onderwerp, Object $lijstplaatsen_plaats_17, Object $plaats_plaats_18) {
    return ComputeHelpers.foldPlace(dev.uchar.regelspraak.transpiler.tms.plan.Consequence.PlaceReason.MEMBER_FAULT, "keurlast van een jutter: vouw 0", $onderwerp, 0, java.util.Arrays.asList("keurendeJutter"), java.util.Arrays.asList($lijstplaatsen_plaats_17), java.util.Arrays.asList($plaats_plaats_18));
