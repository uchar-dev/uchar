rule "keurlast van een jutter: lidfout in vouw 0 over een open segment"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( keurendeJutter == $vouwonderwerp, $gekeurd : (ComputeHelpers.holds(gekeurd)) )
    accumulate( $lijstplaats_plaats_15 : ListPlace( field == "keurendeJutter", beta_keurlastVanEenJutterLidfoutInVouw0OverEenOpenSegment(this, $onderwerp), $lijstplaatswaarde_plaats_16 : place ); $lijstplaatsen_plaats_17 : count(), $plaats_plaats_18 : exactMin($lijstplaatswaarde_plaats_16) )
    $stand_3 : State( attribute == ElementKey.of("vondst", "keurtarief", false), subject == $onderwerp, $tijdlijn_3 : value )
    eval( toets_keurlastVanEenJutterLidfoutInVouw0OverEenOpenSegment($gekeurd, $tijdlijn_3) )
