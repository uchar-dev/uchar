    insertLogical(new MemberFault("keurlast van een jutter: vouw 0", $vouwonderwerp, $onderwerp, PeriodArithmetic.openSegmentFault("keurtarief", $onderwerp, $tijdlijn_3), plaats_keurlastVanEenJutterLidfoutInVouw0OverEenOpenSegment($onderwerp, $lijstplaatsen_plaats_17, $plaats_plaats_18)));
end

rule "stand Vondst.keurtarief: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : (ComputeHelpers.periods(keurtarief)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("vondst", "keurtarief", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "keurtarief", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "keurtarief", false), $invoer));
end

rule "stand Vondst.keurtarief: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : (ComputeHelpers.periods(keurtarief)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("vondst", "keurtarief", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "keurtarief", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "keurtarief", false), ComputeHelpers.bucketScalarOf($invoer)));
end

