package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Recipient;

rule "verdeel de kadeopbrengst van een kadeberging: ontvanger"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Kadeberging()
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( kadeberging == $vouwonderwerp, $vrachtgewicht : vrachtgewicht, $kademaximum : kademaximum )
then
    insertLogical(new Recipient("verdeel de kadeopbrengst van een kadeberging", $vouwonderwerp, $onderwerp, $vrachtgewicht, null, $kademaximum));
end

rule "verdeel de kadeopbrengst van een kadeberging"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kadeberging( $kadeopbrengst : kadeopbrengst )
    accumulate( $ontvanger_verdeling_1 : Recipient( allocation == "verdeel de kadeopbrengst van een kadeberging", source == $onderwerp ); $ontvangers_verdeling_2 : collectList($ontvanger_verdeling_1) )
then
    for (Object feit : ComputeHelpers.payout("verdeel de kadeopbrengst van een kadeberging", $onderwerp, dev.uchar.regelspraak.ir.ResolvedAllocation.Method.NAAR_RATO, $kadeopbrengst, $ontvangers_verdeling_2, true, true, false, Integer.valueOf(2), ElementKey.of("jutter", "kadedeel", false), ElementKey.of("kadeberging", "kaderest", false), "verdeel de kadeopbrengst van een kadeberging", Integer.valueOf(2), Integer.valueOf(2), "verdeel de kadeopbrengst van een kadeberging")) {
        insertLogical(feit);
    }
end

