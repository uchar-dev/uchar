package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Decides;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de taxatie van de Vondst verminderd met 5,00
function Object waarde_waardering(Object $taxatie) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsVerminderd($taxatie, new java.math.BigDecimal("5")), Integer.valueOf(2), "berekende waarde", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "waardering"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $taxatie : taxatie )
then
    Object v = waarde_waardering($taxatie);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "waardering", ComputeHelpers.designate(v, "waardering")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "berekende waarde", false), v, "waardering"));
        }
    }
end

// zijn gewicht gevuld is
function boolean toets_bergloonNaarGewicht(Object $gewicht) {
    return ComputeHelpers.emptyTest($gewicht, Boolean.FALSE);
}

// het gewicht van de Vondst maal 2
function Object waarde_bergloonNaarGewicht(Object $gewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal($gewicht, new java.math.BigDecimal("2")), Integer.valueOf(2), "berekende bergloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "bergloon naar gewicht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht )
    eval( toets_bergloonNaarGewicht($gewicht) )
then
    Object v = waarde_bergloonNaarGewicht($gewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "bergloon naar gewicht", ComputeHelpers.designate(v, "bergloon naar gewicht")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "berekende bergloon", false), v, "bergloon naar gewicht"));
        }
    }
end

// hij afwijkende opgave waarde heeft
function boolean toets_controleBijAfwijkendeWaarde(Object $afwijkendeOpgaveWaarde) {
    return ComputeHelpers.characteristic($afwijkendeOpgaveWaarde, Boolean.TRUE);
}

rule "controle bij afwijkende waarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "afwijkende opgave waarde", true), subject == $onderwerp, $afwijkendeOpgaveWaarde : holds )
    eval( toets_controleBijAfwijkendeWaarde($afwijkendeOpgaveWaarde) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "ter controle", true)));
end

// hij aan alle volgende voorwaarden voldoet: - zijn opgegeven waarde is gevuld - zijn berekende waarde is gevuld - zijn opgegeven waarde is ongelijk aan zijn berekende waarde
function boolean toets_afwijkingOpgaveWaarde(Object $opgegevenWaarde, Object $berekendeWaarde) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($opgegevenWaarde, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($berekendeWaarde, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($opgegevenWaarde, $berekendeWaarde, "!=")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

rule "afwijking opgave waarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opgegevenWaarde : opgegevenWaarde )
    $stand_1 : State( attribute == ElementKey.of("vondst", "berekende waarde", false), subject == $onderwerp, $berekendeWaarde : value )
    eval( toets_afwijkingOpgaveWaarde($opgegevenWaarde, $berekendeWaarde) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "afwijkende opgave waarde", true)));
end

// hij aan alle volgende voorwaarden voldoet: - zijn opgegeven bergloon is gevuld - zijn berekende bergloon is gevuld - zijn opgegeven bergloon is ongelijk aan zijn berekende bergloon
function boolean toets_afwijkingOpgaveBergloon(Object $opgegevenBergloon, Object $berekendeBergloon) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($opgegevenBergloon, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($berekendeBergloon, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($opgegevenBergloon, $berekendeBergloon, "!=")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

rule "afwijking opgave bergloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opgegevenBergloon : opgegevenBergloon )
    $stand_1 : State( attribute == ElementKey.of("vondst", "berekende bergloon", false), subject == $onderwerp, $berekendeBergloon : value )
    eval( toets_afwijkingOpgaveBergloon($opgegevenBergloon, $berekendeBergloon) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "afwijkende opgave bergloon", true)));
end

// hij heeft geen afwijkende opgave waarde
function boolean toets_controleOpgaveWaarde(Object $afwijkendeOpgaveWaarde) {
    return ComputeHelpers.not(ComputeHelpers.characteristic($afwijkendeOpgaveWaarde, Boolean.FALSE));
}

rule "controle opgave waarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "afwijkende opgave waarde", true), subject == $onderwerp, $afwijkendeOpgaveWaarde : holds )
    eval( toets_controleOpgaveWaarde($afwijkendeOpgaveWaarde) )
then
    insertLogical(ComputeHelpers.inconsistency("controle opgave waarde", $onderwerp, ComputeHelpers.list1("EF-025")));
end

// hij heeft geen afwijkende opgave bergloon
function boolean toets_controleOpgaveBergloon(Object $afwijkendeOpgaveBergloon) {
    return ComputeHelpers.not(ComputeHelpers.characteristic($afwijkendeOpgaveBergloon, Boolean.FALSE));
}

rule "controle opgave bergloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "afwijkende opgave bergloon", true), subject == $onderwerp, $afwijkendeOpgaveBergloon : holds )
    eval( toets_controleOpgaveBergloon($afwijkendeOpgaveBergloon) )
then
    insertLogical(ComputeHelpers.inconsistency("controle opgave bergloon", $onderwerp, ComputeHelpers.list1("EF-025")));
end

rule "defaults A:Vondst.waarde: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $opgegevenWaarde : opgegevenWaarde )
then
    // zijn opgegeven waarde
    Object v = $opgegevenWaarde;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "waarde");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.waarde", ComputeHelpers.designate(passend, "defaults A:Vondst.waarde")));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.waarde", 0));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "waarde", false), passend, "defaults A:Vondst.waarde"));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.waarde", 0));
        }
    }
end

rule "defaults A:Vondst.waarde: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst") )
    $stand_0 : State( attribute == ElementKey.of("vondst", "berekende waarde", false), subject == $onderwerp, $berekendeWaarde : value )
    not( $hoger_21 : Decides( stack == "defaults A:Vondst.waarde" && index < 1, subject == $onderwerp ) )
then
    // zijn berekende waarde
    Object v = $berekendeWaarde;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "waarde");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.waarde", ComputeHelpers.designate(passend, "defaults A:Vondst.waarde")));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.waarde", 1));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "waarde", false), passend, "defaults A:Vondst.waarde"));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.waarde", 1));
        }
    }
end

