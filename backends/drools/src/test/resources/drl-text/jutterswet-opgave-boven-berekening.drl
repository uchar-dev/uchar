rule "defaults A:Vondst.bergloon: default 2"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), ComputeHelpers.readProperty(this, "bergloon") == null )
    not( $hoger_34 : Decides( stack == "defaults A:Vondst.bergloon" && index < 2, subject == $onderwerp ) )
then
    // 25,00
    Object v = new java.math.BigDecimal("25");
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "bergloon");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.bergloon", ComputeHelpers.designate(passend, "defaults A:Vondst.bergloon")));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.bergloon", 2));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), passend, "defaults A:Vondst.bergloon"));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.bergloon", 2));
        }
    }
end

rule "kenmerkstand Vondst.afwijkende opgave waarde: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(afwijkendeOpgaveWaarde) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "afwijkende opgave waarde", true), true));
end

