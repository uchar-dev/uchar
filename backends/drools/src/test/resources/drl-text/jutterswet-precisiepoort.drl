    Object v = waarde_taxatiewaarde($taxatie);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "taxatiewaarde", ComputeHelpers.designate(v, "taxatiewaarde")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "taxatiewaarde", false), v, "taxatiewaarde"));
        }
    }
end

rule "stand Vondst.ruwe aandeel: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "ruwe aandeel", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "ruwe aandeel", false), $v));
end

rule "stand Vondst.ruwe aandeel: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : ruweAandeel )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "ruwe aandeel", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "ruwe aandeel", false), $invoer));
end

rule "parameterstand heffingspercentage"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("heffingspercentage", heffingspercentage));
end

