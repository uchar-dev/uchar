package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.ParameterState;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.math.BigDecimal heffingspercentage;

// zijn opbrengst gedeeld door zijn aantal deelnemers
function Object waarde_ruwAandeel(Object $opbrengst, Object $aantalDeelnemers, Object sonde) {
    try {
        return ComputeHelpers.divided($opbrengst, $aantalDeelnemers, sonde);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "ruw aandeel"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opbrengst : opbrengst, $aantalDeelnemers : aantalDeelnemers )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_ruwAandeel($opbrengst, $aantalDeelnemers, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "ruw aandeel", ComputeHelpers.designate(v, "ruw aandeel")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("ruw aandeel", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "ruwe aandeel", false), v, "ruw aandeel"));
        }
    }
end

// zijn ruwe aandeel naar beneden afgerond op 0 decimalen
function Object waarde_aandeel(Object $ruweAandeel) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding($ruweAandeel, Integer.valueOf(0), java.math.RoundingMode.FLOOR), Integer.valueOf(0), "aandeel", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aandeel"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "ruwe aandeel", false), subject == $onderwerp, $ruweAandeel : value )
then
    Object v = waarde_aandeel($ruweAandeel);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aandeel", ComputeHelpers.designate(v, "aandeel")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "aandeel", false), v, "aandeel"));
        }
    }
end

// zijn opbrengst gedeeld door 3 rekenkundig afgerond op 2 decimalen
function Object waarde_derdeDeel(Object $opbrengst, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($opbrengst, new java.math.BigDecimal("3"), sonde), Integer.valueOf(2), java.math.RoundingMode.HALF_UP), Integer.valueOf(2), "derde deel", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "derde deel"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opbrengst : opbrengst )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_derdeDeel($opbrengst, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "derde deel", ComputeHelpers.designate(v, "derde deel")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("derde deel", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "derde deel", false), v, "derde deel"));
        }
    }
end

