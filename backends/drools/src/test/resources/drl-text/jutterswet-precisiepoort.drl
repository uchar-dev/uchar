// (het heffingspercentage van zijn taxatie) naar beneden afgerond op 2 decimalen
function Object waarde_heffing(Object $heffingspercentage, Object $taxatie) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(RegelSpraakRuntime.rsPercentageVan($heffingspercentage, $taxatie), Integer.valueOf(2), java.math.RoundingMode.FLOOR), Integer.valueOf(2), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffing"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $taxatie : taxatie )
    $parameter_0 : ParameterState( parameter == "heffingspercentage", $heffingspercentage : value )
then
    Object v = waarde_heffing($heffingspercentage, $taxatie);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing", ComputeHelpers.designate(v, "heffing")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "heffing", false), v, "heffing"));
        }
    }
end

// zijn taxatie maal 100
function Object waarde_taxatiewaarde(Object $taxatie) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal($taxatie, new java.math.BigDecimal("100")), Integer.valueOf(0), "taxatiewaarde", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "taxatiewaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $taxatie : taxatie )
