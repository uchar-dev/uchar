function Object waarde_kwart(Object $opbrengst, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.divided($opbrengst, new java.math.BigDecimal("4"), sonde), Integer.valueOf(2), "kwart", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "kwart"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opbrengst : opbrengst )
