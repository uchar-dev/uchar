// hij aan alle volgende voorwaarden voldoet: - zijn taxatie heeft een waarde - zijn taxatie is groter dan 1000,00
function boolean toets_kostbareVondst(Object $taxatie) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest(ComputeHelpers.payload($taxatie, "waarde"), Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.payload($taxatie, "waarde"), new java.math.BigDecimal("1000"), ">")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "kostbare vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "taxatie", false), subject == $onderwerp, $taxatie : value )
    eval( toets_kostbareVondst($taxatie) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "kostbaar", true)));
end

// de som van de taxatie van alle vondsten van de Jutter die een waarde hebben
function Object waarde_getaxeerdTotaal(Object $aantal_vouw_21, Object $vouw_vouw_23) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_21, $vouw_vouw_23, null), Integer.valueOf(2), "getaxeerd totaal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "getaxeerd totaal"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_18 : Contribution( fold == "getaxeerd totaal: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_22 : value ); $aantal_vouw_21 : count(), $vouw_vouw_23 : exactSum($bijdragewaarde_vouw_22) )
then
    Object v = waarde_getaxeerdTotaal($aantal_vouw_21, $vouw_vouw_23);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "getaxeerd totaal", ComputeHelpers.designate(v, "getaxeerd totaal")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "getaxeerd totaal", false), v, "getaxeerd totaal"));
        }
    }
end

// onbekend
function Object waarde_opslagOnbekendInDeWinter() {
    try {
        return PeriodArithmetic.writtenValues(PeriodArithmetic.clipped(PeriodCondition.window(java.time.LocalDate.parse("2025-01-01"), Boolean.TRUE, java.time.LocalDate.parse("2025-03-01"), Boolean.TRUE, Boolean.FALSE), PeriodArithmetic.scalar(ComputeHelpers.constructorValue("onbekend"))));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "opslag onbekend in de winter"
    dialect "mvel"
when
