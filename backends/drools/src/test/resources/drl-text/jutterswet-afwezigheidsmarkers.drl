    return java.util.Arrays.asList("taxatie uit schatting", "taxatie onbekend", "taxatie niet van toepassing", "vindloon naar taxatie", "forfaitair vindloon", "geen vindloon", "kostbare vondst", "getaxeerd totaal", "opslag onbekend in de winter", "opslag niet van toepassing na verkoop", "opslagtoeslag");
