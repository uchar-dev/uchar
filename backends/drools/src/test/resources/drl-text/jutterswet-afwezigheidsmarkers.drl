// zijn schatting
function Object waarde_taxatieUitSchatting(Object $schatting) {
    try {
        return ComputeHelpers.construct("waarde", $schatting);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "taxatie uit schatting"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $schatting : schatting )
then
    Object v = waarde_taxatieUitSchatting($schatting);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "taxatie uit schatting", ComputeHelpers.designate(v, "taxatie uit schatting")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "taxatie", false), v, "taxatie uit schatting"));
        }
    }
end

// hij onleesbaar is
function boolean toets_taxatieOnbekend(Object $onleesbaar) {
    return ComputeHelpers.characteristic($onleesbaar, Boolean.TRUE);
}

// onbekend
function Object waarde_taxatieOnbekend() {
    try {
        return ComputeHelpers.constructorValue("onbekend");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "taxatie onbekend"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $onleesbaar : (ComputeHelpers.holds(onleesbaar)) )
    eval( toets_taxatieOnbekend($onleesbaar) )
then
    Object v = waarde_taxatieOnbekend();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "taxatie onbekend", ComputeHelpers.designate(v, "taxatie onbekend")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "taxatie", false), v, "taxatie onbekend"));
        }
    }
end

