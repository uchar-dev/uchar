            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "opslagtoeslag", false), v, "opslagtoeslag"));
        }
    }
end

function boolean toets_schrijversVondstTaxatieVerschil(Object $waarden) {
    return ComputeHelpers.differ($waarden);
}

function java.util.List lijst_schrijversVondstTaxatieVerschil() {
    return java.util.Arrays.asList("taxatie uit schatting", "taxatie onbekend", "taxatie niet van toepassing", "vindloon naar taxatie", "forfaitair vindloon", "geen vindloon", "kostbare vondst", "getaxeerd totaal", "opslag onbekend in de winter", "opslag niet van toepassing na verkoop", "opslagtoeslag");
}

rule "schrijvers Vondst.taxatie: verschil"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    accumulate( $waarde : Value( attribute == ElementKey.of("vondst", "taxatie", false), subject == $onderwerp ); $waarden : collectList($waarde) )
    eval( toets_schrijversVondstTaxatieVerschil($waarden) )
then
    insertLogical(ComputeHelpers.writersConflict($onderwerp, $waarden, "taxatie", lijst_schrijversVondstTaxatieVerschil(), ComputeHelpers.list2("Jutter", "Vondst"), ComputeHelpers.list2("Jutter", "Vondst")));
end

