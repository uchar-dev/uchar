// 7
function Object waarde_opslagtoeslag(Object $tijdlijn_0, Object $onderwerp) {
    try {
        return PeriodArithmetic.written(PeriodArithmetic.clipped(PeriodCondition.whereEqual(ComputeHelpers.complete($tijdlijn_0, "a condition per period reads the time-dependent attribute \"opslagkosten\" of ", $onderwerp, " whole; the case supplies only the asOfDate-bucket scalar, which carries no period", "opslagkosten", Boolean.TRUE), ComputeHelpers.constructorValue("onbekend"), Boolean.TRUE, Boolean.TRUE), PeriodArithmetic.scalar(new java.math.BigDecimal("7"))), Integer.valueOf(0), "opslagtoeslag");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

