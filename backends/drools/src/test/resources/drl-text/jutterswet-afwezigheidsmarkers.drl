rule "stand Vondst.opslagkosten: de vereniging van de schrijvers"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : (ComputeHelpers.periods(opslagkosten)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("vondst", "opslagkosten", false), subject == $onderwerp ) )
    exists( $schrijver : Value( attribute == ElementKey.of("vondst", "opslagkosten", false), subject == $onderwerp ) )
    accumulate( $waarde : Value( attribute == ElementKey.of("vondst", "opslagkosten", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("vondst", "opslagkosten", false), $waarden, $invoer, lijst_standVondstOpslagkostenDeVerenigingVanDeSchrijvers()));
end

