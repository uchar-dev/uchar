// zijn taxatie een waarde heeft
function boolean toets_vindloonNaarTaxatie(Object $taxatie) {
    return ComputeHelpers.emptyTest(ComputeHelpers.payload($taxatie, "waarde"), Boolean.FALSE);
}

// zijn taxatie gedeeld door 10 rekenkundig afgerond op 2 decimalen
function Object waarde_vindloonNaarTaxatie(Object $taxatie, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided(ComputeHelpers.payload($taxatie, "waarde"), new java.math.BigDecimal("10"), sonde), Integer.valueOf(2), java.math.RoundingMode.HALF_UP), Integer.valueOf(2), "vindloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vindloon naar taxatie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "taxatie", false), subject == $onderwerp, $taxatie : value )
    eval( toets_vindloonNaarTaxatie($taxatie) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_vindloonNaarTaxatie($taxatie, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vindloon naar taxatie", ComputeHelpers.designate(v, "vindloon naar taxatie")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("vindloon naar taxatie", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vindloon", false), v, "vindloon naar taxatie"));
        }
    }
end

