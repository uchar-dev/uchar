function boolean beta_ploegvarendBijdrageAanVouw3(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("ploeg"), java.util.Arrays.asList("ploeg"));
}

// ten minste één van de rechten van de ploeg van het Jutrecht de vaartijd heeft
function boolean matrix_ploegvarendBijdrageAanVouw3(Object $onderwerp, Object $vaartijd) {
    return ComputeHelpers.characteristic($vaartijd, Boolean.TRUE);
}

rule "ploegvarend: bijdrage aan vouw 3"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutrecht()
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( beta_ploegvarendBijdrageAanVouw3(this, $vouwonderwerp) )
    $stand_1 : CharacteristicState( characteristic == ElementKey.of("wrakrecht", "vaartijd", true), subject == $onderwerp, $vaartijd : holds )
then
    insertLogical(new Contribution("ploegvarend: vouw 3", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_ploegvarendBijdrageAanVouw3($onderwerp, $vaartijd))));
end

rule "kenmerkstand Wrakrecht.vaartijd: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakrecht( ComputeHelpers.holds(vaartijd) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("wrakrecht", "vaartijd", true), true));
end

rule "kenmerkstand Wrakrecht.vaartijd: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakrecht()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("wrakrecht", "vaartijd", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("wrakrecht", "vaartijd", true), true));
end

rule "kenmerkstand Wrakrecht.vaartijd: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakrecht( ComputeHelpers.holds(vaartijd) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("wrakrecht", "vaartijd", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("wrakrecht", "vaartijd", true), false));
end

rule "kenmerkstand Wrakrecht.vaartijd: onwaar buiten Wrakrecht op Strandrecht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( ComputeHelpers.classNotIn(this, ComputeHelpers.list1("dev.uchar.regelspraak.facts.Wrakrecht")) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("wrakrecht", "vaartijd", true), false));
end

rule "parameterstand vaartijddrempel"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("vaartijddrempel", vaartijddrempel));
end

