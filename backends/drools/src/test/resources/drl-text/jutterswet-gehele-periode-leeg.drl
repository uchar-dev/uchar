// het havengeld van de werf van de Schuit gedurende het gehele jaar gevuld is
function boolean toets_werftoeslagVanEenSchuit(Object $werfHavengeld, Object $onderwerp) {
    try {
        return ComputeHelpers.wholePeriod(ComputeHelpers.complete($werfHavengeld, "the whole-period qualifier over \"havengeld\" needs the full timeline; the werf of ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "havengeld", Boolean.FALSE), null, "JAAR", Integer.valueOf(6), Boolean.FALSE);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

// 70
function Object waarde_werftoeslagVanEenSchuit() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("70"), Integer.valueOf(0), "werftoeslag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "werftoeslag van een schuit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    $padstand_0 : PathState( path == "Schuit:werf" && member == ElementKey.of("werf", "havengeld", false), subject == $onderwerp, $werfHavengeld : value )
    eval( toets_werftoeslagVanEenSchuit($werfHavengeld, $onderwerp) )
then
    Object v = waarde_werftoeslagVanEenSchuit();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "werftoeslag van een schuit", ComputeHelpers.designate(v, "werftoeslag van een schuit")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schuit", "werftoeslag", false), v, "werftoeslag van een schuit"));
        }
    }
end

// het havengeld van de werf van de Schuit gedurende het gehele jaar gevuld is
