// de bemanning van de Schuit gedurende het gehele jaar leeg is
function boolean toets_leegtoeslagVanEenSchuit(Object $tijdlijn_0, Object $onderwerp) {
    try {
        return ComputeHelpers.wholePeriod(ComputeHelpers.complete($tijdlijn_0, "the whole-period qualifier over \"bemanning\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "bemanning", Boolean.TRUE), null, "JAAR", Integer.valueOf(8), Boolean.FALSE);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

// 10
function Object waarde_leegtoeslagVanEenSchuit() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("10"), Integer.valueOf(0), "leegtoeslag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "leegtoeslag van een schuit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    $stand_0 : State( attribute == ElementKey.of("schuit", "bemanning", false), subject == $onderwerp, $tijdlijn_0 : value )
    eval( toets_leegtoeslagVanEenSchuit($tijdlijn_0, $onderwerp) )
then
    Object v = waarde_leegtoeslagVanEenSchuit();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "leegtoeslag van een schuit", ComputeHelpers.designate(v, "leegtoeslag van een schuit")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schuit", "leegtoeslag", false), v, "leegtoeslag van een schuit"));
        }
    }
end

