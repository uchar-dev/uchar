    try {
        boolean uitkomst = ComputeHelpers.wholePeriod(ComputeHelpers.complete($werfHavengeld, "the whole-period qualifier over \"havengeld\" needs the full timeline; the werf of ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "havengeld", Boolean.FALSE), null, "JAAR", Integer.valueOf(6), Boolean.FALSE);
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

// het havengeld van de werf van de Schuit gedurende het gehele jaar gevuld is
function Object fout_werftoeslagVanEenSchuitFoutInDeVoorwaarde(Object $werfHavengeld, Object $onderwerp) {
    try {
        boolean uitkomst = ComputeHelpers.wholePeriod(ComputeHelpers.complete($werfHavengeld, "the whole-period qualifier over \"havengeld\" needs the full timeline; the werf of ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "havengeld", Boolean.FALSE), null, "JAAR", Integer.valueOf(6), Boolean.FALSE);
        return null;
