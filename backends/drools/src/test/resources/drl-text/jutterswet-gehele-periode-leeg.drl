rule "werftoeslag van een schuit: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    $padstand_0 : PathState( path == "Schuit:werf" && member == ElementKey.of("werf", "havengeld", false), subject == $onderwerp, $werfHavengeld : value )
    eval( toets_werftoeslagVanEenSchuitFoutInDeVoorwaarde($werfHavengeld, $onderwerp) )
then
    Object f = fout_werftoeslagVanEenSchuitFoutInDeVoorwaarde($werfHavengeld, $onderwerp);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("de voorwaarde van \"werftoeslag van een schuit\" faalde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    insertLogical(new Fault($onderwerp, "werftoeslag van een schuit", ComputeHelpers.designate(f, "werftoeslag van een schuit")));
end

