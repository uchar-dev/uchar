package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Decides;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.LeftOpen;
import dev.uchar.regelspraak.transpiler.tms.OpenInput;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

global OpenInput open_invoer;

// zijn taxatie plus zijn toeslag
function Object waarde_uitbetaling(Object $taxatie, Object open_invoer, Object $onderwerp, Object $toeslag) {
    return ComputeHelpers.valued(() -> ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus(ComputeHelpers.readInput($taxatie, open_invoer, $onderwerp, ElementKey.of("vondst", "taxatie", false)), $toeslag), Integer.valueOf(0), "uitbetaling", null), null);
}

rule "uitbetaling"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $taxatie : taxatie, $toeslag : toeslag )
then
    Object v = waarde_uitbetaling($taxatie, open_invoer, $onderwerp, $toeslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "uitbetaling", ComputeHelpers.designate(v, "uitbetaling")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "uitbetaling", false), "uitbetaling"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "uitbetaling", false), v, "uitbetaling"));
        }
    }
end

// zijn taxatie plus zijn bijslag
function Object waarde_bijbetaling(Object $taxatie, Object open_invoer, Object $onderwerp, Object $bijslag) {
    return ComputeHelpers.valued(() -> ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus(ComputeHelpers.readInput($taxatie, open_invoer, $onderwerp, ElementKey.of("vondst", "taxatie", false)), ComputeHelpers.readInput($bijslag, open_invoer, $onderwerp, ElementKey.of("vondst", "bijslag", false))), Integer.valueOf(0), "bijbetaling", null), null);
}

rule "bijbetaling"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $taxatie : taxatie, $bijslag : bijslag )
then
    Object v = waarde_bijbetaling($taxatie, open_invoer, $onderwerp, $bijslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "bijbetaling", ComputeHelpers.designate(v, "bijbetaling")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "bijbetaling", false), "bijbetaling"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bijbetaling", false), v, "bijbetaling"));
        }
    }
end

// hij niet drijfhout is
function boolean toets_drijftoeslag(Object $drijfhout) {
    return ComputeHelpers.characteristic($drijfhout, Boolean.FALSE);
}

// 2
function Object waarde_drijftoeslag() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("2"), Integer.valueOf(0), "drijftoeslag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "drijftoeslag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $drijfhout : (ComputeHelpers.holds(drijfhout)) )
    eval( toets_drijftoeslag($drijfhout) )
then
    Object v = waarde_drijftoeslag();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "drijftoeslag", ComputeHelpers.designate(v, "drijftoeslag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "drijftoeslag", false), v, "drijftoeslag"));
        }
    }
end

// hij niet wrakhout is
function Object oordeel_wraktoeslag(Object $wrakhout, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.characteristic(ComputeHelpers.readInput($wrakhout, open_invoer, $onderwerp, ElementKey.of("vondst", "wrakhout", true)), Boolean.FALSE), false);
}

// 2
function Object waarde_wraktoeslag(Object $wrakhout, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.decided(oordeel_wraktoeslag($wrakhout, open_invoer, $onderwerp), () -> ComputeHelpers.fitTarget(new java.math.BigDecimal("2"), Integer.valueOf(0), "wraktoeslag", null), null);
}

rule "wraktoeslag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $wrakhout : (ComputeHelpers.holds(wrakhout)) )
    eval( ComputeHelpers.acts(oordeel_wraktoeslag($wrakhout, open_invoer, $onderwerp)) )
then
    Object v = waarde_wraktoeslag($wrakhout, open_invoer, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "wraktoeslag", ComputeHelpers.designate(v, "wraktoeslag")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "wraktoeslag", false), "wraktoeslag"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "wraktoeslag", false), v, "wraktoeslag"));
        }
    }
end

// zijn gewicht maal 2
function Object waarde_bergloon(Object $gewicht, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.valued(() -> ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal(ComputeHelpers.readInput($gewicht, open_invoer, $onderwerp, ElementKey.of("vondst", "gewicht", false)), new java.math.BigDecimal("2")), Integer.valueOf(0), "berekende bergloon", null), null);
}

rule "bergloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht )
then
    Object v = waarde_bergloon($gewicht, open_invoer, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "bergloon", ComputeHelpers.designate(v, "bergloon")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "berekende bergloon", false), "bergloon"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "berekende bergloon", false), v, "bergloon"));
        }
    }
end

// hij aan alle volgende voorwaarden voldoet: - zijn opgegeven bergloon is gevuld - zijn berekende bergloon is gevuld - zijn opgegeven bergloon is ongelijk aan zijn berekende bergloon
function Object oordeel_afwijkingOpgaveBergloon(Object $opgegevenBergloon, Object $berekendeBergloon) {
    return ComputeHelpers.judge(() -> {
        var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, 3, null);
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(ComputeHelpers.emptyTest($opgegevenBergloon, Boolean.FALSE));
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(() -> ComputeHelpers.emptyTest(ComputeHelpers.read($berekendeBergloon), Boolean.FALSE));
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(() -> RegelSpraakRuntime.rsAggVergelijk($opgegevenBergloon, ComputeHelpers.read($berekendeBergloon), "!="));
        return lezing.verdict();
    }, false);
}

rule "afwijking opgave bergloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opgegevenBergloon : opgegevenBergloon )
    $stand_1 : State( attribute == ElementKey.of("vondst", "berekende bergloon", false), subject == $onderwerp, $berekendeBergloon : value )
    eval( ComputeHelpers.acts(oordeel_afwijkingOpgaveBergloon($opgegevenBergloon, $berekendeBergloon)) )
then
    if (ComputeHelpers.decides(oordeel_afwijkingOpgaveBergloon($opgegevenBergloon, $berekendeBergloon))) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "afwijkende opgave bergloon", true)));
    } else {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "afwijkende opgave bergloon", true), "afwijking opgave bergloon"));
    }
end

// hij heeft geen afwijkende opgave bergloon
function boolean toets_controleOpgaveBergloon(Object $afwijkendeOpgaveBergloon) {
    return ComputeHelpers.establishedTrue(() -> ComputeHelpers.not(ComputeHelpers.characteristic(ComputeHelpers.read($afwijkendeOpgaveBergloon), Boolean.FALSE)), false);
}

rule "controle opgave bergloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "afwijkende opgave bergloon", true), subject == $onderwerp, $afwijkendeOpgaveBergloon : holds )
    eval( toets_controleOpgaveBergloon($afwijkendeOpgaveBergloon) )
then
    insertLogical(ComputeHelpers.inconsistency("controle opgave bergloon", $onderwerp, ComputeHelpers.list1("EF-025")));
end

rule "defaults A:Vondst.bergloon: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $opgegevenBergloon : opgegevenBergloon )
then
    // zijn opgegeven bergloon
    Object v = $opgegevenBergloon;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "bergloon");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.bergloon", ComputeHelpers.designate(passend, "defaults A:Vondst.bergloon")));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.bergloon", 0));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), passend, "defaults A:Vondst.bergloon"));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.bergloon", 0));
        }
    }
end

// zijn berekende bergloon
function Object afloop_defaultsAVondstBergloonDefault1(Object $berekendeBergloon) {
    return ComputeHelpers.valued(() -> ComputeHelpers.read($berekendeBergloon), null);
}

rule "defaults A:Vondst.bergloon: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst") )
    $stand_0 : State( attribute == ElementKey.of("vondst", "berekende bergloon", false), subject == $onderwerp, $berekendeBergloon : value )
    not( $hoger_13 : Decides( stack == "defaults A:Vondst.bergloon" && index < 1, subject == $onderwerp ) )
then
    Object v = afloop_defaultsAVondstBergloonDefault1($berekendeBergloon);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "defaults A:Vondst.bergloon", ComputeHelpers.designate(v, "defaults A:Vondst.bergloon")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "bergloon", false), "defaults A:Vondst.bergloon: default 1"));
        insertLogical(new Decides($onderwerp, "defaults A:Vondst.bergloon", 1, true));
    } else if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "bergloon");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.bergloon", ComputeHelpers.designate(passend, "defaults A:Vondst.bergloon")));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.bergloon", 1));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), passend, "defaults A:Vondst.bergloon"));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.bergloon", 1));
        }
    }
end

rule "stand Vondst.berekende bergloon: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "berekende bergloon", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekende bergloon", false), $v));
end

rule "stand Vondst.berekende bergloon: open door een schrijver"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    not( $waarde : Value( attribute == ElementKey.of("vondst", "berekende bergloon", false), subject == $onderwerp ) )
    exists( $opengelaten : LeftOpen( member == ElementKey.of("vondst", "berekende bergloon", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekende bergloon", false), ComputeHelpers.open($onderwerp, ElementKey.of("vondst", "berekende bergloon", false))));
end

rule "stand Vondst.berekende bergloon: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : berekendeBergloon )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "berekende bergloon", false), subject == $onderwerp ) )
    not( $opengelaten : LeftOpen( member == ElementKey.of("vondst", "berekende bergloon", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekende bergloon", false), $invoer));
end

rule "kenmerkstand Vondst.afwijkende opgave bergloon: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(afwijkendeOpgaveBergloon) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "afwijkende opgave bergloon", true), true));
end

rule "kenmerkstand Vondst.afwijkende opgave bergloon: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "afwijkende opgave bergloon", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "afwijkende opgave bergloon", true), true));
end

rule "kenmerkstand Vondst.afwijkende opgave bergloon: open door een schrijver"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(afwijkendeOpgaveBergloon) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "afwijkende opgave bergloon", true), subject == $onderwerp ) )
    exists( $opengelaten : LeftOpen( member == ElementKey.of("vondst", "afwijkende opgave bergloon", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "afwijkende opgave bergloon", true), ComputeHelpers.open($onderwerp, ElementKey.of("vondst", "afwijkende opgave bergloon", true))));
end

rule "kenmerkstand Vondst.afwijkende opgave bergloon: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(afwijkendeOpgaveBergloon) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "afwijkende opgave bergloon", true), subject == $onderwerp ) )
    not( $opengelaten : LeftOpen( member == ElementKey.of("vondst", "afwijkende opgave bergloon", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "afwijkende opgave bergloon", true), false));
end

