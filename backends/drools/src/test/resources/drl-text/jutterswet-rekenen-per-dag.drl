    $stand_3 : State( attribute == ElementKey.of("jutter", "afdrachttarief", false), subject == $onderwerp, $tijdlijn_3 : value )
then
    Object v = waarde_vondstheffingVanEenJutter($aantal_vouw_52, $vouw_vouw_54, $eerste_lidfout_vouw_59, $tijdlijn_3, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vondstheffing van een jutter", ComputeHelpers.designate(v, "vondstheffing van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vondstheffing", false), v, "vondstheffing van een jutter"));
        }
    }
end

