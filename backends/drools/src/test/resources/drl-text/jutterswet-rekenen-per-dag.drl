    accumulate( $waarde : Value( attribute == ElementKey.of("jutter", "gewaarborgde vondstheffing", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("jutter", "gewaarborgde vondstheffing", false), $waarden, null, lijst_standJutterGewaarborgdeVondstheffingDeVerenigingVanDeSchrijversEenEmmerscalair()));
end

