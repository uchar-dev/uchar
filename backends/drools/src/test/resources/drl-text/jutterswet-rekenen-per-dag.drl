// (de som van de opbrengst van alle vondsten van de Jutter) maal zijn afdrachttarief
function Object waarde_vondstheffingVanEenJutter(Object $aantal_vouw_52, Object $vouw_vouw_54, Object $eerste_lidfout_vouw_59, Object $tijdlijn_3, Object $onderwerp) {
    try {
        return PeriodArithmetic.written(PeriodArithmetic.times(vouwlezing_vondstheffingVanEenJutter($aantal_vouw_52, $vouw_vouw_54, $eerste_lidfout_vouw_59, $tijdlijn_3, $onderwerp), ComputeHelpers.complete($tijdlijn_3, "the period arithmetic of ch. 3.4/3.5 reads the temporal attribute \"afdrachttarief\" of ", $onderwerp, "; the case supplies only the asOfDate-bucket scalar, which carries no period", "afdrachttarief", Boolean.TRUE)), Integer.valueOf(0), "vondstheffing");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// de som van de opbrengst van alle vondsten van de Jutter
function Object vouwlezing_vondstheffingVanEenJutter(Object $aantal_vouw_52, Object $vouw_vouw_54, Object $eerste_lidfout_vouw_59, Object $tijdlijn_3, Object $onderwerp) {
    if ($eerste_lidfout_vouw_59 != null) {
        throw ((MemberFault) $eerste_lidfout_vouw_59).fault();
    }
    return PeriodArithmetic.sum($vouw_vouw_54, null);
}

rule "vondstheffing van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_49 : Contribution( fold == "vondstheffing van een jutter: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_53 : value ); $aantal_vouw_52 : count(), $vouw_vouw_54 : collectList($bijdragewaarde_vouw_53) )
