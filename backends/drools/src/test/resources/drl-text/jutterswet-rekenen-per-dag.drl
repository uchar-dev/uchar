// zijn strandloon gedeeld door zijn stormtoeslag
function Object waarde_loonverhoudingVanEenJutter(Object $tijdlijn_0, Object $onderwerp, Object $tijdlijn_2, Object sonde) {
    try {
        return PeriodArithmetic.written(deling_loonverhoudingVanEenJutter($tijdlijn_0, $onderwerp, $tijdlijn_2, sonde), null, "loonverhouding");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

