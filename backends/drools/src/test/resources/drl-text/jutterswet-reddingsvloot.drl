    accumulate( $bijdrage_vouw_16 : Contribution( fold == "inzetbaar bij vaartijd: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_20 : value ); $aantal_vouw_19 : count(), $vouw_vouw_21 : collectList($bijdragewaarde_vouw_20) )
