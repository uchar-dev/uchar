function Object lidtoets_inzetbaarBijVaartijdBijdrageAanVouw0(Object $onderwerp, Object $tijdlijn_1, Object $lijstplaatsen_plaats_5, Object $plaats_plaats_6) {
    java.util.List plaats = plaats_inzetbaarBijVaartijdBijdrageAanVouw0($onderwerp, $lijstplaatsen_plaats_5, $plaats_plaats_6);
    Boolean waar = null;
    RuntimeException fout = null;
    try {
        waar = Boolean.valueOf(ComputeHelpers.wholePeriod(ComputeHelpers.complete($tijdlijn_1, "the whole-period qualifier over \"vaartijd\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "vaartijd", Boolean.TRUE), new java.math.BigDecimal("20"), "JAAR", Integer.valueOf(2), Boolean.FALSE));
    } catch (RuntimeException e) {
        fout = ComputeHelpers.caught(e);
    }
    return new MemberTest(plaats, waar, fout, ComputeHelpers.reported(null), ComputeHelpers.depositCodes(null));
