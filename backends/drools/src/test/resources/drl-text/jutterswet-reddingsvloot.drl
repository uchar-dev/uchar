rule "sloeptal van een reddingsvloot"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Reddingsvloot()
    accumulate( $bijdrage_vouw_94 : Contribution( fold == "sloeptal van een reddingsvloot: vouw 4", subject == $onderwerp ); $aantal_vouw_97 : count() )
then
    Object v = waarde_sloeptalVanEenReddingsvloot($aantal_vouw_97);
