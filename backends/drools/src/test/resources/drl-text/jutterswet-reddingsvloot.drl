rule "stand Reddingssloep.vaartijd: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Reddingssloep( $invoer : (ComputeHelpers.periods(vaartijd)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("reddingssloep", "vaartijd", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("reddingssloep", "vaartijd", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("reddingssloep", "vaartijd", false), $invoer));
end

rule "stand Reddingssloep.vaartijd: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Reddingssloep( $invoer : (ComputeHelpers.periods(vaartijd)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("reddingssloep", "vaartijd", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("reddingssloep", "vaartijd", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("reddingssloep", "vaartijd", false), ComputeHelpers.bucketScalarOf($invoer)));
end

