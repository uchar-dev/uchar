package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de vondstteller van de Jutter min 12
function Object waarde_drempeloverschotVanEenJutter(Object $vondstteller) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMin($vondstteller, new java.math.BigDecimal("12")), Integer.valueOf(0), "drempeloverschot", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "drempeloverschot van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstteller : vondstteller )
then
    Object v = waarde_drempeloverschotVanEenJutter($vondstteller);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "drempeloverschot van een jutter", ComputeHelpers.designate(v, "drempeloverschot van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "drempeloverschot", false), v, "drempeloverschot van een jutter"));
        }
    }
end

// de vondstteller van de Jutter min 6
function Object waarde_hardheidsoverschotVanEenJutter(Object $vondstteller) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMin($vondstteller, new java.math.BigDecimal("6")), Integer.valueOf(0), "hardheidsoverschot", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "hardheidsoverschot van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstteller : vondstteller )
then
    Object v = waarde_hardheidsoverschotVanEenJutter($vondstteller);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "hardheidsoverschot van een jutter", ComputeHelpers.designate(v, "hardheidsoverschot van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "hardheidsoverschot", false), v, "hardheidsoverschot van een jutter"));
        }
    }
end

// het drempeloverschot van de Jutter plus het hardheidsoverschot van de Jutter
function Object waarde_jaarsomVanEenJutter(Object $drempeloverschot, Object $hardheidsoverschot) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($drempeloverschot, $hardheidsoverschot), Integer.valueOf(0), "jaarsom", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jaarsom van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $stand_0 : State( attribute == ElementKey.of("jutter", "drempeloverschot", false), subject == $onderwerp, $drempeloverschot : value )
    $stand_1 : State( attribute == ElementKey.of("jutter", "hardheidsoverschot", false), subject == $onderwerp, $hardheidsoverschot : value )
then
    Object v = waarde_jaarsomVanEenJutter($drempeloverschot, $hardheidsoverschot);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jaarsom van een jutter", ComputeHelpers.designate(v, "jaarsom van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "jaarsom", false), v, "jaarsom van een jutter"));
        }
    }
end

rule "stand Jutter.drempeloverschot: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "drempeloverschot", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "drempeloverschot", false), $v));
end

rule "stand Jutter.drempeloverschot: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : drempeloverschot )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "drempeloverschot", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "drempeloverschot", false), $invoer));
end

rule "stand Jutter.hardheidsoverschot: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "hardheidsoverschot", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "hardheidsoverschot", false), $v));
end

rule "stand Jutter.hardheidsoverschot: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : hardheidsoverschot )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "hardheidsoverschot", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "hardheidsoverschot", false), $invoer));
end

