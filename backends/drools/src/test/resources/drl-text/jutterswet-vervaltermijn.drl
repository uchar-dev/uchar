package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn aangiftedatum plus 2 weken
function Object waarde_berekeningVervaldatum(Object $aangiftedatum) {
    try {
        return ComputeHelpers.dateStep($aangiftedatum, new java.math.BigDecimal("2"), "WEEKS", Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "Berekening vervaldatum"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $aangiftedatum : aangiftedatum )
then
    Object v = waarde_berekeningVervaldatum($aangiftedatum);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "Berekening vervaldatum", ComputeHelpers.designate(v, "Berekening vervaldatum")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vervaldatum", false), v, "Berekening vervaldatum"));
        }
    }
end

