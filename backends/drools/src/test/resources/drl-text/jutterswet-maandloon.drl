    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(maandloon)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "maandloon", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "maandloon", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "maandloon", false), $invoer));
end

rule "stand Jutter.maandloon: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(maandloon)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "maandloon", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "maandloon", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "maandloon", false), ComputeHelpers.bucketScalarOf($invoer)));
end

