// zijn strandloon plus zijn stormtoeslag
function Object waarde_maandloonVanEenJutter(Object $tijdlijn_0, Object $onderwerp, Object $tijdlijn_2) {
    try {
        return PeriodArithmetic.written(PeriodArithmetic.plus(ComputeHelpers.complete($tijdlijn_0, "the period arithmetic of ch. 3.4/3.5 reads the temporal attribute \"strandloon\" of ", $onderwerp, "; the case supplies only the asOfDate-bucket scalar, which carries no period", "strandloon", Boolean.TRUE), ComputeHelpers.complete($tijdlijn_2, "the period arithmetic of ch. 3.4/3.5 reads the temporal attribute \"stormtoeslag\" of ", $onderwerp, "; the case supplies only the asOfDate-bucket scalar, which carries no period", "stormtoeslag", Boolean.TRUE)), Integer.valueOf(0), "maandloon");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "maandloon van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $stand_0 : State( attribute == ElementKey.of("jutter", "strandloon", false), subject == $onderwerp, $tijdlijn_0 : value )
    $stand_2 : State( attribute == ElementKey.of("jutter", "stormtoeslag", false), subject == $onderwerp, $tijdlijn_2 : value )
then
    Object v = waarde_maandloonVanEenJutter($tijdlijn_0, $onderwerp, $tijdlijn_2);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "maandloon van een jutter", ComputeHelpers.designate(v, "maandloon van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "maandloon", false), v, "maandloon van een jutter"));
        }
    }
end

