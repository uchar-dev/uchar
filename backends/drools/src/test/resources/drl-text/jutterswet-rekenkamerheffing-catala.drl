package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.CreationStamp;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// 
function Object waarde_berekeningBedrag(Object $grondslag, Object $aftrek) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsVerminderd($grondslag, $aftrek), Integer.valueOf(0), "bedrag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "berekening bedrag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer()
    $stand_0 : State( attribute == ElementKey.of("rekenkamer", "grondslag", false), subject == $onderwerp, $grondslag : value )
    $stand_1 : State( attribute == ElementKey.of("rekenkamer", "aftrek", false), subject == $onderwerp, $aftrek : value )
then
    Object v = waarde_berekeningBedrag($grondslag, $aftrek);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "berekening bedrag", ComputeHelpers.designate(v, "berekening bedrag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("rekenkamer", "bedrag", false), v, "berekening bedrag"));
        }
    }
end

// de bedrag van de rekenkamer
function Object waarde_berekeningHeffing(Object $rekenkamerBedrag) {
    try {
        return ComputeHelpers.fitTarget($rekenkamerBedrag, Integer.valueOf(0), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "berekening heffing"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsaanslag()
    $padstand_0 : PathState( path == "Bergingsaanslag:rekenkamer" && member == ElementKey.of("rekenkamer", "bedrag", false), subject == $onderwerp, $rekenkamerBedrag : value )
then
    Object v = waarde_berekeningHeffing($rekenkamerBedrag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "berekening heffing", ComputeHelpers.designate(v, "berekening heffing")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("bergingsaanslag", "heffing", false), v, "berekening heffing"));
        }
    }
end

function boolean beta_richtRekenkamerOp(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// de bergingswaarde; de vindersaftrek
function Object creatie_richtRekenkamerOp(Object $bergingswaarde, Object $vindersaftrek, Object $fase, Object $herkomsten_creatie_8, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("richt rekenkamer op", 0, "Bergingsaanslag", (java.util.List) $herkomsten_creatie_8, 100);
    Object i0 = null;
    Object i1 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($bergingswaarde, Integer.valueOf(0), "grondslag", "richt rekenkamer op"));
        i1 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($vindersaftrek, Integer.valueOf(0), "aftrek", "richt rekenkamer op"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Rekenkamer");
    ComputeHelpers.set(nieuw, "grondslag", i0);
    ComputeHelpers.set(nieuw, "aftrek", i1);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("richt rekenkamer op", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("bergingsaanslag_rekenkamer", $onderwerp, nieuw, fase));
    return feiten;
}

rule "richt rekenkamer op"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsaanslag( rekenkamer == null, $bergingswaarde : bergingswaarde, $vindersaftrek : vindersaftrek )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_7 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_8 : collectList($herkomst_creatie_7) )
    not( $gemaakt_creatie_10 : CreationStamp( rule == "richt rekenkamer op", subject == $onderwerp ) )
    not( $nieuw_creatie_11 : CreationStamp( object == $onderwerp, beta_richtRekenkamerOp(this, $fase) ) )
    not( $eigen_fout : Fault( rule == "richt rekenkamer op", subject == $onderwerp ) )
then
    Object v = creatie_richtRekenkamerOp($bergingswaarde, $vindersaftrek, $fase, $herkomsten_creatie_8, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "richt rekenkamer op", ComputeHelpers.designate(v, "richt rekenkamer op")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

rule "koppeling bergingsaanslag_rekenkamer uit de invoer: Bergingsaanslag.rekenkamer"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Bergingsaanslag( rekenkamer != null, $ander : rekenkamer )
then
    insertLogical(new RelationLink("bergingsaanslag_rekenkamer", $houder, $ander, 0));
end

rule "koppeling bergingsaanslag_rekenkamer uit de invoer: Rekenkamer.rekenkamer_houder"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Rekenkamer( rekenkamerHouder != null, $ander : rekenkamerHouder )
then
    insertLogical(new RelationLink("bergingsaanslag_rekenkamer", $ander, $houder, 0));
end

function boolean beta_koppelingBergingsaanslagRekenkamerTweedeVullingVanRekenkamer(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "second");
}

rule "koppeling bergingsaanslag_rekenkamer: tweede vulling van rekenkamer"
    dialect "mvel"
when
    $een : RelationLink( relation == "bergingsaanslag_rekenkamer", $nabij : first )
    $twee : RelationLink( relation == "bergingsaanslag_rekenkamer", first != null, first == $een.first, beta_koppelingBergingsaanslagRekenkamerTweedeVullingVanRekenkamer(this, $een) )
then
    insertLogical(new Fault($nabij, "Bergingsaanslag_rekenkamer", new SecondFillingFault("rekenkamer", $nabij)));
end

function boolean beta_koppelingBergingsaanslagRekenkamerTweedeVullingVanRekenkamerHouder(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling bergingsaanslag_rekenkamer: tweede vulling van rekenkamer_houder"
    dialect "mvel"
when
    $een : RelationLink( relation == "bergingsaanslag_rekenkamer", $nabij : second )
    $twee : RelationLink( relation == "bergingsaanslag_rekenkamer", second != null, second == $een.second, beta_koppelingBergingsaanslagRekenkamerTweedeVullingVanRekenkamerHouder(this, $een) )
then
    insertLogical(new Fault($nabij, "Bergingsaanslag_rekenkamer", new SecondFillingFault("rekenkamer_houder", $nabij)));
end

rule "padstand Bergingsaanslag.rekenkamer naar Rekenkamer.bedrag: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsaanslag()
    $koppeling_keten_30 : RelationLink( relation == "bergingsaanslag_rekenkamer", first == $onderwerp, $overzijde_keten_31 : second )
    $stap_keten_29 : dev.uchar.regelspraak.facts.Rekenkamer( this == $overzijde_keten_31 )
    $stand : State( attribute == ElementKey.of("rekenkamer", "bedrag", false), subject == $stap_keten_29, $v : value )
then
    insertLogical(new PathState($onderwerp, "Bergingsaanslag:rekenkamer", ElementKey.of("rekenkamer", "bedrag", false), $v, $stap_keten_29));
end

rule "padstand Bergingsaanslag.rekenkamer naar Rekenkamer.bedrag: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsaanslag()
    not( $koppeling_keten_38 : RelationLink( relation == "bergingsaanslag_rekenkamer", first == $onderwerp, $overzijde_keten_39 : second ) and $stap_keten_37 : dev.uchar.regelspraak.facts.Rekenkamer( this == $overzijde_keten_39 ) )
then
    insertLogical(new PathState($onderwerp, "Bergingsaanslag:rekenkamer", ElementKey.of("rekenkamer", "bedrag", false), null, null));
end

