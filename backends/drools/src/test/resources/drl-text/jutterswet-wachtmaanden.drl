function Object waarde_toeslagdagenVanEenJutter(Object $tijdlijn_0) {
    try {
        return PeriodArithmetic.clipped(PeriodCondition.wholeBuckets(PeriodCondition.truePeriods($tijdlijn_0), "MAAND", Boolean.TRUE), PeriodArithmetic.dayCount(RegelSpraakRuntime.rsAantalDagenIn(((java.util.List) $tijdlijn_0), "MAAND", Period.class)));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "toeslagdagen van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $tijdlijn_0 : (ComputeHelpers.periods(wachtplichtig)) )
then
    Object v = waarde_toeslagdagenVanEenJutter($tijdlijn_0);
