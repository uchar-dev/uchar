rule "parameterstand verzuimrentevoet"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("verzuimrentevoet", verzuimrentevoet));
end

rule "parameterstand rentejaar"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("rentejaar", rentejaar));
end

