    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("afdracht", "maandrente", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("afdracht", "maandrente", false), subject == $onderwerp ) )
