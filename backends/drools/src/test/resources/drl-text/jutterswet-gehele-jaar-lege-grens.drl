rule "gelijkpremie van een jutter: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $wachtgrens : wachtgrens )
    $stand_0 : State( attribute == ElementKey.of("jutter", "wachtdagen", false), subject == $onderwerp, $tijdlijn_0 : value )
    eval( toets_gelijkpremieVanEenJutterFoutInDeVoorwaarde($tijdlijn_0, $wachtgrens, $onderwerp) )
then
    Object f = fout_gelijkpremieVanEenJutterFoutInDeVoorwaarde($tijdlijn_0, $wachtgrens, $onderwerp);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"gelijkpremie van een jutter\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "gelijkpremie van een jutter", ComputeHelpers.designate(f, "gelijkpremie van een jutter")));
end

