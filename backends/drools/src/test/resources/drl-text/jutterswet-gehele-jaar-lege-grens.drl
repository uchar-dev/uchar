rule "stand Jutter.wachtdagen: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(wachtdagen)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "wachtdagen", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "wachtdagen", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "wachtdagen", false), $invoer));
end

rule "stand Jutter.wachtdagen: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(wachtdagen)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "wachtdagen", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "wachtdagen", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "wachtdagen", false), ComputeHelpers.bucketScalarOf($invoer)));
end

