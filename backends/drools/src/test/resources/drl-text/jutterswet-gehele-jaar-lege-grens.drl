package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.BucketInput;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn wachtdagen gedurende het gehele jaar gelijk is aan zijn wachtgrens
function boolean toets_gelijkpremieVanEenJutter(Object $tijdlijn_0, Object $wachtgrens, Object $onderwerp) {
    try {
        return ComputeHelpers.wholePeriod(ComputeHelpers.complete($tijdlijn_0, "the whole-period qualifier over \"wachtdagen\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "wachtdagen", Boolean.TRUE), $wachtgrens, "JAAR", Integer.valueOf(4), Boolean.FALSE);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

// 20
function Object waarde_gelijkpremieVanEenJutter() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("20"), Integer.valueOf(0), "gelijkpremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "gelijkpremie van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $wachtgrens : wachtgrens )
    $stand_0 : State( attribute == ElementKey.of("jutter", "wachtdagen", false), subject == $onderwerp, $tijdlijn_0 : value )
    eval( toets_gelijkpremieVanEenJutter($tijdlijn_0, $wachtgrens, $onderwerp) )
then
    Object v = waarde_gelijkpremieVanEenJutter();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "gelijkpremie van een jutter", ComputeHelpers.designate(v, "gelijkpremie van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "gelijkpremie", false), v, "gelijkpremie van een jutter"));
        }
    }
end

