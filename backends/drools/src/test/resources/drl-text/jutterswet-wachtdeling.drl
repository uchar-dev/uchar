package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// hij aan geen van de volgende voorwaarden voldoet: - zijn ploegomvang is gelijk aan 0 - het aandeel is groter dan 0
function boolean toets_geentekenVanEenWacht(Object $ploegomvang, Object $vangstwaarde) {
    try {
        int raak = 0;
        Boolean vast;
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.GEEN, 0, raak, 0, 2);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("0"), "==")) {
            raak++;
        }
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.GEEN, 0, raak, 1, 1);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($vangstwaarde, $ploegomvang, null), Integer.valueOf(0), java.math.RoundingMode.FLOOR), new java.math.BigDecimal("0"), ">")) {
            raak++;
        }
        return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.GEEN, 0, raak, 2);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

// 1
function Object waarde_geentekenVanEenWacht(Object sonde) {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "geenteken", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "geenteken van een wacht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wacht( $ploegomvang : ploegomvang, $vangstwaarde : vangstwaarde )
    eval( toets_geentekenVanEenWacht($ploegomvang, $vangstwaarde) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_geentekenVanEenWacht(sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "geenteken van een wacht", ComputeHelpers.designate(v, "geenteken van een wacht")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("geenteken van een wacht", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("wacht", "geenteken", false), v, "geenteken van een wacht"));
        }
    }
end

// hij aan geen van de volgende voorwaarden voldoet: - zijn ploegomvang is gelijk aan 0 - het aandeel is groter dan 0
function boolean toets_geentekenVanEenWachtFoutInDeVoorwaarde(Object $ploegomvang, Object $vangstwaarde) {
    try {
        boolean uitkomst = samengesteld1_geentekenVanEenWachtFoutInDeVoorwaarde($ploegomvang, $vangstwaarde);
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

