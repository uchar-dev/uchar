rule "geenteken van een wacht: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wacht( $ploegomvang : ploegomvang, $vangstwaarde : vangstwaarde )
    eval( toets_geentekenVanEenWachtFoutInDeVoorwaarde($ploegomvang, $vangstwaarde) )
then
    Object f = fout_geentekenVanEenWachtFoutInDeVoorwaarde($ploegomvang, $vangstwaarde);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("de voorwaarde van \"geenteken van een wacht\" faalde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    insertLogical(new Fault($onderwerp, "geenteken van een wacht", ComputeHelpers.designate(f, "geenteken van een wacht")));
end

