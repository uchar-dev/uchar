when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Strandvoogd()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( beta_eersteVinddagVanEenStrandvoogdBijdrageAanVouw9(this, $vouwonderwerp), $vinddag : vinddag )
then
    Object v = ComputeHelpers.contribution("eerste vinddag van een strandvoogd: vouw 9", $vouwonderwerp, $onderwerp, $vinddag, null, null, false, false);
