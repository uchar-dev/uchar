function boolean beta_eersteVinddagVanEenStrandvoogdBijdrageAanVouw9(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("jutter", "strandvoogd"), java.util.Arrays.asList());
}

