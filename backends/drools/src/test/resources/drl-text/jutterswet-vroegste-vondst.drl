// de tijdsduur van de eerste van de vinddag van alle vondsten van de Jutter tot de laatste van de vinddag van alle vondsten van de Jutter in hele dagen
function Object waarde_vondstspanne(Object $aantal_vouw_42, Object $vouw_vouw_44, Object $aantal_vouw_49, Object $vouw_vouw_51) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsTijdsduur(((java.time.temporal.Temporal) ComputeHelpers.foldValue($aantal_vouw_42, $vouw_vouw_44, null)), ((java.time.temporal.Temporal) ComputeHelpers.foldValue($aantal_vouw_49, $vouw_vouw_51, null)), "DAYS", Boolean.FALSE), Integer.valueOf(0), "vondstspanne", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vondstspanne"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_39 : Contribution( fold == "vondstspanne: vouw 5", subject == $onderwerp, $bijdragewaarde_vouw_43 : value ); $aantal_vouw_42 : count(), $vouw_vouw_44 : exactMin($bijdragewaarde_vouw_43) )
    accumulate( $bijdrage_vouw_46 : Contribution( fold == "vondstspanne: vouw 6", subject == $onderwerp, $bijdragewaarde_vouw_50 : value ); $aantal_vouw_49 : count(), $vouw_vouw_51 : exactMax($bijdragewaarde_vouw_50) )
then
    Object v = waarde_vondstspanne($aantal_vouw_42, $vouw_vouw_44, $aantal_vouw_49, $vouw_vouw_51);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vondstspanne", ComputeHelpers.designate(v, "vondstspanne")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vondstspanne", false), v, "vondstspanne"));
        }
    }
end

