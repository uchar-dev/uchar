// de eerste van de vinddag van alle vondsten van de Jutter
function Object waarde_eersteVinddagVanEenJutter(Object $aantal_vouw_4, Object $vouw_vouw_6) {
    try {
        return ComputeHelpers.foldValue($aantal_vouw_4, $vouw_vouw_6, null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "eerste vinddag van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "eerste vinddag van een jutter: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_5 : value ); $aantal_vouw_4 : count(), $vouw_vouw_6 : exactMin($bijdragewaarde_vouw_5) )
then
    Object v = waarde_eersteVinddagVanEenJutter($aantal_vouw_4, $vouw_vouw_6);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "eerste vinddag van een jutter", ComputeHelpers.designate(v, "eerste vinddag van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "eerste vinddag", false), v, "eerste vinddag van een jutter"));
        }
    }
end

