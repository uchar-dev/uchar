// zijn gewicht groter is dan 5
function boolean toets_zwaar(Object $gewicht) {
    return RegelSpraakRuntime.rsAggVergelijk($gewicht, new java.math.BigDecimal("5"), ">");
}

rule "zwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht )
    eval( toets_zwaar($gewicht) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "zwaar", true)));
end

rule "eerste vinddag van een jutter: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( jutter == $vouwonderwerp, $vinddag : vinddag )
then
    Object v = ComputeHelpers.contribution("eerste vinddag van een jutter: vouw 0", $vouwonderwerp, $onderwerp, $vinddag, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

