    return ComputeHelpers.dateCompare($maand, $schuitAfmeerdag, dev.uchar.regelspraak.ir.Condition.Operator.LATER);
}

rule "eerste maand na het afmeren via de lading: bijdrage aan vouw 5"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Schuit()
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand( schuit == $vouwonderwerp, $maand : maand, $schuitAfmeerdag : (pad_eersteMaandNaHetAfmerenViaDeLadingBijdrageAanVouw5(this)) )
    eval( toets_eersteMaandNaHetAfmerenViaDeLadingBijdrageAanVouw5($maand, $schuitAfmeerdag) )
then
    Object v = ComputeHelpers.contribution("eerste maand na het afmeren via de lading: vouw 5", $vouwonderwerp, $onderwerp, $maand, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

