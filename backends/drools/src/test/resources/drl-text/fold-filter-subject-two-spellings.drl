// de eerste van de maand van alle ladingen van de Schuit die aan de volgende voorwaarde voldoen: zijn maand plus 1 mnd is later dan de laatste van de einddag van alle klachten van de Schuit
function Object waarde_eersteKlachtvrijeMaand(Object $aantal_vouw_26, Object $vouw_vouw_28, Object $eerste_filterfout_vouw_33) {
    try {
        return vouwlezing_eersteKlachtvrijeMaand($aantal_vouw_26, $vouw_vouw_28, $eerste_filterfout_vouw_33);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// de eerste van de maand van alle ladingen van de Schuit die aan de volgende voorwaarde voldoen: zijn maand plus 1 mnd is later dan de laatste van de einddag van alle klachten van de Schuit
function Object vouwlezing_eersteKlachtvrijeMaand(Object $aantal_vouw_26, Object $vouw_vouw_28, Object $eerste_filterfout_vouw_33) {
    if ($eerste_filterfout_vouw_33 != null) {
        throw ((FilterFault) $eerste_filterfout_vouw_33).fault();
    }
    return ComputeHelpers.foldValue($aantal_vouw_26, $vouw_vouw_28, null);
}

rule "eerste klachtvrije maand"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    accumulate( $bijdrage_vouw_23 : Contribution( fold == "eerste klachtvrije maand: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_27 : value ); $aantal_vouw_26 : count(), $vouw_vouw_28 : exactMin($bijdragewaarde_vouw_27) )
    accumulate( $filterfout_vouw_29 : FilterFault( fold == "eerste klachtvrije maand: vouw 0", subject == $onderwerp ); $filterfouten_vouw_32 : count(), $eerste_filterfout_vouw_33 : exactMin($filterfout_vouw_29) )
then
    Object v = waarde_eersteKlachtvrijeMaand($aantal_vouw_26, $vouw_vouw_28, $eerste_filterfout_vouw_33);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "eerste klachtvrije maand", ComputeHelpers.designate(v, "eerste klachtvrije maand")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schuit", "eerste klachtvrije maand", false), v, "eerste klachtvrije maand"));
        }
    }
end

