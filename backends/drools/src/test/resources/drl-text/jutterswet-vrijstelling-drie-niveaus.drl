package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;

// hij aan ten minste één van de volgende voorwaarden voldoet: - zijn soort is gelijk aan 'Blik' - hij voldoet aan alle volgende voorwaarden: .. zijn leeftijd is groter dan 65 .. hij voldoet aan ten minste één van de volgende voorwaarden: .... zijn soort is gelijk aan 'Touw' .... zijn soort is gelijk aan 'Glas' .... zijn soort is gelijk aan 'Kurk'
function boolean toets_vrijstelling(Object $soort, Object $leeftijd) {
    var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, 2, null);
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.textEqual(RegelSpraakRuntime.rsEnumNaam($soort), RegelSpraakRuntime.rsEnumNaam("Blik"), Boolean.TRUE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(samengesteld1_vrijstelling($soort, $leeftijd));
    return lezing.verdict();
}

// hij voldoet aan alle volgende voorwaarden: .. zijn leeftijd is groter dan 65 .. hij voldoet aan ten minste één van de volgende voorwaarden: .... zijn soort is gelijk aan 'Touw' .... zijn soort is gelijk aan 'Glas' .... zijn soort is gelijk aan 'Kurk'
function boolean samengesteld1_vrijstelling(Object $soort, Object $leeftijd) {
    var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, 2, null);
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(RegelSpraakRuntime.rsAggVergelijk($leeftijd, new java.math.BigDecimal("65"), ">"));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(samengesteld2_vrijstelling($soort, $leeftijd));
    return lezing.verdict();
}

// hij voldoet aan ten minste één van de volgende voorwaarden: .... zijn soort is gelijk aan 'Touw' .... zijn soort is gelijk aan 'Glas' .... zijn soort is gelijk aan 'Kurk'
function boolean samengesteld2_vrijstelling(Object $soort, Object $leeftijd) {
    var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, 3, null);
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.textEqual(RegelSpraakRuntime.rsEnumNaam($soort), RegelSpraakRuntime.rsEnumNaam("Touw"), Boolean.TRUE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.textEqual(RegelSpraakRuntime.rsEnumNaam($soort), RegelSpraakRuntime.rsEnumNaam("Glas"), Boolean.TRUE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.textEqual(RegelSpraakRuntime.rsEnumNaam($soort), RegelSpraakRuntime.rsEnumNaam("Kurk"), Boolean.TRUE));
    return lezing.verdict();
}

rule "vrijstelling"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $soort : soort, $leeftijd : leeftijd )
    eval( toets_vrijstelling($soort, $leeftijd) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "vrijstelling", true)));
end

