package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// -0.00
function Object waarde_kortingVanEenVondst() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("0"), Integer.valueOf(2), "korting", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "korting van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
then
    Object v = waarde_kortingVanEenVondst();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "korting van een vondst", ComputeHelpers.designate(v, "korting van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "korting", false), v, "korting van een vondst"));
        }
    }
end

// zijn grondwaarde groter is dan -0
function boolean toets_nettowaardeVanEenVondst(Object $grondwaarde) {
    return RegelSpraakRuntime.rsAggVergelijk($grondwaarde, new java.math.BigDecimal("0"), ">");
}

// zijn grondwaarde min zijn korting
function Object waarde_nettowaardeVanEenVondst(Object $grondwaarde, Object $korting) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMin($grondwaarde, $korting), Integer.valueOf(2), "nettowaarde", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "nettowaarde van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $grondwaarde : grondwaarde )
    $stand_1 : State( attribute == ElementKey.of("vondst", "korting", false), subject == $onderwerp, $korting : value )
    eval( toets_nettowaardeVanEenVondst($grondwaarde) )
then
    Object v = waarde_nettowaardeVanEenVondst($grondwaarde, $korting);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "nettowaarde van een vondst", ComputeHelpers.designate(v, "nettowaarde van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "nettowaarde", false), v, "nettowaarde van een vondst"));
        }
    }
end

rule "stand Vondst.korting: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "korting", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "korting", false), $v));
end

rule "stand Vondst.korting: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : korting )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "korting", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "korting", false), $invoer));
end

