package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Decides;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;

// hij aan alle volgende voorwaarden voldoet: - hij is noodweer verklaard - zijn aantal geborgen wrakken is groter of gelijk aan 8
function boolean toets_defaultsKJutterBergingsbevoegdDefault0(Object $noodweerVerklaard, Object $aantalGeborgenWrakken) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($noodweerVerklaard, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($aantalGeborgenWrakken, new java.math.BigDecimal("8"), ">=")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "defaults K:Jutter.bergingsbevoegd: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $noodweerVerklaard : (ComputeHelpers.holds(noodweerVerklaard)), $aantalGeborgenWrakken : aantalGeborgenWrakken )
    eval( toets_defaultsKJutterBergingsbevoegdDefault0($noodweerVerklaard, $aantalGeborgenWrakken) )
then
    Object v = Boolean.TRUE;
    if (v != null) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "bergingsbevoegd", true)));
        insertLogical(new Decides($onderwerp, "defaults K:Jutter.bergingsbevoegd", 0));
    }
end

// zijn aantal geborgen wrakken groter of gelijk is aan 20
function boolean toets_defaultsKJutterBergingsbevoegdDefault1(Object $aantalGeborgenWrakken) {
    return RegelSpraakRuntime.rsAggVergelijk($aantalGeborgenWrakken, new java.math.BigDecimal("20"), ">=");
}

rule "defaults K:Jutter.bergingsbevoegd: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $aantalGeborgenWrakken : aantalGeborgenWrakken )
    not( $hoger_3 : Decides( stack == "defaults K:Jutter.bergingsbevoegd" && index < 1, subject == $onderwerp ) )
    eval( toets_defaultsKJutterBergingsbevoegdDefault1($aantalGeborgenWrakken) )
then
    Object v = Boolean.TRUE;
    if (v != null) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "bergingsbevoegd", true)));
        insertLogical(new Decides($onderwerp, "defaults K:Jutter.bergingsbevoegd", 1));
    }
end

