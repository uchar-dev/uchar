// de maximale waarde van het tarief van alle vergunningen van het register van de Vergunning die aan alle volgende voorwaarden voldoen: - hij is niet de Vergunning zelf - zijn tarief gedeeld door de teller van de Vergunning zelf is groter dan 1
function Object waarde_hoogsteTariefBovenEigenTeller(Object $aantal_vouw_15, Object $vouw_vouw_17, Object $eerste_filterfout_vouw_22, Object $filterdeponeringen_vouw_26, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(vouwlezing_hoogsteTariefBovenEigenTeller($aantal_vouw_15, $vouw_vouw_17, $eerste_filterfout_vouw_22, $filterdeponeringen_vouw_26, sonde), Integer.valueOf(0), "hoogste tarief boven eigen teller", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// de maximale waarde van het tarief van alle vergunningen van het register van de Vergunning die aan alle volgende voorwaarden voldoen: - hij is niet de Vergunning zelf - zijn tarief gedeeld door de teller van de Vergunning zelf is groter dan 1
function Object vouwlezing_hoogsteTariefBovenEigenTeller(Object $aantal_vouw_15, Object $vouw_vouw_17, Object $eerste_filterfout_vouw_22, Object $filterdeponeringen_vouw_26, Object sonde) {
    ComputeHelpers.reportFilterDeposits(sonde, $filterdeponeringen_vouw_26);
    if ($eerste_filterfout_vouw_22 != null) {
        throw ((FilterFault) $eerste_filterfout_vouw_22).fault();
    }
    return ComputeHelpers.foldValue($aantal_vouw_15, $vouw_vouw_17, null);
}

rule "hoogste tarief boven eigen teller"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning()
    accumulate( $bijdrage_vouw_12 : Contribution( fold == "hoogste tarief boven eigen teller: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_16 : value ); $aantal_vouw_15 : count(), $vouw_vouw_17 : exactMax($bijdragewaarde_vouw_16) )
    accumulate( $filterfout_vouw_18 : FilterFault( fold == "hoogste tarief boven eigen teller: vouw 0", subject == $onderwerp ); $filterfouten_vouw_21 : count(), $eerste_filterfout_vouw_22 : exactMin($filterfout_vouw_18) )
    accumulate( $filterdeponering_vouw_23 : FilterDeposit( fold == "hoogste tarief boven eigen teller: vouw 0", subject == $onderwerp ); $filterdeponeringen_vouw_26 : collectList($filterdeponering_vouw_23) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_hoogsteTariefBovenEigenTeller($aantal_vouw_15, $vouw_vouw_17, $eerste_filterfout_vouw_22, $filterdeponeringen_vouw_26, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "hoogste tarief boven eigen teller", ComputeHelpers.designate(v, "hoogste tarief boven eigen teller")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("hoogste tarief boven eigen teller", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vergunning", "hoogste tarief boven eigen teller", false), v, "hoogste tarief boven eigen teller"));
        }
    }
end

function boolean beta_hoogsteTariefBovenEigenTellerBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("register"), java.util.Arrays.asList("register"));
}

// aan alle volgende voorwaarden voldoen: - hij is niet de Vergunning zelf - zijn tarief gedeeld door de teller van de Vergunning zelf is groter dan 1
function boolean toets_hoogsteTariefBovenEigenTellerBijdrageAanVouw0(Object $vouwonderwerp, Object $onderwerp, Object $tarief, Object $teller) {
    try {
        int raak = 0;
        Boolean vast;
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
        if (vast != null) {
            return vast;
        }
        if (ComputeHelpers.sameObject($onderwerp, $vouwonderwerp, Boolean.TRUE)) {
            raak++;
        }
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.divided($tarief, $teller, null), new java.math.BigDecimal("1"), ">")) {
            raak++;
        }
        return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "hoogste tarief boven eigen teller: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Vergunning( $teller : teller )
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( beta_hoogsteTariefBovenEigenTellerBijdrageAanVouw0(this, $vouwonderwerp), $tarief : tarief )
    eval( toets_hoogsteTariefBovenEigenTellerBijdrageAanVouw0($vouwonderwerp, $onderwerp, $tarief, $teller) )
then
    Object v = ComputeHelpers.contribution("hoogste tarief boven eigen teller: vouw 0", $vouwonderwerp, $onderwerp, $tarief, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

