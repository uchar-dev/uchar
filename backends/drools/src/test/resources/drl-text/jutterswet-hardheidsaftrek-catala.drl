    $stap_keten_39 : dev.uchar.regelspraak.facts.Rekenkamer( this == $overzijde_keten_41 )
    $stand : State( attribute == ElementKey.of("rekenkamer", "heffing", false), subject == $stap_keten_39, $v : value )
then
    insertLogical(new PathState($onderwerp, "Bergingsaanslag:rekenkamer", ElementKey.of("rekenkamer", "heffing", false), $v, $stap_keten_39));
end

