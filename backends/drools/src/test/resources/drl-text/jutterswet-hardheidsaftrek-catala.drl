// 
function Object waarde_berekeningHeffing(Object $bergingswaarde, Object $aftrek) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsVerminderd($bergingswaarde, $aftrek), Integer.valueOf(0), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "berekening heffing"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer()
    $stand_0 : State( attribute == ElementKey.of("rekenkamer", "bergingswaarde", false), subject == $onderwerp, $bergingswaarde : value )
    $stand_1 : State( attribute == ElementKey.of("rekenkamer", "aftrek", false), subject == $onderwerp, $aftrek : value )
then
    Object v = waarde_berekeningHeffing($bergingswaarde, $aftrek);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "berekening heffing", ComputeHelpers.designate(v, "berekening heffing")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("rekenkamer", "heffing", false), v, "berekening heffing"));
        }
    }
end

// de heffing van de rekenkamer
function Object waarde_berekeningVerschuldigd(Object $rekenkamerHeffing) {
    try {
        return ComputeHelpers.fitTarget($rekenkamerHeffing, Integer.valueOf(0), "verschuldigd", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "berekening verschuldigd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsaanslag()
    $padstand_0 : PathState( path == "Bergingsaanslag:rekenkamer" && member == ElementKey.of("rekenkamer", "heffing", false), subject == $onderwerp, $rekenkamerHeffing : value )
then
    Object v = waarde_berekeningVerschuldigd($rekenkamerHeffing);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "berekening verschuldigd", ComputeHelpers.designate(v, "berekening verschuldigd")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("bergingsaanslag", "verschuldigd", false), v, "berekening verschuldigd"));
        }
    }
end

function boolean beta_richtRekenkamerOp(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// de bergingswaarde
function Object creatie_richtRekenkamerOp(Object $bergingswaarde, Object $fase, Object $herkomsten_creatie_8, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("richt rekenkamer op", 0, "Bergingsaanslag", (java.util.List) $herkomsten_creatie_8, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($bergingswaarde, Integer.valueOf(0), "bergingswaarde", "richt rekenkamer op"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Rekenkamer");
    ComputeHelpers.set(nieuw, "bergingswaarde", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("richt rekenkamer op", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("bergingsaanslag_rekenkamer", $onderwerp, nieuw, fase));
    return feiten;
}

rule "richt rekenkamer op"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsaanslag( rekenkamer == null, $bergingswaarde : bergingswaarde )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_7 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_8 : collectList($herkomst_creatie_7) )
    not( $gemaakt_creatie_10 : CreationStamp( rule == "richt rekenkamer op", subject == $onderwerp ) )
    not( $nieuw_creatie_11 : CreationStamp( object == $onderwerp, beta_richtRekenkamerOp(this, $fase) ) )
    not( $eigen_fout : Fault( rule == "richt rekenkamer op", subject == $onderwerp ) )
then
    Object v = creatie_richtRekenkamerOp($bergingswaarde, $fase, $herkomsten_creatie_8, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "richt rekenkamer op", ComputeHelpers.designate(v, "richt rekenkamer op")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

// hardheid
function boolean toets_defaultsARekenkamerAftrekDefault0(Object $rekenkamerHouderHardheid) {
    return ComputeHelpers.characteristicCheckAlongPath($rekenkamerHouderHardheid, Boolean.TRUE);
}

rule "defaults A:Rekenkamer.aftrek: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Rekenkamer") )
    $padstand_0 : PathState( path == "Rekenkamer:rekenkamer_houder" && member == ElementKey.of("bergingsaanslag", "hardheid", true), subject == $onderwerp, $rekenkamerHouderHardheid : value )
    $padstand_1 : PathState( path == "Rekenkamer:rekenkamer_houder" && member == ElementKey.of("bergingsaanslag", "hardheidsaftrek", false), subject == $onderwerp, $rekenkamerHouderHardheidsaftrek : value )
    eval( toets_defaultsARekenkamerAftrekDefault0($rekenkamerHouderHardheid) )
then
    // de hardheidsaftrek
    Object v = $rekenkamerHouderHardheidsaftrek;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "aftrek");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Rekenkamer.aftrek", ComputeHelpers.designate(passend, "defaults A:Rekenkamer.aftrek")));
            insertLogical(new Decides($onderwerp, "defaults A:Rekenkamer.aftrek", 0));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("rekenkamer", "aftrek", false), passend, "defaults A:Rekenkamer.aftrek"));
            insertLogical(new Decides($onderwerp, "defaults A:Rekenkamer.aftrek", 0));
        }
    }
end

rule "defaults A:Rekenkamer.aftrek: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Rekenkamer") )
    not( $hoger_26 : Decides( stack == "defaults A:Rekenkamer.aftrek" && index < 1, subject == $onderwerp ) )
then
    // 100
    Object v = new java.math.BigDecimal("100");
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "aftrek");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Rekenkamer.aftrek", ComputeHelpers.designate(passend, "defaults A:Rekenkamer.aftrek")));
            insertLogical(new Decides($onderwerp, "defaults A:Rekenkamer.aftrek", 1));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("rekenkamer", "aftrek", false), passend, "defaults A:Rekenkamer.aftrek"));
            insertLogical(new Decides($onderwerp, "defaults A:Rekenkamer.aftrek", 1));
        }
    }
end

