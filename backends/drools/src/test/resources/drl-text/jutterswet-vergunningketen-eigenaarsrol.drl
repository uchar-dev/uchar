rule "verlengde einddag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( $basiseinddag : basiseinddag )
    $padstand_1 : PathState( path == "Vergunning:vorige vergunning.termijn" && member == ElementKey.of("termijn", "overschot", false), subject == $onderwerp, $vorigeVergunningTermijnOverschot : value )
then
