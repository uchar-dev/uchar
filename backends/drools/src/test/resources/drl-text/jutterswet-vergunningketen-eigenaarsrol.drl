end

function boolean toets_schrijversVergunningEinddagVerschil(Object $waarden) {
    return ComputeHelpers.differ($waarden);
}

rule "schrijvers Vergunning.einddag: verschil"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning()
    accumulate( $waarde : Value( attribute == ElementKey.of("vergunning", "einddag", false), subject == $onderwerp ); $waarden : collectList($waarde) )
    eval( toets_schrijversVergunningEinddagVerschil($waarden) )
then
    insertLogical(ComputeHelpers.writersConflict($onderwerp, $waarden, "einddag", ComputeHelpers.list5("restant", "einddag", "einddag zonder restant", "overschot", "verlengde einddag"), ComputeHelpers.list2("Vergunning", "Termijn"), ComputeHelpers.list2("Vergunning", "Termijn")));
end

