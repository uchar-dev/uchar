package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// hij aan alle volgende voorwaarden voldoet: - zijn stopdag is gevuld - zijn einddag is gevuld - zijn stopdag is eerder dan zijn einddag
function boolean toets_restant(Object $stopdag, Object $einddag) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($stopdag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($einddag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.dateCompare($stopdag, $einddag, dev.uchar.regelspraak.ir.Condition.Operator.EERDER)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

// de tijdsduur van zijn stopdag tot zijn einddag in hele dagen
function Object waarde_restant(Object $stopdag, Object $einddag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsTijdsduur(((java.time.temporal.Temporal) $stopdag), ((java.time.temporal.Temporal) $einddag), "DAYS", Boolean.FALSE), Integer.valueOf(0), "restant", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "restant"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( $stopdag : stopdag )
    $stand_1 : State( attribute == ElementKey.of("vergunning", "einddag", false), subject == $onderwerp, $einddag : value )
    eval( toets_restant($stopdag, $einddag) )
then
    Object v = waarde_restant($stopdag, $einddag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "restant", ComputeHelpers.designate(v, "restant")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vergunning", "restant", false), v, "restant"));
        }
    }
end

// het restant van de vorige vergunning van de Vergunning gevuld is
function boolean toets_einddag(Object $vorigeVergunningRestant) {
    return ComputeHelpers.emptyTest($vorigeVergunningRestant, Boolean.FALSE);
}

// zijn basiseinddag plus het restant van de vorige vergunning van de Vergunning
function Object waarde_einddag(Object $vorigeVergunningRestant, Object $basiseinddag) {
    try {
        return ComputeHelpers.dateStep($basiseinddag, $vorigeVergunningRestant, "DAYS", Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "einddag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( $basiseinddag : basiseinddag )
    $padstand_0 : PathState( path == "Vergunning:vorige vergunning" && member == ElementKey.of("vergunning", "restant", false), subject == $onderwerp, $vorigeVergunningRestant : value )
    eval( toets_einddag($vorigeVergunningRestant) )
then
    Object v = waarde_einddag($vorigeVergunningRestant, $basiseinddag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "einddag", ComputeHelpers.designate(v, "einddag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vergunning", "einddag", false), v, "einddag"));
        }
    }
end

// het restant van de vorige vergunning van de Vergunning leeg is
function boolean toets_einddagZonderRestant(Object $vorigeVergunningRestant) {
    return ComputeHelpers.emptyTest($vorigeVergunningRestant, Boolean.TRUE);
}

rule "einddag zonder restant"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( $basiseinddag : basiseinddag )
    $padstand_0 : PathState( path == "Vergunning:vorige vergunning" && member == ElementKey.of("vergunning", "restant", false), subject == $onderwerp, $vorigeVergunningRestant : value )
    eval( toets_einddagZonderRestant($vorigeVergunningRestant) )
then
    // zijn basiseinddag
    Object v = $basiseinddag;
    if (!ComputeHelpers.isEmpty(v)) {
        insertLogical(new Value($onderwerp, ElementKey.of("vergunning", "einddag", false), v, "einddag zonder restant"));
    }
end

function Object pad_overschot(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vergunning"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "stopdag");
}

// hij aan alle volgende voorwaarden voldoet: - de stopdag van de vergunning van de Termijn is gevuld - de verlengde einddag van de vergunning van de Termijn is gevuld - de stopdag van de vergunning van de Termijn is eerder dan de verlengde einddag van de vergunning van de Termijn
function boolean toets_overschot(Object $vergunningStopdag, Object $vergunningVerlengdeEinddag) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($vergunningStopdag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($vergunningVerlengdeEinddag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.dateCompare($vergunningStopdag, $vergunningVerlengdeEinddag, dev.uchar.regelspraak.ir.Condition.Operator.EERDER)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

// de tijdsduur van de stopdag van de vergunning van de Termijn tot de verlengde einddag van de vergunning van de Termijn in hele dagen
function Object waarde_overschot(Object $vergunningStopdag, Object $vergunningVerlengdeEinddag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsTijdsduur(((java.time.temporal.Temporal) $vergunningStopdag), ((java.time.temporal.Temporal) $vergunningVerlengdeEinddag), "DAYS", Boolean.FALSE), Integer.valueOf(0), "overschot", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "overschot"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn( $vergunningStopdag : (pad_overschot(this)) )
    $padstand_1 : PathState( path == "Termijn:vergunning" && member == ElementKey.of("vergunning", "verlengde einddag", false), subject == $onderwerp, $vergunningVerlengdeEinddag : value )
    eval( toets_overschot($vergunningStopdag, $vergunningVerlengdeEinddag) )
then
    Object v = waarde_overschot($vergunningStopdag, $vergunningVerlengdeEinddag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "overschot", ComputeHelpers.designate(v, "overschot")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("termijn", "overschot", false), v, "overschot"));
        }
    }
end

