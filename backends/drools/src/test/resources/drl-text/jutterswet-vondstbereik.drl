package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactMaximumFunction exactMax;
import accumulate dev.uchar.regelspraak.transpiler.tms.ExactMinimumFunction exactMin;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de minimale waarde van de vondstdatum van alle vondsten van de Jutter
function Object waarde_vroegsteVondstdagVanEenJutter(Object $aantal_vouw_4, Object $vouw_vouw_6) {
    try {
        return ComputeHelpers.foldValue($aantal_vouw_4, $vouw_vouw_6, null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vroegste vondstdag van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "vroegste vondstdag van een jutter: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_5 : value ); $aantal_vouw_4 : count(), $vouw_vouw_6 : exactMin($bijdragewaarde_vouw_5) )
then
    Object v = waarde_vroegsteVondstdagVanEenJutter($aantal_vouw_4, $vouw_vouw_6);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vroegste vondstdag van een jutter", ComputeHelpers.designate(v, "vroegste vondstdag van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vroegste vondstdag", false), v, "vroegste vondstdag van een jutter"));
        }
    }
end

// de maximale waarde van de vondstdatum van alle vondsten van de Jutter
function Object waarde_jongsteVondstdagVanEenJutter(Object $aantal_vouw_11, Object $vouw_vouw_13) {
    try {
        return ComputeHelpers.foldValue($aantal_vouw_11, $vouw_vouw_13, null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jongste vondstdag van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_8 : Contribution( fold == "jongste vondstdag van een jutter: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_12 : value ); $aantal_vouw_11 : count(), $vouw_vouw_13 : exactMax($bijdragewaarde_vouw_12) )
then
    Object v = waarde_jongsteVondstdagVanEenJutter($aantal_vouw_11, $vouw_vouw_13);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jongste vondstdag van een jutter", ComputeHelpers.designate(v, "jongste vondstdag van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "jongste vondstdag", false), v, "jongste vondstdag van een jutter"));
        }
    }
end

rule "vroegste vondstdag van een jutter: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( aanmelder == $vouwonderwerp, $vondstdatum : vondstdatum )
then
    Object v = ComputeHelpers.contribution("vroegste vondstdag van een jutter: vouw 0", $vouwonderwerp, $onderwerp, $vondstdatum, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "jongste vondstdag van een jutter: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( aanmelder == $vouwonderwerp, $vondstdatum : vondstdatum )
then
    Object v = ComputeHelpers.contribution("jongste vondstdag van een jutter: vouw 1", $vouwonderwerp, $onderwerp, $vondstdatum, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

