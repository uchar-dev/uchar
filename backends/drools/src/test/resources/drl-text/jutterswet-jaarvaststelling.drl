package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.ParameterState;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.math.BigDecimal vondstdrempel;
global java.math.BigDecimal penningbedrag;
global java.math.BigDecimal fondspercentage;
global java.time.LocalDate uitbetaaldag;

// zijn aantal aangemelde vondsten groter of gelijk is aan de vondstdrempel
function boolean toets_penningrechtBijDrempel(Object $aantalAangemeldeVondsten, Object $vondstdrempel) {
    try {
        return RegelSpraakRuntime.rsAggVergelijk($aantalAangemeldeVondsten, ComputeHelpers.required($vondstdrempel, "parameter \"vondstdrempel\" is unbound in this case (binding is fail-fast, ch. 5.7)"), ">=");
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "penningrecht bij drempel"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $aantalAangemeldeVondsten : aantalAangemeldeVondsten )
    $parameter_1 : ParameterState( parameter == "vondstdrempel", $vondstdrempel : value )
    eval( toets_penningrechtBijDrempel($aantalAangemeldeVondsten, $vondstdrempel) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "penninggerechtigd", true)));
end

// zijn aantal aangemelde vondsten groter of gelijk is aan de vondstdrempel
function boolean toets_penningrechtBijDrempelFoutInDeVoorwaarde(Object $aantalAangemeldeVondsten, Object $vondstdrempel) {
    try {
        boolean uitkomst = RegelSpraakRuntime.rsAggVergelijk($aantalAangemeldeVondsten, ComputeHelpers.required($vondstdrempel, "parameter \"vondstdrempel\" is unbound in this case (binding is fail-fast, ch. 5.7)"), ">=");
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

// zijn aantal aangemelde vondsten groter of gelijk is aan de vondstdrempel
function Object fout_penningrechtBijDrempelFoutInDeVoorwaarde(Object $aantalAangemeldeVondsten, Object $vondstdrempel) {
    try {
        boolean uitkomst = RegelSpraakRuntime.rsAggVergelijk($aantalAangemeldeVondsten, ComputeHelpers.required($vondstdrempel, "parameter \"vondstdrempel\" is unbound in this case (binding is fail-fast, ch. 5.7)"), ">=");
        return null;
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "penningrecht bij drempel: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $aantalAangemeldeVondsten : aantalAangemeldeVondsten )
    $parameter_1 : ParameterState( parameter == "vondstdrempel", $vondstdrempel : value )
    eval( toets_penningrechtBijDrempelFoutInDeVoorwaarde($aantalAangemeldeVondsten, $vondstdrempel) )
then
    Object f = fout_penningrechtBijDrempelFoutInDeVoorwaarde($aantalAangemeldeVondsten, $vondstdrempel);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"penningrecht bij drempel\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "penningrecht bij drempel", ComputeHelpers.designate(f, "penningrecht bij drempel")));
end

// hij penninggerechtigd is
function boolean toets_uitkeringVanDePenning(Object $penninggerechtigd) {
    return ComputeHelpers.characteristic($penninggerechtigd, Boolean.TRUE);
}

// het penningbedrag
function Object waarde_uitkeringVanDePenning(Object $penningbedrag) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.required($penningbedrag, "parameter \"penningbedrag\" is unbound in this case (binding is fail-fast, ch. 5.7)"), Integer.valueOf(0), "uitkering", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "uitkering van de penning"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $parameter_1 : ParameterState( parameter == "penningbedrag", $penningbedrag : value )
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("jutter", "penninggerechtigd", true), subject == $onderwerp, $penninggerechtigd : holds )
    eval( toets_uitkeringVanDePenning($penninggerechtigd) )
then
    Object v = waarde_uitkeringVanDePenning($penningbedrag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "uitkering van de penning", ComputeHelpers.designate(v, "uitkering van de penning")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "uitkering", false), v, "uitkering van de penning"));
        }
    }
end

// hij penninggerechtigd is
function boolean toets_afdrachtAanHetEilandfonds(Object $penninggerechtigd) {
    return ComputeHelpers.characteristic($penninggerechtigd, Boolean.TRUE);
}

