// het aantal dagen in het jaar dat hij wachtplichtig is
function Object waarde_stormwachtdagenVanEenJutter(Object $tijdlijn_0) {
    try {
        return PeriodArithmetic.dayCount(RegelSpraakRuntime.rsAantalDagenInVanaf(((java.util.List) $tijdlijn_0), "JAAR", java.time.LocalDate.parse("2000-10-01"), Period.class));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "stormwachtdagen van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $tijdlijn_0 : (ComputeHelpers.periods(wachtplichtig)) )
then
    Object v = waarde_stormwachtdagenVanEenJutter($tijdlijn_0);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "stormwachtdagen van een jutter", ComputeHelpers.designate(v, "stormwachtdagen van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "stormwachtdagen", false), v, "stormwachtdagen van een jutter"));
        }
    }
end

