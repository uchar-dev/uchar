    accumulate( $waarde : Value( attribute == ElementKey.of("jutter", "maandwachtdagen", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("jutter", "maandwachtdagen", false), $waarden, $invoer, lijst_standJutterMaandwachtdagenDeVerenigingVanDeSchrijvers()));
end

