rule "defaults A:Strandrecht.uitkering: terugval 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Strandrecht"), $grondslag : grondslag )
    not( $uitkomst_4 : Outcome( stack == "defaults A:Strandrecht.uitkering" && chain >= 1 && chain < 2, subject == $onderwerp ) )
then
    // zijn grondslag
    Object v = $grondslag;
    if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults A:Strandrecht.uitkering", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
