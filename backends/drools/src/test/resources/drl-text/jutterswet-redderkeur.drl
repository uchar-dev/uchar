rule "wisselend bij ploegkeur"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Reddingspost()
    accumulate( $bijdrage_vouw_25 : Contribution( fold == "wisselend bij ploegkeur: vouw 3", subject == $onderwerp, $bijdragewaarde_vouw_29 : value ); $aantal_vouw_28 : count(), $vouw_vouw_30 : exactSum($bijdragewaarde_vouw_29) )
    eval( toets_wisselendBijPloegkeur($aantal_vouw_28, $vouw_vouw_30) )
