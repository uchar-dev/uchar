package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.Value;

// alle redders van de Reddingspost aan alle volgende voorwaarden voldoen
function boolean toets_paraatBijPloegkeur(Object $aantal_vouw_4, Object $vouw_vouw_6) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_4, $vouw_vouw_6, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0));
}

rule "paraat bij ploegkeur"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Reddingspost()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "paraat bij ploegkeur: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_5 : value ); $aantal_vouw_4 : count(), $vouw_vouw_6 : exactSum($bijdragewaarde_vouw_5) )
    eval( toets_paraatBijPloegkeur($aantal_vouw_4, $vouw_vouw_6) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("reddingspost", "paraat", true)));
end

