// alle redders van de Reddingspost aan ten hoogste 1 van de volgende voorwaarden voldoen
function boolean toets_wisselendBijPloegkeur(Object $aantal_vouw_28, Object $vouw_vouw_30) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_28, $vouw_vouw_30, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0));
