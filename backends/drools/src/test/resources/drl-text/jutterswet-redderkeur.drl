// het aantal redders van de Reddingspost
function Object waarde_redderstalVanEenReddingspost(Object $aantal_vouw_36) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_36), Integer.valueOf(0), "redderstal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "redderstal van een reddingspost"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Reddingspost()
    accumulate( $bijdrage_vouw_33 : Contribution( fold == "redderstal van een reddingspost: vouw 4", subject == $onderwerp ); $aantal_vouw_36 : count() )
then
    Object v = waarde_redderstalVanEenReddingspost($aantal_vouw_36);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "redderstal van een reddingspost", ComputeHelpers.designate(v, "redderstal van een reddingspost")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("reddingspost", "redderstal", false), v, "redderstal van een reddingspost"));
        }
    }
end

// hij aan alle volgende voorwaarden voldoet: - zijn dienstjaren groter zijn dan 5 - hij gediplomeerd is
function boolean matrix_paraatBijPloegkeurBijdrageAanVouw0(Object $onderwerp, Object $dienstjaren, Object $gediplomeerd) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($dienstjaren, new java.math.BigDecimal("5"), ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($gediplomeerd, Boolean.TRUE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "paraat bij ploegkeur: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Reddingspost()
    $onderwerp : dev.uchar.regelspraak.facts.Redder( post == $vouwonderwerp, $dienstjaren : dienstjaren, $gediplomeerd : (ComputeHelpers.holds(gediplomeerd)) )
then
    insertLogical(new Contribution("paraat bij ploegkeur: vouw 0", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_paraatBijPloegkeurBijdrageAanVouw0($onderwerp, $dienstjaren, $gediplomeerd))));
end

// hij aan ten minste 1 van de volgende voorwaarden voldoet: - zijn conditie groter is dan 7 - hij aan alle volgende voorwaarden voldoet: - hij gediplomeerd is - zijn dienstjaren groter zijn dan 2
function boolean matrix_geoefendBijPloegkeurBijdrageAanVouw1(Object $onderwerp, Object $conditie, Object $gediplomeerd, Object $dienstjaren) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($conditie, new java.math.BigDecimal("7"), ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (samengesteld_geoefendBijPloegkeurBijdrageAanVouw1($onderwerp, $conditie, $gediplomeerd, $dienstjaren)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 2);
}

// hij aan alle volgende voorwaarden voldoet: - hij gediplomeerd is - zijn dienstjaren groter zijn dan 2
function boolean samengesteld_geoefendBijPloegkeurBijdrageAanVouw1(Object $onderwerp, Object $conditie, Object $gediplomeerd, Object $dienstjaren) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($gediplomeerd, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($dienstjaren, new java.math.BigDecimal("2"), ">")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "geoefend bij ploegkeur: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Reddingspost()
    $onderwerp : dev.uchar.regelspraak.facts.Redder( post == $vouwonderwerp, $conditie : conditie, $gediplomeerd : (ComputeHelpers.holds(gediplomeerd)), $dienstjaren : dienstjaren )
then
    insertLogical(new Contribution("geoefend bij ploegkeur: vouw 1", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_geoefendBijPloegkeurBijdrageAanVouw1($onderwerp, $conditie, $gediplomeerd, $dienstjaren))));
end

