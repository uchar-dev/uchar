// hij aan ten hoogste 1 van de volgende voorwaarden voldoet: - hij gediplomeerd is - zijn conditie groter is dan 7 - zijn dienstjaren groter zijn dan 5
function boolean matrix_wisselendBijPloegkeurBijdrageAanVouw3(Object $onderwerp, Object $gediplomeerd, Object $conditie, Object $dienstjaren) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($gediplomeerd, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($conditie, new java.math.BigDecimal("7"), ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($dienstjaren, new java.math.BigDecimal("5"), ">")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 3);
}

