function boolean toets_geoefendBijPloegkeur(Object $aantal_vouw_12, Object $vouw_vouw_14) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_12, $vouw_vouw_14, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0));
