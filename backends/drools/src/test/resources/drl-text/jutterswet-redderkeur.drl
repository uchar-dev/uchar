rule "geoefend bij ploegkeur"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Reddingspost()
    accumulate( $bijdrage_vouw_9 : Contribution( fold == "geoefend bij ploegkeur: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_13 : value ); $aantal_vouw_12 : count(), $vouw_vouw_14 : exactSum($bijdragewaarde_vouw_13) )
    eval( toets_geoefendBijPloegkeur($aantal_vouw_12, $vouw_vouw_14) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("reddingspost", "geoefend", true)));
end

