    Boolean waar = null;
    RuntimeException fout = null;
    try {
        waar = Boolean.valueOf(ComputeHelpers.wholePeriod(ComputeHelpers.complete($tijdlijn_1, "the whole-period qualifier over \"sleeptijd\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "sleeptijd", Boolean.TRUE), new java.math.BigDecimal("20"), "JAAR", Integer.valueOf(2), Boolean.TRUE));
    } catch (RuntimeException e) {
        fout = ComputeHelpers.caught(e);
    }
    return new MemberTest(plaats, waar, fout, ComputeHelpers.reported(null), ComputeHelpers.depositCodes(null));
