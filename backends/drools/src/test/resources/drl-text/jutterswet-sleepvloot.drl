rule "stand Sleepboot.sleeptijd: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Sleepboot( $invoer : (ComputeHelpers.periods(sleeptijd)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("sleepboot", "sleeptijd", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("sleepboot", "sleeptijd", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("sleepboot", "sleeptijd", false), $invoer));
end

rule "stand Sleepboot.sleeptijd: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Sleepboot( $invoer : (ComputeHelpers.periods(sleeptijd)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("sleepboot", "sleeptijd", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("sleepboot", "sleeptijd", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("sleepboot", "sleeptijd", false), ComputeHelpers.bucketScalarOf($invoer)));
end

