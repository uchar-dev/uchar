rule "bootal van een sleepvloot"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Sleepvloot()
    accumulate( $bijdrage_vouw_94 : Contribution( fold == "bootal van een sleepvloot: vouw 4", subject == $onderwerp ); $aantal_vouw_97 : count() )
then
    Object v = waarde_bootalVanEenSleepvloot($aantal_vouw_97);
    if (ComputeHelpers.isEvaluationFault(v)) {
