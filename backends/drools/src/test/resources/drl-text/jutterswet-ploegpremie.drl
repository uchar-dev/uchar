rule "premiegerechtigd bij dagvergoeding: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsploeg()
    accumulate( $bijdrage_vouw_16 : Contribution( fold == "premiegerechtigd bij dagvergoeding: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_20 : value ); $aantal_vouw_19 : count(), $vouw_vouw_21 : collectList($bijdragewaarde_vouw_20) )
    eval( toets_premiegerechtigdBijDagvergoedingFoutInDeVoorwaarde($aantal_vouw_19, $vouw_vouw_21) )
then
    Object f = fout_premiegerechtigdBijDagvergoedingFoutInDeVoorwaarde($aantal_vouw_19, $vouw_vouw_21);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("de voorwaarde van \"premiegerechtigd bij dagvergoeding\" faalde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    insertLogical(new Fault($onderwerp, "premiegerechtigd bij dagvergoeding", ComputeHelpers.designate(f, "premiegerechtigd bij dagvergoeding")));
end

