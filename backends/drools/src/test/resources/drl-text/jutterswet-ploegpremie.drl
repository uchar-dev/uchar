// de dagvergoeding van alle bergers van de Bergingsploeg gedurende het gehele jaar groter is dan 40
function boolean toets_premiegerechtigdBijDagvergoeding(Object $aantal_vouw_12, Object $vouw_vouw_14) {
    try {
        return ((Boolean) kwantorlezing_premiegerechtigdBijDagvergoeding($aantal_vouw_12, $vouw_vouw_14));
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

// de dagvergoeding van alle bergers van de Bergingsploeg gedurende het gehele jaar groter is dan 40
function Object kwantorlezing_premiegerechtigdBijDagvergoeding(Object $aantal_vouw_12, Object $vouw_vouw_14) {
    return ComputeHelpers.quantifierRead($aantal_vouw_12, $vouw_vouw_14, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0), null);
}

rule "premiegerechtigd bij dagvergoeding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsploeg()
    accumulate( $bijdrage_vouw_9 : Contribution( fold == "premiegerechtigd bij dagvergoeding: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_13 : value ); $aantal_vouw_12 : count(), $vouw_vouw_14 : collectList($bijdragewaarde_vouw_13) )
    eval( toets_premiegerechtigdBijDagvergoeding($aantal_vouw_12, $vouw_vouw_14) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("bergingsploeg", "premiegerechtigd", true)));
end

