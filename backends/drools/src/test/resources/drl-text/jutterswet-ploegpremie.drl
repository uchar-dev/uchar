rule "stand Berger.dagvergoeding: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berger( $invoer : (ComputeHelpers.periods(dagvergoeding)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("berger", "dagvergoeding", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("berger", "dagvergoeding", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("berger", "dagvergoeding", false), $invoer));
end

rule "stand Berger.dagvergoeding: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berger( $invoer : (ComputeHelpers.periods(dagvergoeding)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("berger", "dagvergoeding", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("berger", "dagvergoeding", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("berger", "dagvergoeding", false), ComputeHelpers.bucketScalarOf($invoer)));
end

