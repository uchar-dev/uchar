// het aantal bergers van de Bergingsploeg
function Object waarde_bergertalVanEenBergingsploeg(Object $aantal_vouw_50) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_50), Integer.valueOf(0), "bergertal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "bergertal van een bergingsploeg"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Bergingsploeg()
    accumulate( $bijdrage_vouw_47 : Contribution( fold == "bergertal van een bergingsploeg: vouw 2", subject == $onderwerp ); $aantal_vouw_50 : count() )
then
    Object v = waarde_bergertalVanEenBergingsploeg($aantal_vouw_50);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "bergertal van een bergingsploeg", ComputeHelpers.designate(v, "bergertal van een bergingsploeg")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("bergingsploeg", "bergertal", false), v, "bergertal van een bergingsploeg"));
        }
    }
end

function boolean beta_premiegerechtigdBijDagvergoedingBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.placeOf(eigen, ander, java.util.Arrays.asList());
}

// de dagvergoeding van alle bergers van de Bergingsploeg gedurende het gehele jaar groter is dan 40
function Object lidtoets_premiegerechtigdBijDagvergoedingBijdrageAanVouw0(Object $onderwerp, Object $tijdlijn_1, Object $lijstplaatsen_plaats_5, Object $plaats_plaats_6) {
    java.util.List plaats = plaats_premiegerechtigdBijDagvergoedingBijdrageAanVouw0($onderwerp, $lijstplaatsen_plaats_5, $plaats_plaats_6);
    Boolean waar = null;
    RuntimeException fout = null;
    try {
        waar = Boolean.valueOf(ComputeHelpers.wholePeriod(ComputeHelpers.complete($tijdlijn_1, "the whole-period qualifier over \"dagvergoeding\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "dagvergoeding", Boolean.TRUE), new java.math.BigDecimal("40"), "JAAR", Integer.valueOf(2), Boolean.FALSE));
    } catch (RuntimeException e) {
        fout = ComputeHelpers.caught(e);
    }
    return new MemberTest(plaats, waar, fout, ComputeHelpers.reported(null), ComputeHelpers.depositCodes(null));
}

function java.util.List plaats_premiegerechtigdBijDagvergoedingBijdrageAanVouw0(Object $onderwerp, Object $lijstplaatsen_plaats_5, Object $plaats_plaats_6) {
    return ComputeHelpers.foldPlace(dev.uchar.regelspraak.transpiler.tms.plan.Consequence.PlaceReason.QUANTIFIER, "premiegerechtigd bij dagvergoeding: vouw 0", $onderwerp, 0, java.util.Arrays.asList("ploeg"), java.util.Arrays.asList($lijstplaatsen_plaats_5), java.util.Arrays.asList($plaats_plaats_6));
}

