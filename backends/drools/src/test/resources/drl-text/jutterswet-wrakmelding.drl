rule "verdeel het meldgeld: ontvanger"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Wrakvondst()
    $onderwerp : dev.uchar.regelspraak.facts.Melding( vondst == $vouwonderwerp )
then
    insertLogical(new Recipient("verdeel het meldgeld", $vouwonderwerp, $onderwerp, null, null, null));
end

rule "verdeel het meldgeld"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakvondst( $meldgeld : meldgeld )
    accumulate( $ontvanger_verdeling_30 : Recipient( allocation == "verdeel het meldgeld", source == $onderwerp ); $ontvangers_verdeling_31 : collectList($ontvanger_verdeling_30) )
then
    for (Object feit : ComputeHelpers.payout("verdeel het meldgeld", $onderwerp, dev.uchar.regelspraak.ir.ResolvedAllocation.Method.GELIJKE_DELEN, $meldgeld, $ontvangers_verdeling_31, false, false, false, Integer.valueOf(0), ElementKey.of("melding", "meldaandeel", false), ElementKey.of("wrakvondst", "meldrest", false), "verdeel het meldgeld", Integer.valueOf(0), Integer.valueOf(0), "verdeel het meldgeld")) {
        insertLogical(feit);
    }
end

rule "aantal meldingen van een wrakvondst: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Wrakvondst()
    $onderwerp : dev.uchar.regelspraak.facts.Melding( vondst == $vouwonderwerp )
then
    insertLogical(new Contribution("aantal meldingen van een wrakvondst: vouw 0", $vouwonderwerp, $onderwerp, null));
end

rule "meldingental van een vondst: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Vondst()
    $onderwerp : dev.uchar.regelspraak.facts.Melding( vondst == $vouwonderwerp )
then
    insertLogical(new Contribution("meldingental van een vondst: vouw 1", $vouwonderwerp, $onderwerp, null));
end

rule "meldsom van een wrakvondst: bijdrage aan vouw 2"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Wrakvondst()
    $onderwerp : dev.uchar.regelspraak.facts.Melding( vondst == $vouwonderwerp, $ernst : ernst )
then
    Object v = ComputeHelpers.contribution("meldsom van een wrakvondst: vouw 2", $vouwonderwerp, $onderwerp, $ernst, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

// de ernst van ten minste 2 van de meldingen van de Wrakvondst groter is dan 3
function boolean matrix_veelgemeldBijErnstBijdrageAanVouw3(Object $onderwerp, Object $ernst) {
    return RegelSpraakRuntime.rsAggVergelijk($ernst, new java.math.BigDecimal("3"), ">");
}

rule "veelgemeld bij ernst: bijdrage aan vouw 3"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Wrakvondst()
    $onderwerp : dev.uchar.regelspraak.facts.Melding( vondst == $vouwonderwerp, $ernst : ernst )
then
    insertLogical(new Contribution("veelgemeld bij ernst: vouw 3", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_veelgemeldBijErnstBijdrageAanVouw3($onderwerp, $ernst))));
end

