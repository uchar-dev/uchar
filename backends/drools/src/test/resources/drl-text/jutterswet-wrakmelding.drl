package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.Recipient;
import dev.uchar.regelspraak.transpiler.tms.Value;

function Object pad_gemeldeWaardeVanEenMelding(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vondst"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "waarde");
}

// de waarde van de vondst van de Melding
function Object waarde_gemeldeWaardeVanEenMelding(Object $vondstWaarde) {
    try {
        return ComputeHelpers.fitTarget($vondstWaarde, Integer.valueOf(0), "gemelde waarde", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "gemelde waarde van een melding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Melding( $vondstWaarde : (pad_gemeldeWaardeVanEenMelding(this)) )
then
    Object v = waarde_gemeldeWaardeVanEenMelding($vondstWaarde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "gemelde waarde van een melding", ComputeHelpers.designate(v, "gemelde waarde van een melding")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("melding", "gemelde waarde", false), v, "gemelde waarde van een melding"));
        }
    }
end

// het aantal meldingen van de Wrakvondst
function Object waarde_aantalMeldingenVanEenWrakvondst(Object $aantal_vouw_4) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_4), Integer.valueOf(0), "aantal meldingen", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aantal meldingen van een wrakvondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakvondst()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "aantal meldingen van een wrakvondst: vouw 0", subject == $onderwerp ); $aantal_vouw_4 : count() )
then
    Object v = waarde_aantalMeldingenVanEenWrakvondst($aantal_vouw_4);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aantal meldingen van een wrakvondst", ComputeHelpers.designate(v, "aantal meldingen van een wrakvondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("wrakvondst", "aantal meldingen", false), v, "aantal meldingen van een wrakvondst"));
        }
    }
end

// het aantal meldingen van de Vondst
function Object waarde_meldingentalVanEenVondst(Object $aantal_vouw_9) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_9), Integer.valueOf(0), "meldingental", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "meldingental van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    accumulate( $bijdrage_vouw_6 : Contribution( fold == "meldingental van een vondst: vouw 1", subject == $onderwerp ); $aantal_vouw_9 : count() )
then
    Object v = waarde_meldingentalVanEenVondst($aantal_vouw_9);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldingental van een vondst", ComputeHelpers.designate(v, "meldingental van een vondst")));
