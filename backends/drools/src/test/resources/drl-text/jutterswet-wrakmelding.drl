        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "meldingental", false), v, "meldingental van een vondst"));
        }
    }
end

// de som van de ernst van alle meldingen van de Wrakvondst
function Object waarde_meldsomVanEenWrakvondst(Object $aantal_vouw_14, Object $vouw_vouw_16) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_14, $vouw_vouw_16, null), Integer.valueOf(0), "meldsom", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "meldsom van een wrakvondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakvondst()
    accumulate( $bijdrage_vouw_11 : Contribution( fold == "meldsom van een wrakvondst: vouw 2", subject == $onderwerp, $bijdragewaarde_vouw_15 : value ); $aantal_vouw_14 : count(), $vouw_vouw_16 : exactSum($bijdragewaarde_vouw_15) )
then
    Object v = waarde_meldsomVanEenWrakvondst($aantal_vouw_14, $vouw_vouw_16);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldsom van een wrakvondst", ComputeHelpers.designate(v, "meldsom van een wrakvondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("wrakvondst", "meldsom", false), v, "meldsom van een wrakvondst"));
        }
    }
end

// de ernst van ten minste 2 van de meldingen van de Wrakvondst groter is dan 3
function boolean toets_veelgemeldBijErnst(Object $aantal_vouw_21, Object $vouw_vouw_23) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_21, $vouw_vouw_23, dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, Integer.valueOf(2));
}

rule "veelgemeld bij ernst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakvondst()
    accumulate( $bijdrage_vouw_18 : Contribution( fold == "veelgemeld bij ernst: vouw 3", subject == $onderwerp, $bijdragewaarde_vouw_22 : value ); $aantal_vouw_21 : count(), $vouw_vouw_23 : exactSum($bijdragewaarde_vouw_22) )
    eval( toets_veelgemeldBijErnst($aantal_vouw_21, $vouw_vouw_23) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("wrakvondst", "veelgemeld", true)));
end

// hij een vondst is
function boolean toets_gemeldAlsVondst(Object $vullers_rol_26) {
    return ComputeHelpers.roleCount($vullers_rol_26, Boolean.FALSE);
}

rule "gemeld als vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakvondst()
    accumulate( $vuller_rol_25 : dev.uchar.regelspraak.facts.Melding( vondst == $onderwerp ); $vullers_rol_26 : count() )
    eval( toets_gemeldAlsVondst($vullers_rol_26) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("wrakvondst", "gemeld", true)));
end

