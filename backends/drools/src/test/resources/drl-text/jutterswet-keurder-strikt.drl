// aan ten minste één van de volgende voorwaarden voldoen: - hij is gemerkt - hij is drijfhout
function Object oordeel_keurderBijdrageAanVouw0(Object $gemerkt, Object open_invoer, Object $onderwerp, Object $drijfhout) {
    return ComputeHelpers.judge(() -> {
        var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, 2, null);
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(() -> ComputeHelpers.characteristic(ComputeHelpers.readInput($gemerkt, open_invoer, $onderwerp, ElementKey.of("vondst", "gemerkt", true)), Boolean.TRUE));
        if (lezing.stands()) {
            return lezing.verdict();
        }
        lezing.read(() -> ComputeHelpers.characteristic(ComputeHelpers.readInput($drijfhout, open_invoer, $onderwerp, ElementKey.of("vondst", "drijfhout", true)), Boolean.TRUE));
        return lezing.verdict();
    }, false);
}

// het gewicht van alle vondsten van de Jutter die aan ten minste één van de volgende voorwaarden voldoen: - hij is gemerkt - hij is drijfhout groter is dan 10,00
function Object lidtoets_keurderBijdrageAanVouw0(Object $gemerkt, Object open_invoer, Object $onderwerp, Object $drijfhout, Object $gewicht) {
    java.util.List plaats = plaats_keurderBijdrageAanVouw0($onderwerp);
    Boolean waar = null;
    RuntimeException fout = null;
    try {
        waar = Boolean.valueOf(RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.readInput($gewicht, open_invoer, $onderwerp, ElementKey.of("vondst", "gewicht", false)), new java.math.BigDecimal("10"), ">"));
    } catch (RuntimeException e) {
        fout = ComputeHelpers.ended(e);
    }
    return new MemberTest(plaats, waar, fout, ComputeHelpers.reported(null), ComputeHelpers.depositCodes(null));
}

function java.util.List plaats_keurderBijdrageAanVouw0(Object $onderwerp) {
    return ComputeHelpers.foldPlace(dev.uchar.regelspraak.transpiler.tms.plan.Consequence.PlaceReason.QUANTIFIER, "keurder: vouw 0", $onderwerp, 0, java.util.Arrays.asList(), java.util.Arrays.asList(), java.util.Arrays.asList());
