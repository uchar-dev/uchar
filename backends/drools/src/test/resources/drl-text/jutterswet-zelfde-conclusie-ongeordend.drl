// hij betwist is
function Object oordeel_defaultsAVondstBergloonDefault00(Object $betwist, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.characteristic(ComputeHelpers.readInput($betwist, open_invoer, $onderwerp, ElementKey.of("vondst", "betwist", true)), Boolean.TRUE), false);
}

rule "defaults A:Vondst.bergloon: default 0:0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $betwist : (ComputeHelpers.holds(betwist)) )
    eval( ComputeHelpers.acts(oordeel_defaultsAVondstBergloonDefault00($betwist, open_invoer, $onderwerp)) )
then
    if (ComputeHelpers.decides(oordeel_defaultsAVondstBergloonDefault00($betwist, open_invoer, $onderwerp))) {
        // 0
        Object v = new java.math.BigDecimal("0");
        if (v != null) {
            insertLogical(new Outcome($onderwerp, "defaults A:Vondst.bergloon", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
        }
    } else {
        insertLogical(new Outcome($onderwerp, "defaults A:Vondst.bergloon", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN_ONLY, new java.math.BigDecimal("0"), null));
    }
end

