rule "defaults A:Vondst.bergloon: eens wortel"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Vondst.bergloon" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 0 && chain < 2 && position == -1, $onderwerp : subject, $waarde : value )
    not( $uitkomst_34 : Outcome( stack == "defaults A:Vondst.bergloon" && chain >= 0 && chain < 2 && position == -1 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta1_defaultsAVondstBergloonEensWortel(this, $besluit) ) )
    not( $uitkomst_37 : Outcome( stack == "defaults A:Vondst.bergloon" && chain >= 0 && chain < 2 && position == -1 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta2_defaultsAVondstBergloonEensWortel(this, $besluit) ) )
    not( $uitkomst_40 : Outcome( stack == "defaults A:Vondst.bergloon" && chain >= 0 && chain < 2 && position == -1 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN, subject != null, subject == $onderwerp ) )
    not( $uitkomst_42 : Outcome( stack == "defaults A:Vondst.bergloon" && chain >= 0 && chain < 2 && position == -1 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN_ONLY, subject != null, subject == $onderwerp, beta3_defaultsAVondstBergloonEensWortel(this, $besluit) ) )
then
    Object v = $waarde;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "bergloon");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.bergloon", ComputeHelpers.designate(passend, "defaults A:Vondst.bergloon")));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), passend, "defaults A:Vondst.bergloon"));
        }
    }
end

