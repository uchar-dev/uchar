package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Recipient;

rule "verdeel de bergopbrengst van een vrijgegeven strandberging: ontvanger"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Strandberging()
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( strandberging == $vouwonderwerp, $berggewicht : berggewicht )
then
    insertLogical(new Recipient("verdeel de bergopbrengst van een vrijgegeven strandberging", $vouwonderwerp, $onderwerp, $berggewicht, null, null));
end

// de vrijgavescore van de strandberging groter of gelijk is aan 10
function boolean toets_verdeelDeBergopbrengstVanEenVrijgegevenStrandberging(Object $vrijgavescore) {
    return RegelSpraakRuntime.rsAggVergelijk($vrijgavescore, new java.math.BigDecimal("10"), ">=");
}

rule "verdeel de bergopbrengst van een vrijgegeven strandberging"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandberging( $vrijgavescore : vrijgavescore, $bergopbrengst : bergopbrengst )
    accumulate( $ontvanger_verdeling_1 : Recipient( allocation == "verdeel de bergopbrengst van een vrijgegeven strandberging", source == $onderwerp ); $ontvangers_verdeling_2 : collectList($ontvanger_verdeling_1) )
    eval( toets_verdeelDeBergopbrengstVanEenVrijgegevenStrandberging($vrijgavescore) )
then
    for (Object feit : ComputeHelpers.payout("verdeel de bergopbrengst van een vrijgegeven strandberging", $onderwerp, dev.uchar.regelspraak.ir.ResolvedAllocation.Method.NAAR_RATO, $bergopbrengst, $ontvangers_verdeling_2, true, false, false, null, ElementKey.of("jutter", "bergdeel", false), null, "verdeel de bergopbrengst van een vrijgegeven strandberging", Integer.valueOf(0), null, "verdeel de bergopbrengst van een vrijgegeven strandberging")) {
        insertLogical(feit);
    }
end

