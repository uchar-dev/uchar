package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactMaximumFunction exactMax;
import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de bergdag van alle vondsten van de Berging gevuld is
function boolean toets_sluitdag(Object $aantal_vouw_6, Object $vouw_vouw_8) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_6, $vouw_vouw_8, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0));
}

// zijn laatste bergdag plus 1
function Object waarde_sluitdag(Object $laatsteBergdag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($laatsteBergdag, new java.math.BigDecimal("1")), Integer.valueOf(0), "sluitdag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "sluitdag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging()
    accumulate( $bijdrage_vouw_3 : Contribution( fold == "sluitdag: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_7 : value ); $aantal_vouw_6 : count(), $vouw_vouw_8 : exactSum($bijdragewaarde_vouw_7) )
    $stand_2 : State( attribute == ElementKey.of("berging", "laatste bergdag", false), subject == $onderwerp, $laatsteBergdag : value )
    eval( toets_sluitdag($aantal_vouw_6, $vouw_vouw_8) )
then
    Object v = waarde_sluitdag($laatsteBergdag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "sluitdag", ComputeHelpers.designate(v, "sluitdag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("berging", "sluitdag", false), v, "sluitdag"));
        }
    }
end

// de vinddag van geen van de vondsten van de Berging leeg is
function boolean toets_afrekendag(Object $aantal_vouw_16, Object $vouw_vouw_18) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_16, $vouw_vouw_18, dev.uchar.regelspraak.ir.Condition.Quantifier.GEEN, Integer.valueOf(0));
}

// zijn uiterste meldingsdag
function Object waarde_afrekendag(Object $uitersteMeldingsdag) {
    try {
        return ComputeHelpers.fitTarget($uitersteMeldingsdag, Integer.valueOf(0), "afrekendag", null);
