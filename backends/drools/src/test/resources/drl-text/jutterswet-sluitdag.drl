    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "afrekendag", ComputeHelpers.designate(v, "afrekendag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("berging", "afrekendag", false), v, "afrekendag"));
        }
    }
end

// de bergdag van ten minste één van de vondsten van de Berging gevuld is
function boolean toets_controledag(Object $aantal_vouw_28, Object $vouw_vouw_30) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_28, $vouw_vouw_30, dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, Integer.valueOf(1));
}

// zijn laatste bergdag plus zijn wachttijd
function Object waarde_controledag(Object $laatsteBergdag, Object $wachttijd) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($laatsteBergdag, $wachttijd), Integer.valueOf(0), "controledag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "controledag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging()
    accumulate( $bijdrage_vouw_25 : Contribution( fold == "controledag: vouw 2", subject == $onderwerp, $bijdragewaarde_vouw_29 : value ); $aantal_vouw_28 : count(), $vouw_vouw_30 : exactSum($bijdragewaarde_vouw_29) )
    $stand_2 : State( attribute == ElementKey.of("berging", "laatste bergdag", false), subject == $onderwerp, $laatsteBergdag : value )
    $stand_3 : State( attribute == ElementKey.of("berging", "wachttijd", false), subject == $onderwerp, $wachttijd : value )
    eval( toets_controledag($aantal_vouw_28, $vouw_vouw_30) )
then
    Object v = waarde_controledag($laatsteBergdag, $wachttijd);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "controledag", ComputeHelpers.designate(v, "controledag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("berging", "controledag", false), v, "controledag"));
        }
    }
end

// zijn vinddag gevuld is
function boolean toets_bergdag(Object $vinddag) {
    return ComputeHelpers.emptyTest($vinddag, Boolean.FALSE);
}

// zijn vinddag plus 1
function Object waarde_bergdag(Object $vinddag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($vinddag, new java.math.BigDecimal("1")), Integer.valueOf(0), "bergdag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "bergdag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $vinddag : vinddag )
    eval( toets_bergdag($vinddag) )
then
    Object v = waarde_bergdag($vinddag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "bergdag", ComputeHelpers.designate(v, "bergdag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergdag", false), v, "bergdag"));
        }
    }
end

// de maximale waarde van de bergdag van alle vondsten van de Berging
function Object waarde_laatsteBergdag(Object $aantal_vouw_43, Object $vouw_vouw_45) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_43, $vouw_vouw_45, null), Integer.valueOf(0), "laatste bergdag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "laatste bergdag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging()
    accumulate( $bijdrage_vouw_40 : Contribution( fold == "laatste bergdag: vouw 3", subject == $onderwerp, $bijdragewaarde_vouw_44 : value ); $aantal_vouw_43 : count(), $vouw_vouw_45 : exactMax($bijdragewaarde_vouw_44) )
then
    Object v = waarde_laatsteBergdag($aantal_vouw_43, $vouw_vouw_45);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "laatste bergdag", ComputeHelpers.designate(v, "laatste bergdag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("berging", "laatste bergdag", false), v, "laatste bergdag"));
        }
    }
end

