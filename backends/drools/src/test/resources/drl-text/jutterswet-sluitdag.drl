}

rule "afrekendag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging()
    accumulate( $bijdrage_vouw_13 : Contribution( fold == "afrekendag: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_17 : value ); $aantal_vouw_16 : count(), $vouw_vouw_18 : exactSum($bijdragewaarde_vouw_17) )
    $stand_2 : State( attribute == ElementKey.of("berging", "uiterste meldingsdag", false), subject == $onderwerp, $uitersteMeldingsdag : value )
    eval( toets_afrekendag($aantal_vouw_16, $vouw_vouw_18) )
then
