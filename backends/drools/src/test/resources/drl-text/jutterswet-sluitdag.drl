// de bergdag van alle vondsten van de Berging gevuld is
function boolean matrix_sluitdagBijdrageAanVouw0(Object $onderwerp, Object $bergdag) {
    return ComputeHelpers.emptyTest($bergdag, Boolean.FALSE);
}

rule "sluitdag: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Berging()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( berging == $vouwonderwerp )
    $stand_1 : State( attribute == ElementKey.of("vondst", "bergdag", false), subject == $onderwerp, $bergdag : value )
then
    insertLogical(new Contribution("sluitdag: vouw 0", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_sluitdagBijdrageAanVouw0($onderwerp, $bergdag))));
end

// de vinddag van geen van de vondsten van de Berging leeg is
function boolean matrix_afrekendagBijdrageAanVouw1(Object $onderwerp, Object $vinddag) {
    return ComputeHelpers.emptyTest($vinddag, Boolean.TRUE);
}

rule "afrekendag: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Berging()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( berging == $vouwonderwerp, $vinddag : vinddag )
then
    insertLogical(new Contribution("afrekendag: vouw 1", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_afrekendagBijdrageAanVouw1($onderwerp, $vinddag))));
end

// de bergdag van ten minste één van de vondsten van de Berging gevuld is
function boolean matrix_controledagBijdrageAanVouw2(Object $onderwerp, Object $bergdag) {
    return ComputeHelpers.emptyTest($bergdag, Boolean.FALSE);
}

rule "controledag: bijdrage aan vouw 2"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Berging()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( berging == $vouwonderwerp )
    $stand_1 : State( attribute == ElementKey.of("vondst", "bergdag", false), subject == $onderwerp, $bergdag : value )
then
    insertLogical(new Contribution("controledag: vouw 2", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_controledagBijdrageAanVouw2($onderwerp, $bergdag))));
end

rule "laatste bergdag: bijdrage aan vouw 3"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Berging()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( berging == $vouwonderwerp )
    $stand_1 : State( attribute == ElementKey.of("vondst", "bergdag", false), subject == $onderwerp, $bergdag : value )
then
    Object v = ComputeHelpers.contribution("laatste bergdag: vouw 3", $vouwonderwerp, $onderwerp, $bergdag, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "stand Berging.laatste bergdag: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging()
    $waarde : Value( attribute == ElementKey.of("berging", "laatste bergdag", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("berging", "laatste bergdag", false), $v));
end

rule "stand Berging.laatste bergdag: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging( $invoer : laatsteBergdag )
    not( $waarde : Value( attribute == ElementKey.of("berging", "laatste bergdag", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("berging", "laatste bergdag", false), $invoer));
end

