    accumulate( $filterdeponering_vouw_83 : FilterDeposit( fold == "meldgewicht: vouw 1", subject == $onderwerp ); $filterdeponeringen_vouw_86 : collectList($filterdeponering_vouw_83) )
    eval( toets_meldgewicht($dringend) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_meldgewicht($aantal_vouw_75, $vouw_vouw_77, $eerste_filterfout_vouw_82, $filterdeponeringen_vouw_86, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldgewicht", ComputeHelpers.designate(v, "meldgewicht")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("meldgewicht", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("melding", "meldgewicht", false), v, "meldgewicht"));
        }
    }
end

