rule "meldgewicht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Melding( $dringend : (ComputeHelpers.holds(dringend)) )
    accumulate( $bijdrage_vouw_72 : Contribution( fold == "meldgewicht: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_76 : value ); $aantal_vouw_75 : count(), $vouw_vouw_77 : exactSum($bijdragewaarde_vouw_76) )
