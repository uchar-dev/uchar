// 5 plus de korting van de Vondst
function Object waarde_somVanEenVondst(Object $korting) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus(new java.math.BigDecimal("5"), $korting), Integer.valueOf(0), "som", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "som van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $korting : korting )
then
    Object v = waarde_somVanEenVondst($korting);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "som van een vondst", ComputeHelpers.designate(v, "som van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "som", false), v, "som van een vondst"));
        }
    }
end

