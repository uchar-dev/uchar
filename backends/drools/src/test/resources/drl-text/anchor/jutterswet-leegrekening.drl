package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het gewicht van de Vondst plus 5
function Object waarde_brutoVanEenVondst(Object $gewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($gewicht, new java.math.BigDecimal("5")), Integer.valueOf(0), "bruto", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "bruto van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht )
then
    Object v = waarde_brutoVanEenVondst($gewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "bruto van een vondst", ComputeHelpers.designate(v, "bruto van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bruto", false), v, "bruto van een vondst"));
        }
    }
end

