package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.CreationStamp;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de som van de rang van alle opvolgers van de Wachter of 0 als die er niet zijn
function Object waarde_opvolgerrangVanEenWachter(Object $aantal_vouw_9, Object $vouw_vouw_11) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_9, $vouw_vouw_11, new java.math.BigDecimal("0")), Integer.valueOf(0), "opvolgerrang", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "opvolgerrang van een wachter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    accumulate( $bijdrage_vouw_6 : Contribution( fold == "opvolgerrang van een wachter: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_10 : value ); $aantal_vouw_9 : count(), $vouw_vouw_11 : exactSum($bijdragewaarde_vouw_10) )
then
    Object v = waarde_opvolgerrangVanEenWachter($aantal_vouw_9, $vouw_vouw_11);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "opvolgerrang van een wachter", ComputeHelpers.designate(v, "opvolgerrang van een wachter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("wachter", "opvolgerrang", false), v, "opvolgerrang van een wachter"));
        }
    }
end

// de rang van de Wachter is kleiner dan 5
function boolean toets_rangdetector(Object $rang) {
    return ComputeHelpers.not(RegelSpraakRuntime.rsAggVergelijk($rang, new java.math.BigDecimal("5"), "<"));
}

rule "rangdetector"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $stand_0 : State( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $rang : value )
    eval( toets_rangdetector($rang) )
then
    insertLogical(ComputeHelpers.inconsistency("rangdetector", $onderwerp, ComputeHelpers.list1("EF-025")));
end

function boolean beta_estafetteWerfDeOpvolger(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// de rang van de Wachter is kleiner dan 5
function boolean toets_estafetteWerfDeOpvolger(Object $rang) {
    return RegelSpraakRuntime.rsAggVergelijk($rang, new java.math.BigDecimal("5"), "<");
}

// de rang van de Wachter plus 1
function Object creatie_estafetteWerfDeOpvolger(Object $rang, Object $fase, Object $herkomsten_creatie_19, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("werf de opvolger", 0, "Wachter", (java.util.List) $herkomsten_creatie_19, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($rang, new java.math.BigDecimal("1")), Integer.valueOf(0), "rang", "werf de opvolger"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Wachter");
    ComputeHelpers.set(nieuw, "rang", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("werf de opvolger", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("opvolging", $onderwerp, nieuw, fase));
    return feiten;
}

rule "estafette: werf de opvolger"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter( opvolger == null )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    $stand_0 : State( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $rang : value )
    accumulate( $herkomst_creatie_18 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_19 : collectList($herkomst_creatie_18) )
    not( $gemaakt_creatie_21 : CreationStamp( rule == "werf de opvolger", subject == $onderwerp ) )
    not( $nieuw_creatie_22 : CreationStamp( object == $onderwerp, beta_estafetteWerfDeOpvolger(this, $fase) ) )
    eval( toets_estafetteWerfDeOpvolger($rang) )
    not( $eigen_fout : Fault( rule == "werf de opvolger", subject == $onderwerp ) )
then
    Object v = creatie_estafetteWerfDeOpvolger($rang, $fase, $herkomsten_creatie_19, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "werf de opvolger", ComputeHelpers.designate(v, "estafette: werf de opvolger")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

rule "opvolgerrang van een wachter: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Wachter()
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    exists( $koppeling_bereik_0 : RelationLink( relation == "opvolging", second == $onderwerp, first == $vouwonderwerp ) )
    $stand_1 : State( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $rang : value )
then
    Object v = ComputeHelpers.contribution("opvolgerrang van een wachter: vouw 0", $vouwonderwerp, $onderwerp, $rang, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "koppeling opvolging uit de invoer: Wachter.opvolger"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Wachter( opvolger != null, $ander : opvolger )
then
    insertLogical(new RelationLink("opvolging", $houder, $ander, 0));
end

rule "koppeling opvolging uit de invoer: Wachter.voorganger"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Wachter( voorganger != null, $ander : voorganger )
then
    insertLogical(new RelationLink("opvolging", $ander, $houder, 0));
end

function boolean beta_koppelingOpvolgingTweedeVullingVanOpvolger(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "second");
}

rule "koppeling opvolging: tweede vulling van opvolger"
    dialect "mvel"
when
    $een : RelationLink( relation == "opvolging", $nabij : first )
    $twee : RelationLink( relation == "opvolging", first != null, first == $een.first, beta_koppelingOpvolgingTweedeVullingVanOpvolger(this, $een) )
then
    insertLogical(new Fault($nabij, "opvolging", new SecondFillingFault("opvolger", $nabij)));
end

function boolean beta_koppelingOpvolgingTweedeVullingVanVoorganger(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling opvolging: tweede vulling van voorganger"
    dialect "mvel"
when
    $een : RelationLink( relation == "opvolging", $nabij : second )
    $twee : RelationLink( relation == "opvolging", second != null, second == $een.second, beta_koppelingOpvolgingTweedeVullingVanVoorganger(this, $een) )
then
    insertLogical(new Fault($nabij, "opvolging", new SecondFillingFault("voorganger", $nabij)));
end

rule "stand Wachter.rang: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $waarde : Value( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("wachter", "rang", false), $v));
end

rule "stand Wachter.rang: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter( $invoer : rang )
    not( $waarde : Value( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("wachter", "rang", false), $invoer));
end

