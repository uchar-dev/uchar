// hij grondY heeft
function boolean toets_defaultsAJutterHeffingDefault000(Object $grondY) {
    return ComputeHelpers.characteristic($grondY, Boolean.TRUE);
}

rule "defaults A:Jutter.heffing: default 0.0.0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $grondY : (ComputeHelpers.holds(grondY)) )
    eval( toets_defaultsAJutterHeffingDefault000($grondY) )
then
    // 10.00
    Object v = new java.math.BigDecimal("10");
    if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults A:Jutter.heffing", 1, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

