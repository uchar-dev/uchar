// zijn grondslag maal 2
function Object afloop_defaultsAWrakrechtUitkeringDefault2(Object $grondslag) {
    try {
        return RegelSpraakRuntime.rsMaal($grondslag, new java.math.BigDecimal("2"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "defaults A:Wrakrecht.uitkering: default 2"
