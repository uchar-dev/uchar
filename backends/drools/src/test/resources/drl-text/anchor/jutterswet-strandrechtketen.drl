rule "uitkeringstotaal van een kustgemeente: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Kustgemeente()
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( registrerendeKustgemeente == $vouwonderwerp )
    $stand_1 : State( attribute == ElementKey.of("strandrecht", "uitkering", false), subject == $onderwerp, $uitkering : value )
then
    Object v = ComputeHelpers.contribution("uitkeringstotaal van een kustgemeente: vouw 0", $vouwonderwerp, $onderwerp, $uitkering, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "registertal van een kustgemeente: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Kustgemeente()
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( registrerendeKustgemeente == $vouwonderwerp )
then
    insertLogical(new Contribution("registertal van een kustgemeente: vouw 1", $vouwonderwerp, $onderwerp, null));
end

rule "stand Strandrecht.uitkering: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht()
    $waarde : Value( attribute == ElementKey.of("strandrecht", "uitkering", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandrecht", "uitkering", false), $v));
end

rule "stand Strandrecht.uitkering: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( $invoer : uitkering )
    not( $waarde : Value( attribute == ElementKey.of("strandrecht", "uitkering", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandrecht", "uitkering", false), $invoer));
end

