when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakrecht( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Wrakrecht"), $grondslag : grondslag )
    not( $hoger_27 : Decides( stack == "defaults A:Wrakrecht.uitkering" && index < 2, subject == $onderwerp ) )
then
    Object v = afloop_defaultsAWrakrechtUitkeringDefault2($grondslag);
