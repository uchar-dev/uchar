// de Penning is uitgereikt
function boolean toets_penningcontrole(Object $uitgereikt) {
    return ComputeHelpers.not(ComputeHelpers.characteristic($uitgereikt, Boolean.TRUE));
}

rule "penningcontrole"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penning()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("penning", "uitgereikt", true), subject == $onderwerp, $uitgereikt : holds )
    eval( toets_penningcontrole($uitgereikt) )
then
    insertLogical(ComputeHelpers.inconsistency("penningcontrole", $onderwerp, ComputeHelpers.list1("EF-025")));
end

// het aantal houder van de Penning is groter of gelijk aan 1
function boolean toets_houderscontrole(Object $aantal_vouw_38) {
    return ComputeHelpers.not(RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.countOf($aantal_vouw_38), new java.math.BigDecimal("1"), ">="));
}

rule "houderscontrole"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penning()
    accumulate( $bijdrage_vouw_35 : Contribution( fold == "houderscontrole: vouw 3", subject == $onderwerp ); $aantal_vouw_38 : count() )
    eval( toets_houderscontrole($aantal_vouw_38) )
then
    insertLogical(ComputeHelpers.inconsistency("houderscontrole", $onderwerp, ComputeHelpers.list1("EF-025")));
end

function boolean beta_penningVoorEenGerechtigdeJutter(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// de Jutter is penninggerechtigd
function boolean toets_penningVoorEenGerechtigdeJutter(Object $penninggerechtigd) {
    return ComputeHelpers.characteristic($penninggerechtigd, Boolean.TRUE);
}

// de vondstwaarde van de Jutter; waar
function Object creatie_penningVoorEenGerechtigdeJutter(Object $vondstwaarde, Object $fase, Object $herkomsten_creatie_42, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("penning voor een gerechtigde jutter", 0, "Jutter", (java.util.List) $herkomsten_creatie_42, 100);
    Object i0 = null;
    Object i1 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($vondstwaarde, Integer.valueOf(0), "bedrag", "penning voor een gerechtigde jutter"));
        i1 = ComputeHelpers.collapse(Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Penning");
    ComputeHelpers.set(nieuw, "bedrag", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("penning voor een gerechtigde jutter", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("penningbezit", $onderwerp, nieuw, fase));
    feiten.add(Boolean.TRUE.equals(i1) ? new HasCharacteristic(nieuw, ElementKey.of("penning", "uitgereikt", true)) : null);
    return feiten;
}

rule "penning voor een gerechtigde jutter"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $penninggerechtigd : (ComputeHelpers.holds(penninggerechtigd)), $vondstwaarde : vondstwaarde )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_41 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_42 : collectList($herkomst_creatie_41) )
    not( $gemaakt_creatie_44 : CreationStamp( rule == "penning voor een gerechtigde jutter", subject == $onderwerp ) )
    not( $nieuw_creatie_45 : CreationStamp( object == $onderwerp, beta_penningVoorEenGerechtigdeJutter(this, $fase) ) )
    eval( toets_penningVoorEenGerechtigdeJutter($penninggerechtigd) )
    not( $eigen_fout : Fault( rule == "penning voor een gerechtigde jutter", subject == $onderwerp ) )
then
    Object v = creatie_penningVoorEenGerechtigdeJutter($vondstwaarde, $fase, $herkomsten_creatie_42, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "penning voor een gerechtigde jutter", ComputeHelpers.designate(v, "penning voor een gerechtigde jutter")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
        if (feiten.get(3) != null) {
            insert(feiten.get(3));
        }
    }
end

