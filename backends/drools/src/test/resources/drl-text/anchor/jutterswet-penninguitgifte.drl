rule "stand Penning.bedrag: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penning()
    $waarde : Value( attribute == ElementKey.of("penning", "bedrag", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("penning", "bedrag", false), $v));
end

rule "stand Penning.bedrag: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penning( $invoer : bedrag )
    not( $waarde : Value( attribute == ElementKey.of("penning", "bedrag", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("penning", "bedrag", false), $invoer));
end

rule "kenmerkstand Penning.uitgereikt: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penning( ComputeHelpers.holds(uitgereikt) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("penning", "uitgereikt", true), true));
end

rule "kenmerkstand Penning.uitgereikt: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penning()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("penning", "uitgereikt", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("penning", "uitgereikt", true), true));
end

rule "kenmerkstand Penning.uitgereikt: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penning( ComputeHelpers.holds(uitgereikt) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("penning", "uitgereikt", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("penning", "uitgereikt", true), false));
end

