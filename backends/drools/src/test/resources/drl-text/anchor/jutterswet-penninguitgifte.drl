function Object creatie_dossierVoorEenGerechtigdeJutter(Object $fase, Object $herkomsten_creatie_55, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("dossier voor een gerechtigde jutter", 0, "Jutter", (java.util.List) $herkomsten_creatie_55, 100);
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Dossier");
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("dossier voor een gerechtigde jutter", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("dossiervoering", $onderwerp, nieuw, fase));
    return feiten;
}

rule "dossier voor een gerechtigde jutter"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( dossier == null, $penninggerechtigd : (ComputeHelpers.holds(penninggerechtigd)) )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_54 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_55 : collectList($herkomst_creatie_54) )
    not( $gemaakt_creatie_57 : CreationStamp( rule == "dossier voor een gerechtigde jutter", subject == $onderwerp ) )
    not( $nieuw_creatie_58 : CreationStamp( object == $onderwerp, beta_dossierVoorEenGerechtigdeJutter(this, $fase) ) )
    eval( toets_dossierVoorEenGerechtigdeJutter($penninggerechtigd) )
    not( $eigen_fout : Fault( rule == "dossier voor een gerechtigde jutter", subject == $onderwerp ) )
then
    Object v = creatie_dossierVoorEenGerechtigdeJutter($fase, $herkomsten_creatie_55, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "dossier voor een gerechtigde jutter", ComputeHelpers.designate(v, "dossier voor een gerechtigde jutter")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

rule "aantal penningen van een jutter: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Penning()
    exists( $koppeling_bereik_0 : RelationLink( relation == "penningbezit", second == $onderwerp, first == $vouwonderwerp ) )
then
    insertLogical(new Contribution("aantal penningen van een jutter: vouw 0", $vouwonderwerp, $onderwerp, null));
end

rule "penningtotaal van een jutter: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Penning()
    exists( $koppeling_bereik_8 : RelationLink( relation == "penningbezit", second == $onderwerp, first == $vouwonderwerp ) )
    $stand_1 : State( attribute == ElementKey.of("penning", "bedrag", false), subject == $onderwerp, $bedrag : value )
then
    Object v = ComputeHelpers.contribution("penningtotaal van een jutter: vouw 1", $vouwonderwerp, $onderwerp, $bedrag, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

