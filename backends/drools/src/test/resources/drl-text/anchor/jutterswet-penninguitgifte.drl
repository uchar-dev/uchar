rule "koppeling penningbezit uit de invoer: Penning.houder"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Penning( houder != null, $ander : houder )
then
    insertLogical(new RelationLink("penningbezit", $ander, $houder, 0));
end

function boolean beta_koppelingPenningbezitTweedeVullingVanHouder(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling penningbezit: tweede vulling van houder"
    dialect "mvel"
when
    $een : RelationLink( relation == "penningbezit", $nabij : second )
    $twee : RelationLink( relation == "penningbezit", second != null, second == $een.second, beta_koppelingPenningbezitTweedeVullingVanHouder(this, $een) )
then
    insertLogical(new Fault($nabij, "penningbezit", new SecondFillingFault("houder", $nabij)));
end

