// het aantal penningen van de Jutter
function Object waarde_aantalPenningenVanEenJutter(Object $aantal_vouw_7) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_7), Integer.valueOf(0), "aantal penningen", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aantal penningen van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_4 : Contribution( fold == "aantal penningen van een jutter: vouw 0", subject == $onderwerp ); $aantal_vouw_7 : count() )
then
    Object v = waarde_aantalPenningenVanEenJutter($aantal_vouw_7);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aantal penningen van een jutter", ComputeHelpers.designate(v, "aantal penningen van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aantal penningen", false), v, "aantal penningen van een jutter"));
        }
    }
end

// de som van het bedrag van alle penningen van de Jutter of 0 als die er niet zijn
function Object waarde_penningtotaalVanEenJutter(Object $aantal_vouw_17, Object $vouw_vouw_19) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_17, $vouw_vouw_19, new java.math.BigDecimal("0")), Integer.valueOf(0), "penningtotaal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "penningtotaal van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_14 : Contribution( fold == "penningtotaal van een jutter: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_18 : value ); $aantal_vouw_17 : count(), $vouw_vouw_19 : exactSum($bijdragewaarde_vouw_18) )
then
    Object v = waarde_penningtotaalVanEenJutter($aantal_vouw_17, $vouw_vouw_19);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "penningtotaal van een jutter", ComputeHelpers.designate(v, "penningtotaal van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "penningtotaal", false), v, "penningtotaal van een jutter"));
        }
    }
end

