rule "stand Rekenkamer.grondslag: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer()
    $waarde : Value( attribute == ElementKey.of("rekenkamer", "grondslag", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("rekenkamer", "grondslag", false), $v));
