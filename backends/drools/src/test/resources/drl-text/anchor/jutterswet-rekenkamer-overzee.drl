    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer( ComputeHelpers.holds(overzees) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("rekenkamer", "overzees", true), subject == $onderwerp ) )
then
