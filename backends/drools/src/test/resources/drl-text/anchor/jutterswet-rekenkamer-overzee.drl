rule "stand Rekenkamer.heffing: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer( $invoer : heffing )
    not( $waarde : Value( attribute == ElementKey.of("rekenkamer", "heffing", false), subject == $onderwerp ) )
