rule "stand Rekenkamer.grondslag: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer( $invoer : grondslag )
    not( $waarde : Value( attribute == ElementKey.of("rekenkamer", "grondslag", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("rekenkamer", "grondslag", false), $invoer));
