function boolean toets_eenmaligNummerSleutelVanStrandvondst1(Object $tijdlijn_0) {
    return ComputeHelpers.bucketScalar($tijdlijn_0, Boolean.FALSE);
}

function java.util.List componenten_eenmaligNummerSleutelVanStrandvondst1(Object $tijdlijn_0) {
    java.util.List waarden = new java.util.ArrayList();
    waarden.add($tijdlijn_0);
    return waarden;
}

rule "eenmalig nummer: sleutel van Strandvondst 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandvondst()
    $stand_0 : State( attribute == ElementKey.of("strandvondst", "vondstnummer", false), subject == $onderwerp, $tijdlijn_0 : value )
    eval( toets_eenmaligNummerSleutelVanStrandvondst1($tijdlijn_0) )
then
    for (Object k : ComputeHelpers.uniquenessKeys("eenmalig nummer", 0, $onderwerp, null, componenten_eenmaligNummerSleutelVanStrandvondst1($tijdlijn_0), 0)) {
        insertLogical(k);
    }
end

function boolean toets_eenmaligNummerSleutelvormVanStrandvondst1(Object $tijdlijn_0) {
    return ComputeHelpers.bucketScalar($tijdlijn_0, Boolean.TRUE);
}

rule "eenmalig nummer: sleutelvorm van Strandvondst 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandvondst()
    $stand_0 : State( attribute == ElementKey.of("strandvondst", "vondstnummer", false), subject == $onderwerp, $tijdlijn_0 : value )
    eval( toets_eenmaligNummerSleutelvormVanStrandvondst1($tijdlijn_0) )
then
    insertLogical(new Fault($onderwerp, "eenmalig nummer", ComputeHelpers.inputFormFault("vondstnummer", "the ever-unique key \"vondstnummer\" needs the full timeline; ", $onderwerp, " supplies only a scalar (ch. 5.9)", "eenmalig nummer")));
end

function boolean beta_eenmaligNummer(Object eigen, Object ander) {
    return ComputeHelpers.collidesWith(eigen, ander);
}

function boolean toets_eenmaligNummer(Object $botsingen) {
    return ComputeHelpers.duplicate($botsingen);
}

rule "eenmalig nummer"
    dialect "mvel"
when
    $sleutel : UniquenessKey( uniqueness == "eenmalig nummer", $element : element )
    accumulate( $ander : UniquenessKey( uniqueness == "eenmalig nummer", beta_eenmaligNummer(this, $sleutel) ); $botsingen : count() )
    eval( toets_eenmaligNummer($botsingen) )
then
    insertLogical(new UniquenessViolation("eenmalig nummer", $element));
end

rule "eenmalig nummer: kanaal"
    dialect "mvel"
when
    $schending : UniquenessViolation( uniqueness == "eenmalig nummer", $subject : element )
then
    insertLogical(ComputeHelpers.inconsistency("eenmalig nummer", $subject, ComputeHelpers.list1("EF-026")));
end

function boolean toets_kavelPerKustSleutelVanStrandvondst1(Object $tijdlijn_0, Object $kust) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.bucketScalar($tijdlijn_0, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($kust, Boolean.FALSE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

