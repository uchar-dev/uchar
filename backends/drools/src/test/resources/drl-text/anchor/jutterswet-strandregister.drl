rule "stand Strandvondst.vondstnummer: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandvondst( $invoer : (ComputeHelpers.periods(vondstnummer)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("strandvondst", "vondstnummer", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("strandvondst", "vondstnummer", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandvondst", "vondstnummer", false), $invoer));
end

