package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.EvaluationDate;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.time.LocalDate rekendatum;

// de aangiftewaarde van de Jutaangifte vermeerderd met 30
function Object waarde_jutheffingNaarJaartarief1(Object $aangiftewaarde) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($aangiftewaarde, new java.math.BigDecimal("30")), Integer.valueOf(0), "jutheffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jutheffing naar jaartarief #1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutaangifte( $aangiftewaarde : aangiftewaarde )
    $geldigheid_0 : EvaluationDate( ComputeHelpers.inside(date, "2025-01-01", "2025-12-31") )
then
    Object v = waarde_jutheffingNaarJaartarief1($aangiftewaarde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jutheffing naar jaartarief #1", ComputeHelpers.designate(v, "jutheffing naar jaartarief #1")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutaangifte", "jutheffing", false), v, "jutheffing naar jaartarief #1"));
        }
    }
end

rule "jutheffing naar jaartarief #1: geen rekendatum"
    dialect "mvel"
when
    $rekendatum : EvaluationDate( date == null )
then
    insertLogical(new Fault($rekendatum, "jutheffing naar jaartarief #1", ComputeHelpers.computeFault("a validity-bounded form needs an evaluation date; this session is time-free", "jutheffing naar jaartarief #1")));
end

