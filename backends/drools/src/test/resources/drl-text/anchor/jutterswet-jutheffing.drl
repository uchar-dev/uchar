// de aangiftewaarde van de Jutaangifte vermeerderd met 1
function Object waarde_registratiegetalBijAangifte(Object $aangiftewaarde) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($aangiftewaarde, new java.math.BigDecimal("1")), Integer.valueOf(0), "registratiegetal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "registratiegetal bij aangifte"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutaangifte( $aangiftewaarde : aangiftewaarde )
then
    Object v = waarde_registratiegetalBijAangifte($aangiftewaarde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "registratiegetal bij aangifte", ComputeHelpers.designate(v, "registratiegetal bij aangifte")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutaangifte", "registratiegetal", false), v, "registratiegetal bij aangifte"));
        }
    }
end

function boolean toets_schrijversJutaangifteJutheffingVerschil(Object $waarden) {
    return ComputeHelpers.differ($waarden);
}

rule "schrijvers Jutaangifte.jutheffing: verschil"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutaangifte()
    accumulate( $waarde : Value( attribute == ElementKey.of("jutaangifte", "jutheffing", false), subject == $onderwerp ); $waarden : collectList($waarde) )
    eval( toets_schrijversJutaangifteJutheffingVerschil($waarden) )
then
    insertLogical(ComputeHelpers.writersConflict($onderwerp, $waarden, "jutheffing", ComputeHelpers.list3("jutheffing naar jaartarief #1", "jutheffing naar jaartarief #2", "registratiegetal bij aangifte"), ComputeHelpers.list1("Jutaangifte"), ComputeHelpers.list1("Jutaangifte")));
end

rule "rekendatumstand"
    dialect "mvel"
when
then
    insertLogical(new EvaluationDate(rekendatum));
end

