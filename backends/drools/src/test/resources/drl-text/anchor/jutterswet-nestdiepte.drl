function Object conflict_defaultsAJutterHeffingDoorgevenWortel(Object $sleutel) {
    return $sleutel;
}

rule "defaults A:Jutter.heffing: doorgeven wortel"
    dialect "mvel"
when
    $conflict : Outcome( stack == "defaults A:Jutter.heffing" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.CONFLICT && chain >= 0 && chain < 1, $onderwerp : subject, $sleutel : key )
then
    Object v = conflict_defaultsAJutterHeffingDoorgevenWortel($sleutel);
    insertLogical(ComputeHelpers.inconsistency((String) v, $onderwerp, ComputeHelpers.list1("EF-027")));
end

rule "defaults A:Jutter.heffing: eens wortel"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Jutter.heffing" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 0 && chain < 1, $onderwerp : subject, $waarde : value )
then
    Object v = $waarde;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "heffing");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Jutter.heffing", ComputeHelpers.designate(passend, "defaults A:Jutter.heffing")));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "heffing", false), passend, "defaults A:Jutter.heffing"));
        }
    }
end

