    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Jutter.heffing" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 3 && chain < 5, $onderwerp : subject )
    not( $uitkomst_7 : Outcome( stack == "defaults A:Jutter.heffing" && chain >= 3 && chain < 5 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta1_defaultsAJutterHeffingVerschil010(this, $besluit) ) )
    exists( $uitkomst_10 : Outcome( stack == "defaults A:Jutter.heffing" && chain >= 3 && chain < 5 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta2_defaultsAJutterHeffingVerschil010(this, $besluit) ) )
then
    Object v = conflict_defaultsAJutterHeffingVerschil010();
    insertLogical(new Outcome($onderwerp, "defaults A:Jutter.heffing", 2, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.CONFLICT, null, (String) v));
end

