rule "kavelaantal van een gemeente: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Gemeente()
    $onderwerp : dev.uchar.regelspraak.facts.Kavel( gemeente == $vouwonderwerp )
then
    insertLogical(new Contribution("kavelaantal van een gemeente: vouw 0", $vouwonderwerp, $onderwerp, null));
end

