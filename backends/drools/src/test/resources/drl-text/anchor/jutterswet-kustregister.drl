package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.UniquenessKey;
import dev.uchar.regelspraak.transpiler.tms.UniquenessViolation;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het aantal kavels van de Gemeente
function Object waarde_kavelaantalVanEenGemeente(Object $aantal_vouw_4) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_4), Integer.valueOf(0), "kavelaantal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "kavelaantal van een gemeente"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Gemeente()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "kavelaantal van een gemeente: vouw 0", subject == $onderwerp ); $aantal_vouw_4 : count() )
then
    Object v = waarde_kavelaantalVanEenGemeente($aantal_vouw_4);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "kavelaantal van een gemeente", ComputeHelpers.designate(v, "kavelaantal van een gemeente")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("gemeente", "kavelaantal", false), v, "kavelaantal van een gemeente"));
        }
    }
end

function boolean toets_eenmaligKaveletiketSleutelVanKavel1(Object $etiket, Object $gemeente) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($etiket, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($gemeente, Boolean.FALSE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

function java.util.List componenten_eenmaligKaveletiketSleutelVanKavel1(Object $etiket, Object $gemeente) {
    java.util.List waarden = new java.util.ArrayList();
    waarden.add($etiket);
    return waarden;
}

rule "eenmalig kaveletiket: sleutel van Kavel 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kavel( $etiket : etiket, $gemeente : gemeente )
    eval( toets_eenmaligKaveletiketSleutelVanKavel1($etiket, $gemeente) )
then
    for (Object k : ComputeHelpers.uniquenessKeys("eenmalig kaveletiket", 0, $onderwerp, $gemeente, componenten_eenmaligKaveletiketSleutelVanKavel1($etiket, $gemeente), -1)) {
        insertLogical(k);
    }
end

function boolean beta_eenmaligKaveletiket(Object eigen, Object ander) {
    return ComputeHelpers.collidesWith(eigen, ander);
}

function boolean toets_eenmaligKaveletiket(Object $botsingen) {
    return ComputeHelpers.duplicate($botsingen);
}

rule "eenmalig kaveletiket"
    dialect "mvel"
when
    $sleutel : UniquenessKey( uniqueness == "eenmalig kaveletiket", $element : element )
    accumulate( $ander : UniquenessKey( uniqueness == "eenmalig kaveletiket", beta_eenmaligKaveletiket(this, $sleutel) ); $botsingen : count() )
    eval( toets_eenmaligKaveletiket($botsingen) )
then
    insertLogical(new UniquenessViolation("eenmalig kaveletiket", $element));
end

rule "eenmalig kaveletiket: kanaal"
    dialect "mvel"
when
    $schending : UniquenessViolation( uniqueness == "eenmalig kaveletiket", $subject : element )
then
    insertLogical(ComputeHelpers.inconsistency("eenmalig kaveletiket", $subject, ComputeHelpers.list1("EF-026")));
end

