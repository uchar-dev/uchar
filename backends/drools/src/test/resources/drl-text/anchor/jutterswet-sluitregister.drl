package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;

// zijn telling gelijk is aan zijn opgave
function boolean toets_sluitendRegister(Object $telling, Object $opgave) {
    return RegelSpraakRuntime.rsAggVergelijk($telling, $opgave, "==");
}

rule "sluitend register"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Register( $telling : telling, $opgave : opgave )
    eval( toets_sluitendRegister($telling, $opgave) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("register", "sluitend", true)));
end

// zijn telling ongelijk is aan zijn opgave
function boolean toets_afwijkendRegister(Object $telling, Object $opgave) {
    return RegelSpraakRuntime.rsAggVergelijk($telling, $opgave, "!=");
}

rule "afwijkend register"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Register( $telling : telling, $opgave : opgave )
    eval( toets_afwijkendRegister($telling, $opgave) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("register", "afwijkend", true)));
end

