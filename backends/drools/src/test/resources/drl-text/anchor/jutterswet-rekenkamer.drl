package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.CreationStamp;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de grondslag van de Rekenkamer verminderd met de aftrek van de Rekenkamer
function Object waarde_heffingVanEenRekenkamer(Object $grondslag, Object $aftrek) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsVerminderd($grondslag, $aftrek), Integer.valueOf(0), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffing van een rekenkamer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Rekenkamer()
    $stand_0 : State( attribute == ElementKey.of("rekenkamer", "grondslag", false), subject == $onderwerp, $grondslag : value )
    $stand_1 : State( attribute == ElementKey.of("rekenkamer", "aftrek", false), subject == $onderwerp, $aftrek : value )
then
    Object v = waarde_heffingVanEenRekenkamer($grondslag, $aftrek);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing van een rekenkamer", ComputeHelpers.designate(v, "heffing van een rekenkamer")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("rekenkamer", "heffing", false), v, "heffing van een rekenkamer"));
        }
    }
end

// de heffing van haar rekenkamer
function Object waarde_heffingVanEenJutter(Object $rekenkamerHeffing) {
    try {
        return ComputeHelpers.fitTarget($rekenkamerHeffing, Integer.valueOf(0), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffing van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $padstand_0 : PathState( path == "Jutter:rekenkamer" && member == ElementKey.of("rekenkamer", "heffing", false), subject == $onderwerp, $rekenkamerHeffing : value )
then
    Object v = waarde_heffingVanEenJutter($rekenkamerHeffing);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing van een jutter", ComputeHelpers.designate(v, "heffing van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "heffing", false), v, "heffing van een jutter"));
        }
    }
end

function boolean beta_richtDeRekenkamerOp(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// de grondslag van de Jutter; de aftrek van de Jutter
function Object creatie_richtDeRekenkamerOp(Object $grondslag, Object $aftrek, Object $fase, Object $herkomsten_creatie_8, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("richt de rekenkamer op", 0, "Jutter", (java.util.List) $herkomsten_creatie_8, 100);
    Object i0 = null;
    Object i1 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($grondslag, Integer.valueOf(0), "grondslag", "richt de rekenkamer op"));
        i1 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($aftrek, Integer.valueOf(0), "aftrek", "richt de rekenkamer op"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Rekenkamer");
    ComputeHelpers.set(nieuw, "grondslag", i0);
    ComputeHelpers.set(nieuw, "aftrek", i1);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("richt de rekenkamer op", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("taxatieopdracht", $onderwerp, nieuw, fase));
    return feiten;
}

rule "richt de rekenkamer op"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( rekenkamer == null, $grondslag : grondslag, $aftrek : aftrek )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_7 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_8 : collectList($herkomst_creatie_7) )
    not( $gemaakt_creatie_10 : CreationStamp( rule == "richt de rekenkamer op", subject == $onderwerp ) )
    not( $nieuw_creatie_11 : CreationStamp( object == $onderwerp, beta_richtDeRekenkamerOp(this, $fase) ) )
    not( $eigen_fout : Fault( rule == "richt de rekenkamer op", subject == $onderwerp ) )
then
    Object v = creatie_richtDeRekenkamerOp($grondslag, $aftrek, $fase, $herkomsten_creatie_8, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "richt de rekenkamer op", ComputeHelpers.designate(v, "richt de rekenkamer op")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

rule "koppeling taxatieopdracht uit de invoer: Jutter.rekenkamer"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Jutter( rekenkamer != null, $ander : rekenkamer )
then
    insertLogical(new RelationLink("taxatieopdracht", $houder, $ander, 0));
end

rule "koppeling taxatieopdracht uit de invoer: Rekenkamer.opdrachtgever"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Rekenkamer( opdrachtgever != null, $ander : opdrachtgever )
then
    insertLogical(new RelationLink("taxatieopdracht", $ander, $houder, 0));
end

function boolean beta_koppelingTaxatieopdrachtTweedeVullingVanRekenkamer(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "second");
}

rule "koppeling taxatieopdracht: tweede vulling van rekenkamer"
    dialect "mvel"
when
    $een : RelationLink( relation == "taxatieopdracht", $nabij : first )
    $twee : RelationLink( relation == "taxatieopdracht", first != null, first == $een.first, beta_koppelingTaxatieopdrachtTweedeVullingVanRekenkamer(this, $een) )
then
    insertLogical(new Fault($nabij, "taxatieopdracht", new SecondFillingFault("rekenkamer", $nabij)));
end

function boolean beta_koppelingTaxatieopdrachtTweedeVullingVanOpdrachtgever(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling taxatieopdracht: tweede vulling van opdrachtgever"
    dialect "mvel"
when
    $een : RelationLink( relation == "taxatieopdracht", $nabij : second )
    $twee : RelationLink( relation == "taxatieopdracht", second != null, second == $een.second, beta_koppelingTaxatieopdrachtTweedeVullingVanOpdrachtgever(this, $een) )
then
    insertLogical(new Fault($nabij, "taxatieopdracht", new SecondFillingFault("opdrachtgever", $nabij)));
end

rule "padstand Jutter.rekenkamer naar Rekenkamer.heffing: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $koppeling_keten_30 : RelationLink( relation == "taxatieopdracht", first == $onderwerp, $overzijde_keten_31 : second )
    $stap_keten_29 : dev.uchar.regelspraak.facts.Rekenkamer( this == $overzijde_keten_31 )
    $stand : State( attribute == ElementKey.of("rekenkamer", "heffing", false), subject == $stap_keten_29, $v : value )
then
    insertLogical(new PathState($onderwerp, "Jutter:rekenkamer", ElementKey.of("rekenkamer", "heffing", false), $v, $stap_keten_29));
end

rule "padstand Jutter.rekenkamer naar Rekenkamer.heffing: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    not( $koppeling_keten_38 : RelationLink( relation == "taxatieopdracht", first == $onderwerp, $overzijde_keten_39 : second ) and $stap_keten_37 : dev.uchar.regelspraak.facts.Rekenkamer( this == $overzijde_keten_39 ) )
then
    insertLogical(new PathState($onderwerp, "Jutter:rekenkamer", ElementKey.of("rekenkamer", "heffing", false), null, null));
end

