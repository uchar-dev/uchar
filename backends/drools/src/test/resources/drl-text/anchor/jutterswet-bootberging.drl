    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("schipper"), java.util.Arrays.asList());
}

rule "laagste kistgewicht van een jutter: bijdrage aan vouw 2"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Kist( $inhoudsgewicht : inhoudsgewicht )
    exists( $tussen_pad_24 : dev.uchar.regelspraak.facts.Boot( beta_laagsteKistgewichtVanEenJutterBijdrageAanVouw2(this, $vouwonderwerp) ) and $tussen_pad_25 : dev.uchar.regelspraak.facts.Vondst() and $padkoppeling_pad_27 : RelationLink( relation == "berging", first == $tussen_pad_24, second == $tussen_pad_25 ) and $padkoppeling_pad_31 : RelationLink( relation == "inpakking", first == $tussen_pad_25, second == $onderwerp ) )
then
    Object v = ComputeHelpers.contribution("laagste kistgewicht van een jutter: vouw 2", $vouwonderwerp, $onderwerp, $inhoudsgewicht, null, null, false, false);
    if (v != null) {
