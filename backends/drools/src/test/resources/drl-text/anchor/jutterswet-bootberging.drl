rule "laagste kistgewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_35 : Contribution( fold == "laagste kistgewicht van een jutter: vouw 2", subject == $onderwerp, $bijdragewaarde_vouw_39 : value ); $aantal_vouw_38 : count(), $vouw_vouw_40 : exactMin($bijdragewaarde_vouw_39) )
then
    Object v = waarde_laagsteKistgewichtVanEenJutter($aantal_vouw_38, $vouw_vouw_40);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "laagste kistgewicht van een jutter", ComputeHelpers.designate(v, "laagste kistgewicht van een jutter")));
