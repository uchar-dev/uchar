            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "laagste kistgewicht", false), v, "laagste kistgewicht van een jutter"));
        }
    }
end

function boolean beta_laagsteVondstgewichtVanEenJutterBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("schipper"), java.util.Arrays.asList());
}

rule "laagste vondstgewicht van een jutter: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht )
    exists( $tussen_pad_0 : dev.uchar.regelspraak.facts.Boot( beta_laagsteVondstgewichtVanEenJutterBijdrageAanVouw0(this, $vouwonderwerp) ) and $padkoppeling_pad_2 : RelationLink( relation == "berging", first == $tussen_pad_0, second == $onderwerp ) )
then
    Object v = ComputeHelpers.contribution("laagste vondstgewicht van een jutter: vouw 0", $vouwonderwerp, $onderwerp, $gewicht, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

function boolean beta_totaalVondstgewichtVanEenJutterBijdrageAanVouw1(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("schipper"), java.util.Arrays.asList());
}

