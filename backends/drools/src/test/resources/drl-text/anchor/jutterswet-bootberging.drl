package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactMinimumFunction exactMin;
import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de minimale waarde van het gewicht van alle geborgen vondsten van alle gevoerde boten van de Jutter
function Object waarde_laagsteVondstgewichtVanEenJutter(Object $aantal_vouw_9, Object $vouw_vouw_11) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_9, $vouw_vouw_11, null), Integer.valueOf(2), "laagste vondstgewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "laagste vondstgewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_6 : Contribution( fold == "laagste vondstgewicht van een jutter: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_10 : value ); $aantal_vouw_9 : count(), $vouw_vouw_11 : exactMin($bijdragewaarde_vouw_10) )
then
    Object v = waarde_laagsteVondstgewichtVanEenJutter($aantal_vouw_9, $vouw_vouw_11);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "laagste vondstgewicht van een jutter", ComputeHelpers.designate(v, "laagste vondstgewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "laagste vondstgewicht", false), v, "laagste vondstgewicht van een jutter"));
        }
    }
end

// de som van het gewicht van alle geborgen vondsten van alle gevoerde boten van de Jutter of 0 als die er niet zijn
function Object waarde_totaalVondstgewichtVanEenJutter(Object $aantal_vouw_21, Object $vouw_vouw_23) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_21, $vouw_vouw_23, new java.math.BigDecimal("0")), Integer.valueOf(2), "totaal vondstgewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "totaal vondstgewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_18 : Contribution( fold == "totaal vondstgewicht van een jutter: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_22 : value ); $aantal_vouw_21 : count(), $vouw_vouw_23 : exactSum($bijdragewaarde_vouw_22) )
then
    Object v = waarde_totaalVondstgewichtVanEenJutter($aantal_vouw_21, $vouw_vouw_23);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "totaal vondstgewicht van een jutter", ComputeHelpers.designate(v, "totaal vondstgewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "totaal vondstgewicht", false), v, "totaal vondstgewicht van een jutter"));
        }
    }
end

// de minimale waarde van het inhoudsgewicht van alle ingepakte kisten van alle geborgen vondsten van alle gevoerde boten van de Jutter
