    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht )
    exists( $tussen_pad_12 : dev.uchar.regelspraak.facts.Boot( beta_totaalVondstgewichtVanEenJutterBijdrageAanVouw1(this, $vouwonderwerp) ) and $padkoppeling_pad_14 : RelationLink( relation == "berging", first == $tussen_pad_12, second == $onderwerp ) )
