function boolean beta1_defaultsKJutterVrijgesteldVerschil0(Object eigen, Object ander) {
    return ComputeHelpers.earlierMember(eigen, ander);
}

function boolean beta2_defaultsKJutterVrijgesteldVerschil0(Object eigen, Object ander) {
    return ComputeHelpers.anotherDecision(eigen, ander);
}

function Object conflict_defaultsKJutterVrijgesteldVerschil0() {
    return "Jutter.vrijgesteld/0";
}

rule "defaults K:Jutter.vrijgesteld: verschil 0"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults K:Jutter.vrijgesteld" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 1 && chain < 3, $onderwerp : subject )
    not( $uitkomst_5 : Outcome( stack == "defaults K:Jutter.vrijgesteld" && chain >= 1 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta1_defaultsKJutterVrijgesteldVerschil0(this, $besluit) ) )
    exists( $uitkomst_8 : Outcome( stack == "defaults K:Jutter.vrijgesteld" && chain >= 1 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta2_defaultsKJutterVrijgesteldVerschil0(this, $besluit) ) )
then
    Object v = conflict_defaultsKJutterVrijgesteldVerschil0();
    insertLogical(new Outcome($onderwerp, "defaults K:Jutter.vrijgesteld", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.CONFLICT, null, (String) v));
end

