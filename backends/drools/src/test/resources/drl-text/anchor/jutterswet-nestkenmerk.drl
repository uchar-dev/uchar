function Object conflict_defaultsKJutterVrijgesteldDoorgevenWortel(Object $sleutel) {
    return $sleutel;
}

rule "defaults K:Jutter.vrijgesteld: doorgeven wortel"
    dialect "mvel"
when
    $conflict : Outcome( stack == "defaults K:Jutter.vrijgesteld" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.CONFLICT && chain >= 0 && chain < 1, $onderwerp : subject, $sleutel : key )
then
    Object v = conflict_defaultsKJutterVrijgesteldDoorgevenWortel($sleutel);
    insertLogical(ComputeHelpers.inconsistency((String) v, $onderwerp, ComputeHelpers.list1("EF-027")));
end

rule "defaults K:Jutter.vrijgesteld: eens wortel"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults K:Jutter.vrijgesteld" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 0 && chain < 1 && value == true, $onderwerp : subject, $waarde : value )
then
    Object v = $waarde;
    if (v != null) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "vrijgesteld", true)));
    }
end

