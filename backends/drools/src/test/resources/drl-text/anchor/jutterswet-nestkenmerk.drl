    not( $uitkomst_15 : Outcome( stack == "defaults K:Jutter.vrijgesteld" && chain >= 1 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta2_defaultsKJutterVrijgesteldEens0(this, $besluit) ) )
