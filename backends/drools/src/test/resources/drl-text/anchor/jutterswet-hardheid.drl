package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Decides;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;

// art. 5: artikel 3 als ware twaalf vervangen door zes
function boolean toets_defaultsKJutterPenninggerechtigdDefault0(Object $hardheidToegepast, Object $aantalAangemeldeVondsten) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($hardheidToegepast, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($aantalAangemeldeVondsten, new java.math.BigDecimal("6"), ">=")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "defaults K:Jutter.penninggerechtigd: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $hardheidToegepast : (ComputeHelpers.holds(hardheidToegepast)), $aantalAangemeldeVondsten : aantalAangemeldeVondsten )
    eval( toets_defaultsKJutterPenninggerechtigdDefault0($hardheidToegepast, $aantalAangemeldeVondsten) )
then
    Object v = Boolean.TRUE;
    if (v != null) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "penninggerechtigd", true)));
        insertLogical(new Decides($onderwerp, "defaults K:Jutter.penninggerechtigd", 0));
    }
end

// ten minste twaalf vondsten heeft aangemeld
function boolean toets_defaultsKJutterPenninggerechtigdDefault1(Object $aantalAangemeldeVondsten) {
    return RegelSpraakRuntime.rsAggVergelijk($aantalAangemeldeVondsten, new java.math.BigDecimal("12"), ">=");
}

rule "defaults K:Jutter.penninggerechtigd: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $aantalAangemeldeVondsten : aantalAangemeldeVondsten )
    not( $hoger_3 : Decides( stack == "defaults K:Jutter.penninggerechtigd" && index < 1, subject == $onderwerp ) )
    eval( toets_defaultsKJutterPenninggerechtigdDefault1($aantalAangemeldeVondsten) )
then
    Object v = Boolean.TRUE;
    if (v != null) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "penninggerechtigd", true)));
        insertLogical(new Decides($onderwerp, "defaults K:Jutter.penninggerechtigd", 1));
    }
end

