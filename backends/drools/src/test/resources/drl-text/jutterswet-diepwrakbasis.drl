function boolean toets_schrijversStrandrechtUitkeringVerschil(Object $waarden) {
    return ComputeHelpers.differ($waarden);
}

rule "schrijvers Strandrecht.uitkering: verschil"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht()
    accumulate( $waarde : Value( attribute == ElementKey.of("strandrecht", "uitkering", false), subject == $onderwerp ); $waarden : collectList($waarde) )
    eval( toets_schrijversStrandrechtUitkeringVerschil($waarden) )
then
    insertLogical(ComputeHelpers.writersConflict($onderwerp, $waarden, "uitkering", ComputeHelpers.list2("uitkering van een strandrecht", "uitkering van een diepwrak"), ComputeHelpers.list3("Strandrecht", "Wrakrecht", "Diepwrak"), ComputeHelpers.list3("Strandrecht", "Wrakrecht", "Diepwrak")));
end

