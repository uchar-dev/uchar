package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het aantal vondsten van de aanmelder
function Object waarde_aantalEigenVondsten(Object $aantal_vouw_4) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_4), Integer.valueOf(0), "aantal eigen vondsten", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aantal eigen vondsten"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "aantal eigen vondsten: vouw 0", subject == $onderwerp ); $aantal_vouw_4 : count() )
then
    Object v = waarde_aantalEigenVondsten($aantal_vouw_4);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aantal eigen vondsten", ComputeHelpers.designate(v, "aantal eigen vondsten")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aantal eigen vondsten", false), v, "aantal eigen vondsten"));
        }
    }
end

rule "aantal eigen vondsten: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( aanmelder == $vouwonderwerp )
then
    insertLogical(new Contribution("aantal eigen vondsten: vouw 0", $vouwonderwerp, $onderwerp, null));
end

