    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "noordgewicht van een jutter", ComputeHelpers.designate(v, "noordgewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "noordgewicht", false), v, "noordgewicht van een jutter"));
        }
    }
end

