package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn vondstgewicht in voorjaar op zuid
function Object waarde_zuidvoorjaarsgewichtVanEenJutter(Object $vondstgewicht) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.cell($vondstgewicht, java.util.Arrays.asList("voorjaar", "zuid")), Integer.valueOf(2), "zuidvoorjaarsgewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "zuidvoorjaarsgewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstgewicht : vondstgewicht )
then
    Object v = waarde_zuidvoorjaarsgewichtVanEenJutter($vondstgewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zuidvoorjaarsgewicht van een jutter", ComputeHelpers.designate(v, "zuidvoorjaarsgewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "zuidvoorjaarsgewicht", false), v, "zuidvoorjaarsgewicht van een jutter"));
        }
    }
end

