// de som van zijn vondstgewicht over alle seizoenen over de stranden in {noord}
function Object waarde_noordgewichtVanEenJutter(Object $vondstgewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsDimSom(ComputeHelpers.map($vondstgewicht), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar", "noord"), java.util.Arrays.asList("zomer", "noord"), java.util.Arrays.asList("najaar", "noord"))), Integer.valueOf(2), "noordgewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

