// zijn vondstgewicht in voorjaar op zuid plus zijn vondstgewicht in zomer en op zuid
function Object waarde_zuidzeeaanvoerVanEenJutter(Object $vondstgewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus(ComputeHelpers.cell($vondstgewicht, java.util.Arrays.asList("voorjaar", "zuid")), ComputeHelpers.cell($vondstgewicht, java.util.Arrays.asList("zomer", "zuid"))), Integer.valueOf(2), "aanvoer[zuid, zee]", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

