    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zuidzeeaanvoer van een jutter", ComputeHelpers.designate(v, "zuidzeeaanvoer van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aanvoer[zuid, zee]", false), v, "zuidzeeaanvoer van een jutter"));
        }
    }
end

function boolean toets_zuidrivieraanvoerVanEenJutter(Object $onderwerp) {
    return ComputeHelpers.emptyTest(ComputeHelpers.cell(ComputeHelpers.readProperty($onderwerp, "aanvoer"), java.util.Arrays.asList("zuid", "rivier")), Boolean.TRUE);
}

// 0 kg
function Object waarde_zuidrivieraanvoerVanEenJutter() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("0"), Integer.valueOf(2), "aanvoer[zuid, rivier]", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "zuidrivieraanvoer van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    not( $andere_schrijver : Value( attribute == ElementKey.of("jutter", "aanvoer[zuid, rivier]", false) && writer != "zuidrivieraanvoer van een jutter", subject == $onderwerp ) )
    eval( toets_zuidrivieraanvoerVanEenJutter($onderwerp) )
then
    Object v = waarde_zuidrivieraanvoerVanEenJutter();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zuidrivieraanvoer van een jutter", ComputeHelpers.designate(v, "zuidrivieraanvoer van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aanvoer[zuid, rivier]", false), v, "zuidrivieraanvoer van een jutter"));
        }
    }
end

