// de som van zijn aanvoer over alle stranden over de herkomsten in {zee}
function Object waarde_zeeaanvoergewichtVanEenJutter(Object $aanvoer, Object $aanvoer2) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsDimSom(ComputeHelpers.map(ComputeHelpers.withCell($aanvoer, java.util.Arrays.asList("zuid", "zee"), $aanvoer2)), java.util.Arrays.asList(java.util.Arrays.asList("noord", "zee"), java.util.Arrays.asList("zuid", "zee"))), Integer.valueOf(2), "zeeaanvoergewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "zeeaanvoergewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $aanvoer : aanvoer )
    $stand_1 : State( attribute == ElementKey.of("jutter", "aanvoer[zuid, zee]", false), subject == $onderwerp, $aanvoer2 : value )
then
    Object v = waarde_zeeaanvoergewichtVanEenJutter($aanvoer, $aanvoer2);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zeeaanvoergewicht van een jutter", ComputeHelpers.designate(v, "zeeaanvoergewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "zeeaanvoergewicht", false), v, "zeeaanvoergewicht van een jutter"));
        }
    }
end

rule "stand Jutter.aanvoer[zuid, zee]: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "aanvoer[zuid, zee]", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "aanvoer[zuid, zee]", false), $v));
end

rule "stand Jutter.aanvoer[zuid, zee]: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : aanvoer )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "aanvoer[zuid, zee]", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "aanvoer[zuid, zee]", false), ComputeHelpers.cell($invoer, java.util.Arrays.asList("zuid", "zee"))));
end

