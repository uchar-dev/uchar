package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.EmptyBarrier;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de toeslag is de meerprijs van de Vondst
function Object waarde_vondstrechtVanEenVondst(Object $meerprijs, Object $grondrecht) {
    try {
        return ComputeHelpers.fitTarget(let_vondstrechtVanEenVondst($meerprijs, $grondrecht), Integer.valueOf(0), "vondstrecht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// de toeslag is de meerprijs van de Vondst
function Object let_vondstrechtVanEenVondst(Object $meerprijs, Object $grondrecht) {
    Object cel_1 = ComputeHelpers.binderCell();
    try {
        return RegelSpraakRuntime.rsPlus($grondrecht, binder_vondstrechtVanEenVondst($meerprijs, $grondrecht, cel_1));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_1);
    }
}

// de meerprijs van de Vondst
function Object binder_vondstrechtVanEenVondst(Object $meerprijs, Object $grondrecht, Object cel_1) {
    if (!ComputeHelpers.binderCellFilled(cel_1)) {
        ComputeHelpers.fillBinderCell(cel_1, $meerprijs);
    }
    return ComputeHelpers.binderValue(cel_1);
}

rule "vondstrecht van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $meerprijs : meerprijs, $grondrecht : grondrecht )
then
    Object v = waarde_vondstrechtVanEenVondst($meerprijs, $grondrecht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vondstrecht van een vondst", ComputeHelpers.designate(v, "vondstrecht van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vondstrecht", false), v, "vondstrecht van een vondst"));
        }
    }
end

