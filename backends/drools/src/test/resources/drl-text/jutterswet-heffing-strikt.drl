package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.LeftOpen;
import dev.uchar.regelspraak.transpiler.tms.OpenInput;
import dev.uchar.regelspraak.transpiler.tms.Outcome;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

global OpenInput open_invoer;

// zijn taxatie gevuld is
function Object oordeel_heffing(Object $taxatie, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.emptyTest(ComputeHelpers.readInput($taxatie, open_invoer, $onderwerp, ElementKey.of("vondst", "taxatie", false)), Boolean.FALSE), false);
}

// 0
function Object waarde_heffing(Object $taxatie, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.decided(oordeel_heffing($taxatie, open_invoer, $onderwerp), () -> ComputeHelpers.fitTarget(new java.math.BigDecimal("0"), Integer.valueOf(0), "heffing", null), null);
}

rule "heffing"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $taxatie : taxatie )
    eval( ComputeHelpers.acts(oordeel_heffing($taxatie, open_invoer, $onderwerp)) )
then
    Object v = waarde_heffing($taxatie, open_invoer, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing", ComputeHelpers.designate(v, "heffing")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "heffing", false), "heffing"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "heffing", false), v, "heffing"));
        }
    }
end

// 25
function Object waarde_heffingAanvankelijk() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("25"), Integer.valueOf(0), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffing aanvankelijk"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( heffing == null )
    not( $andere_schrijver : Value( attribute == ElementKey.of("vondst", "heffing", false) && writer != "heffing aanvankelijk", subject == $onderwerp ) )
    not( $andere_opengelaten : LeftOpen( member == ElementKey.of("vondst", "heffing", false) && writer != "heffing aanvankelijk", subject == $onderwerp ) )
then
    Object v = waarde_heffingAanvankelijk();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing aanvankelijk", ComputeHelpers.designate(v, "heffing aanvankelijk")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "heffing", false), v, "heffing aanvankelijk"));
        }
    }
end

// zijn taxatie leeg is
function Object oordeel_heffingscode(Object $taxatie, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.emptyTest(ComputeHelpers.readInput($taxatie, open_invoer, $onderwerp, ElementKey.of("vondst", "taxatie", false)), Boolean.TRUE), false);
}

// 1
function Object waarde_heffingscode(Object $taxatie, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.decided(oordeel_heffingscode($taxatie, open_invoer, $onderwerp), () -> ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "heffingscode", null), null);
}

rule "heffingscode"
