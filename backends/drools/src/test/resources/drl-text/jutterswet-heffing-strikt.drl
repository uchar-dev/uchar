    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "heffingscode", false), "heffingscode"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "heffingscode", false), v, "heffingscode"));
