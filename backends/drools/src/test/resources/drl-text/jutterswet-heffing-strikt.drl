rule "stand Vondst.heffingscode: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "heffingscode", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "heffingscode", false), $v));
end

rule "stand Vondst.heffingscode: open door een schrijver"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    not( $waarde : Value( attribute == ElementKey.of("vondst", "heffingscode", false), subject == $onderwerp ) )
    exists( $opengelaten : LeftOpen( member == ElementKey.of("vondst", "heffingscode", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "heffingscode", false), ComputeHelpers.open($onderwerp, ElementKey.of("vondst", "heffingscode", false))));
end

rule "stand Vondst.heffingscode: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : heffingscode )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "heffingscode", false), subject == $onderwerp ) )
    not( $opengelaten : LeftOpen( member == ElementKey.of("vondst", "heffingscode", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "heffingscode", false), $invoer));
end

