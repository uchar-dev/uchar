end

// 25 maal zijn heffingscode
function Object waarde_codeheffing(Object $heffingscode) {
    return ComputeHelpers.valued(() -> ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal(new java.math.BigDecimal("25"), ComputeHelpers.read($heffingscode)), Integer.valueOf(0), "codeheffing", null), null);
}

rule "codeheffing"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "heffingscode", false), subject == $onderwerp, $heffingscode : value )
then
    Object v = waarde_codeheffing($heffingscode);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "codeheffing", ComputeHelpers.designate(v, "codeheffing")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "codeheffing", false), "codeheffing"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "codeheffing", false), v, "codeheffing"));
        }
    }
end

// zijn taxatie gevuld is
function Object oordeel_defaultsAVondstStapelheffingDefault0(Object $taxatie, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.emptyTest(ComputeHelpers.readInput($taxatie, open_invoer, $onderwerp, ElementKey.of("vondst", "taxatie", false)), Boolean.FALSE), false);
}

rule "defaults A:Vondst.stapelheffing: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $taxatie : taxatie )
    eval( ComputeHelpers.acts(oordeel_defaultsAVondstStapelheffingDefault0($taxatie, open_invoer, $onderwerp)) )
then
    if (ComputeHelpers.decides(oordeel_defaultsAVondstStapelheffingDefault0($taxatie, open_invoer, $onderwerp))) {
        // 0
        Object v = new java.math.BigDecimal("0");
        if (v != null) {
            insertLogical(new Outcome($onderwerp, "defaults A:Vondst.stapelheffing", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
        }
    } else {
        insertLogical(new Outcome($onderwerp, "defaults A:Vondst.stapelheffing", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN_ONLY, new java.math.BigDecimal("0"), null));
    }
end

rule "defaults A:Vondst.stapelheffing: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst") )
    not( $hoger_12 : Outcome( stack == "defaults A:Vondst.stapelheffing" && chain == 0 && position >= 0 && position < 1 && kind != dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN_ONLY, subject == $onderwerp ) )
then
    // 25
    Object v = new java.math.BigDecimal("25");
    if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults A:Vondst.stapelheffing", 0, 1, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

