rule "defaults A:Vondst.stapelheffing: eens wortel"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Vondst.stapelheffing" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 0 && chain < 1 && position == -1, $onderwerp : subject, $waarde : value )
then
    Object v = $waarde;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "stapelheffing");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.stapelheffing", ComputeHelpers.designate(passend, "defaults A:Vondst.stapelheffing")));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "stapelheffing", false), passend, "defaults A:Vondst.stapelheffing"));
        }
    }
end

