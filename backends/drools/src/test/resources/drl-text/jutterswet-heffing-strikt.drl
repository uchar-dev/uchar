    return ComputeHelpers.anotherDecision(eigen, ander);
}

rule "defaults A:Vondst.stapelheffing: eens keten 0"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Vondst.stapelheffing" && chain == 0 && position >= 0 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, $onderwerp : subject, $waarde : value )
    not( $stap_16 : Outcome( stack == "defaults A:Vondst.stapelheffing" && chain == 0 && position >= 0 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN_ONLY, subject != null, subject == $onderwerp, beta_defaultsAVondstStapelheffingEensKeten0(this, $besluit) ) )
