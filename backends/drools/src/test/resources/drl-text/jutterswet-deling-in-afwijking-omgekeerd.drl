    Object sonde = ComputeHelpers.depositFlag();
    Object v = afloop_defaultsAVondstToeslagTerugval0($toeslaggrond, $geschatteGewicht, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "defaults A:Vondst.toeslag", ComputeHelpers.designate(v, "defaults A:Vondst.toeslag")));
    } else if (v != null) {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("Vondst.toeslag", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        insertLogical(new Outcome($onderwerp, "defaults A:Vondst.toeslag", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

