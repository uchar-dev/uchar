    eval( toets_defaultsAVondstPremieDefault0($premiegrond, $geschatteGewicht) )
then
    // 9,00
    Object v = new java.math.BigDecimal("9");
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "premie");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.premie", ComputeHelpers.designate(passend, "defaults A:Vondst.premie")));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.premie", 0));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "premie", false), passend, "defaults A:Vondst.premie"));
            insertLogical(new Decides($onderwerp, "defaults A:Vondst.premie", 0));
        }
    }
end

