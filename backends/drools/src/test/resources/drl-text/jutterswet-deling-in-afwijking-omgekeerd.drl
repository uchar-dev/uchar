// zijn premiegrond gedeeld door zijn geschatte gewicht groter is dan 1
function boolean toets_defaultsAVondstPremieDefault0(Object $premiegrond, Object $geschatteGewicht) {
    try {
        return RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.divided($premiegrond, $geschatteGewicht, null), new java.math.BigDecimal("1"), ">");
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "defaults A:Vondst.premie: default 0"
    dialect "mvel"
when
