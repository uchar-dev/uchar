// zijn gewogen gewicht gevuld is
function boolean toets_defaultsAVondstVerhoudingDefault0(Object $gewogenGewicht) {
    return ComputeHelpers.emptyTest($gewogenGewicht, Boolean.FALSE);
}

// zijn gewogen gewicht gedeeld door zijn geschatte gewicht rekenkundig afgerond op 2 decimalen
function Object afloop_defaultsAVondstVerhoudingDefault0(Object $gewogenGewicht, Object $geschatteGewicht, Object sonde) {
    try {
        return RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($gewogenGewicht, $geschatteGewicht, sonde), Integer.valueOf(2), java.math.RoundingMode.HALF_UP);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

