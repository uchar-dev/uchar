package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het aantal vondsten van de Jutter
function Object waarde_aantalAangemeldeVondsten(Object $aantal_vouw_4) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_4), Integer.valueOf(0), "aantal aangemelde vondsten", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aantal aangemelde vondsten"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "aantal aangemelde vondsten: vouw 0", subject == $onderwerp ); $aantal_vouw_4 : count() )
then
    Object v = waarde_aantalAangemeldeVondsten($aantal_vouw_4);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aantal aangemelde vondsten", ComputeHelpers.designate(v, "aantal aangemelde vondsten")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aantal aangemelde vondsten", false), v, "aantal aangemelde vondsten"));
        }
    }
end

// het aantal gevulde waarden van het gewicht van alle vondsten van de Jutter
function Object waarde_aantalGewogenVondsten(Object $aantal_vouw_9) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_9), Integer.valueOf(0), "aantal gewogen vondsten", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aantal gewogen vondsten"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_6 : Contribution( fold == "aantal gewogen vondsten: vouw 1", subject == $onderwerp ); $aantal_vouw_9 : count() )
then
    Object v = waarde_aantalGewogenVondsten($aantal_vouw_9);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aantal gewogen vondsten", ComputeHelpers.designate(v, "aantal gewogen vondsten")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aantal gewogen vondsten", false), v, "aantal gewogen vondsten"));
        }
    }
end

rule "aantal aangemelde vondsten: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( aanmelder == $vouwonderwerp )
then
    insertLogical(new Contribution("aantal aangemelde vondsten: vouw 0", $vouwonderwerp, $onderwerp, null));
end

rule "aantal gewogen vondsten: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( aanmelder == $vouwonderwerp, $gewicht : gewicht )
then
    Object v = ComputeHelpers.contribution("aantal gewogen vondsten: vouw 1", $vouwonderwerp, $onderwerp, $gewicht, null, null, true, false);
    if (v != null) {
        insertLogical(v);
    }
end

