rule "stand Jutter.borgdeel: de vereniging van de schrijvers"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(borgdeel)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "borgdeel", false), subject == $onderwerp ) )
    exists( $schrijver : Value( attribute == ElementKey.of("jutter", "borgdeel", false), subject == $onderwerp ) )
    accumulate( $waarde : Value( attribute == ElementKey.of("jutter", "borgdeel", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("jutter", "borgdeel", false), $waarden, $invoer, ComputeHelpers.list2("borgdeel", "wachtsom")));
end

rule "stand Jutter.borgdeel: de vereniging van de schrijvers, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "borgdeel", false), subject == $onderwerp ) )
    exists( $schrijver : Value( attribute == ElementKey.of("jutter", "borgdeel", false), subject == $onderwerp ) )
    accumulate( $waarde : Value( attribute == ElementKey.of("jutter", "borgdeel", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("jutter", "borgdeel", false), $waarden, null, ComputeHelpers.list2("borgdeel", "wachtsom")));
end

