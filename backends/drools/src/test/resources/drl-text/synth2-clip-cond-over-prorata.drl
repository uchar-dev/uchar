when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(bedrag)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "bedrag", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "bedrag", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "bedrag", false), ComputeHelpers.bucketScalarOf($invoer)));
