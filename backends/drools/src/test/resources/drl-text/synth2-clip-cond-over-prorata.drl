    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(borgdeel)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "borgdeel", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "borgdeel", false), subject == $onderwerp ) )
