// hij een vondst heeft
function boolean toets_actief(Object $vullers_rol_25) {
    return ComputeHelpers.roleCount($vullers_rol_25, Boolean.FALSE);
}

rule "actief"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $vuller_rol_24 : dev.uchar.regelspraak.facts.Vondst( vinder == $onderwerp ); $vullers_rol_25 : count() )
    eval( toets_actief($vullers_rol_25) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "actief", true)));
end

// hij geen vondst heeft
function boolean toets_vondstloos(Object $vullers_rol_29) {
