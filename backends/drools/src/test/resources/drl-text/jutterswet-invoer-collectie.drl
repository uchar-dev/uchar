function Object pad_vindpremie(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vinder"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "bonus");
}

// zijn waarde plus de bonus van de vinder van de Vondst
function Object waarde_vindpremie(Object $waarde2, Object $vinderBonus) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($waarde2, $vinderBonus), Integer.valueOf(0), "vindpremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vindpremie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $waarde2 : waarde, $vinderBonus : (pad_vindpremie(this)) )
then
    Object v = waarde_vindpremie($waarde2, $vinderBonus);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vindpremie", ComputeHelpers.designate(v, "vindpremie")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vindpremie", false), v, "vindpremie"));
        }
    }
end

// hij een vondst is
function boolean toets_toegewezen(Object $vinderGezet) {
    return ComputeHelpers.roleField($vinderGezet, Boolean.FALSE);
}

rule "toegewezen"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $vinderGezet : (ComputeHelpers.isSet(vinder, null)) )
    eval( toets_toegewezen($vinderGezet) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "toegewezen", true)));
end

rule "vondstenaantal: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( vinder == $vouwonderwerp )
then
    insertLogical(new Contribution("vondstenaantal: vouw 0", $vouwonderwerp, $onderwerp, null));
end

rule "totale waarde: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( vinder == $vouwonderwerp, $waarde2 : waarde )
then
    Object v = ComputeHelpers.contribution("totale waarde: vouw 1", $vouwonderwerp, $onderwerp, $waarde2, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "keuringenaantal: bijdrage aan vouw 2"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Keuring( keurmeester == $vouwonderwerp )
then
    insertLogical(new Contribution("keuringenaantal: vouw 2", $vouwonderwerp, $onderwerp, null));
end

rule "totaal keurloon: bijdrage aan vouw 3"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Keuring( keurmeester == $vouwonderwerp, $keurloon : keurloon )
then
    Object v = ComputeHelpers.contribution("totaal keurloon: vouw 3", $vouwonderwerp, $onderwerp, $keurloon, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

// de waarde van alle vondsten van de Jutter groter is dan 50
function boolean matrix_louterKostbaarBijdrageAanVouw4(Object $onderwerp, Object $waarde2) {
    return RegelSpraakRuntime.rsAggVergelijk($waarde2, new java.math.BigDecimal("50"), ">");
}

rule "louter kostbaar: bijdrage aan vouw 4"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( vinder == $vouwonderwerp, $waarde2 : waarde )
then
    insertLogical(new Contribution("louter kostbaar: vouw 4", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_louterKostbaarBijdrageAanVouw4($onderwerp, $waarde2))));
end

