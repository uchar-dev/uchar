// zijn gewicht groter is dan 5
function boolean toets_zwaar(Object $gewicht) {
    return RegelSpraakRuntime.rsAggVergelijk($gewicht, new java.math.BigDecimal("5"), ">");
}

rule "zwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht )
    eval( toets_zwaar($gewicht) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "zwaar", true)));
end

function boolean beta_maakEenAfrekening(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// 10% van de som van het gewicht van alle vondsten van de Jutter; (de minimale waarde van het gewicht van alle vondsten van de Jutter) plus 1; de eerste van de vinddag van alle vondsten van de Jutter; het aantal vondsten van de Jutter
function Object creatie_maakEenAfrekening(Object $aantal_vouw_33, Object $vouw_vouw_35, Object $aantal_vouw_40, Object $vouw_vouw_42, Object $aantal_vouw_47, Object $vouw_vouw_49, Object $aantal_vouw_54, Object $fase, Object $herkomsten_creatie_57, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("maak een afrekening", 0, "Jutter", (java.util.List) $herkomsten_creatie_57, 100);
    Object i0 = null;
    Object i1 = null;
    Object i2 = null;
    Object i3 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPercentageVan(new java.math.BigDecimal("10"), ComputeHelpers.foldValue($aantal_vouw_33, $vouw_vouw_35, null)), Integer.valueOf(2), "heffing", "maak een afrekening"));
        i1 = ComputeHelpers.collapse(ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus(ComputeHelpers.foldValue($aantal_vouw_40, $vouw_vouw_42, null), new java.math.BigDecimal("1")), Integer.valueOf(0), "weeggrens", "maak een afrekening"));
        i2 = ComputeHelpers.collapse(ComputeHelpers.foldValue($aantal_vouw_47, $vouw_vouw_49, null));
        i3 = ComputeHelpers.collapse(ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_54), Integer.valueOf(0), "telling", "maak een afrekening"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Afrekening");
    ComputeHelpers.set(nieuw, "heffing", i0);
    ComputeHelpers.set(nieuw, "weeggrens", i1);
    ComputeHelpers.set(nieuw, "afrekendag", i2);
    ComputeHelpers.set(nieuw, "telling", i3);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("maak een afrekening", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("jutterheeftafrekening", $onderwerp, nieuw, fase));
    return feiten;
}

rule "maak een afrekening"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( afrekening == null )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $bijdrage_vouw_30 : Contribution( fold == "maak een afrekening: vouw 2", subject == $onderwerp, $bijdragewaarde_vouw_34 : value ); $aantal_vouw_33 : count(), $vouw_vouw_35 : exactSum($bijdragewaarde_vouw_34) )
    accumulate( $bijdrage_vouw_37 : Contribution( fold == "maak een afrekening: vouw 3", subject == $onderwerp, $bijdragewaarde_vouw_41 : value ); $aantal_vouw_40 : count(), $vouw_vouw_42 : exactMin($bijdragewaarde_vouw_41) )
    accumulate( $bijdrage_vouw_44 : Contribution( fold == "maak een afrekening: vouw 4", subject == $onderwerp, $bijdragewaarde_vouw_48 : value ); $aantal_vouw_47 : count(), $vouw_vouw_49 : exactMin($bijdragewaarde_vouw_48) )
    accumulate( $bijdrage_vouw_51 : Contribution( fold == "maak een afrekening: vouw 5", subject == $onderwerp ); $aantal_vouw_54 : count() )
    accumulate( $herkomst_creatie_56 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_57 : collectList($herkomst_creatie_56) )
    not( $gemaakt_creatie_59 : CreationStamp( rule == "maak een afrekening", subject == $onderwerp ) )
    not( $nieuw_creatie_60 : CreationStamp( object == $onderwerp, beta_maakEenAfrekening(this, $fase) ) )
    not( $eigen_fout : Fault( rule == "maak een afrekening", subject == $onderwerp ) )
then
    Object v = creatie_maakEenAfrekening($aantal_vouw_33, $vouw_vouw_35, $aantal_vouw_40, $vouw_vouw_42, $aantal_vouw_47, $vouw_vouw_49, $aantal_vouw_54, $fase, $herkomsten_creatie_57, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "maak een afrekening", ComputeHelpers.designate(v, "maak een afrekening")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

