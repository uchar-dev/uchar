// de heffing van de afrekening van de Jutter
function Object waarde_heffing(Object $afrekeningHeffing) {
    try {
        return ComputeHelpers.fitTarget($afrekeningHeffing, Integer.valueOf(2), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffing"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $padstand_0 : PathState( path == "Jutter:afrekening" && member == ElementKey.of("afrekening", "heffing", false), subject == $onderwerp, $afrekeningHeffing : value )
then
    Object v = waarde_heffing($afrekeningHeffing);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing", ComputeHelpers.designate(v, "heffing")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "heffing", false), v, "heffing"));
        }
    }
end

