}

// (de laatste van de vinddag van alle vondsten van de Jutter die zwaar zijn) plus 30 dagen
function Object creatie_geefEenZeebrief(Object $aantal_vouw_80, Object $vouw_vouw_82, Object $fase, Object $herkomsten_creatie_85, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("geef een zeebrief", 0, "Jutter", (java.util.List) $herkomsten_creatie_85, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.dateStep(ComputeHelpers.foldValue($aantal_vouw_80, $vouw_vouw_82, null), new java.math.BigDecimal("30"), "DAYS", Boolean.TRUE));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Zeebrief");
    ComputeHelpers.set(nieuw, "slotdag", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("geef een zeebrief", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("jutterheeftzeebrief", $onderwerp, nieuw, fase));
    return feiten;
}

rule "geef een zeebrief"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $bijdrage_vouw_69 : Contribution( fold == "geef een zeebrief: vouw 6", subject == $onderwerp ); $aantal_vouw_72 : count() )
    accumulate( $bijdrage_vouw_77 : Contribution( fold == "geef een zeebrief: vouw 7", subject == $onderwerp, $bijdragewaarde_vouw_81 : value ); $aantal_vouw_80 : count(), $vouw_vouw_82 : exactMax($bijdragewaarde_vouw_81) )
    accumulate( $herkomst_creatie_84 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_85 : collectList($herkomst_creatie_84) )
    not( $gemaakt_creatie_87 : CreationStamp( rule == "geef een zeebrief", subject == $onderwerp ) )
    not( $nieuw_creatie_88 : CreationStamp( object == $onderwerp, beta_geefEenZeebrief(this, $fase) ) )
    eval( toets_geefEenZeebrief($aantal_vouw_72) )
    not( $eigen_fout : Fault( rule == "geef een zeebrief", subject == $onderwerp ) )
then
    Object v = creatie_geefEenZeebrief($aantal_vouw_80, $vouw_vouw_82, $fase, $herkomsten_creatie_85, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "geef een zeebrief", ComputeHelpers.designate(v, "geef een zeebrief")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

