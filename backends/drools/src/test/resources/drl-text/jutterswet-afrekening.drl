when
    $een : RelationLink( relation == "jutterheeftafrekening", $nabij : first )
    $twee : RelationLink( relation == "jutterheeftafrekening", first != null, first == $een.first, beta_koppelingJutterheeftafrekeningTweedeVullingVanAfrekening(this, $een) )
then
    insertLogical(new Fault($nabij, "JutterHeeftAfrekening", new SecondFillingFault("afrekening", $nabij)));
end

