// hij aan alle volgende voorwaarden voldoet: - alle vondsten van de Jutter geen drijfvermogen hebben - ten minste één van de vondsten van de Jutter waardevol is
function boolean toets_duikplichtigeJutter(Object $aantal_vouw_60, Object $vouw_vouw_62, Object $aantal_vouw_67, Object $vouw_vouw_69) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.quantifierVerdict($aantal_vouw_60, $vouw_vouw_62, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0))) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.quantifierVerdict($aantal_vouw_67, $vouw_vouw_69, dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, Integer.valueOf(1))) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "duikplichtige jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_57 : Contribution( fold == "duikplichtige jutter: vouw 7", subject == $onderwerp, $bijdragewaarde_vouw_61 : value ); $aantal_vouw_60 : count(), $vouw_vouw_62 : exactSum($bijdragewaarde_vouw_61) )
    accumulate( $bijdrage_vouw_64 : Contribution( fold == "duikplichtige jutter: vouw 8", subject == $onderwerp, $bijdragewaarde_vouw_68 : value ); $aantal_vouw_67 : count(), $vouw_vouw_69 : exactSum($bijdragewaarde_vouw_68) )
    eval( toets_duikplichtigeJutter($aantal_vouw_60, $vouw_vouw_62, $aantal_vouw_67, $vouw_vouw_69) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "duikplichtig", true)));
end

