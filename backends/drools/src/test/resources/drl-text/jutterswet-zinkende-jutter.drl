end

// alle vondsten van de Jutter geen drijfvermogen hebben
function boolean matrix_zinkendeJutterBijdrageAanVouw0(Object $onderwerp, Object $drijfvermogen) {
    return ComputeHelpers.characteristic($drijfvermogen, Boolean.FALSE);
}

rule "zinkende jutter: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( vinder == $vouwonderwerp, $drijfvermogen : (ComputeHelpers.holds(drijfvermogen)) )
then
    insertLogical(new Contribution("zinkende jutter: vouw 0", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_zinkendeJutterBijdrageAanVouw0($onderwerp, $drijfvermogen))));
end

