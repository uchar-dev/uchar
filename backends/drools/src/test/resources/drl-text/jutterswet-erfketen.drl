package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn vondstwaarde maal 2
function Object waarde_strandloonVanEenJutter(Object $vondstwaarde) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal($vondstwaarde, new java.math.BigDecimal("2")), Integer.valueOf(0), "strandloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "strandloon van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstwaarde : vondstwaarde )
then
    Object v = waarde_strandloonVanEenJutter($vondstwaarde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "strandloon van een jutter", ComputeHelpers.designate(v, "strandloon van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "strandloon", false), v, "strandloon van een jutter"));
        }
    }
end

// zijn strandloon groter is dan 10
function boolean toets_klipbonusVanEenKlipjutter(Object $strandloon) {
    return RegelSpraakRuntime.rsAggVergelijk($strandloon, new java.math.BigDecimal("10"), ">");
}

// zijn strandloon plus 5
function Object waarde_klipbonusVanEenKlipjutter(Object $strandloon) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($strandloon, new java.math.BigDecimal("5")), Integer.valueOf(0), "klipbonus", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "klipbonus van een klipjutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Klipjutter()
    $stand_0 : State( attribute == ElementKey.of("jutter", "strandloon", false), subject == $onderwerp, $strandloon : value )
    eval( toets_klipbonusVanEenKlipjutter($strandloon) )
then
    Object v = waarde_klipbonusVanEenKlipjutter($strandloon);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "klipbonus van een klipjutter", ComputeHelpers.designate(v, "klipbonus van een klipjutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("klipjutter", "klipbonus", false), v, "klipbonus van een klipjutter"));
        }
    }
end

// zijn klimhoogte maal 3
function Object waarde_kliptoeslagVanEenKlipjutter(Object $klimhoogte) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal($klimhoogte, new java.math.BigDecimal("3")), Integer.valueOf(0), "kliptoeslag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "kliptoeslag van een klipjutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Klipjutter( $klimhoogte : klimhoogte )
then
    Object v = waarde_kliptoeslagVanEenKlipjutter($klimhoogte);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "kliptoeslag van een klipjutter", ComputeHelpers.designate(v, "kliptoeslag van een klipjutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "kliptoeslag", false), v, "kliptoeslag van een klipjutter"));
        }
    }
end

// zijn strandloon plus zijn kliptoeslag
function Object waarde_jutterloonVanEenJutter(Object $strandloon, Object $kliptoeslag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($strandloon, $kliptoeslag), Integer.valueOf(0), "jutterloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jutterloon van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $stand_0 : State( attribute == ElementKey.of("jutter", "strandloon", false), subject == $onderwerp, $strandloon : value )
    $stand_1 : State( attribute == ElementKey.of("jutter", "kliptoeslag", false), subject == $onderwerp, $kliptoeslag : value )
then
    Object v = waarde_jutterloonVanEenJutter($strandloon, $kliptoeslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jutterloon van een jutter", ComputeHelpers.designate(v, "jutterloon van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "jutterloon", false), v, "jutterloon van een jutter"));
        }
    }
end

// zijn klimhoogte groter is dan 20
function boolean toets_hoogwerker(Object $klimhoogte) {
    return RegelSpraakRuntime.rsAggVergelijk($klimhoogte, new java.math.BigDecimal("20"), ">");
}

rule "hoogwerker"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Klipjutter( $klimhoogte : klimhoogte )
    eval( toets_hoogwerker($klimhoogte) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "hoogwerker", true)));
end

// hij hoogwerker is
function boolean toets_hoogtepremieVanEenJutter(Object $hoogwerker) {
    return ComputeHelpers.characteristic($hoogwerker, Boolean.TRUE);
}

// 7
function Object waarde_hoogtepremieVanEenJutter() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("7"), Integer.valueOf(0), "hoogtepremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "hoogtepremie van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("jutter", "hoogwerker", true), subject == $onderwerp, $hoogwerker : holds )
    eval( toets_hoogtepremieVanEenJutter($hoogwerker) )
then
    Object v = waarde_hoogtepremieVanEenJutter();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "hoogtepremie van een jutter", ComputeHelpers.designate(v, "hoogtepremie van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "hoogtepremie", false), v, "hoogtepremie van een jutter"));
        }
    }
end

rule "stand Jutter.strandloon: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "strandloon", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "strandloon", false), $v));
end

rule "stand Jutter.strandloon: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : strandloon )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "strandloon", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "strandloon", false), $invoer));
end

rule "stand Jutter.kliptoeslag: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "kliptoeslag", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "kliptoeslag", false), $v));
end

rule "stand Jutter.kliptoeslag: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : kliptoeslag )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "kliptoeslag", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "kliptoeslag", false), $invoer));
end

rule "kenmerkstand Jutter.hoogwerker: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.holds(hoogwerker) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "hoogwerker", true), true));
end

rule "kenmerkstand Jutter.hoogwerker: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("jutter", "hoogwerker", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "hoogwerker", true), true));
end

rule "kenmerkstand Jutter.hoogwerker: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.holds(hoogwerker) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("jutter", "hoogwerker", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "hoogwerker", true), false));
end

