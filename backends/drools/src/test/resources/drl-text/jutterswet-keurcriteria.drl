    var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, 3, null);
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(RegelSpraakRuntime.rsAggVergelijk($gewicht, new java.math.BigDecimal("50"), ">"));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(RegelSpraakRuntime.rsAggVergelijk($lengte, new java.math.BigDecimal("50"), ">"));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(RegelSpraakRuntime.rsAggVergelijk($jaartal, new java.math.BigDecimal("1500"), "<"));
    return lezing.verdict();
}

rule "keuring naar ten hoogste een criterium"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht, $lengte : lengte, $jaartal : jaartal )
    eval( toets_keuringNaarTenHoogsteEenCriterium($gewicht, $lengte, $jaartal) )
then
    insertLogical(ComputeHelpers.inconsistency("keuring naar ten hoogste een criterium", $onderwerp, ComputeHelpers.list1("EF-025")));
end

// Een Vondst moet voldoen aan precies één van de volgende criteria: - zijn gewicht is groter dan 1 - zijn lengte is groter dan 20
function boolean toets_keuringNaarPreciesEenCriterium(Object $gewicht, Object $lengte) {
    return ComputeHelpers.not(Boolean.valueOf(samengesteld_keuringNaarPreciesEenCriterium($gewicht, $lengte)));
