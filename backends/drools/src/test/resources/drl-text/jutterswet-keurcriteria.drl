// Een Vondst moet voldoen aan geen van de volgende criteria: - zijn gewicht is kleiner dan 0 - zijn lengte is kleiner dan 0
function boolean toets_keuringNaarGeenCriterium(Object $gewicht, Object $lengte) {
    return ComputeHelpers.not(Boolean.valueOf(samengesteld_keuringNaarGeenCriterium($gewicht, $lengte)));
}

// Een Vondst moet voldoen aan geen van de volgende criteria: - zijn gewicht is kleiner dan 0 - zijn lengte is kleiner dan 0
