package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Decides;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.ParameterState;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.math.BigDecimal teruggavetermijn;

// zijn claimdatum plus de teruggavetermijn
function Object waarde_teruggaveNaDeClaimdatum(Object $claimdatum, Object $teruggavetermijn) {
    try {
        return ComputeHelpers.dateStep($claimdatum, ComputeHelpers.required($teruggavetermijn, "parameter \"teruggavetermijn\" is unbound in this case (binding is fail-fast, ch. 5.7)"), "DAYS", Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "teruggave na de claimdatum"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $claimdatum : claimdatum )
    $parameter_1 : ParameterState( parameter == "teruggavetermijn", $teruggavetermijn : value )
then
    Object v = waarde_teruggaveNaDeClaimdatum($claimdatum, $teruggavetermijn);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "teruggave na de claimdatum", ComputeHelpers.designate(v, "teruggave na de claimdatum")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "berekende teruggavedatum", false), v, "teruggave na de claimdatum"));
        }
    }
end

// hij aan alle volgende voorwaarden voldoet: - zijn opgegeven teruggavedatum is gevuld - zijn berekende teruggavedatum is gevuld - zijn opgegeven teruggavedatum is ongelijk aan zijn berekende teruggavedatum
function boolean toets_afwijkingOpgaveTeruggavedatum(Object $opgegevenTeruggavedatum, Object $berekendeTeruggavedatum) {
    var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, 3, null);
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.emptyTest($opgegevenTeruggavedatum, Boolean.FALSE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.emptyTest($berekendeTeruggavedatum, Boolean.FALSE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.dateCompare($opgegevenTeruggavedatum, $berekendeTeruggavedatum, dev.uchar.regelspraak.ir.Condition.Operator.ONGELIJK));
    return lezing.verdict();
}

rule "afwijking opgave teruggavedatum"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opgegevenTeruggavedatum : opgegevenTeruggavedatum )
    $stand_1 : State( attribute == ElementKey.of("vondst", "berekende teruggavedatum", false), subject == $onderwerp, $berekendeTeruggavedatum : value )
    eval( toets_afwijkingOpgaveTeruggavedatum($opgegevenTeruggavedatum, $berekendeTeruggavedatum) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true)));
end

// hij heeft geen afwijkende opgave teruggavedatum
function boolean toets_controleOpgaveTeruggavedatum(Object $afwijkendeOpgaveTeruggavedatum) {
    return ComputeHelpers.not(ComputeHelpers.characteristic($afwijkendeOpgaveTeruggavedatum, Boolean.FALSE));
}

rule "controle opgave teruggavedatum"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true), subject == $onderwerp, $afwijkendeOpgaveTeruggavedatum : holds )
    eval( toets_controleOpgaveTeruggavedatum($afwijkendeOpgaveTeruggavedatum) )
then
    insertLogical(ComputeHelpers.inconsistency("controle opgave teruggavedatum", $onderwerp, ComputeHelpers.list1("EF-025")));
end

rule "defaults A:Vondst.teruggavedatum: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $opgegevenTeruggavedatum : opgegevenTeruggavedatum )
then
    // zijn opgegeven teruggavedatum
    Object v = $opgegevenTeruggavedatum;
    if (v != null) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "teruggavedatum", false), v, "defaults A:Vondst.teruggavedatum"));
        insertLogical(new Decides($onderwerp, "defaults A:Vondst.teruggavedatum", 0));
    }
end

rule "defaults A:Vondst.teruggavedatum: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst") )
    $stand_0 : State( attribute == ElementKey.of("vondst", "berekende teruggavedatum", false), subject == $onderwerp, $berekendeTeruggavedatum : value )
    not( $hoger_12 : Decides( stack == "defaults A:Vondst.teruggavedatum" && index < 1, subject == $onderwerp ) )
then
    // zijn berekende teruggavedatum
    Object v = $berekendeTeruggavedatum;
    if (v != null) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "teruggavedatum", false), v, "defaults A:Vondst.teruggavedatum"));
        insertLogical(new Decides($onderwerp, "defaults A:Vondst.teruggavedatum", 1));
    }
end

rule "stand Vondst.berekende teruggavedatum: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "berekende teruggavedatum", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekende teruggavedatum", false), $v));
end

rule "stand Vondst.berekende teruggavedatum: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : berekendeTeruggavedatum )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "berekende teruggavedatum", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekende teruggavedatum", false), $invoer));
end

rule "kenmerkstand Vondst.afwijkende opgave teruggavedatum: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(afwijkendeOpgaveTeruggavedatum) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true), true));
end

rule "kenmerkstand Vondst.afwijkende opgave teruggavedatum: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true), true));
end

rule "kenmerkstand Vondst.afwijkende opgave teruggavedatum: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(afwijkendeOpgaveTeruggavedatum) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "afwijkende opgave teruggavedatum", true), false));
end

rule "parameterstand teruggavetermijn"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("teruggavetermijn", teruggavetermijn));
end

