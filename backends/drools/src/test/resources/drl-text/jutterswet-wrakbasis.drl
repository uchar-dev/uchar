package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Decides;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn grondslag maal 2
function Object waarde_uitkeringVanEenWrakrecht(Object $grondslag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal($grondslag, new java.math.BigDecimal("2")), Integer.valueOf(2), "uitkering", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "uitkering van een wrakrecht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakrecht( ComputeHelpers.classNotIn(this, ComputeHelpers.list1("dev.uchar.regelspraak.facts.Wrakrecht")), $grondslag : grondslag )
then
    Object v = waarde_uitkeringVanEenWrakrecht($grondslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "uitkering van een wrakrecht", ComputeHelpers.designate(v, "uitkering van een wrakrecht")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("strandrecht", "uitkering", false), v, "uitkering van een wrakrecht"));
        }
    }
end

// het Strandrecht betwist is
function boolean toets_defaultsAStrandrechtUitkeringDefault0(Object $betwist) {
    return ComputeHelpers.characteristic($betwist, Boolean.TRUE);
}

rule "defaults A:Strandrecht.uitkering: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Strandrecht"), $betwist : (ComputeHelpers.holds(betwist)) )
    eval( toets_defaultsAStrandrechtUitkeringDefault0($betwist) )
then
    // 99.00
    Object v = new java.math.BigDecimal("99");
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "uitkering");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Strandrecht.uitkering", ComputeHelpers.designate(passend, "defaults A:Strandrecht.uitkering")));
            insertLogical(new Decides($onderwerp, "defaults A:Strandrecht.uitkering", 0));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("strandrecht", "uitkering", false), passend, "defaults A:Strandrecht.uitkering"));
            insertLogical(new Decides($onderwerp, "defaults A:Strandrecht.uitkering", 0));
        }
    }
end

rule "defaults A:Strandrecht.uitkering: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Strandrecht"), $grondslag : grondslag )
    not( $hoger_4 : Decides( stack == "defaults A:Strandrecht.uitkering" && index < 1, subject == $onderwerp ) )
then
    // zijn grondslag
    Object v = $grondslag;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "uitkering");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Strandrecht.uitkering", ComputeHelpers.designate(passend, "defaults A:Strandrecht.uitkering")));
            insertLogical(new Decides($onderwerp, "defaults A:Strandrecht.uitkering", 1));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("strandrecht", "uitkering", false), passend, "defaults A:Strandrecht.uitkering"));
            insertLogical(new Decides($onderwerp, "defaults A:Strandrecht.uitkering", 1));
        }
    }
end

