// zijn grondslag maal 2
function Object afloop_defaultsAWrakrechtUitkeringDefault1(Object $grondslag) {
    try {
        return RegelSpraakRuntime.rsMaal($grondslag, new java.math.BigDecimal("2"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "defaults A:Wrakrecht.uitkering: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakrecht( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Wrakrecht"), $grondslag : grondslag )
    not( $hoger_10 : Decides( stack == "defaults A:Wrakrecht.uitkering" && index < 1, subject == $onderwerp ) )
then
    Object v = afloop_defaultsAWrakrechtUitkeringDefault1($grondslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "defaults A:Wrakrecht.uitkering", ComputeHelpers.designate(v, "defaults A:Wrakrecht.uitkering")));
    } else if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "uitkering");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Wrakrecht.uitkering", ComputeHelpers.designate(passend, "defaults A:Wrakrecht.uitkering")));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakrecht.uitkering", 1));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("strandrecht", "uitkering", false), passend, "defaults A:Wrakrecht.uitkering"));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakrecht.uitkering", 1));
        }
    }
end

