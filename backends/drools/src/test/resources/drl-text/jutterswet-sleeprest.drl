package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.ParameterState;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.math.BigDecimal bergingsfactor;

// 50 min de bergingsfactor maal de sleepafstand van de Berging
function Object waarde_resterendeSleepafstandVanEenBerging(Object $bergingsfactor, Object $sleepafstand) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMin(new java.math.BigDecimal("50"), RegelSpraakRuntime.rsMaal(ComputeHelpers.required($bergingsfactor, "parameter \"bergingsfactor\" is unbound in this case (binding is fail-fast, ch. 5.7)"), $sleepafstand)), Integer.valueOf(2), "resterende sleepafstand", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "resterende sleepafstand van een berging"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging( $sleepafstand : sleepafstand )
    $parameter_0 : ParameterState( parameter == "bergingsfactor", $bergingsfactor : value )
then
    Object v = waarde_resterendeSleepafstandVanEenBerging($bergingsfactor, $sleepafstand);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "resterende sleepafstand van een berging", ComputeHelpers.designate(v, "resterende sleepafstand van een berging")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("berging", "resterende sleepafstand", false), v, "resterende sleepafstand van een berging"));
        }
    }
end

rule "parameterstand bergingsfactor"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("bergingsfactor", bergingsfactor));
end

