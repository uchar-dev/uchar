// de Schuit gekeurd is
function boolean toets_ligprijsVanEenSchuit(Object $gekeurd) {
    return ComputeHelpers.characteristic($gekeurd, Boolean.TRUE);
}

// het kadegeld van de winterhaven van de Schuit
function Object waarde_ligprijsVanEenSchuit(Object $winterhavenKadegeld) {
    try {
        return ComputeHelpers.fitTarget($winterhavenKadegeld, Integer.valueOf(0), "ligprijs", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "ligprijs van een schuit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit( $gekeurd : (ComputeHelpers.holds(gekeurd)) )
    $padstand_1 : PathState( path == "Schuit:winterhaven" && member == ElementKey.of("haven", "kadegeld", false), subject == $onderwerp, $winterhavenKadegeld : value )
    eval( toets_ligprijsVanEenSchuit($gekeurd) )
then
    Object v = waarde_ligprijsVanEenSchuit($winterhavenKadegeld);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "ligprijs van een schuit", ComputeHelpers.designate(v, "ligprijs van een schuit")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schuit", "ligprijs", false), v, "ligprijs van een schuit"));
        }
    }
end

function Object pad_vlagprijsVanEenSchuit(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vlaghaven"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "kadegeld");
}

// het kadegeld van de vlaghaven van de Schuit
function Object waarde_vlagprijsVanEenSchuit(Object $vlaghavenKadegeld) {
    try {
        return ComputeHelpers.fitTarget($vlaghavenKadegeld, Integer.valueOf(0), "vlagprijs", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vlagprijs van een schuit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit( $vlaghavenKadegeld : (pad_vlagprijsVanEenSchuit(this)) )
then
    Object v = waarde_vlagprijsVanEenSchuit($vlaghavenKadegeld);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vlagprijs van een schuit", ComputeHelpers.designate(v, "vlagprijs van een schuit")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schuit", "vlagprijs", false), v, "vlagprijs van een schuit"));
        }
    }
end

function Object pad_vlaglengteVanEenHaven(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vlaggenschip"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "romplengte");
}

