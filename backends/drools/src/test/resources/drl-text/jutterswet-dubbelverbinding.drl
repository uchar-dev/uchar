// de Haven veilig is
function boolean toets_winterbergingDoorDeHaven(Object $veilig) {
    return ComputeHelpers.characteristic($veilig, Boolean.TRUE);
}

function boolean beta_winterbergingDoorDeHaven(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("thuishaven"), java.util.Arrays.asList());
}

rule "winterberging door de haven"
    dialect "mvel"
    agenda-group "uchar-feitcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Haven( $veilig : (ComputeHelpers.holds(veilig)) )
    $geldigheid_0 : EvaluationDate( ComputeHelpers.inside(date, "2026-03-01", null) )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    eval( toets_winterbergingDoorDeHaven($veilig) )
    $stap_keten_27 : dev.uchar.regelspraak.facts.Schuit( beta_winterbergingDoorDeHaven(this, $onderwerp) )
    not( $bestaand_feitcreatie_29 : RelationLink( relation == "winterberging", first == $onderwerp, second == $stap_keten_27 ) )
then
    insert(new RelationLink("winterberging", $onderwerp, $stap_keten_27, $fase));
end

rule "winterberging door de haven: geen rekendatum"
    dialect "mvel"
when
    $rekendatum : EvaluationDate( date == null )
then
    insertLogical(new Fault($rekendatum, "winterberging door de haven", ComputeHelpers.computeFault("a validity-bounded form needs an evaluation date; this session is time-free", "winterberging door de haven")));
end

// het kadegeld van de Haven groter is dan 30
function boolean toets_keurbergingDoorDeHaven(Object $kadegeld) {
    return RegelSpraakRuntime.rsAggVergelijk($kadegeld, new java.math.BigDecimal("30"), ">");
}

function boolean beta_keurbergingDoorDeHaven(Object eigen, Object ander) {
    return ComputeHelpers.notInPhase(eigen, ander);
}

rule "keurberging door de haven"
    dialect "mvel"
    agenda-group "uchar-feitcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Haven( $kadegeld : kadegeld )
    $creatiefase : CreationPhase( stratum >= 1, $fase : number )
    eval( toets_keurbergingDoorDeHaven($kadegeld) )
    $koppeling_keten_37 : RelationLink( relation == "winterberging", first == $onderwerp, beta_keurbergingDoorDeHaven(this, $fase), $overzijde_keten_38 : second )
    $stap_keten_36 : dev.uchar.regelspraak.facts.Schuit( this == $overzijde_keten_38 )
    not( $bestaand_feitcreatie_43 : RelationLink( relation == "keurberging", first == $onderwerp, second == $stap_keten_36 ) )
then
    insert(new RelationLink("keurberging", $onderwerp, $stap_keten_36, $fase));
end

rule "liggertal van een haven: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Haven()
    $onderwerp : dev.uchar.regelspraak.facts.Schuit( thuishaven == $vouwonderwerp )
then
    insertLogical(new Contribution("liggertal van een haven: vouw 0", $vouwonderwerp, $onderwerp, null));
end

rule "wintertal van een haven: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Haven()
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    exists( $koppeling_bereik_5 : RelationLink( relation == "winterberging", second == $onderwerp, first == $vouwonderwerp ) )
then
    insertLogical(new Contribution("wintertal van een haven: vouw 1", $vouwonderwerp, $onderwerp, null));
end

rule "keurtal van een haven: bijdrage aan vouw 2"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Haven()
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    exists( $koppeling_bereik_13 : RelationLink( relation == "keurberging", second == $onderwerp, first == $vouwonderwerp ) )
then
    insertLogical(new Contribution("keurtal van een haven: vouw 2", $vouwonderwerp, $onderwerp, null));
end

rule "koppeling winterberging uit de invoer: Schuit.winterhaven"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Schuit( winterhaven != null, $ander : winterhaven )
then
    insertLogical(new RelationLink("winterberging", $ander, $houder, 0));
end

function boolean beta_koppelingWinterbergingTweedeVullingVanWinterhaven(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling winterberging: tweede vulling van winterhaven"
    dialect "mvel"
when
    $een : RelationLink( relation == "winterberging", $nabij : second )
    $twee : RelationLink( relation == "winterberging", second != null, second == $een.second, beta_koppelingWinterbergingTweedeVullingVanWinterhaven(this, $een) )
then
    insertLogical(new Fault($nabij, "winterberging", new SecondFillingFault("winterhaven", $nabij)));
end

rule "koppeling keurberging uit de invoer: Schuit.keurhaven"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Schuit( keurhaven != null, $ander : keurhaven )
then
    insertLogical(new RelationLink("keurberging", $ander, $houder, 0));
end

function boolean beta_koppelingKeurbergingTweedeVullingVanKeurhaven(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling keurberging: tweede vulling van keurhaven"
    dialect "mvel"
when
    $een : RelationLink( relation == "keurberging", $nabij : second )
    $twee : RelationLink( relation == "keurberging", second != null, second == $een.second, beta_koppelingKeurbergingTweedeVullingVanKeurhaven(this, $een) )
then
    insertLogical(new Fault($nabij, "keurberging", new SecondFillingFault("keurhaven", $nabij)));
end

rule "padstand Schuit.winterhaven naar Haven.kadegeld: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    $koppeling_keten_58 : RelationLink( relation == "winterberging", second == $onderwerp, $overzijde_keten_59 : first )
    $stap_keten_57 : dev.uchar.regelspraak.facts.Haven( this == $overzijde_keten_59, $v : kadegeld )
then
    insertLogical(new PathState($onderwerp, "Schuit:winterhaven", ElementKey.of("haven", "kadegeld", false), $v, $stap_keten_57));
end

rule "padstand Schuit.winterhaven naar Haven.kadegeld: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    not( $koppeling_keten_64 : RelationLink( relation == "winterberging", second == $onderwerp, $overzijde_keten_65 : first ) and $stap_keten_63 : dev.uchar.regelspraak.facts.Haven( this == $overzijde_keten_65 ) )
then
    insertLogical(new PathState($onderwerp, "Schuit:winterhaven", ElementKey.of("haven", "kadegeld", false), null, null));
end

rule "rekendatumstand"
    dialect "mvel"
when
then
    insertLogical(new EvaluationDate(rekendatum));
end

