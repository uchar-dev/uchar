package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

function Object pad_toeslagVanEenSchuit(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("werf"));
    return bereikt == null ? null : ComputeHelpers.periods(ComputeHelpers.readProperty(bereikt, "bedrijvig"));
}

// de werf van de Schuit gedurende het gehele jaar bedrijvig is
function boolean toets_toeslagVanEenSchuit(Object $werfBedrijvig) {
    return ComputeHelpers.wholePeriod($werfBedrijvig, null, "JAAR", Integer.valueOf(7), Boolean.FALSE);
}

// de lengte van de Schuit
function Object waarde_toeslagVanEenSchuit(Object $lengte) {
    try {
        return ComputeHelpers.fitTarget($lengte, Integer.valueOf(2), "toeslag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "toeslag van een schuit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit( $werfBedrijvig : (pad_toeslagVanEenSchuit(this)), $lengte : lengte )
    eval( toets_toeslagVanEenSchuit($werfBedrijvig) )
then
    Object v = waarde_toeslagVanEenSchuit($lengte);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "toeslag van een schuit", ComputeHelpers.designate(v, "toeslag van een schuit")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schuit", "toeslag", false), v, "toeslag van een schuit"));
        }
    }
end

function Object pad_kortingVanEenSchuit(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("werf"));
    return bereikt == null ? null : ComputeHelpers.periods(ComputeHelpers.readProperty(bereikt, "bedrijvig"));
}

// de werf van de Schuit niet gedurende het gehele jaar bedrijvig is
function boolean toets_kortingVanEenSchuit(Object $werfBedrijvig) {
    return ComputeHelpers.wholePeriod($werfBedrijvig, null, "JAAR", Integer.valueOf(7), Boolean.TRUE);
}

// de lengte van de Schuit
function Object waarde_kortingVanEenSchuit(Object $lengte) {
    try {
        return ComputeHelpers.fitTarget($lengte, Integer.valueOf(2), "korting", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "korting van een schuit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit( $werfBedrijvig : (pad_kortingVanEenSchuit(this)), $lengte : lengte )
    eval( toets_kortingVanEenSchuit($werfBedrijvig) )
then
    Object v = waarde_kortingVanEenSchuit($lengte);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "korting van een schuit", ComputeHelpers.designate(v, "korting van een schuit")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schuit", "korting", false), v, "korting van een schuit"));
        }
    }
end

