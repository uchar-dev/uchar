rule "stand Jutter.laadvermogen via boot: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : laadvermogenViaBoot )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "laadvermogen via boot", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "laadvermogen via boot", false), $invoer));
