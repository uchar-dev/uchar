    $waarde : Value( attribute == ElementKey.of("jutter", "vinddag via vondst", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "vinddag via vondst", false), $v));
end

rule "stand Jutter.vinddag via vondst: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : vinddagViaVondst )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "vinddag via vondst", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "vinddag via vondst", false), $invoer));
end

rule "stand Jutter.laadvermogen via boot: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "laadvermogen via boot", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "laadvermogen via boot", false), $v));
