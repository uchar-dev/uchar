    }
}

rule "eerste vinddag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg()
    accumulate( $bijdrage_vouw_16 : Contribution( fold == "eerste vinddag: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_20 : value ); $aantal_vouw_19 : count(), $vouw_vouw_21 : exactMin($bijdragewaarde_vouw_20) )
then
    Object v = waarde_eersteVinddag($aantal_vouw_19, $vouw_vouw_21);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "eerste vinddag", ComputeHelpers.designate(v, "eerste vinddag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("ploeg", "eerste vinddag", false), v, "eerste vinddag"));
        }
    }
end

