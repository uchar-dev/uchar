    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "laadvermogen via boot", ComputeHelpers.designate(v, "laadvermogen via boot")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "laadvermogen via boot", false), v, "laadvermogen via boot"));
        }
    }
end

// aan de volgende voorwaarde voldoen: hij is actief
function boolean toets_zwaarsteGewichtBijdrageAanVouw0(Object $actief) {
    return ComputeHelpers.characteristic($actief, Boolean.TRUE);
}

rule "zwaarste gewicht: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Ploeg()
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ploeg == $vouwonderwerp )
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("jutter", "actief", true), subject == $onderwerp, $actief : holds )
    $stand_2 : State( attribute == ElementKey.of("jutter", "gewicht via vondst en weging", false), subject == $onderwerp, $gewichtViaVondstEnWeging : value )
    eval( toets_zwaarsteGewichtBijdrageAanVouw0($actief) )
then
    Object v = ComputeHelpers.contribution("zwaarste gewicht: vouw 0", $vouwonderwerp, $onderwerp, $gewichtViaVondstEnWeging, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "eerste vinddag: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Ploeg()
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ploeg == $vouwonderwerp )
    $stand_1 : State( attribute == ElementKey.of("jutter", "vinddag via vondst", false), subject == $onderwerp, $vinddagViaVondst : value )
then
    Object v = ComputeHelpers.contribution("eerste vinddag: vouw 1", $vouwonderwerp, $onderwerp, $vinddagViaVondst, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "bootcapaciteit: bijdrage aan vouw 2"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Ploeg()
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ploeg == $vouwonderwerp )
    $stand_1 : State( attribute == ElementKey.of("jutter", "laadvermogen via boot", false), subject == $onderwerp, $laadvermogenViaBoot : value )
then
    Object v = ComputeHelpers.contribution("bootcapaciteit: vouw 2", $vouwonderwerp, $onderwerp, $laadvermogenViaBoot, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

function boolean beta1_vlootcapaciteitBijdrageAanVouw3(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("ploeg"), java.util.Arrays.asList());
}

function boolean beta2_vlootcapaciteitBijdrageAanVouw3(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("boot"), java.util.Arrays.asList());
}

rule "vlootcapaciteit: bijdrage aan vouw 3"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Ploeg()
    $onderwerp : dev.uchar.regelspraak.facts.Boot( $laadvermogen : laadvermogen )
    exists( $tussen_pad_31 : dev.uchar.regelspraak.facts.Jutter( beta1_vlootcapaciteitBijdrageAanVouw3(this, $vouwonderwerp), beta2_vlootcapaciteitBijdrageAanVouw3(this, $onderwerp) ) )
then
    Object v = ComputeHelpers.contribution("vlootcapaciteit: vouw 3", $vouwonderwerp, $onderwerp, $laadvermogen, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "kenmerkstand Jutter.actief: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.holds(actief) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "actief", true), true));
end

rule "kenmerkstand Jutter.actief: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("jutter", "actief", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "actief", true), true));
end

rule "kenmerkstand Jutter.actief: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.holds(actief) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("jutter", "actief", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("jutter", "actief", true), false));
end

rule "stand Jutter.gewicht via vondst en weging: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "gewicht via vondst en weging", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "gewicht via vondst en weging", false), $v));
end

rule "stand Jutter.gewicht via vondst en weging: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : gewichtViaVondstEnWeging )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "gewicht via vondst en weging", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "gewicht via vondst en weging", false), $invoer));
end

