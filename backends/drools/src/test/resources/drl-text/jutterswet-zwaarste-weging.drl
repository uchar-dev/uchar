package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactMaximumFunction exactMax;
import accumulate dev.uchar.regelspraak.transpiler.tms.ExactMinimumFunction exactMin;
import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn startdag gevuld is
function boolean toets_actief(Object $startdag) {
    return ComputeHelpers.emptyTest($startdag, Boolean.FALSE);
}

rule "actief"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $startdag : startdag )
    eval( toets_actief($startdag) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "actief", true)));
end

// de maximale waarde van het gewicht van de weging van de vondst van alle jutters van de Ploeg die aan de volgende voorwaarde voldoen: hij is actief
function Object waarde_zwaarsteGewicht(Object $aantal_vouw_10, Object $vouw_vouw_12) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_10, $vouw_vouw_12, null), Integer.valueOf(0), "zwaarste gewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "zwaarste gewicht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg()
    accumulate( $bijdrage_vouw_7 : Contribution( fold == "zwaarste gewicht: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_11 : value ); $aantal_vouw_10 : count(), $vouw_vouw_12 : exactMax($bijdragewaarde_vouw_11) )
then
    Object v = waarde_zwaarsteGewicht($aantal_vouw_10, $vouw_vouw_12);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zwaarste gewicht", ComputeHelpers.designate(v, "zwaarste gewicht")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("ploeg", "zwaarste gewicht", false), v, "zwaarste gewicht"));
        }
    }
end

// de eerste van de vinddag van de vondst van alle jutters van de Ploeg
function Object waarde_eersteVinddag(Object $aantal_vouw_19, Object $vouw_vouw_21) {
    try {
        return ComputeHelpers.foldValue($aantal_vouw_19, $vouw_vouw_21, null);
    } catch (RuntimeException e) {
