function Object pad_gewichtViaVondstEnWeging(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vondst", "weging"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "gewicht");
}

// het gewicht van de weging van de vondst van de Jutter
function Object waarde_gewichtViaVondstEnWeging(Object $vondstWegingGewicht) {
    try {
        return ComputeHelpers.fitTarget($vondstWegingGewicht, Integer.valueOf(0), "gewicht via vondst en weging", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "gewicht via vondst en weging"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstWegingGewicht : (pad_gewichtViaVondstEnWeging(this)) )
then
    Object v = waarde_gewichtViaVondstEnWeging($vondstWegingGewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "gewicht via vondst en weging", ComputeHelpers.designate(v, "gewicht via vondst en weging")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "gewicht via vondst en weging", false), v, "gewicht via vondst en weging"));
        }
    }
end

function Object pad_vinddagViaVondst(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vondst"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "vinddag");
}

rule "vinddag via vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstVinddag : (pad_vinddagViaVondst(this)) )
then
    // de vinddag van de vondst van de Jutter
    Object v = $vondstVinddag;
    if (!ComputeHelpers.isEmpty(v)) {
        insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vinddag via vondst", false), v, "vinddag via vondst"));
    }
end

function Object pad_laadvermogenViaBoot(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("boot"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "laadvermogen");
}

// het laadvermogen van de boot van de Jutter
function Object waarde_laadvermogenViaBoot(Object $bootLaadvermogen) {
    try {
        return ComputeHelpers.fitTarget($bootLaadvermogen, Integer.valueOf(0), "laadvermogen via boot", null);
