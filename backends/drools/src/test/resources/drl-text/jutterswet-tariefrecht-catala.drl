function boolean beta1_defaultsAPenningplichtigeTariefVerschil0(Object eigen, Object ander) {
    return ComputeHelpers.earlierMember(eigen, ander);
}

function boolean beta2_defaultsAPenningplichtigeTariefVerschil0(Object eigen, Object ander) {
    return ComputeHelpers.anotherDecision(eigen, ander);
}

function Object conflict_defaultsAPenningplichtigeTariefVerschil0() {
    return "Penningplichtige.tarief/0";
}

rule "defaults A:Penningplichtige.tarief: verschil 0"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Penningplichtige.tarief" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 1 && chain < 3, $onderwerp : subject )
    not( $uitkomst_7 : Outcome( stack == "defaults A:Penningplichtige.tarief" && chain >= 1 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta1_defaultsAPenningplichtigeTariefVerschil0(this, $besluit) ) )
    exists( $uitkomst_10 : Outcome( stack == "defaults A:Penningplichtige.tarief" && chain >= 1 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta2_defaultsAPenningplichtigeTariefVerschil0(this, $besluit) ) )
then
    Object v = conflict_defaultsAPenningplichtigeTariefVerschil0();
    insertLogical(new Outcome($onderwerp, "defaults A:Penningplichtige.tarief", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.CONFLICT, null, (String) v));
end

