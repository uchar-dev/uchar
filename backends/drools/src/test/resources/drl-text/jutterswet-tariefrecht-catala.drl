    not( $uitkomst_14 : Outcome( stack == "defaults A:Penningplichtige.tarief" && chain >= 1 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta1_defaultsAPenningplichtigeTariefEens0(this, $besluit) ) )
    not( $uitkomst_17 : Outcome( stack == "defaults A:Penningplichtige.tarief" && chain >= 1 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta2_defaultsAPenningplichtigeTariefEens0(this, $besluit) ) )
