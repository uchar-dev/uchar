rule "stand Penningplichtige.tarief: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penningplichtige()
    $waarde : Value( attribute == ElementKey.of("penningplichtige", "tarief", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("penningplichtige", "tarief", false), $v));
