function boolean toets_defaultsAPenningplichtigeTariefDefault000(Object $kindertal) {
    return RegelSpraakRuntime.rsAggVergelijk($kindertal, new java.math.BigDecimal("4"), ">=");
}

rule "defaults A:Penningplichtige.tarief: default 0.0.0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penningplichtige( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Penningplichtige"), $kindertal : kindertal )
    eval( toets_defaultsAPenningplichtigeTariefDefault000($kindertal) )
then
