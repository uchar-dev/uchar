package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.EmptyBarrier;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Outcome;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// aftrek
function Object waarde_berekeningAanslag(Object $kindertal, Object $inkomen, Object $tarief) {
    try {
        return ComputeHelpers.fitTarget(let1_berekeningAanslag($kindertal, $inkomen, $tarief), Integer.valueOf(2), "aanslag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// aftrek
function Object let1_berekeningAanslag(Object $kindertal, Object $inkomen, Object $tarief) {
    Object cel_1 = ComputeHelpers.binderCell();
    try {
        return let2_berekeningAanslag($kindertal, $inkomen, $tarief, cel_1);
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_1);
    }
}

// 
function Object binder1_berekeningAanslag(Object $kindertal, Object $inkomen, Object $tarief, Object cel_1) {
    if (!ComputeHelpers.binderCellFilled(cel_1)) {
        ComputeHelpers.fillBinderCell(cel_1, RegelSpraakRuntime.rsAfronding(RegelSpraakRuntime.rsMaal(new java.math.BigDecimal("250"), $kindertal), Integer.valueOf(2), java.math.RoundingMode.HALF_UP));
    }
    return ComputeHelpers.binderValue(cel_1);
}

// belasting
function Object let2_berekeningAanslag(Object $kindertal, Object $inkomen, Object $tarief, Object cel_1) {
    Object cel_4 = ComputeHelpers.binderCell();
    try {
        return (RegelSpraakRuntime.rsAggVergelijk(binder1_berekeningAanslag($kindertal, $inkomen, $tarief, cel_1), binder2_berekeningAanslag($kindertal, $inkomen, $tarief, cel_1, cel_4), ">") ? (Object) new java.math.BigDecimal("0") : (Object) RegelSpraakRuntime.rsVerminderd(binder2_berekeningAanslag($kindertal, $inkomen, $tarief, cel_1, cel_4), binder1_berekeningAanslag($kindertal, $inkomen, $tarief, cel_1)));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_4);
    }
}

// 
function Object binder2_berekeningAanslag(Object $kindertal, Object $inkomen, Object $tarief, Object cel_1, Object cel_4) {
    if (!ComputeHelpers.binderCellFilled(cel_4)) {
        ComputeHelpers.fillBinderCell(cel_4, RegelSpraakRuntime.rsAfronding(RegelSpraakRuntime.rsMaal($inkomen, $tarief), Integer.valueOf(2), java.math.RoundingMode.HALF_UP));
    }
    return ComputeHelpers.binderValue(cel_4);
}

rule "berekening aanslag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penningplichtige( $kindertal : kindertal, $inkomen : inkomen )
    $stand_3 : State( attribute == ElementKey.of("penningplichtige", "tarief", false), subject == $onderwerp, $tarief : value )
then
    Object v = waarde_berekeningAanslag($kindertal, $inkomen, $tarief);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "berekening aanslag", ComputeHelpers.designate(v, "berekening aanslag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("penningplichtige", "aanslag", false), v, "berekening aanslag"));
        }
    }
end

