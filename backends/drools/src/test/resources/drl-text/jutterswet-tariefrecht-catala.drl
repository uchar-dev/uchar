rule "stand Penningplichtige.tarief: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Penningplichtige( $invoer : tarief )
    not( $waarde : Value( attribute == ElementKey.of("penningplichtige", "tarief", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("penningplichtige", "tarief", false), $invoer));
end

