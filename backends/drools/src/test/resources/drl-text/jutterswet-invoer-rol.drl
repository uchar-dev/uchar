function boolean beta1_loodscapaciteitBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("vinder"), java.util.Arrays.asList());
}

function boolean beta2_loodscapaciteitBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("bewaarplaats"), java.util.Arrays.asList());
}

rule "loodscapaciteit: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Loods( $capaciteit : capaciteit )
    exists( $tussen_pad_3 : dev.uchar.regelspraak.facts.Vondst( beta1_loodscapaciteitBijdrageAanVouw0(this, $vouwonderwerp), beta2_loodscapaciteitBijdrageAanVouw0(this, $onderwerp) ) )
then
    Object v = ComputeHelpers.contribution("loodscapaciteit: vouw 0", $vouwonderwerp, $onderwerp, $capaciteit, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

function boolean beta1_ruimBewaardBijdrageAanVouw1(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("vinder"), java.util.Arrays.asList());
}

function boolean beta2_ruimBewaardBijdrageAanVouw1(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("bewaarplaats"), java.util.Arrays.asList());
}

// de capaciteit van alle bewaarplaatsen van alle vondsten van de Jutter groter is dan 5
function boolean matrix_ruimBewaardBijdrageAanVouw1(Object $onderwerp, Object $capaciteit) {
    return RegelSpraakRuntime.rsAggVergelijk($capaciteit, new java.math.BigDecimal("5"), ">");
}

rule "ruim bewaard: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Loods( $capaciteit : capaciteit )
    exists( $tussen_pad_12 : dev.uchar.regelspraak.facts.Vondst( beta1_ruimBewaardBijdrageAanVouw1(this, $vouwonderwerp), beta2_ruimBewaardBijdrageAanVouw1(this, $onderwerp) ) )
then
    insertLogical(new Contribution("ruim bewaard: vouw 1", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_ruimBewaardBijdrageAanVouw1($onderwerp, $capaciteit))));
end

