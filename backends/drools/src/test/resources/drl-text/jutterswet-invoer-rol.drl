package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.Value;

function Object pad_vindpremie(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vinder"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "bonus");
}

// zijn waarde plus de bonus van de vinder van de Vondst
function Object waarde_vindpremie(Object $waarde2, Object $vinderBonus) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($waarde2, $vinderBonus), Integer.valueOf(0), "vindpremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vindpremie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $waarde2 : waarde, $vinderBonus : (pad_vindpremie(this)) )
then
    Object v = waarde_vindpremie($waarde2, $vinderBonus);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vindpremie", ComputeHelpers.designate(v, "vindpremie")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vindpremie", false), v, "vindpremie"));
        }
    }
end

