then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "gekeurd", true)));
end

// de som van de capaciteit van alle bewaarplaatsen van alle vondsten van de Jutter
function Object waarde_loodscapaciteit(Object $aantal_vouw_9, Object $vouw_vouw_11) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_9, $vouw_vouw_11, null), Integer.valueOf(0), "loodscapaciteit", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "loodscapaciteit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_6 : Contribution( fold == "loodscapaciteit: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_10 : value ); $aantal_vouw_9 : count(), $vouw_vouw_11 : exactSum($bijdragewaarde_vouw_10) )
then
    Object v = waarde_loodscapaciteit($aantal_vouw_9, $vouw_vouw_11);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "loodscapaciteit", ComputeHelpers.designate(v, "loodscapaciteit")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "loodscapaciteit", false), v, "loodscapaciteit"));
        }
    }
end

// de capaciteit van alle bewaarplaatsen van alle vondsten van de Jutter groter is dan 5
function boolean toets_ruimBewaard(Object $aantal_vouw_18, Object $vouw_vouw_20) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_18, $vouw_vouw_20, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0));
}

rule "ruim bewaard"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_15 : Contribution( fold == "ruim bewaard: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_19 : value ); $aantal_vouw_18 : count(), $vouw_vouw_20 : exactSum($bijdragewaarde_vouw_19) )
    eval( toets_ruimBewaard($aantal_vouw_18, $vouw_vouw_20) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "ruim bewaard", true)));
end

