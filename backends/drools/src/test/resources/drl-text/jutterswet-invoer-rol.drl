// hij een vondst is
function boolean toets_toegewezen(Object $vinderGezet) {
    return ComputeHelpers.roleField($vinderGezet, Boolean.FALSE);
}

rule "toegewezen"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $vinderGezet : (ComputeHelpers.isSet(vinder, null)) )
    eval( toets_toegewezen($vinderGezet) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "toegewezen", true)));
end

// hij geen vondst is
function boolean toets_verweesd(Object $vinderGezet) {
    return ComputeHelpers.roleField($vinderGezet, Boolean.TRUE);
}

rule "verweesd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $vinderGezet : (ComputeHelpers.isSet(vinder, null)) )
    eval( toets_verweesd($vinderGezet) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "verweesd", true)));
end

// hij een gekeurde vondst is
function boolean toets_gekeurd(Object $keurmeesterGezet) {
