rule "geboekte gewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $padstand_0 : PathState( path == "Jutter:geboekte vangst" && member == ElementKey.of("vangst", "vangsttotaal", false), subject == $onderwerp, $geboekteVangstVangsttotaal : value )
then
    Object v = waarde_geboekteGewichtVanEenJutter($geboekteVangstVangsttotaal);
