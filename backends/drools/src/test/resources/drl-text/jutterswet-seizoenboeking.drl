// zijn vondstgewicht in voorjaar maal 2
function Object waarde_najaarsgewichtVanEenJutter(Object $vondstgewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal(ComputeHelpers.cell($vondstgewicht, java.util.Arrays.asList("voorjaar")), new java.math.BigDecimal("2")), Integer.valueOf(2), "vondstgewicht[najaar]", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "najaarsgewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstgewicht : vondstgewicht )
then
    Object v = waarde_najaarsgewichtVanEenJutter($vondstgewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "najaarsgewicht van een jutter", ComputeHelpers.designate(v, "najaarsgewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vondstgewicht[najaar]", false), v, "najaarsgewicht van een jutter"));
        }
    }
end

function boolean toets_zomergewichtVanEenJutter(Object $onderwerp) {
    return ComputeHelpers.emptyTest(ComputeHelpers.cell(ComputeHelpers.readProperty($onderwerp, "vondstgewicht"), java.util.Arrays.asList("zomer")), Boolean.TRUE);
}

// 0 kg
function Object waarde_zomergewichtVanEenJutter() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("0"), Integer.valueOf(2), "vondstgewicht[zomer]", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "zomergewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    not( $andere_schrijver : Value( attribute == ElementKey.of("jutter", "vondstgewicht[zomer]", false) && writer != "zomergewicht van een jutter", subject == $onderwerp ) )
    eval( toets_zomergewichtVanEenJutter($onderwerp) )
then
    Object v = waarde_zomergewichtVanEenJutter();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zomergewicht van een jutter", ComputeHelpers.designate(v, "zomergewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vondstgewicht[zomer]", false), v, "zomergewicht van een jutter"));
        }
    }
end

// de som van zijn vondstgewicht over alle seizoenen
function Object waarde_jaargewichtVanEenJutter(Object $vondstgewicht, Object $vondstgewicht2, Object $vondstgewicht3) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsDimSom(ComputeHelpers.map(ComputeHelpers.withCell(ComputeHelpers.withCell($vondstgewicht, java.util.Arrays.asList("zomer"), $vondstgewicht2), java.util.Arrays.asList("najaar"), $vondstgewicht3)), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar"))), Integer.valueOf(2), "jaargewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jaargewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstgewicht : vondstgewicht )
    $stand_1 : State( attribute == ElementKey.of("jutter", "vondstgewicht[zomer]", false), subject == $onderwerp, $vondstgewicht2 : value )
    $stand_2 : State( attribute == ElementKey.of("jutter", "vondstgewicht[najaar]", false), subject == $onderwerp, $vondstgewicht3 : value )
then
    Object v = waarde_jaargewichtVanEenJutter($vondstgewicht, $vondstgewicht2, $vondstgewicht3);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jaargewicht van een jutter", ComputeHelpers.designate(v, "jaargewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "jaargewicht", false), v, "jaargewicht van een jutter"));
        }
    }
end

// de som van zijn vangstgewicht over alle seizoenen
function Object waarde_vangsttotaalVanEenVangst(Object $vangstgewicht, Object $vangstgewicht2) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsDimSom(ComputeHelpers.map(ComputeHelpers.withCell($vangstgewicht, java.util.Arrays.asList("najaar"), $vangstgewicht2)), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar"))), Integer.valueOf(2), "vangsttotaal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vangsttotaal van een vangst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vangst( $vangstgewicht : vangstgewicht )
    $stand_1 : State( attribute == ElementKey.of("vangst", "vangstgewicht[najaar]", false), subject == $onderwerp, $vangstgewicht2 : value )
then
    Object v = waarde_vangsttotaalVanEenVangst($vangstgewicht, $vangstgewicht2);
