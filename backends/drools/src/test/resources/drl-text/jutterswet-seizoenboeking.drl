        }
    }
end

function boolean beta_boekEenVangstBijElkeJutter(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// zijn vondstgewicht in najaar
function Object creatie_boekEenVangstBijElkeJutter(Object $vondstgewicht, Object $fase, Object $herkomsten_creatie_15, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("boek een vangst bij elke jutter", 1, "Jutter", (java.util.List) $herkomsten_creatie_15, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($vondstgewicht, Integer.valueOf(2), "vangstgewicht[najaar]", "boek een vangst bij elke jutter"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Vangst");
    ComputeHelpers.setCell(nieuw, "vangstgewicht", java.util.Arrays.asList("najaar"), i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("boek een vangst bij elke jutter", $onderwerp, nieuw, fase, 1, diepte));
    feiten.add(new RelationLink("vangstboeking", $onderwerp, nieuw, fase));
    return feiten;
}

rule "boek een vangst bij elke jutter"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( geboekteVangst == null )
    $creatiefase : CreationPhase( stratum >= 1, $fase : number )
    $stand_0 : State( attribute == ElementKey.of("jutter", "vondstgewicht[najaar]", false), subject == $onderwerp, $vondstgewicht : value )
    accumulate( $herkomst_creatie_14 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_15 : collectList($herkomst_creatie_14) )
    not( $gemaakt_creatie_17 : CreationStamp( rule == "boek een vangst bij elke jutter", subject == $onderwerp ) )
    not( $nieuw_creatie_18 : CreationStamp( object == $onderwerp, beta_boekEenVangstBijElkeJutter(this, $fase) ) )
    not( $eigen_fout : Fault( rule == "boek een vangst bij elke jutter", subject == $onderwerp ) )
then
    Object v = creatie_boekEenVangstBijElkeJutter($vondstgewicht, $fase, $herkomsten_creatie_15, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "boek een vangst bij elke jutter", ComputeHelpers.designate(v, "boek een vangst bij elke jutter")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

rule "koppeling vangstboeking uit de invoer: Jutter.geboekte vangst"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Jutter( geboekteVangst != null, $ander : geboekteVangst )
then
    insertLogical(new RelationLink("vangstboeking", $houder, $ander, 0));
end

rule "koppeling vangstboeking uit de invoer: Vangst.boeker"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Vangst( boeker != null, $ander : boeker )
then
    insertLogical(new RelationLink("vangstboeking", $ander, $houder, 0));
end

function boolean beta_koppelingVangstboekingTweedeVullingVanGeboekteVangst(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "second");
}

rule "koppeling vangstboeking: tweede vulling van geboekte vangst"
    dialect "mvel"
when
    $een : RelationLink( relation == "vangstboeking", $nabij : first )
    $twee : RelationLink( relation == "vangstboeking", first != null, first == $een.first, beta_koppelingVangstboekingTweedeVullingVanGeboekteVangst(this, $een) )
then
    insertLogical(new Fault($nabij, "vangstboeking", new SecondFillingFault("geboekte vangst", $nabij)));
end

function boolean beta_koppelingVangstboekingTweedeVullingVanBoeker(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling vangstboeking: tweede vulling van boeker"
    dialect "mvel"
when
    $een : RelationLink( relation == "vangstboeking", $nabij : second )
    $twee : RelationLink( relation == "vangstboeking", second != null, second == $een.second, beta_koppelingVangstboekingTweedeVullingVanBoeker(this, $een) )
then
    insertLogical(new Fault($nabij, "vangstboeking", new SecondFillingFault("boeker", $nabij)));
end

rule "padstand Jutter.geboekte vangst naar Vangst.vangsttotaal: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $koppeling_keten_37 : RelationLink( relation == "vangstboeking", first == $onderwerp, $overzijde_keten_38 : second )
    $stap_keten_36 : dev.uchar.regelspraak.facts.Vangst( this == $overzijde_keten_38 )
    $stand : State( attribute == ElementKey.of("vangst", "vangsttotaal", false), subject == $stap_keten_36, $v : value )
then
    insertLogical(new PathState($onderwerp, "Jutter:geboekte vangst", ElementKey.of("vangst", "vangsttotaal", false), $v, $stap_keten_36));
end

rule "padstand Jutter.geboekte vangst naar Vangst.vangsttotaal: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    not( $koppeling_keten_45 : RelationLink( relation == "vangstboeking", first == $onderwerp, $overzijde_keten_46 : second ) and $stap_keten_44 : dev.uchar.regelspraak.facts.Vangst( this == $overzijde_keten_46 ) )
then
    insertLogical(new PathState($onderwerp, "Jutter:geboekte vangst", ElementKey.of("vangst", "vangsttotaal", false), null, null));
end

