    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("termijn", "overdraagbaar", true), true));
end

rule "kenmerkstand Termijn.overdraagbaar: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("termijn", "overdraagbaar", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("termijn", "overdraagbaar", true), true));
end

rule "kenmerkstand Termijn.overdraagbaar: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn( ComputeHelpers.holds(overdraagbaar) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("termijn", "overdraagbaar", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("termijn", "overdraagbaar", true), false));
