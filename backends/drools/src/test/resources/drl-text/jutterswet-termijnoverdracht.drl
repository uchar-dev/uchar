package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het overschot van de termijn van de vorige vergunning van de Vergunning gevuld is
function boolean toets_verlengd(Object $vorigeVergunningTermijnOverschot) {
    return ComputeHelpers.emptyTest($vorigeVergunningTermijnOverschot, Boolean.FALSE);
}

rule "verlengd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning()
    $padstand_0 : PathState( path == "Vergunning:vorige vergunning.termijn" && member == ElementKey.of("termijn", "overschot", false), subject == $onderwerp, $vorigeVergunningTermijnOverschot : value )
    eval( toets_verlengd($vorigeVergunningTermijnOverschot) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vergunning", "verlengd", true)));
end

// zijn houder niet verlengd is
function boolean toets_overdraagbaar(Object $houderVerlengd) {
    return ComputeHelpers.characteristicCheckAlongPath($houderVerlengd, Boolean.FALSE);
}

rule "overdraagbaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn()
    $padstand_0 : PathState( path == "Termijn:houder" && member == ElementKey.of("vergunning", "verlengd", true), subject == $onderwerp, $houderVerlengd : value )
    eval( toets_overdraagbaar($houderVerlengd) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("termijn", "overdraagbaar", true)));
end

function Object pad1_overschot(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("houder"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "stopdag");
}

function Object pad2_overschot(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("houder"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "basiseinddag");
}

// hij aan alle volgende voorwaarden voldoet: - hij is overdraagbaar - de stopdag van zijn houder is gevuld - de stopdag van zijn houder is eerder dan de basiseinddag van zijn houder
function boolean toets_overschot(Object $overdraagbaar, Object $houderStopdag, Object $houderBasiseinddag) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($overdraagbaar, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($houderStopdag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.dateCompare($houderStopdag, $houderBasiseinddag, dev.uchar.regelspraak.ir.Condition.Operator.EERDER)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

// de tijdsduur van de stopdag van zijn houder tot de basiseinddag van zijn houder in hele dagen
function Object waarde_overschot(Object $houderStopdag, Object $houderBasiseinddag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsTijdsduur(((java.time.temporal.Temporal) $houderStopdag), ((java.time.temporal.Temporal) $houderBasiseinddag), "DAYS", Boolean.FALSE), Integer.valueOf(0), "overschot", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "overschot"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn( $houderStopdag : (pad1_overschot(this)), $houderBasiseinddag : (pad2_overschot(this)) )
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("termijn", "overdraagbaar", true), subject == $onderwerp, $overdraagbaar : holds )
    eval( toets_overschot($overdraagbaar, $houderStopdag, $houderBasiseinddag) )
then
    Object v = waarde_overschot($houderStopdag, $houderBasiseinddag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "overschot", ComputeHelpers.designate(v, "overschot")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("termijn", "overschot", false), v, "overschot"));
        }
    }
end

// zijn basiseinddag plus het overschot van de termijn van de vorige vergunning van de Vergunning
function Object waarde_verlengdeEinddag(Object $basiseinddag, Object $vorigeVergunningTermijnOverschot) {
    try {
        return ComputeHelpers.dateStep($basiseinddag, $vorigeVergunningTermijnOverschot, "DAYS", Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "verlengde einddag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( $basiseinddag : basiseinddag )
    $padstand_1 : PathState( path == "Vergunning:vorige vergunning.termijn" && member == ElementKey.of("termijn", "overschot", false), subject == $onderwerp, $vorigeVergunningTermijnOverschot : value )
then
    Object v = waarde_verlengdeEinddag($basiseinddag, $vorigeVergunningTermijnOverschot);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "verlengde einddag", ComputeHelpers.designate(v, "verlengde einddag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vergunning", "verlengde einddag", false), v, "verlengde einddag"));
        }
    }
end

function Object pad1_padstandVergunningVorigeVergunningTermijnNaarTermijnOverschotLinkAanwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("vorigeVergunning", "termijn"));
}

function Object pad2_padstandVergunningVorigeVergunningTermijnNaarTermijnOverschotLinkAanwezig(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("vorigeVergunning"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "termijn");
}

rule "padstand Vergunning.vorige vergunning.termijn naar Termijn.overschot: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( pad1_padstandVergunningVorigeVergunningTermijnNaarTermijnOverschotLinkAanwezig(this) != null, $bereikt : (pad2_padstandVergunningVorigeVergunningTermijnNaarTermijnOverschotLinkAanwezig(this)) )
    $stand : State( attribute == ElementKey.of("termijn", "overschot", false), subject != null, subject == $bereikt, $v : value )
then
    insertLogical(new PathState($onderwerp, "Vergunning:vorige vergunning.termijn", ElementKey.of("termijn", "overschot", false), $v, $bereikt));
end

function Object pad_padstandVergunningVorigeVergunningTermijnNaarTermijnOverschotLinkAfwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("vorigeVergunning", "termijn"));
}

rule "padstand Vergunning.vorige vergunning.termijn naar Termijn.overschot: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( pad_padstandVergunningVorigeVergunningTermijnNaarTermijnOverschotLinkAfwezig(this) == null )
then
    insertLogical(new PathState($onderwerp, "Vergunning:vorige vergunning.termijn", ElementKey.of("termijn", "overschot", false), null, null));
end

function Object pad_padstandTermijnHouderNaarVergunningVerlengdLinkAanwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("houder"));
}

rule "padstand Termijn.houder naar Vergunning.verlengd: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn( pad_padstandTermijnHouderNaarVergunningVerlengdLinkAanwezig(this) != null, $bereikt : houder )
    $stand : CharacteristicState( characteristic == ElementKey.of("vergunning", "verlengd", true), subject != null, subject == $bereikt, $v : holds )
then
    insertLogical(new PathState($onderwerp, "Termijn:houder", ElementKey.of("vergunning", "verlengd", true), $v, $bereikt));
end

function Object pad_padstandTermijnHouderNaarVergunningVerlengdLinkAfwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("houder"));
}

rule "padstand Termijn.houder naar Vergunning.verlengd: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn( pad_padstandTermijnHouderNaarVergunningVerlengdLinkAfwezig(this) == null )
then
    insertLogical(new PathState($onderwerp, "Termijn:houder", ElementKey.of("vergunning", "verlengd", true), null, null));
end

rule "stand Termijn.overschot: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn()
    $waarde : Value( attribute == ElementKey.of("termijn", "overschot", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("termijn", "overschot", false), $v));
end

rule "stand Termijn.overschot: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Termijn( $invoer : overschot )
    not( $waarde : Value( attribute == ElementKey.of("termijn", "overschot", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("termijn", "overschot", false), $invoer));
end

rule "kenmerkstand Vergunning.verlengd: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( ComputeHelpers.holds(verlengd) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vergunning", "verlengd", true), true));
end

rule "kenmerkstand Vergunning.verlengd: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vergunning", "verlengd", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vergunning", "verlengd", true), true));
end

rule "kenmerkstand Vergunning.verlengd: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning( ComputeHelpers.holds(verlengd) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vergunning", "verlengd", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vergunning", "verlengd", true), false));
end

rule "kenmerkstand Termijn.overdraagbaar: waar uit de invoer"
