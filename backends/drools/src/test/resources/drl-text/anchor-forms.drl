        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("deelbaar later tarief", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vergunning", "deelbaar later tarief", false), v, "deelbaar later tarief"));
        }
    }
end

