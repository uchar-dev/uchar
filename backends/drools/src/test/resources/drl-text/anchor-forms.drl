import dev.uchar.regelspraak.transpiler.tms.Value;

// de maximale waarde van het tarief van alle vergunningen van het register van de Vergunning die aan alle volgende voorwaarden voldoen: hij is niet de Vergunning zelf; de Vergunning zelf is geschorst
function Object waarde_tariefNaastGeschorste(Object $aantal_vouw_5, Object $vouw_vouw_7) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_5, $vouw_vouw_7, null), Integer.valueOf(0), "tarief naast geschorste", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "tarief naast geschorste"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning()
    accumulate( $bijdrage_vouw_2 : Contribution( fold == "tarief naast geschorste: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_6 : value ); $aantal_vouw_5 : count(), $vouw_vouw_7 : exactMax($bijdragewaarde_vouw_6) )
then
    Object v = waarde_tariefNaastGeschorste($aantal_vouw_5, $vouw_vouw_7);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "tarief naast geschorste", ComputeHelpers.designate(v, "tarief naast geschorste")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vergunning", "tarief naast geschorste", false), v, "tarief naast geschorste"));
        }
    }
end

// voor alle vergunningen van het register van de Vergunning die niet de Vergunning zelf zijn geldt: de Vergunning zelf is niet geschorst
function boolean toets_registerrust(Object $aantal_vouw_13, Object $vouw_vouw_15) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_13, $vouw_vouw_15, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0));
}

rule "registerrust"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning()
    accumulate( $bijdrage_vouw_10 : Contribution( fold == "registerrust: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_14 : value ); $aantal_vouw_13 : count(), $vouw_vouw_15 : exactSum($bijdragewaarde_vouw_14) )
    eval( toets_registerrust($aantal_vouw_13, $vouw_vouw_15) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vergunning", "registerrust", true)));
end

