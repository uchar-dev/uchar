// de maximale waarde van het tarief van alle vergunningen van het register van de Vergunning die aan alle volgende voorwaarden voldoen: hij is niet de Vergunning zelf; zijn tarief gedeeld door zijn teller is groter dan 1
function Object waarde_deelbaarTarief(Object $aantal_vouw_63, Object $vouw_vouw_65, Object $eerste_filterfout_vouw_70, Object $filterdeponeringen_vouw_74, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(vouwlezing_deelbaarTarief($aantal_vouw_63, $vouw_vouw_65, $eerste_filterfout_vouw_70, $filterdeponeringen_vouw_74, sonde), Integer.valueOf(0), "deelbaar tarief", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// de maximale waarde van het tarief van alle vergunningen van het register van de Vergunning die aan alle volgende voorwaarden voldoen: hij is niet de Vergunning zelf; zijn tarief gedeeld door zijn teller is groter dan 1
function Object vouwlezing_deelbaarTarief(Object $aantal_vouw_63, Object $vouw_vouw_65, Object $eerste_filterfout_vouw_70, Object $filterdeponeringen_vouw_74, Object sonde) {
    ComputeHelpers.reportFilterDeposits(sonde, $filterdeponeringen_vouw_74);
    if ($eerste_filterfout_vouw_70 != null) {
        throw ((FilterFault) $eerste_filterfout_vouw_70).fault();
    }
    return ComputeHelpers.foldValue($aantal_vouw_63, $vouw_vouw_65, null);
}

rule "deelbaar tarief"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vergunning()
    accumulate( $bijdrage_vouw_60 : Contribution( fold == "deelbaar tarief: vouw 6", subject == $onderwerp, $bijdragewaarde_vouw_64 : value ); $aantal_vouw_63 : count(), $vouw_vouw_65 : exactMax($bijdragewaarde_vouw_64) )
    accumulate( $filterfout_vouw_66 : FilterFault( fold == "deelbaar tarief: vouw 6", subject == $onderwerp ); $filterfouten_vouw_69 : count(), $eerste_filterfout_vouw_70 : exactMin($filterfout_vouw_66) )
    accumulate( $filterdeponering_vouw_71 : FilterDeposit( fold == "deelbaar tarief: vouw 6", subject == $onderwerp ); $filterdeponeringen_vouw_74 : collectList($filterdeponering_vouw_71) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_deelbaarTarief($aantal_vouw_63, $vouw_vouw_65, $eerste_filterfout_vouw_70, $filterdeponeringen_vouw_74, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "deelbaar tarief", ComputeHelpers.designate(v, "deelbaar tarief")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("deelbaar tarief", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vergunning", "deelbaar tarief", false), v, "deelbaar tarief"));
        }
    }
end

