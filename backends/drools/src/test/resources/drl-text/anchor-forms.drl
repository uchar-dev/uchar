    accumulate( $filterfout_vouw_169 : FilterFault( fold == "deelbaar tarief van ongeschorste: vouw 14", subject == $onderwerp ); $filterfouten_vouw_172 : count(), $eerste_filterfout_vouw_173 : exactMin($filterfout_vouw_169) )
