    accumulate( $bijdrage_vouw_135 : Contribution( fold == "deelbaar later tarief: vouw 13", subject == $onderwerp, $bijdragewaarde_vouw_139 : value ); $aantal_vouw_138 : count(), $vouw_vouw_140 : exactMax($bijdragewaarde_vouw_139) )
