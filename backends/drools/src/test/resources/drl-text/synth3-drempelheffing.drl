package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.EmptyBarrier;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.ParameterState;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.math.BigDecimal tarief;
global java.math.BigDecimal drempel;
global java.math.BigDecimal basisheffing;

// g is de grondslag van de Jutter
function Object waarde_heffingVanEenJutter(Object $grondslag, Object $tarief, Object $drempel, Object $basisheffing) {
    try {
        return ComputeHelpers.fitTarget(let1_heffingVanEenJutter($grondslag, $tarief, $drempel, $basisheffing), Integer.valueOf(2), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// g is de grondslag van de Jutter
function Object let1_heffingVanEenJutter(Object $grondslag, Object $tarief, Object $drempel, Object $basisheffing) {
    Object cel_1 = ComputeHelpers.binderCell();
    try {
        return let2_heffingVanEenJutter($grondslag, $tarief, $drempel, $basisheffing, cel_1);
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_1);
    }
}

// zijn grondslag
function Object binder1_heffingVanEenJutter(Object $grondslag, Object $tarief, Object $drempel, Object $basisheffing, Object cel_1) {
    if (!ComputeHelpers.binderCellFilled(cel_1)) {
        ComputeHelpers.fillBinderCell(cel_1, $grondslag);
    }
    return ComputeHelpers.binderValue(cel_1);
}

// ruw is de grondslag maal het tarief
function Object let2_heffingVanEenJutter(Object $grondslag, Object $tarief, Object $drempel, Object $basisheffing, Object cel_1) {
    Object cel_3 = ComputeHelpers.binderCell();
    try {
        return let3_heffingVanEenJutter($grondslag, $tarief, $drempel, $basisheffing, cel_1, cel_3);
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_3);
    }
}

// de grondslag maal het tarief
function Object binder2_heffingVanEenJutter(Object $grondslag, Object $tarief, Object $drempel, Object $basisheffing, Object cel_1, Object cel_3) {
    if (!ComputeHelpers.binderCellFilled(cel_3)) {
        ComputeHelpers.fillBinderCell(cel_3, RegelSpraakRuntime.rsMaal(binder1_heffingVanEenJutter($grondslag, $tarief, $drempel, $basisheffing, cel_1), ComputeHelpers.required($tarief, "parameter \"tarief\" is unbound in this case (binding is fail-fast, ch. 5.7)")));
    }
    return ComputeHelpers.binderValue(cel_3);
}

// volle is de grondslag maal het tarief afgerond
function Object let3_heffingVanEenJutter(Object $grondslag, Object $tarief, Object $drempel, Object $basisheffing, Object cel_1, Object cel_3) {
    Object cel_4 = ComputeHelpers.binderCell();
    try {
        return (RegelSpraakRuntime.rsAggVergelijk(binder1_heffingVanEenJutter($grondslag, $tarief, $drempel, $basisheffing, cel_1), ComputeHelpers.required($drempel, "parameter \"drempel\" is unbound in this case (binding is fail-fast, ch. 5.7)"), ">") ? (Object) RegelSpraakRuntime.rsPlus(ComputeHelpers.required($basisheffing, "parameter \"basisheffing\" is unbound in this case (binding is fail-fast, ch. 5.7)"), binder3_heffingVanEenJutter($grondslag, $tarief, $drempel, $basisheffing, cel_1, cel_3, cel_4)) : (Object) ComputeHelpers.required($basisheffing, "parameter \"basisheffing\" is unbound in this case (binding is fail-fast, ch. 5.7)"));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_4);
    }
}

// de grondslag maal het tarief rekenkundig afgerond op 2 decimalen
function Object binder3_heffingVanEenJutter(Object $grondslag, Object $tarief, Object $drempel, Object $basisheffing, Object cel_1, Object cel_3, Object cel_4) {
    if (!ComputeHelpers.binderCellFilled(cel_4)) {
        ComputeHelpers.fillBinderCell(cel_4, RegelSpraakRuntime.rsAfronding(binder2_heffingVanEenJutter($grondslag, $tarief, $drempel, $basisheffing, cel_1, cel_3), Integer.valueOf(2), java.math.RoundingMode.HALF_UP));
    }
    return ComputeHelpers.binderValue(cel_4);
}

rule "heffing van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $grondslag : grondslag )
    $parameter_2 : ParameterState( parameter == "tarief", $tarief : value )
    $parameter_5 : ParameterState( parameter == "drempel", $drempel : value )
    $parameter_6 : ParameterState( parameter == "basisheffing", $basisheffing : value )
then
    Object v = waarde_heffingVanEenJutter($grondslag, $tarief, $drempel, $basisheffing);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing van een jutter", ComputeHelpers.designate(v, "heffing van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "heffing", false), v, "heffing van een jutter"));
        }
    }
end

rule "parameterstand tarief"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("tarief", tarief));
end

rule "parameterstand drempel"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("drempel", drempel));
end

rule "parameterstand basisheffing"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("basisheffing", basisheffing));
end

