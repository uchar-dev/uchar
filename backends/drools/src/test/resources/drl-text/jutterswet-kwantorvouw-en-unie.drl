rule "drukte: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_42 : Contribution( fold == "drukte: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_46 : value ); $aantal_vouw_45 : count(), $vouw_vouw_47 : collectList($bijdragewaarde_vouw_46) )
    eval( toets_drukteFoutInDeVoorwaarde($aantal_vouw_45, $vouw_vouw_47) )
then
    Object f = fout_drukteFoutInDeVoorwaarde($aantal_vouw_45, $vouw_vouw_47);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"drukte\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "drukte", ComputeHelpers.designate(f, "drukte")));
end

