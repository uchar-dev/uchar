// zijn gewicht gedeeld door zijn deelnemers is groter dan 2
function Object lidtoets_drukteBijdrageAanVouw1(Object $onderwerp, Object $gewicht, Object $deelnemers, Object $lijstplaatsen_plaats_31, Object $plaats_plaats_32, Object sonde) {
    java.util.List plaats = plaats_drukteBijdrageAanVouw1($onderwerp, $lijstplaatsen_plaats_31, $plaats_plaats_32);
    Boolean waar = null;
    RuntimeException fout = null;
    try {
        waar = Boolean.valueOf(RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.divided($gewicht, $deelnemers, sonde), new java.math.BigDecimal("2"), ">"));
    } catch (RuntimeException e) {
        fout = ComputeHelpers.caught(e);
    }
    return new MemberTest(plaats, waar, fout, ComputeHelpers.reported(sonde), ComputeHelpers.depositCodes(sonde));
}

