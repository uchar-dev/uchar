}

rule "drukte"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_35 : Contribution( fold == "drukte: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_39 : value ); $aantal_vouw_38 : count(), $vouw_vouw_40 : collectList($bijdragewaarde_vouw_39) )
    eval( toets_drukte($aantal_vouw_38, $vouw_vouw_40) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "druk", true)));
end

