// hij actief is
function boolean toets_unietelling(Object $actief) {
    return ComputeHelpers.characteristic($actief, Boolean.TRUE);
}

// het aantal vondsten van de Jutter die gemerkt zijn en vondsten van de Jutter die aan de volgende voorwaarde voldoen: zijn gewicht gedeeld door zijn deelnemers is groter dan 2
function Object waarde_unietelling(Object $aantal_vouw_17, Object $eerste_filterfout_vouw_22, Object $filterdeponeringen_vouw_26, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(vouwlezing_unietelling($aantal_vouw_17, $eerste_filterfout_vouw_22, $filterdeponeringen_vouw_26, sonde), Integer.valueOf(0), "unietelling", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// het aantal vondsten van de Jutter die gemerkt zijn en vondsten van de Jutter die aan de volgende voorwaarde voldoen: zijn gewicht gedeeld door zijn deelnemers is groter dan 2
function Object vouwlezing_unietelling(Object $aantal_vouw_17, Object $eerste_filterfout_vouw_22, Object $filterdeponeringen_vouw_26, Object sonde) {
    ComputeHelpers.reportFilterDeposits(sonde, $filterdeponeringen_vouw_26);
    if ($eerste_filterfout_vouw_22 != null) {
        throw ((FilterFault) $eerste_filterfout_vouw_22).fault();
    }
    return ComputeHelpers.countOf($aantal_vouw_17);
}

rule "unietelling"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $actief : (ComputeHelpers.holds(actief)) )
    accumulate( $bijdrage_vouw_14 : Contribution( fold == "unietelling: vouw 0", subject == $onderwerp ); $aantal_vouw_17 : count() )
    accumulate( $filterfout_vouw_18 : FilterFault( fold == "unietelling: vouw 0", subject == $onderwerp ); $filterfouten_vouw_21 : count(), $eerste_filterfout_vouw_22 : exactMin($filterfout_vouw_18) )
    accumulate( $filterdeponering_vouw_23 : FilterDeposit( fold == "unietelling: vouw 0", subject == $onderwerp ); $filterdeponeringen_vouw_26 : collectList($filterdeponering_vouw_23) )
    eval( toets_unietelling($actief) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_unietelling($aantal_vouw_17, $eerste_filterfout_vouw_22, $filterdeponeringen_vouw_26, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "unietelling", ComputeHelpers.designate(v, "unietelling")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("unietelling", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "unietelling", false), v, "unietelling"));
        }
    }
end

// ten minste één van de vondsten van de Jutter zijn gewicht gedeeld door zijn deelnemers groter is dan 2
