    $onderwerp : dev.uchar.regelspraak.facts.Vondst( aanmelder == $vouwonderwerp, $gewicht : gewicht, $deelnemers : deelnemers )
    accumulate( $lijstplaats_plaats_29 : ListPlace( field == "aanmelder", beta_drukteBijdrageAanVouw1(this, $onderwerp), $lijstplaatswaarde_plaats_30 : place ); $lijstplaatsen_plaats_31 : count(), $plaats_plaats_32 : exactMin($lijstplaatswaarde_plaats_30) )
