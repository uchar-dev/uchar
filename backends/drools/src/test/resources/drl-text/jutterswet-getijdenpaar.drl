    $onderwerp : dev.uchar.regelspraak.facts.Getijdenpaar( $aankomst : aankomst )
then
    Object v = waarde_berekeningIjkdatum($aankomst);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "Berekening ijkdatum", ComputeHelpers.designate(v, "Berekening ijkdatum")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("getijdenpaar", "ijkdatum", false), v, "Berekening ijkdatum"));
        }
    }
end

