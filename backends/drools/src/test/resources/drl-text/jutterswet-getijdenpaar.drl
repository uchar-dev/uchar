// zijn aankomst plus 26 uur
function Object waarde_berekeningHersteltijd(Object $aankomst) {
    try {
        return ComputeHelpers.dateStep($aankomst, new java.math.BigDecimal("26"), "HOURS", Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "Berekening hersteltijd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Getijdenpaar( $aankomst : aankomst )
then
    Object v = waarde_berekeningHersteltijd($aankomst);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "Berekening hersteltijd", ComputeHelpers.designate(v, "Berekening hersteltijd")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("getijdenpaar", "hersteltijd", false), v, "Berekening hersteltijd"));
        }
    }
end

// zijn aankomst plus 1 maand
function Object waarde_berekeningIjkdatum(Object $aankomst) {
    try {
        return ComputeHelpers.dateStep($aankomst, new java.math.BigDecimal("1"), "MONTHS", Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

