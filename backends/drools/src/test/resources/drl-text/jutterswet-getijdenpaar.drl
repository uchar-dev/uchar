    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsTijdsduur(((java.time.temporal.Temporal) $aankomst), ((java.time.temporal.Temporal) $vertrek), "DAYS", Boolean.FALSE), Integer.valueOf(0), "dagspanne", null);
