package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de tijdsduur van zijn aankomst tot zijn vertrek in hele uren
function Object waarde_berekeningUurspanne(Object $aankomst, Object $vertrek) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsTijdsduur(((java.time.temporal.Temporal) $aankomst), ((java.time.temporal.Temporal) $vertrek), "HOURS", Boolean.FALSE), Integer.valueOf(0), "uurspanne", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "Berekening uurspanne"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Getijdenpaar( $aankomst : aankomst, $vertrek : vertrek )
then
    Object v = waarde_berekeningUurspanne($aankomst, $vertrek);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "Berekening uurspanne", ComputeHelpers.designate(v, "Berekening uurspanne")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("getijdenpaar", "uurspanne", false), v, "Berekening uurspanne"));
        }
    }
end

