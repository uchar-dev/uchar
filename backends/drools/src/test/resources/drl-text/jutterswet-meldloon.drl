package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de waarde van de Vondst plus 5 €
function Object waarde_meldloonVanEenVondst(Object $waarde2) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($waarde2, new java.math.BigDecimal("5")), Integer.valueOf(0), "meldloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "meldloon van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $waarde2 : waarde )
then
    Object v = waarde_meldloonVanEenVondst($waarde2);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldloon van een vondst", ComputeHelpers.designate(v, "meldloon van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "meldloon", false), v, "meldloon van een vondst"));
        }
    }
end

// het meldloon van de Vondst min 12,50 €
function Object waarde_nettoloonVanEenVondst(Object $meldloon) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMin($meldloon, new java.math.BigDecimal("12.5")), Integer.valueOf(2), "nettoloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "nettoloon van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "meldloon", false), subject == $onderwerp, $meldloon : value )
then
    Object v = waarde_nettoloonVanEenVondst($meldloon);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "nettoloon van een vondst", ComputeHelpers.designate(v, "nettoloon van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "nettoloon", false), v, "nettoloon van een vondst"));
        }
    }
end

rule "stand Vondst.meldloon: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "meldloon", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "meldloon", false), $v));
end

rule "stand Vondst.meldloon: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : meldloon )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "meldloon", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "meldloon", false), $invoer));
end

