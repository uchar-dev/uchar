package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.UniquenessKey;
import dev.uchar.regelspraak.transpiler.tms.UniquenessViolation;

function boolean toets_eenmaligeReekscodeSleutelVanStrandvondst1(Object $reekscode, Object $volgnummer) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($reekscode, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($volgnummer, Boolean.FALSE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

function java.util.List componenten_eenmaligeReekscodeSleutelVanStrandvondst1(Object $reekscode, Object $volgnummer) {
    java.util.List waarden = new java.util.ArrayList();
    waarden.add($reekscode);
    waarden.add($volgnummer);
    return waarden;
}

rule "eenmalige reekscode: sleutel van Strandvondst 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandvondst( $reekscode : reekscode, $volgnummer : volgnummer )
    eval( toets_eenmaligeReekscodeSleutelVanStrandvondst1($reekscode, $volgnummer) )
then
    for (Object k : ComputeHelpers.uniquenessKeys("eenmalige reekscode", 0, $onderwerp, null, componenten_eenmaligeReekscodeSleutelVanStrandvondst1($reekscode, $volgnummer), -1)) {
        insertLogical(k);
    }
end

