function boolean beta_eenmaligeReekscode(Object eigen, Object ander) {
    return ComputeHelpers.collidesWith(eigen, ander);
}

function boolean toets_eenmaligeReekscode(Object $botsingen) {
    return ComputeHelpers.duplicate($botsingen);
}

rule "eenmalige reekscode"
    dialect "mvel"
when
    $sleutel : UniquenessKey( uniqueness == "eenmalige reekscode", $element : element )
    accumulate( $ander : UniquenessKey( uniqueness == "eenmalige reekscode", beta_eenmaligeReekscode(this, $sleutel) ); $botsingen : count() )
    eval( toets_eenmaligeReekscode($botsingen) )
then
    insertLogical(new UniquenessViolation("eenmalige reekscode", $element));
end

rule "eenmalige reekscode: kanaal"
    dialect "mvel"
when
    $schending : UniquenessViolation( uniqueness == "eenmalige reekscode", $subject : element )
then
    insertLogical(ComputeHelpers.inconsistency("eenmalige reekscode", $subject, ComputeHelpers.list1("EF-026")));
end

