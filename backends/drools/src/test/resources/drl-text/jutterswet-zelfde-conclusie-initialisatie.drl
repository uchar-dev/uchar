when
    $besluit : Outcome( stack == "defaults A:Vondst.strandloon" && chain == 0 && position >= 0 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, $onderwerp : subject, $waarde : value )
    not( $stap_13 : Outcome( stack == "defaults A:Vondst.strandloon" && chain == 0 && position >= 0 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN_ONLY, subject != null, subject == $onderwerp, beta_defaultsAVondstStrandloonEensKeten0(this, $besluit) ) )
