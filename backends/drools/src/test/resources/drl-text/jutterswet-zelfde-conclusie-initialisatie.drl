rule "defaults A:Vondst.strandloon: eens wortel"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Vondst.strandloon" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 0 && chain < 1 && position == -1, $onderwerp : subject, $waarde : value )
then
    Object v = $waarde;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "strandloon");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Vondst.strandloon", ComputeHelpers.designate(passend, "defaults A:Vondst.strandloon")));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "strandloon", false), passend, "defaults A:Vondst.strandloon"));
        }
    }
end

