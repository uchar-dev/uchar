package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.LeftOpen;
import dev.uchar.regelspraak.transpiler.tms.OpenInput;
import dev.uchar.regelspraak.transpiler.tms.Outcome;
import dev.uchar.regelspraak.transpiler.tms.Value;

global OpenInput open_invoer;

// hij betwist is
function Object oordeel_meldloon(Object $betwist, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.characteristic(ComputeHelpers.readInput($betwist, open_invoer, $onderwerp, ElementKey.of("vondst", "betwist", true)), Boolean.TRUE), false);
}

// 5
function Object waarde_meldloon(Object $betwist, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.decided(oordeel_meldloon($betwist, open_invoer, $onderwerp), () -> ComputeHelpers.fitTarget(new java.math.BigDecimal("5"), Integer.valueOf(0), "meldloon", null), null);
}

rule "meldloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $betwist : (ComputeHelpers.holds(betwist)) )
    eval( ComputeHelpers.acts(oordeel_meldloon($betwist, open_invoer, $onderwerp)) )
then
    Object v = waarde_meldloon($betwist, open_invoer, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldloon", ComputeHelpers.designate(v, "meldloon")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "meldloon", false), "meldloon"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "meldloon", false), v, "meldloon"));
        }
    }
end

// 5
function Object waarde_standaardMeldloon() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("5"), Integer.valueOf(0), "meldloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "standaard meldloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( meldloon == null )
    not( $andere_schrijver : Value( attribute == ElementKey.of("vondst", "meldloon", false) && writer != "standaard meldloon", subject == $onderwerp ) )
    not( $andere_opengelaten : LeftOpen( member == ElementKey.of("vondst", "meldloon", false) && writer != "standaard meldloon", subject == $onderwerp ) )
then
    Object v = waarde_standaardMeldloon();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "standaard meldloon", ComputeHelpers.designate(v, "standaard meldloon")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "meldloon", false), v, "standaard meldloon"));
        }
    }
end

// hij betwist is
function Object oordeel_defaultsAVondstStrandloonDefault0(Object $betwist, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.characteristic(ComputeHelpers.readInput($betwist, open_invoer, $onderwerp, ElementKey.of("vondst", "betwist", true)), Boolean.TRUE), false);
}

rule "defaults A:Vondst.strandloon: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $betwist : (ComputeHelpers.holds(betwist)) )
    eval( ComputeHelpers.acts(oordeel_defaultsAVondstStrandloonDefault0($betwist, open_invoer, $onderwerp)) )
then
    if (ComputeHelpers.decides(oordeel_defaultsAVondstStrandloonDefault0($betwist, open_invoer, $onderwerp))) {
        // 5
        Object v = new java.math.BigDecimal("5");
        if (v != null) {
            insertLogical(new Outcome($onderwerp, "defaults A:Vondst.strandloon", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
        }
    } else {
        insertLogical(new Outcome($onderwerp, "defaults A:Vondst.strandloon", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN_ONLY, new java.math.BigDecimal("5"), null));
    }
end

rule "defaults A:Vondst.strandloon: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), ComputeHelpers.readProperty(this, "strandloon") == null )
    not( $hoger_10 : Outcome( stack == "defaults A:Vondst.strandloon" && chain == 0 && position >= 0 && position < 1 && kind != dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.OPEN_ONLY, subject == $onderwerp ) )
then
    // 5
    Object v = new java.math.BigDecimal("5");
    if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults A:Vondst.strandloon", 0, 1, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

function boolean beta_defaultsAVondstStrandloonEensKeten0(Object eigen, Object ander) {
