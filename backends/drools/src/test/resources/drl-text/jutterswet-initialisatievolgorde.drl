package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn gewicht groter is dan 10
function boolean toets_standaardbergloon(Object $gewicht) {
    return RegelSpraakRuntime.rsAggVergelijk($gewicht, new java.math.BigDecimal("10"), ">");
}

// 2 maal zijn berekend gewicht
function Object waarde_standaardbergloon(Object $berekendGewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal(new java.math.BigDecimal("2"), $berekendGewicht), Integer.valueOf(2), "bergloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "standaardbergloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( bergloon == null, $gewicht : gewicht )
    $stand_1 : State( attribute == ElementKey.of("vondst", "berekend gewicht", false), subject == $onderwerp, $berekendGewicht : value )
    eval( toets_standaardbergloon($gewicht) )
    not( $andere_schrijver : Value( attribute == ElementKey.of("vondst", "bergloon", false) && writer != "standaardbergloon", subject == $onderwerp ) )
then
    Object v = waarde_standaardbergloon($berekendGewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "standaardbergloon", ComputeHelpers.designate(v, "standaardbergloon")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), v, "standaardbergloon"));
        }
    }
end

// zijn berekend gewicht plus 5
function Object waarde_standaardvindloon(Object $berekendGewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($berekendGewicht, new java.math.BigDecimal("5")), Integer.valueOf(2), "vindloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "standaardvindloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( vindloon == null )
    $stand_0 : State( attribute == ElementKey.of("vondst", "berekend gewicht", false), subject == $onderwerp, $berekendGewicht : value )
    not( $andere_schrijver : Value( attribute == ElementKey.of("vondst", "vindloon", false) && writer != "standaardvindloon", subject == $onderwerp ) )
then
    Object v = waarde_standaardvindloon($berekendGewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "standaardvindloon", ComputeHelpers.designate(v, "standaardvindloon")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vindloon", false), v, "standaardvindloon"));
        }
    }
end

// het gewicht van de Vondst plus 1
function Object waarde_berekendGewichtVanEenVondst(Object $gewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($gewicht, new java.math.BigDecimal("1")), Integer.valueOf(2), "berekend gewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "berekend gewicht van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gewicht : gewicht )
then
    Object v = waarde_berekendGewichtVanEenVondst($gewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "berekend gewicht van een vondst", ComputeHelpers.designate(v, "berekend gewicht van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "berekend gewicht", false), v, "berekend gewicht van een vondst"));
        }
    }
end

rule "stand Vondst.berekend gewicht: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "berekend gewicht", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekend gewicht", false), $v));
end

rule "stand Vondst.berekend gewicht: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : berekendGewicht )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "berekend gewicht", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "berekend gewicht", false), $invoer));
end

