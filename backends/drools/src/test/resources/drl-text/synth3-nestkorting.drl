    not( $uitkomst_7 : Outcome( stack == "defaults A:Jutter.korting" && chain >= 1 && chain < 4 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta1_defaultsAJutterKortingVerschil0(this, $besluit) ) )
