function Object conflict_defaultsAJutterKortingDoorgevenWortel(Object $sleutel) {
    return $sleutel;
}

rule "defaults A:Jutter.korting: doorgeven wortel"
    dialect "mvel"
when
    $conflict : Outcome( stack == "defaults A:Jutter.korting" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.CONFLICT && chain >= 0 && chain < 1, $onderwerp : subject, $sleutel : key )
then
    Object v = conflict_defaultsAJutterKortingDoorgevenWortel($sleutel);
    insertLogical(ComputeHelpers.inconsistency((String) v, $onderwerp, ComputeHelpers.list1("EF-027")));
end

rule "defaults A:Jutter.korting: eens wortel"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Jutter.korting" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 0 && chain < 1, $onderwerp : subject, $waarde : value )
then
    Object v = $waarde;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "korting");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Jutter.korting", ComputeHelpers.designate(passend, "defaults A:Jutter.korting")));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "korting", false), passend, "defaults A:Jutter.korting"));
        }
    }
end

