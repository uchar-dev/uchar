// hij grondP heeft
function boolean toets_defaultsAJutterKortingDefault000(Object $grondP) {
    return ComputeHelpers.characteristic($grondP, Boolean.TRUE);
}

// de grondslag plus 20.00
function Object afloop_defaultsAJutterKortingDefault000(Object $grondslag) {
    try {
        return RegelSpraakRuntime.rsPlus($grondslag, new java.math.BigDecimal("20"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "defaults A:Jutter.korting: default 0.0.0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $grondP : (ComputeHelpers.holds(grondP)), $grondslag : grondslag )
    eval( toets_defaultsAJutterKortingDefault000($grondP) )
then
    Object v = afloop_defaultsAJutterKortingDefault000($grondslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "defaults A:Jutter.korting", ComputeHelpers.designate(v, "defaults A:Jutter.korting")));
    } else if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults A:Jutter.korting", 1, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

