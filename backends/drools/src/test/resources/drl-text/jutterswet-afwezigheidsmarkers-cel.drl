package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn schatting
function Object waarde_najaarsgewichtUitSchatting(Object $schatting) {
    try {
        return ComputeHelpers.construct("waarde", $schatting);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "najaarsgewicht uit schatting"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $schatting : schatting )
then
    Object v = waarde_najaarsgewichtUitSchatting($schatting);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "najaarsgewicht uit schatting", ComputeHelpers.designate(v, "najaarsgewicht uit schatting")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "gewicht[najaar]", false), v, "najaarsgewicht uit schatting"));
        }
    }
end

// hij onleesbaar is
function boolean toets_voorjaarsgewichtOnbekend(Object $onleesbaar) {
    return ComputeHelpers.characteristic($onleesbaar, Boolean.TRUE);
}

// onbekend
function Object waarde_voorjaarsgewichtOnbekend() {
    try {
        return ComputeHelpers.constructorValue("onbekend");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "voorjaarsgewicht onbekend"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $onleesbaar : (ComputeHelpers.holds(onleesbaar)) )
    eval( toets_voorjaarsgewichtOnbekend($onleesbaar) )
then
    Object v = waarde_voorjaarsgewichtOnbekend();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "voorjaarsgewicht onbekend", ComputeHelpers.designate(v, "voorjaarsgewicht onbekend")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "gewicht[voorjaar]", false), v, "voorjaarsgewicht onbekend"));
        }
    }
end

// zijn gewicht in najaar een waarde heeft
function boolean toets_najaarsloon(Object $gewicht) {
    return ComputeHelpers.emptyTest(ComputeHelpers.payload($gewicht, "waarde"), Boolean.FALSE);
}

// zijn gewicht in najaar maal 2
function Object waarde_najaarsloon(Object $gewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal(ComputeHelpers.payload($gewicht, "waarde"), new java.math.BigDecimal("2")), Integer.valueOf(2), "najaarsloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "najaarsloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "gewicht[najaar]", false), subject == $onderwerp, $gewicht : value )
    eval( toets_najaarsloon($gewicht) )
then
    Object v = waarde_najaarsloon($gewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "najaarsloon", ComputeHelpers.designate(v, "najaarsloon")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "najaarsloon", false), v, "najaarsloon"));
        }
    }
end

// zijn gewicht in voorjaar onbekend is
function boolean toets_voorjaarstoeslag(Object $gewicht) {
    return ComputeHelpers.textEqual($gewicht, ComputeHelpers.constructorValue("onbekend"), Boolean.TRUE);
}

// 7,00
function Object waarde_voorjaarstoeslag() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("7"), Integer.valueOf(2), "voorjaarstoeslag", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "voorjaarstoeslag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "gewicht[voorjaar]", false), subject == $onderwerp, $gewicht : value )
    eval( toets_voorjaarstoeslag($gewicht) )
then
    Object v = waarde_voorjaarstoeslag();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "voorjaarstoeslag", ComputeHelpers.designate(v, "voorjaarstoeslag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "voorjaarstoeslag", false), v, "voorjaarstoeslag"));
        }
    }
end

// hij aan alle volgende voorwaarden voldoet: - zijn gewicht in najaar heeft een waarde - zijn gewicht in najaar is groter dan 100,00
function boolean toets_zwareVondst(Object $gewicht) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest(ComputeHelpers.payload($gewicht, "waarde"), Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk(ComputeHelpers.payload($gewicht, "waarde"), new java.math.BigDecimal("100"), ">")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "zware vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "gewicht[najaar]", false), subject == $onderwerp, $gewicht : value )
    eval( toets_zwareVondst($gewicht) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "zwaar", true)));
end

rule "stand Vondst.gewicht[najaar]: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "gewicht[najaar]", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "gewicht[najaar]", false), $v));
end

rule "stand Vondst.gewicht[najaar]: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : gewicht )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "gewicht[najaar]", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "gewicht[najaar]", false), ComputeHelpers.cell($invoer, java.util.Arrays.asList("najaar"))));
end

rule "stand Vondst.gewicht[voorjaar]: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "gewicht[voorjaar]", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "gewicht[voorjaar]", false), $v));
end

rule "stand Vondst.gewicht[voorjaar]: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : gewicht )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "gewicht[voorjaar]", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "gewicht[voorjaar]", false), ComputeHelpers.cell($invoer, java.util.Arrays.asList("voorjaar"))));
end

