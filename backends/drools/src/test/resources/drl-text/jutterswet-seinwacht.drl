rule "hoogsteteken van een seinwacht: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Seinwacht( $ploegomvang : ploegomvang, $vangstwaarde : vangstwaarde )
    eval( toets_hoogstetekenVanEenSeinwachtFoutInDeVoorwaarde($ploegomvang, $vangstwaarde) )
then
    Object f = fout_hoogstetekenVanEenSeinwachtFoutInDeVoorwaarde($ploegomvang, $vangstwaarde);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("de voorwaarde van \"hoogsteteken van een seinwacht\" faalde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    insertLogical(new Fault($onderwerp, "hoogsteteken van een seinwacht", ComputeHelpers.designate(f, "hoogsteteken van een seinwacht")));
end

