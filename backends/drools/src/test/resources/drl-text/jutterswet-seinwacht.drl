package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// hij aan ten hoogste één van de volgende voorwaarden voldoet: - zijn ploegomvang is gelijk aan 0 - zijn vangstwaarde is groter dan 0 - het aandeel is groter dan 0
function boolean toets_hoogstetekenVanEenSeinwacht(Object $ploegomvang, Object $vangstwaarde) {
    try {
        int raak = 0;
        Boolean vast;
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 0, 3);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("0"), "==")) {
            raak++;
        }
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 1, 2);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk($vangstwaarde, new java.math.BigDecimal("0"), ">")) {
            raak++;
        }
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 2, 1);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($vangstwaarde, $ploegomvang, null), Integer.valueOf(0), java.math.RoundingMode.FLOOR), new java.math.BigDecimal("0"), ">")) {
            raak++;
        }
        return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, 1, raak, 3);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

// 1
function Object waarde_hoogstetekenVanEenSeinwacht(Object sonde) {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "hoogsteteken", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "hoogsteteken van een seinwacht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Seinwacht( $ploegomvang : ploegomvang, $vangstwaarde : vangstwaarde )
    eval( toets_hoogstetekenVanEenSeinwacht($ploegomvang, $vangstwaarde) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_hoogstetekenVanEenSeinwacht(sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "hoogsteteken van een seinwacht", ComputeHelpers.designate(v, "hoogsteteken van een seinwacht")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("hoogsteteken van een seinwacht", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("seinwacht", "hoogsteteken", false), v, "hoogsteteken van een seinwacht"));
        }
    }
end

// hij aan ten hoogste één van de volgende voorwaarden voldoet: - zijn ploegomvang is gelijk aan 0 - zijn vangstwaarde is groter dan 0 - het aandeel is groter dan 0
function boolean toets_hoogstetekenVanEenSeinwachtFoutInDeVoorwaarde(Object $ploegomvang, Object $vangstwaarde) {
    try {
        boolean uitkomst = samengesteld1_hoogstetekenVanEenSeinwachtFoutInDeVoorwaarde($ploegomvang, $vangstwaarde);
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

