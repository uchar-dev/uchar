    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.PRECIES, 3, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("0"), "==")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.PRECIES, 3, raak, 2);
}

// hij aan precies drie van de volgende voorwaarden voldoet: - het aandeel is groter dan 0 - zijn ploegomvang is gelijk aan 0
function java.util.List deponering_randtekenVanEenSeinwachtDeponeringInDeVoorwaarde(Object $vangstwaarde, Object $ploegomvang, Object sonde) {
    try {
        boolean uitkomst = samengesteld2_randtekenVanEenSeinwachtDeponeringInDeVoorwaarde($vangstwaarde, $ploegomvang, sonde);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
    }
    if (!ComputeHelpers.reported(sonde)) {
        ComputeHelpers.contractBreach("de voorwaarde van \"randteken van een seinwacht\" deponeerde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    return ComputeHelpers.depositCodes(sonde);
}

// hij aan precies drie van de volgende voorwaarden voldoet: - het aandeel is groter dan 0 - zijn ploegomvang is gelijk aan 0
function boolean samengesteld2_randtekenVanEenSeinwachtDeponeringInDeVoorwaarde(Object $vangstwaarde, Object $ploegomvang, Object sonde) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.PRECIES, 3, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($vangstwaarde, $ploegomvang, sonde), Integer.valueOf(0), java.math.RoundingMode.FLOOR), new java.math.BigDecimal("0"), ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.PRECIES, 3, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("0"), "==")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.PRECIES, 3, raak, 2);
}

rule "randteken van een seinwacht: deponering in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Seinwacht( $vangstwaarde : vangstwaarde, $ploegomvang : ploegomvang )
    eval( toets_randtekenVanEenSeinwachtDeponeringInDeVoorwaarde($vangstwaarde, $ploegomvang, ComputeHelpers.depositFlag()) )
then
    insertLogical(ComputeHelpers.inconsistency("randteken van een seinwacht", $onderwerp, deponering_randtekenVanEenSeinwachtDeponeringInDeVoorwaarde($vangstwaarde, $ploegomvang, ComputeHelpers.depositFlag())));
end

