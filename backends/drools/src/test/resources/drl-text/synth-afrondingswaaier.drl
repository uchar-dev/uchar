package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de opbrengst van de Veilingronde gedeeld door de kavels van de Veilingronde naar beneden afgerond op 0 decimalen
function Object waarde_prijsBenedenafVanEenVeilingronde(Object $opbrengst, Object $kavels, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($opbrengst, $kavels, sonde), Integer.valueOf(0), java.math.RoundingMode.FLOOR), Integer.valueOf(0), "prijsBenedenaf", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "prijs benedenaf van een veilingronde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Veilingronde( $opbrengst : opbrengst, $kavels : kavels )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_prijsBenedenafVanEenVeilingronde($opbrengst, $kavels, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "prijs benedenaf van een veilingronde", ComputeHelpers.designate(v, "prijs benedenaf van een veilingronde")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("prijs benedenaf van een veilingronde", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("veilingronde", "prijsbenedenaf", false), v, "prijs benedenaf van een veilingronde"));
        }
    }
end

