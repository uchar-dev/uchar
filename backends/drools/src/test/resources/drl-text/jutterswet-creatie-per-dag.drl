// 20
function Object waarde_seizoenswaarde() {
    try {
        return PeriodArithmetic.written(PeriodArithmetic.clipped(PeriodCondition.window(java.time.LocalDate.parse("2025-03-01"), Boolean.TRUE, java.time.LocalDate.parse("2025-09-01"), Boolean.TRUE, Boolean.FALSE), PeriodArithmetic.scalar(new java.math.BigDecimal("20"))), Integer.valueOf(0), "seizoenswaarde");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "seizoenswaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Melding()
then
    Object v = waarde_seizoenswaarde();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "seizoenswaarde", ComputeHelpers.designate(v, "seizoenswaarde")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("melding", "seizoenswaarde", false), v, "seizoenswaarde"));
        }
    }
end

