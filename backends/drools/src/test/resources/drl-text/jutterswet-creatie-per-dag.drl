function Object let_standaardaanvulloon(Object $andere_schrijvers_schrijvers_1, Object $aanvulloonInvoer, Object $emmerinvoeren_dagen_5, Object $onderwerp) {
    Object cel_4 = ComputeHelpers.binderCell();
