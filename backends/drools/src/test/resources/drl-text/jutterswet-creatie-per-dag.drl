        i3 = ComputeHelpers.collapse(PeriodArithmetic.written(ComputeHelpers.complete($tijdlijn_0, "the period arithmetic of ch. 3.4/3.5 reads the temporal attribute \"strandloon\" of ", $onderwerp, "; the case supplies only the asOfDate-bucket scalar, which carries no period", "strandloon", Boolean.TRUE), Integer.valueOf(0), "seizoensloon"));
