    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(RegelSpraakRuntime.rsMaal($spanwijdte, $rek), Integer.valueOf(1), java.math.RoundingMode.HALF_UP), Integer.valueOf(1), "krimp", null);
