        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("middenprijs van een vondst", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "middenprijs", false), v, "middenprijs van een vondst"));
        }
    }
end

// (de spanwijdte van de Vondst maal de rek van de Vondst) rekenkundig afgerond op 1 decimalen
