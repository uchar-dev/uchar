when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $strandvoogd : (ComputeHelpers.holds(strandvoogd)) )
