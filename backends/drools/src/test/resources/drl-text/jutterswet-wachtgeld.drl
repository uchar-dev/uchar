package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Outcome;
import dev.uchar.regelspraak.transpiler.tms.Value;

// hij kustwacht is
function boolean toets_defaultsAJutterWachtgeldDefault00(Object $kustwacht) {
    return ComputeHelpers.characteristic($kustwacht, Boolean.TRUE);
}

rule "defaults A:Jutter.wachtgeld: default 0:0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Jutter"), $kustwacht : (ComputeHelpers.holds(kustwacht)) )
    eval( toets_defaultsAJutterWachtgeldDefault00($kustwacht) )
then
    // 30
    Object v = new java.math.BigDecimal("30");
    if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults A:Jutter.wachtgeld", 0, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

