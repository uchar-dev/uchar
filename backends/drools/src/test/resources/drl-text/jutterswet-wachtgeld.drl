function boolean beta1_defaultsAJutterWachtgeldVerschilWortel(Object eigen, Object ander) {
    return ComputeHelpers.earlierMember(eigen, ander);
}

function boolean beta2_defaultsAJutterWachtgeldVerschilWortel(Object eigen, Object ander) {
    return ComputeHelpers.anotherDecision(eigen, ander);
}

function Object conflict_defaultsAJutterWachtgeldVerschilWortel() {
    return "Jutter.wachtgeld";
}

rule "defaults A:Jutter.wachtgeld: verschil wortel"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Jutter.wachtgeld" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 0 && chain < 3, $onderwerp : subject )
    not( $uitkomst_7 : Outcome( stack == "defaults A:Jutter.wachtgeld" && chain >= 0 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta1_defaultsAJutterWachtgeldVerschilWortel(this, $besluit) ) )
    exists( $uitkomst_10 : Outcome( stack == "defaults A:Jutter.wachtgeld" && chain >= 0 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta2_defaultsAJutterWachtgeldVerschilWortel(this, $besluit) ) )
then
    Object v = conflict_defaultsAJutterWachtgeldVerschilWortel();
    insertLogical(ComputeHelpers.inconsistency((String) v, $onderwerp, ComputeHelpers.list1("EF-027")));
end

function boolean beta1_defaultsAJutterWachtgeldEensWortel(Object eigen, Object ander) {
    return ComputeHelpers.earlierMember(eigen, ander);
}

function boolean beta2_defaultsAJutterWachtgeldEensWortel(Object eigen, Object ander) {
    return ComputeHelpers.anotherDecision(eigen, ander);
}

rule "defaults A:Jutter.wachtgeld: eens wortel"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults A:Jutter.wachtgeld" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 0 && chain < 3, $onderwerp : subject, $waarde : value )
    not( $uitkomst_14 : Outcome( stack == "defaults A:Jutter.wachtgeld" && chain >= 0 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta1_defaultsAJutterWachtgeldEensWortel(this, $besluit) ) )
    not( $uitkomst_17 : Outcome( stack == "defaults A:Jutter.wachtgeld" && chain >= 0 && chain < 3 && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, subject != null, subject == $onderwerp, beta2_defaultsAJutterWachtgeldEensWortel(this, $besluit) ) )
then
    Object v = $waarde;
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(0), "wachtgeld");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Jutter.wachtgeld", ComputeHelpers.designate(passend, "defaults A:Jutter.wachtgeld")));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "wachtgeld", false), passend, "defaults A:Jutter.wachtgeld"));
        }
    }
end

