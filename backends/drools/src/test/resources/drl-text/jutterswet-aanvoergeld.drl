package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.ParameterState;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.math.BigDecimal aanvoerdrempel;
global java.math.BigDecimal aanvoertarief;

// zijn aangevoerd gewicht groter of gelijk is aan de aanvoerdrempel
function boolean toets_aanvoerplichtigBijDrempel(Object $aangevoerdGewicht, Object $aanvoerdrempel) {
    try {
        return RegelSpraakRuntime.rsAggVergelijk($aangevoerdGewicht, ComputeHelpers.required($aanvoerdrempel, "parameter \"aanvoerdrempel\" is unbound in this case (binding is fail-fast, ch. 5.7)"), ">=");
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "aanvoerplichtig bij drempel"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $aangevoerdGewicht : aangevoerdGewicht )
    $parameter_1 : ParameterState( parameter == "aanvoerdrempel", $aanvoerdrempel : value )
    eval( toets_aanvoerplichtigBijDrempel($aangevoerdGewicht, $aanvoerdrempel) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "aanvoerplichtig", true)));
end

// zijn aangevoerd gewicht groter of gelijk is aan de aanvoerdrempel
function boolean toets_aanvoerplichtigBijDrempelFoutInDeVoorwaarde(Object $aangevoerdGewicht, Object $aanvoerdrempel) {
    try {
        boolean uitkomst = RegelSpraakRuntime.rsAggVergelijk($aangevoerdGewicht, ComputeHelpers.required($aanvoerdrempel, "parameter \"aanvoerdrempel\" is unbound in this case (binding is fail-fast, ch. 5.7)"), ">=");
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

// zijn aangevoerd gewicht groter of gelijk is aan de aanvoerdrempel
function Object fout_aanvoerplichtigBijDrempelFoutInDeVoorwaarde(Object $aangevoerdGewicht, Object $aanvoerdrempel) {
    try {
        boolean uitkomst = RegelSpraakRuntime.rsAggVergelijk($aangevoerdGewicht, ComputeHelpers.required($aanvoerdrempel, "parameter \"aanvoerdrempel\" is unbound in this case (binding is fail-fast, ch. 5.7)"), ">=");
        return null;
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aanvoerplichtig bij drempel: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $aangevoerdGewicht : aangevoerdGewicht )
    $parameter_1 : ParameterState( parameter == "aanvoerdrempel", $aanvoerdrempel : value )
    eval( toets_aanvoerplichtigBijDrempelFoutInDeVoorwaarde($aangevoerdGewicht, $aanvoerdrempel) )
then
    Object f = fout_aanvoerplichtigBijDrempelFoutInDeVoorwaarde($aangevoerdGewicht, $aanvoerdrempel);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"aanvoerplichtig bij drempel\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "aanvoerplichtig bij drempel", ComputeHelpers.designate(f, "aanvoerplichtig bij drempel")));
end

// zijn aanvoerwaarde plus het aanvoertarief
function Object waarde_aanvoergeldVanEenJutter(Object $aanvoerwaarde, Object $aanvoertarief) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($aanvoerwaarde, ComputeHelpers.required($aanvoertarief, "parameter \"aanvoertarief\" is unbound in this case (binding is fail-fast, ch. 5.7)")), Integer.valueOf(2), "aanvoergeld", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aanvoergeld van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $aanvoerwaarde : aanvoerwaarde )
    $parameter_1 : ParameterState( parameter == "aanvoertarief", $aanvoertarief : value )
then
    Object v = waarde_aanvoergeldVanEenJutter($aanvoerwaarde, $aanvoertarief);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aanvoergeld van een jutter", ComputeHelpers.designate(v, "aanvoergeld van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aanvoergeld", false), v, "aanvoergeld van een jutter"));
        }
    }
end

rule "parameterstand aanvoerdrempel"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("aanvoerdrempel", aanvoerdrempel));
end

rule "parameterstand aanvoertarief"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("aanvoertarief", aanvoertarief));
end

