    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("wachter", "gevarenrang", false), v, "gevarenrang van een wachter"));
        }
    }
end

function Object pad_seingerechtigdBijRisicopost(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("post"));
    return bereikt == null ? null : ComputeHelpers.holds(ComputeHelpers.readProperty(bereikt, "risicopost"));
}

// zijn post risicopost is
function boolean toets_seingerechtigdBijRisicopost(Object $postRisicopost) {
    return ComputeHelpers.characteristicCheckAlongPath($postRisicopost, Boolean.TRUE);
}

rule "seingerechtigd bij risicopost"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter( $postRisicopost : (pad_seingerechtigdBijRisicopost(this)) )
    eval( toets_seingerechtigdBijRisicopost($postRisicopost) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("wachter", "seingerechtigd", true)));
end

// het aantal seinen van de post
function Object waarde_seinaantalVanEenPost(Object $aantal_vouw_5) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_5), Integer.valueOf(0), "seinaantal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "seinaantal van een post"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Post()
    accumulate( $bijdrage_vouw_2 : Contribution( fold == "seinaantal van een post: vouw 0", subject == $onderwerp ); $aantal_vouw_5 : count() )
then
    Object v = waarde_seinaantalVanEenPost($aantal_vouw_5);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "seinaantal van een post", ComputeHelpers.designate(v, "seinaantal van een post")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("post", "seinaantal", false), v, "seinaantal van een post"));
        }
    }
end

// de som van het gewicht van alle seinen van de post of 0 als die er niet zijn
function Object waarde_seingewichtVanEenPost(Object $aantal_vouw_10, Object $vouw_vouw_12) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_10, $vouw_vouw_12, new java.math.BigDecimal("0")), Integer.valueOf(0), "seingewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "seingewicht van een post"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Post()
    accumulate( $bijdrage_vouw_7 : Contribution( fold == "seingewicht van een post: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_11 : value ); $aantal_vouw_10 : count(), $vouw_vouw_12 : exactSum($bijdragewaarde_vouw_11) )
then
    Object v = waarde_seingewichtVanEenPost($aantal_vouw_10, $vouw_vouw_12);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "seingewicht van een post", ComputeHelpers.designate(v, "seingewicht van een post")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("post", "seingewicht", false), v, "seingewicht van een post"));
        }
    }
end

// het aantal vakseinen van het kustvak
function Object waarde_vakseinaantalVanEenKustvak(Object $aantal_vouw_20) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_20), Integer.valueOf(0), "vakseinaantal", null);
