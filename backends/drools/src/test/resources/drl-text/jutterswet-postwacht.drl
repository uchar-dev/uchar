rule "vakseinaantal van een kustvak"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kustvak()
    accumulate( $bijdrage_vouw_17 : Contribution( fold == "vakseinaantal van een kustvak: vouw 2", subject == $onderwerp ); $aantal_vouw_20 : count() )
then
    Object v = waarde_vakseinaantalVanEenKustvak($aantal_vouw_20);
    if (ComputeHelpers.isEvaluationFault(v)) {
