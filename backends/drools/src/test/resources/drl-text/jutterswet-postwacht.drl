    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("kustvak", "vakseinaantal", false), v, "vakseinaantal van een kustvak"));
        }
    }
end

function boolean toets_wachtnummerUniekPerPostSleutelVanWachter1(Object $wachtnummer, Object $post) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($wachtnummer, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($post, Boolean.FALSE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

function java.util.List componenten_wachtnummerUniekPerPostSleutelVanWachter1(Object $wachtnummer, Object $post) {
    java.util.List waarden = new java.util.ArrayList();
    waarden.add($wachtnummer);
    return waarden;
}

rule "wachtnummer uniek per post: sleutel van Wachter 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter( $wachtnummer : wachtnummer, $post : post )
    eval( toets_wachtnummerUniekPerPostSleutelVanWachter1($wachtnummer, $post) )
then
    for (Object k : ComputeHelpers.uniquenessKeys("wachtnummer uniek per post", 0, $onderwerp, $post, componenten_wachtnummerUniekPerPostSleutelVanWachter1($wachtnummer, $post), -1)) {
        insertLogical(k);
    }
end

function boolean beta_wachtnummerUniekPerPost(Object eigen, Object ander) {
    return ComputeHelpers.collidesWith(eigen, ander);
}

function boolean toets_wachtnummerUniekPerPost(Object $botsingen) {
    return ComputeHelpers.duplicate($botsingen);
}

rule "wachtnummer uniek per post"
    dialect "mvel"
when
    $sleutel : UniquenessKey( uniqueness == "wachtnummer uniek per post", $element : element )
    accumulate( $ander : UniquenessKey( uniqueness == "wachtnummer uniek per post", beta_wachtnummerUniekPerPost(this, $sleutel) ); $botsingen : count() )
    eval( toets_wachtnummerUniekPerPost($botsingen) )
then
    insertLogical(new UniquenessViolation("wachtnummer uniek per post", $element));
end

rule "wachtnummer uniek per post: kanaal"
    dialect "mvel"
when
    $schending : UniquenessViolation( uniqueness == "wachtnummer uniek per post", $subject : element )
then
    insertLogical(ComputeHelpers.inconsistency("wachtnummer uniek per post", $subject, ComputeHelpers.list1("EF-026")));
end

function boolean beta1_vakbeseiningDoorHetKustvak(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("kustvak"), java.util.Arrays.asList());
}

function boolean beta2_vakbeseiningDoorHetKustvak(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("post"), java.util.Arrays.asList());
}

rule "vakbeseining door het kustvak"
    dialect "mvel"
    agenda-group "uchar-feitcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kustvak()
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    $stap_keten_28 : dev.uchar.regelspraak.facts.Post( beta1_vakbeseiningDoorHetKustvak(this, $onderwerp) )
    $stap_keten_30 : dev.uchar.regelspraak.facts.Sein( beta2_vakbeseiningDoorHetKustvak(this, $stap_keten_28) )
    not( $bestaand_feitcreatie_32 : RelationLink( relation == "vakbeseining", first == $onderwerp, second == $stap_keten_30 ) )
then
    insert(new RelationLink("vakbeseining", $onderwerp, $stap_keten_30, $fase));
end

rule "seinaantal van een post: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Post()
    $onderwerp : dev.uchar.regelspraak.facts.Sein( post == $vouwonderwerp )
then
    insertLogical(new Contribution("seinaantal van een post: vouw 0", $vouwonderwerp, $onderwerp, null));
end

rule "seingewicht van een post: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Post()
    $onderwerp : dev.uchar.regelspraak.facts.Sein( post == $vouwonderwerp, $gewicht : gewicht )
then
    Object v = ComputeHelpers.contribution("seingewicht van een post: vouw 1", $vouwonderwerp, $onderwerp, $gewicht, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "vakseinaantal van een kustvak: bijdrage aan vouw 2"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Kustvak()
    $onderwerp : dev.uchar.regelspraak.facts.Sein()
    exists( $koppeling_bereik_13 : RelationLink( relation == "vakbeseining", second == $onderwerp, first == $vouwonderwerp ) )
then
    insertLogical(new Contribution("vakseinaantal van een kustvak: vouw 2", $vouwonderwerp, $onderwerp, null));
end

rule "koppeling vakbeseining uit de invoer: Sein.seinvak"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Sein( seinvak != null, $ander : seinvak )
then
    insertLogical(new RelationLink("vakbeseining", $ander, $houder, 0));
end

function boolean beta_koppelingVakbeseiningTweedeVullingVanSeinvak(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling vakbeseining: tweede vulling van seinvak"
    dialect "mvel"
when
    $een : RelationLink( relation == "vakbeseining", $nabij : second )
    $twee : RelationLink( relation == "vakbeseining", second != null, second == $een.second, beta_koppelingVakbeseiningTweedeVullingVanSeinvak(this, $een) )
then
    insertLogical(new Fault($nabij, "vakbeseining", new SecondFillingFault("seinvak", $nabij)));
end

