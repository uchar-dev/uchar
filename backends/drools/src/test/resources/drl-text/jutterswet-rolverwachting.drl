when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $verdienstelijk : (ComputeHelpers.holds(verdienstelijk)) )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_15 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_16 : collectList($herkomst_creatie_15) )
    not( $gemaakt_creatie_18 : CreationStamp( rule == "stel erebesluit vast", subject == $onderwerp ) )
    not( $nieuw_creatie_19 : CreationStamp( object == $onderwerp, beta_stelErebesluitVast(this, $fase) ) )
    eval( toets_stelErebesluitVast($verdienstelijk) )
    not( $eigen_fout : Fault( rule == "stel erebesluit vast", subject == $onderwerp ) )
then
    Object v = creatie_stelErebesluitVast($fase, $herkomsten_creatie_16, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "stel erebesluit vast", ComputeHelpers.designate(v, "stel erebesluit vast")));
    } else {
        java.util.List feiten = (java.util.List) v;
