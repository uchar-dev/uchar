package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.CreationStamp;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;

// zijn vondstscore kleiner is dan 10
function boolean toets_afwijzingOnderDrempel(Object $vondstscore) {
    return RegelSpraakRuntime.rsAggVergelijk($vondstscore, new java.math.BigDecimal("10"), "<");
}

rule "afwijzing onder drempel"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstscore : vondstscore )
    eval( toets_afwijzingOnderDrempel($vondstscore) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "afgewezen", true)));
end

function boolean beta_stelBasisbesluitVast(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// zijn vondstscore groter of gelijk is aan 10
function boolean toets_stelBasisbesluitVast(Object $vondstscore) {
    return RegelSpraakRuntime.rsAggVergelijk($vondstscore, new java.math.BigDecimal("10"), ">=");
}

// 50
function Object creatie_stelBasisbesluitVast(Object $fase, Object $herkomsten_creatie_3, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("stel basisbesluit vast", 0, "Jutter", (java.util.List) $herkomsten_creatie_3, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget(new java.math.BigDecimal("50"), Integer.valueOf(0), "toelage", "stel basisbesluit vast"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Penningbesluit");
    ComputeHelpers.set(nieuw, "toelage", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("stel basisbesluit vast", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("penningtoekenning", $onderwerp, nieuw, fase));
    return feiten;
}

rule "stel basisbesluit vast"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstscore : vondstscore )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_2 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_3 : collectList($herkomst_creatie_2) )
    not( $gemaakt_creatie_5 : CreationStamp( rule == "stel basisbesluit vast", subject == $onderwerp ) )
    not( $nieuw_creatie_6 : CreationStamp( object == $onderwerp, beta_stelBasisbesluitVast(this, $fase) ) )
    eval( toets_stelBasisbesluitVast($vondstscore) )
    not( $eigen_fout : Fault( rule == "stel basisbesluit vast", subject == $onderwerp ) )
then
    Object v = creatie_stelBasisbesluitVast($fase, $herkomsten_creatie_3, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "stel basisbesluit vast", ComputeHelpers.designate(v, "stel basisbesluit vast")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

function boolean beta_stelErebesluitVast(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// hij verdienstelijk is
function boolean toets_stelErebesluitVast(Object $verdienstelijk) {
    return ComputeHelpers.characteristic($verdienstelijk, Boolean.TRUE);
}

