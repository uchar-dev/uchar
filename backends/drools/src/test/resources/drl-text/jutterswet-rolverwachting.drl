function boolean toets_verleenOorkonde(Object $vondstscore) {
    return RegelSpraakRuntime.rsAggVergelijk($vondstscore, new java.math.BigDecimal("20"), ">=");
}

// zijn keurjaar
function Object creatie_verleenOorkonde(Object $keurjaar, Object $fase, Object $herkomsten_creatie_29, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("verleen oorkonde", 0, "Jutter", (java.util.List) $herkomsten_creatie_29, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($keurjaar, Integer.valueOf(0), "jaartal", "verleen oorkonde"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Oorkonde");
    ComputeHelpers.set(nieuw, "jaartal", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("verleen oorkonde", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("oorkondeverlening", $onderwerp, nieuw, fase));
    return feiten;
}

rule "verleen oorkonde"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( oorkonde == null, $vondstscore : vondstscore, $keurjaar : keurjaar )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_28 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_29 : collectList($herkomst_creatie_28) )
    not( $gemaakt_creatie_31 : CreationStamp( rule == "verleen oorkonde", subject == $onderwerp ) )
    not( $nieuw_creatie_32 : CreationStamp( object == $onderwerp, beta_verleenOorkonde(this, $fase) ) )
    eval( toets_verleenOorkonde($vondstscore) )
    not( $eigen_fout : Fault( rule == "verleen oorkonde", subject == $onderwerp ) )
then
    Object v = creatie_verleenOorkonde($keurjaar, $fase, $herkomsten_creatie_29, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "verleen oorkonde", ComputeHelpers.designate(v, "verleen oorkonde")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

// de Haven gekeurd is
function boolean toets_wijsHavenToe(Object $gekeurd) {
    return ComputeHelpers.characteristic($gekeurd, Boolean.TRUE);
}

function boolean beta_wijsHavenToe(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("thuishaven"), java.util.Arrays.asList());
}

rule "wijs haven toe"
    dialect "mvel"
    agenda-group "uchar-feitcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Haven( $gekeurd : (ComputeHelpers.holds(gekeurd)) )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    eval( toets_wijsHavenToe($gekeurd) )
    $stap_keten_43 : dev.uchar.regelspraak.facts.Jutter( beta_wijsHavenToe(this, $onderwerp) )
    not( $bestaand_feitcreatie_45 : RelationLink( relation == "haventoewijzing", first == $onderwerp, second == $stap_keten_43 ) )
then
    insert(new RelationLink("haventoewijzing", $onderwerp, $stap_keten_43, $fase));
end

rule "koppeling penningtoekenning uit de invoer: Penningbesluit.gerechtigde"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Penningbesluit( gerechtigde != null, $ander : gerechtigde )
then
    insertLogical(new RelationLink("penningtoekenning", $ander, $houder, 0));
end

function boolean beta_koppelingPenningtoekenningTweedeVullingVanGerechtigde(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling penningtoekenning: tweede vulling van gerechtigde"
    dialect "mvel"
when
    $een : RelationLink( relation == "penningtoekenning", $nabij : second )
    $twee : RelationLink( relation == "penningtoekenning", second != null, second == $een.second, beta_koppelingPenningtoekenningTweedeVullingVanGerechtigde(this, $een) )
then
    insertLogical(new Fault($nabij, "penningtoekenning", new SecondFillingFault("gerechtigde", $nabij)));
end

