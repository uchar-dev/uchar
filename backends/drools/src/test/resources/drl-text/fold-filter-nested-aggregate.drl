}

rule "eerste maand na de afmeerdag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    accumulate( $bijdrage_vouw_10 : Contribution( fold == "eerste maand na de afmeerdag: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_14 : value ); $aantal_vouw_13 : count(), $vouw_vouw_15 : exactMin($bijdragewaarde_vouw_14) )
    accumulate( $filterfout_vouw_16 : FilterFault( fold == "eerste maand na de afmeerdag: vouw 0", subject == $onderwerp ); $filterfouten_vouw_19 : count(), $eerste_filterfout_vouw_20 : exactMin($filterfout_vouw_16) )
then
    Object v = waarde_eersteMaandNaDeAfmeerdag($aantal_vouw_13, $vouw_vouw_15, $eerste_filterfout_vouw_20);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "eerste maand na de afmeerdag", ComputeHelpers.designate(v, "eerste maand na de afmeerdag")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schuit", "eerste maand na de afmeerdag", false), v, "eerste maand na de afmeerdag"));
        }
    }
end

