function Object waarde_eersteMaandNaDeAfmeerdag(Object $aantal_vouw_13, Object $vouw_vouw_15, Object $eerste_filterfout_vouw_20) {
    try {
        return vouwlezing_eersteMaandNaDeAfmeerdag($aantal_vouw_13, $vouw_vouw_15, $eerste_filterfout_vouw_20);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

