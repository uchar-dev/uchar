rule "laat beladen: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schuit()
    accumulate( $bijdrage_vouw_104 : Contribution( fold == "laat beladen: vouw 4", subject == $onderwerp, $bijdragewaarde_vouw_108 : value ); $aantal_vouw_107 : count(), $vouw_vouw_109 : exactSum($bijdragewaarde_vouw_108) )
    accumulate( $filterfout_vouw_110 : FilterFault( fold == "laat beladen: vouw 4", subject == $onderwerp ); $filterfouten_vouw_113 : count(), $eerste_filterfout_vouw_114 : exactMin($filterfout_vouw_110) )
    eval( toets_laatBeladenFoutInDeVoorwaarde($aantal_vouw_107, $vouw_vouw_109, $eerste_filterfout_vouw_114) )
then
    Object f = fout_laatBeladenFoutInDeVoorwaarde($aantal_vouw_107, $vouw_vouw_109, $eerste_filterfout_vouw_114);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"laat beladen\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "laat beladen", ComputeHelpers.designate(f, "laat beladen")));
end

// aan de volgende voorwaarde voldoen: zijn maand is later dan de laatste van (de afmeerdag van de Schuit min 1 mnd) en (de afmeerdag van de Schuit min 2 mnd)
function boolean toets_eersteMaandNaDeAfmeerdagBijdrageAanVouw0(Object $maand, Object $afmeerdag) {
    try {
        return ComputeHelpers.dateCompare($maand, ComputeHelpers.largest(ComputeHelpers.largest(null, ComputeHelpers.dateStep($afmeerdag, new java.math.BigDecimal("1"), "MONTHS", Boolean.FALSE)), ComputeHelpers.dateStep($afmeerdag, new java.math.BigDecimal("2"), "MONTHS", Boolean.FALSE)), dev.uchar.regelspraak.ir.Condition.Operator.LATER);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

