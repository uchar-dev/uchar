    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( pad_loodscapaciteitOpenBereikInVouw0Stap2(this) == null, vinder == $vouwonderwerp )
    accumulate( $lijstplaats_plaats_13 : ListPlace( field == "vinder", beta_loodscapaciteitOpenBereikInVouw0Stap2(this, $onderwerp), $lijstplaatswaarde_plaats_14 : place ); $lijstplaatsen_plaats_15 : count(), $plaats_plaats_16 : exactMin($lijstplaatswaarde_plaats_14) )
    eval( toets_loodscapaciteitOpenBereikInVouw0Stap2(open_invoer, $onderwerp) )
then
    insertLogical(new RangeOpen("loodscapaciteit: vouw 0", $vouwonderwerp, ComputeHelpers.open($onderwerp, ElementKey.role("bewaring", 0, "bewaarplaats")), ComputeHelpers.rangePlace("loodscapaciteit: vouw 0", $onderwerp, 0, 2, java.util.Arrays.asList("vinder"), java.util.Arrays.asList($lijstplaatsen_plaats_15), java.util.Arrays.asList($plaats_plaats_16))));
end

