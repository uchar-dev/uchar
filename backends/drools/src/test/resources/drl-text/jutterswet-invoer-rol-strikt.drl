// hij een vondst is
function Object oordeel_toegewezen(Object $vinder, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.roleFieldOpen($vinder, "", Boolean.FALSE, open_invoer, $onderwerp, ElementKey.role("vinding", 0, "vinder")), false);
}

rule "toegewezen"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $vinder : vinder )
    eval( ComputeHelpers.acts(oordeel_toegewezen($vinder, open_invoer, $onderwerp)) )
then
    if (ComputeHelpers.decides(oordeel_toegewezen($vinder, open_invoer, $onderwerp))) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "toegewezen", true)));
    } else {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "toegewezen", true), "toegewezen"));
    }
end

// hij geen vondst is
function Object oordeel_verweesd(Object $vinder, Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.judge(() -> ComputeHelpers.roleFieldOpen($vinder, "", Boolean.TRUE, open_invoer, $onderwerp, ElementKey.role("vinding", 0, "vinder")), false);
}

rule "verweesd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $vinder : vinder )
    eval( ComputeHelpers.acts(oordeel_verweesd($vinder, open_invoer, $onderwerp)) )
then
    if (ComputeHelpers.decides(oordeel_verweesd($vinder, open_invoer, $onderwerp))) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "verweesd", true)));
    } else {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "verweesd", true), "verweesd"));
    }
end

// hij een gekeurde vondst is
function boolean toets_gekeurd(Object $keurmeesterGezet) {
    return ComputeHelpers.roleField($keurmeesterGezet, Boolean.FALSE);
}

rule "gekeurd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $keurmeesterGezet : (ComputeHelpers.isSet(keurmeester, null)) )
    eval( toets_gekeurd($keurmeesterGezet) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "gekeurd", true)));
end

// de som van de capaciteit van alle bewaarplaatsen van alle vondsten van de Jutter
function Object waarde_loodscapaciteit(Object $aantal_vouw_24, Object $vouw_vouw_26, Object $openleden_vouw_30, Object $eerste_bereikopen_vouw_35) {
    return ComputeHelpers.valued(() -> ComputeHelpers.fitTarget(vouwlezing_loodscapaciteit($aantal_vouw_24, $vouw_vouw_26, $openleden_vouw_30, $eerste_bereikopen_vouw_35), Integer.valueOf(0), "loodscapaciteit", null), null);
}

// de som van de capaciteit van alle bewaarplaatsen van alle vondsten van de Jutter
function Object vouwlezing_loodscapaciteit(Object $aantal_vouw_24, Object $vouw_vouw_26, Object $openleden_vouw_30, Object $eerste_bereikopen_vouw_35) {
    ComputeHelpers.beforeFoldOutcome($eerste_bereikopen_vouw_35, null, null, null, null, $openleden_vouw_30);
    return ComputeHelpers.foldValue(ComputeHelpers.standingCount($aantal_vouw_24, $openleden_vouw_30), $vouw_vouw_26, null);
}

rule "loodscapaciteit"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_21 : Contribution( fold == "loodscapaciteit: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_25 : value ); $aantal_vouw_24 : count(), $vouw_vouw_26 : exactSum($bijdragewaarde_vouw_25) )
    accumulate( $openlid_vouw_27 : FoldOpen( fold == "loodscapaciteit: vouw 0", subject == $onderwerp ); $openleden_vouw_30 : collectList($openlid_vouw_27) )
    accumulate( $bereikopen_vouw_31 : RangeOpen( fold == "loodscapaciteit: vouw 0", subject == $onderwerp ); $bereikopen_aantal_vouw_34 : count(), $eerste_bereikopen_vouw_35 : exactMin($bereikopen_vouw_31) )
then
    Object v = waarde_loodscapaciteit($aantal_vouw_24, $vouw_vouw_26, $openleden_vouw_30, $eerste_bereikopen_vouw_35);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "loodscapaciteit", ComputeHelpers.designate(v, "loodscapaciteit")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("jutter", "loodscapaciteit", false), "loodscapaciteit"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "loodscapaciteit", false), v, "loodscapaciteit"));
        }
    }
end

// de capaciteit van alle bewaarplaatsen van alle vondsten van de Jutter groter is dan 5
function Object oordeel_ruimBewaard(Object $aantal_vouw_51, Object $vouw_vouw_53, Object $openleden_vouw_57, Object $eerste_bereikopen_vouw_62) {
    return ComputeHelpers.judge(() -> ((Boolean) vouwlezing_ruimBewaard($aantal_vouw_51, $vouw_vouw_53, $openleden_vouw_57, $eerste_bereikopen_vouw_62)), false);
}

// de capaciteit van alle bewaarplaatsen van alle vondsten van de Jutter groter is dan 5
function Object vouwlezing_ruimBewaard(Object $aantal_vouw_51, Object $vouw_vouw_53, Object $openleden_vouw_57, Object $eerste_bereikopen_vouw_62) {
    ComputeHelpers.beforeFoldOutcome($eerste_bereikopen_vouw_62, null, null, null, null, $openleden_vouw_57);
    return ComputeHelpers.quantifierVerdictOverOpen($aantal_vouw_51, $vouw_vouw_53, $openleden_vouw_57, dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, Integer.valueOf(0));
}

rule "ruim bewaard"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_48 : Contribution( fold == "ruim bewaard: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_52 : value ); $aantal_vouw_51 : count(), $vouw_vouw_53 : exactSum($bijdragewaarde_vouw_52) )
    accumulate( $openlid_vouw_54 : FoldOpen( fold == "ruim bewaard: vouw 1", subject == $onderwerp ); $openleden_vouw_57 : collectList($openlid_vouw_54) )
    accumulate( $bereikopen_vouw_58 : RangeOpen( fold == "ruim bewaard: vouw 1", subject == $onderwerp ); $bereikopen_aantal_vouw_61 : count(), $eerste_bereikopen_vouw_62 : exactMin($bereikopen_vouw_58) )
    eval( ComputeHelpers.acts(oordeel_ruimBewaard($aantal_vouw_51, $vouw_vouw_53, $openleden_vouw_57, $eerste_bereikopen_vouw_62)) )
then
    if (ComputeHelpers.decides(oordeel_ruimBewaard($aantal_vouw_51, $vouw_vouw_53, $openleden_vouw_57, $eerste_bereikopen_vouw_62))) {
        insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "ruim bewaard", true)));
    } else {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("jutter", "ruim bewaard", true), "ruim bewaard"));
    }
end

