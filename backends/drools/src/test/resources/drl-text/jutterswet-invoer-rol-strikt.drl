function boolean beta1_loodscapaciteitBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("vinder"), java.util.Arrays.asList());
}

function boolean beta2_loodscapaciteitBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("bewaarplaats"), java.util.Arrays.asList());
}

function java.util.List plaats_loodscapaciteitBijdrageAanVouw0(Object $onderwerp) {
    return ComputeHelpers.foldPlace(dev.uchar.regelspraak.transpiler.tms.plan.Consequence.PlaceReason.OPEN_MEMBER, "loodscapaciteit: vouw 0", $onderwerp, 0, java.util.Arrays.asList(), java.util.Arrays.asList(), java.util.Arrays.asList());
}

rule "loodscapaciteit: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Loods( $capaciteit : capaciteit )
    exists( $tussen_pad_9 : dev.uchar.regelspraak.facts.Vondst( beta1_loodscapaciteitBijdrageAanVouw0(this, $vouwonderwerp), beta2_loodscapaciteitBijdrageAanVouw0(this, $onderwerp) ) )
then
    Object v = ComputeHelpers.contributionAt("loodscapaciteit: vouw 0", $vouwonderwerp, $onderwerp, ComputeHelpers.input($capaciteit, open_invoer, $onderwerp, ElementKey.of("loods", "capaciteit", false)), null, null, false, false, plaats_loodscapaciteitBijdrageAanVouw0($onderwerp));
    if (v != null) {
        insertLogical(v);
    }
end

function Object pad_loodscapaciteitOpenBereikInVouw0Stap2(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("bewaarplaats"));
}

function boolean beta_loodscapaciteitOpenBereikInVouw0Stap2(Object eigen, Object ander) {
    return ComputeHelpers.placeOf(eigen, ander, java.util.Arrays.asList());
}

function boolean toets_loodscapaciteitOpenBereikInVouw0Stap2(Object open_invoer, Object $onderwerp) {
    return ComputeHelpers.incompleteInput(open_invoer, $onderwerp, ElementKey.role("bewaring", 0, "bewaarplaats"));
}

