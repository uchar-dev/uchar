        insertLogical(new Fault($onderwerp, "bandgewicht van een vangst", ComputeHelpers.designate(v, "bandgewicht van een vangst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vangst", "bandgewicht", false), v, "bandgewicht van een vangst"));
        }
    }
end

