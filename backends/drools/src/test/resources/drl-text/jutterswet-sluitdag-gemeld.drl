// zijn gemelde sluitdag gevuld is
function boolean toets_afrekendag(Object $gemeldeSluitdag) {
    return ComputeHelpers.emptyTest($gemeldeSluitdag, Boolean.FALSE);
}

rule "afrekendag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging( $gemeldeSluitdag : gemeldeSluitdag )
    eval( toets_afrekendag($gemeldeSluitdag) )
then
    // zijn gemelde sluitdag
    Object v = $gemeldeSluitdag;
    if (!ComputeHelpers.isEmpty(v)) {
        insertLogical(new Value($onderwerp, ElementKey.of("berging", "berekende afrekendag", false), v, "afrekendag"));
    }
end

// hij aan alle volgende voorwaarden voldoet: - zijn opgegeven uiterste meldingsdag is gevuld - zijn berekende uiterste meldingsdag is gevuld - zijn opgegeven uiterste meldingsdag is ongelijk aan zijn berekende uiterste meldingsdag
function boolean toets_afwijkingOpgaveUitersteMeldingsdag(Object $opgegevenUitersteMeldingsdag, Object $berekendeUitersteMeldingsdag) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($opgegevenUitersteMeldingsdag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($berekendeUitersteMeldingsdag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.dateCompare($opgegevenUitersteMeldingsdag, $berekendeUitersteMeldingsdag, dev.uchar.regelspraak.ir.Condition.Operator.ONGELIJK)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

rule "afwijking opgave uiterste meldingsdag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging( $opgegevenUitersteMeldingsdag : opgegevenUitersteMeldingsdag )
    $stand_1 : State( attribute == ElementKey.of("berging", "berekende uiterste meldingsdag", false), subject == $onderwerp, $berekendeUitersteMeldingsdag : value )
    eval( toets_afwijkingOpgaveUitersteMeldingsdag($opgegevenUitersteMeldingsdag, $berekendeUitersteMeldingsdag) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("berging", "afwijkende opgave uiterste meldingsdag", true)));
end

// hij aan alle volgende voorwaarden voldoet: - zijn opgegeven afrekendag is gevuld - zijn berekende afrekendag is gevuld - zijn opgegeven afrekendag is ongelijk aan zijn berekende afrekendag
function boolean toets_afwijkingOpgaveAfrekendag(Object $opgegevenAfrekendag, Object $berekendeAfrekendag) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($opgegevenAfrekendag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest($berekendeAfrekendag, Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.dateCompare($opgegevenAfrekendag, $berekendeAfrekendag, dev.uchar.regelspraak.ir.Condition.Operator.ONGELIJK)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

rule "afwijking opgave afrekendag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging( $opgegevenAfrekendag : opgegevenAfrekendag )
    $stand_1 : State( attribute == ElementKey.of("berging", "berekende afrekendag", false), subject == $onderwerp, $berekendeAfrekendag : value )
    eval( toets_afwijkingOpgaveAfrekendag($opgegevenAfrekendag, $berekendeAfrekendag) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("berging", "afwijkende opgave afrekendag", true)));
end

// hij heeft geen afwijkende opgave uiterste meldingsdag
function boolean toets_controleOpgaveUitersteMeldingsdag(Object $afwijkendeOpgaveUitersteMeldingsdag) {
    return ComputeHelpers.not(ComputeHelpers.characteristic($afwijkendeOpgaveUitersteMeldingsdag, Boolean.FALSE));
}

rule "controle opgave uiterste meldingsdag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("berging", "afwijkende opgave uiterste meldingsdag", true), subject == $onderwerp, $afwijkendeOpgaveUitersteMeldingsdag : holds )
    eval( toets_controleOpgaveUitersteMeldingsdag($afwijkendeOpgaveUitersteMeldingsdag) )
then
    insertLogical(ComputeHelpers.inconsistency("controle opgave uiterste meldingsdag", $onderwerp, ComputeHelpers.list1("EF-025")));
end

// hij heeft geen afwijkende opgave afrekendag
function boolean toets_controleOpgaveAfrekendag(Object $afwijkendeOpgaveAfrekendag) {
    return ComputeHelpers.not(ComputeHelpers.characteristic($afwijkendeOpgaveAfrekendag, Boolean.FALSE));
}

rule "controle opgave afrekendag"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("berging", "afwijkende opgave afrekendag", true), subject == $onderwerp, $afwijkendeOpgaveAfrekendag : holds )
    eval( toets_controleOpgaveAfrekendag($afwijkendeOpgaveAfrekendag) )
then
    insertLogical(ComputeHelpers.inconsistency("controle opgave afrekendag", $onderwerp, ComputeHelpers.list1("EF-025")));
end

