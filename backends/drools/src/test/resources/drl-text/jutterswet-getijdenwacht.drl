    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(jaarpremie)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "jaarpremie", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "jaarpremie", false), subject == $onderwerp ) )
then
