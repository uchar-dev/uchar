// het aantal premiejutters van de Premiepot
function Object waarde_jutteraantal(Object $aantal_vouw_7) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_7), Integer.valueOf(0), "jutteraantal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jutteraantal"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Premiepot()
    accumulate( $bijdrage_vouw_4 : Contribution( fold == "jutteraantal: vouw 0", subject == $onderwerp ); $aantal_vouw_7 : count() )
then
    Object v = waarde_jutteraantal($aantal_vouw_7);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jutteraantal", ComputeHelpers.designate(v, "jutteraantal")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("premiepot", "jutteraantal", false), v, "jutteraantal"));
        }
    }
end

