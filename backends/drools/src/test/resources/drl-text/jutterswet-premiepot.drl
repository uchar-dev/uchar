// hij een premiejutter is
function boolean toets_premiegerechtigd(Object $rolkoppelingen_rol_13) {
    return ComputeHelpers.roleCount($rolkoppelingen_rol_13, Boolean.FALSE);
}

rule "premiegerechtigd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $rolkoppeling_rol_12 : RelationLink( relation == "premiepotvoorjutters", second == $onderwerp ); $rolkoppelingen_rol_13 : count() )
    eval( toets_premiegerechtigd($rolkoppelingen_rol_13) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "premiegerechtigd", true)));
end

function boolean beta_premiepot(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// het aantal havenjutters van de Haven maal de premie per havenjutter
function Object creatie_premiepot(Object $aantal_vouw_21, Object $premiePerHavenjutter, Object $fase, Object $herkomsten_creatie_25, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("premiepot", 0, "Haven", (java.util.List) $herkomsten_creatie_25, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal(ComputeHelpers.countOf($aantal_vouw_21), ComputeHelpers.required($premiePerHavenjutter, "parameter \"premie per havenjutter\" is unbound in this case (binding is fail-fast, ch. 5.7)")), Integer.valueOf(0), "pot", "premiepot"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Premiepot");
    ComputeHelpers.set(nieuw, "pot", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("premiepot", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("havenheeftpremiepot", $onderwerp, nieuw, fase));
    return feiten;
}

rule "premiepot"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Haven( premiepot == null )
    $parameter_1 : ParameterState( parameter == "premiePerHavenjutter", $premiePerHavenjutter : value )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $bijdrage_vouw_18 : Contribution( fold == "premiepot: vouw 1", subject == $onderwerp ); $aantal_vouw_21 : count() )
    accumulate( $herkomst_creatie_24 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_25 : collectList($herkomst_creatie_24) )
    not( $gemaakt_creatie_27 : CreationStamp( rule == "premiepot", subject == $onderwerp ) )
    not( $nieuw_creatie_28 : CreationStamp( object == $onderwerp, beta_premiepot(this, $fase) ) )
    not( $eigen_fout : Fault( rule == "premiepot", subject == $onderwerp ) )
then
    Object v = creatie_premiepot($aantal_vouw_21, $premiePerHavenjutter, $fase, $herkomsten_creatie_25, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "premiepot", ComputeHelpers.designate(v, "premiepot")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

function boolean beta1_premiejutters(Object eigen, Object ander) {
    return ComputeHelpers.notInPhase(eigen, ander);
}

function boolean beta2_premiejutters(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("haven"), java.util.Arrays.asList());
}

rule "premiejutters"
    dialect "mvel"
    agenda-group "uchar-feitcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Premiepot()
    $creatiefase : CreationPhase( stratum >= 1, $fase : number )
    $koppeling_keten_38 : RelationLink( relation == "havenheeftpremiepot", second == $onderwerp, beta1_premiejutters(this, $fase), $overzijde_keten_39 : first )
    $stap_keten_37 : dev.uchar.regelspraak.facts.Haven( this == $overzijde_keten_39 )
    $stap_keten_44 : dev.uchar.regelspraak.facts.Jutter( beta2_premiejutters(this, $stap_keten_37) )
    not( $bestaand_feitcreatie_46 : RelationLink( relation == "premiepotvoorjutters", first == $onderwerp, second == $stap_keten_44 ) )
then
    insert(new RelationLink("premiepotvoorjutters", $onderwerp, $stap_keten_44, $fase));
end

