package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.EmptyBarrier;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de grondslag is zijn grondslag
function Object waarde_heffingVanEenJutter(Object $grondslag) {
    try {
        return ComputeHelpers.fitTarget(let1_heffingVanEenJutter($grondslag), Integer.valueOf(2), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// de grondslag is zijn grondslag
function Object let1_heffingVanEenJutter(Object $grondslag) {
    Object cel_1 = ComputeHelpers.binderCell();
    try {
        return RegelSpraakRuntime.rsPlus(let2_heffingVanEenJutter($grondslag, cel_1), new java.math.BigDecimal("100"));
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_1);
    }
}

// zijn grondslag
function Object binder1_heffingVanEenJutter(Object $grondslag, Object cel_1) {
    if (!ComputeHelpers.binderCellFilled(cel_1)) {
        ComputeHelpers.fillBinderCell(cel_1, $grondslag);
    }
    return ComputeHelpers.binderValue(cel_1);
}

// het opgehoogde is de grondslag plus 1,00
function Object let2_heffingVanEenJutter(Object $grondslag, Object cel_1) {
    Object cel_2 = ComputeHelpers.binderCell();
    try {
        return binder2_heffingVanEenJutter($grondslag, cel_1, cel_2);
    } catch (EmptyBarrier barriere) {
        return ComputeHelpers.intercepted(barriere, cel_2);
    }
}

// de grondslag plus 1,00
function Object binder2_heffingVanEenJutter(Object $grondslag, Object cel_1, Object cel_2) {
    if (!ComputeHelpers.binderCellFilled(cel_2)) {
        ComputeHelpers.fillBinderCell(cel_2, RegelSpraakRuntime.rsPlus(binder1_heffingVanEenJutter($grondslag, cel_1), new java.math.BigDecimal("1")));
    }
    return ComputeHelpers.binderValue(cel_2);
}

rule "heffing van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $grondslag : grondslag )
then
    Object v = waarde_heffingVanEenJutter($grondslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing van een jutter", ComputeHelpers.designate(v, "heffing van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "heffing", false), v, "heffing van een jutter"));
        }
    }
end

