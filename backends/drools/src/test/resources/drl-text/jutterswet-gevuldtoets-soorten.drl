function Object pad_herleidbareVondst(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("jutter"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "naam");
}

// de naam van de jutter van de Vondst gevuld is
function boolean toets_herleidbareVondst(Object $jutterNaam) {
    return ComputeHelpers.emptyTest($jutterNaam, Boolean.FALSE);
}

rule "herleidbare vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $jutterNaam : (pad_herleidbareVondst(this)) )
    eval( toets_herleidbareVondst($jutterNaam) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "herleidbaar", true)));
end

function Object pad_onherleidbareVondst(Object o) {
    Object bereikt = ComputeHelpers.along(o, java.util.Arrays.asList("jutter"));
    return bereikt == null ? null : ComputeHelpers.readProperty(bereikt, "naam");
}

// de naam van de jutter van de Vondst leeg is
function boolean toets_onherleidbareVondst(Object $jutterNaam) {
    return ComputeHelpers.emptyTest($jutterNaam, Boolean.TRUE);
}

rule "onherleidbare vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $jutterNaam : (pad_onherleidbareVondst(this)) )
    eval( toets_onherleidbareVondst($jutterNaam) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "onherleidbaar", true)));
end

