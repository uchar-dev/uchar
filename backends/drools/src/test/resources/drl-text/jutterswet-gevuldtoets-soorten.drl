// hij aan alle volgende voorwaarden voldoet: - zijn herkeuring heeft een waarde - zijn herkeuring is gelijk aan 'hout'
function boolean toets_houtenVondst(Object $herkeuring) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.emptyTest(ComputeHelpers.payload($herkeuring, "waarde"), Boolean.FALSE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.textEqual(RegelSpraakRuntime.rsEnumNaam(ComputeHelpers.payload($herkeuring, "waarde")), RegelSpraakRuntime.rsEnumNaam("hout"), Boolean.TRUE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "houten vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $herkeuring : herkeuring )
    eval( toets_houtenVondst($herkeuring) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "houten", true)));
end

