package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;

// zijn categorie gevuld is
function boolean toets_ingedeeldeVondst(Object $categorie) {
    return ComputeHelpers.emptyTest($categorie, Boolean.FALSE);
}

rule "ingedeelde vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $categorie : categorie )
    eval( toets_ingedeeldeVondst($categorie) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "ingedeeld", true)));
end

