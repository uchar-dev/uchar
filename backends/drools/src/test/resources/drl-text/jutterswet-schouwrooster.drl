package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.ParameterState;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.math.BigDecimal schouwdrempel;

// zijn vaste schouwlast plus zijn extra schouwlast
function Object waarde_schouwplichtVanEenStrandmeester(Object $vasteSchouwlast, Object $extraSchouwlast) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($vasteSchouwlast, $extraSchouwlast), Integer.valueOf(0), "schouwplicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "schouwplicht van een strandmeester"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandmeester( $vasteSchouwlast : vasteSchouwlast, $extraSchouwlast : extraSchouwlast )
then
    Object v = waarde_schouwplichtVanEenStrandmeester($vasteSchouwlast, $extraSchouwlast);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "schouwplicht van een strandmeester", ComputeHelpers.designate(v, "schouwplicht van een strandmeester")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("strandmeester", "schouwplicht", false), v, "schouwplicht van een strandmeester"));
        }
    }
end

// zijn schouwplicht kleiner is dan de schouwdrempel
function boolean toets_kenmerktoekenningSchouwvrij(Object $schouwplicht, Object $schouwdrempel) {
    return RegelSpraakRuntime.rsAggVergelijk($schouwplicht, $schouwdrempel, "<");
}

rule "Kenmerktoekenning schouwvrij"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandmeester()
    $parameter_1 : ParameterState( parameter == "schouwdrempel", $schouwdrempel : value )
    $stand_0 : State( attribute == ElementKey.of("strandmeester", "schouwplicht", false), subject == $onderwerp, $schouwplicht : value )
    eval( toets_kenmerktoekenningSchouwvrij($schouwplicht, $schouwdrempel) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("strandmeester", "schouwvrij", true)));
end

rule "stand Strandmeester.schouwplicht: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandmeester()
    $waarde : Value( attribute == ElementKey.of("strandmeester", "schouwplicht", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandmeester", "schouwplicht", false), $v));
end

rule "stand Strandmeester.schouwplicht: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandmeester( $invoer : schouwplicht )
    not( $waarde : Value( attribute == ElementKey.of("strandmeester", "schouwplicht", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandmeester", "schouwplicht", false), $invoer));
end

rule "parameterstand schouwdrempel"
    dialect "mvel"
when
then
    insertLogical(new ParameterState("schouwdrempel", schouwdrempel));
end

