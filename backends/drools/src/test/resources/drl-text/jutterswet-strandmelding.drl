package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.CreationStamp;
import dev.uchar.regelspraak.transpiler.tms.Decides;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de uitkering van zijn gemeld strandrecht
function Object waarde_leesDeGemeldeUitkering(Object $gemeldStrandrechtUitkering) {
    try {
        return ComputeHelpers.fitTarget($gemeldStrandrechtUitkering, Integer.valueOf(2), "gemelde uitkering", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "lees de gemelde uitkering"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Melding()
    $padstand_0 : PathState( path == "Melding:gemeld strandrecht" && member == ElementKey.of("strandrecht", "uitkering", false), subject == $onderwerp, $gemeldStrandrechtUitkering : value )
then
    Object v = waarde_leesDeGemeldeUitkering($gemeldStrandrechtUitkering);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "lees de gemelde uitkering", ComputeHelpers.designate(v, "lees de gemelde uitkering")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("melding", "gemelde uitkering", false), v, "lees de gemelde uitkering"));
        }
    }
end

function boolean beta_maakEenStrandrechtBijElkeMelding(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// zijn omvang
function Object creatie_maakEenStrandrechtBijElkeMelding(Object $omvang, Object $fase, Object $herkomsten_creatie_4, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("maak een strandrecht bij elke melding", 0, "Melding", (java.util.List) $herkomsten_creatie_4, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($omvang, Integer.valueOf(2), "uitkering", "maak een strandrecht bij elke melding"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Strandrecht");
    ComputeHelpers.set(nieuw, "uitkering", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("maak een strandrecht bij elke melding", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("strandmelding", $onderwerp, nieuw, fase));
    return feiten;
}

rule "maak een strandrecht bij elke melding"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Melding( gemeldStrandrecht == null, $omvang : omvang )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_3 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_4 : collectList($herkomst_creatie_3) )
    not( $gemaakt_creatie_6 : CreationStamp( rule == "maak een strandrecht bij elke melding", subject == $onderwerp ) )
    not( $nieuw_creatie_7 : CreationStamp( object == $onderwerp, beta_maakEenStrandrechtBijElkeMelding(this, $fase) ) )
    not( $eigen_fout : Fault( rule == "maak een strandrecht bij elke melding", subject == $onderwerp ) )
then
    Object v = creatie_maakEenStrandrechtBijElkeMelding($omvang, $fase, $herkomsten_creatie_4, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "maak een strandrecht bij elke melding", ComputeHelpers.designate(v, "maak een strandrecht bij elke melding")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

// zijn grondslag groter is dan 100
function boolean toets_defaultsAWrakrechtUitkeringDefault0(Object $grondslag) {
    return RegelSpraakRuntime.rsAggVergelijk($grondslag, new java.math.BigDecimal("100"), ">");
}

rule "defaults A:Wrakrecht.uitkering: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakrecht( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Wrakrecht"), $grondslag : grondslag )
    eval( toets_defaultsAWrakrechtUitkeringDefault0($grondslag) )
then
    // 9,00
    Object v = new java.math.BigDecimal("9");
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "uitkering");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Wrakrecht.uitkering", ComputeHelpers.designate(passend, "defaults A:Wrakrecht.uitkering")));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakrecht.uitkering", 0));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("strandrecht", "uitkering", false), passend, "defaults A:Wrakrecht.uitkering"));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakrecht.uitkering", 0));
        }
    }
end

rule "defaults A:Wrakrecht.uitkering: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wrakrecht( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Wrakrecht") )
    not( $hoger_18 : Decides( stack == "defaults A:Wrakrecht.uitkering" && index < 1, subject == $onderwerp ) )
then
    // 5,00
    Object v = new java.math.BigDecimal("5");
    if (v != null) {
        Object passend = ComputeHelpers.fitted(v, Integer.valueOf(2), "uitkering");
        if (ComputeHelpers.isEvaluationFault(passend)) {
            insertLogical(new Fault($onderwerp, "defaults A:Wrakrecht.uitkering", ComputeHelpers.designate(passend, "defaults A:Wrakrecht.uitkering")));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakrecht.uitkering", 1));
        } else {
            insertLogical(new Value($onderwerp, ElementKey.of("strandrecht", "uitkering", false), passend, "defaults A:Wrakrecht.uitkering"));
            insertLogical(new Decides($onderwerp, "defaults A:Wrakrecht.uitkering", 1));
        }
    }
end

rule "koppeling strandmelding uit de invoer: Melding.gemeld strandrecht"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Melding( gemeldStrandrecht != null, $ander : gemeldStrandrecht )
then
    insertLogical(new RelationLink("strandmelding", $houder, $ander, 0));
end

rule "koppeling strandmelding uit de invoer: Strandrecht.melding"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Strandrecht( melding != null, $ander : melding )
then
    insertLogical(new RelationLink("strandmelding", $ander, $houder, 0));
end

function boolean beta_koppelingStrandmeldingTweedeVullingVanGemeldStrandrecht(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "second");
}

rule "koppeling strandmelding: tweede vulling van gemeld strandrecht"
    dialect "mvel"
when
    $een : RelationLink( relation == "strandmelding", $nabij : first )
    $twee : RelationLink( relation == "strandmelding", first != null, first == $een.first, beta_koppelingStrandmeldingTweedeVullingVanGemeldStrandrecht(this, $een) )
then
    insertLogical(new Fault($nabij, "strandmelding", new SecondFillingFault("gemeld strandrecht", $nabij)));
end

function boolean beta_koppelingStrandmeldingTweedeVullingVanMelding(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling strandmelding: tweede vulling van melding"
    dialect "mvel"
when
    $een : RelationLink( relation == "strandmelding", $nabij : second )
    $twee : RelationLink( relation == "strandmelding", second != null, second == $een.second, beta_koppelingStrandmeldingTweedeVullingVanMelding(this, $een) )
then
    insertLogical(new Fault($nabij, "strandmelding", new SecondFillingFault("melding", $nabij)));
end

rule "padstand Melding.gemeld strandrecht naar Strandrecht.uitkering: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Melding()
    $koppeling_keten_32 : RelationLink( relation == "strandmelding", first == $onderwerp, $overzijde_keten_33 : second )
    $stap_keten_31 : dev.uchar.regelspraak.facts.Strandrecht( this == $overzijde_keten_33 )
    $stand : State( attribute == ElementKey.of("strandrecht", "uitkering", false), subject == $stap_keten_31, $v : value )
then
    insertLogical(new PathState($onderwerp, "Melding:gemeld strandrecht", ElementKey.of("strandrecht", "uitkering", false), $v, $stap_keten_31));
end

rule "padstand Melding.gemeld strandrecht naar Strandrecht.uitkering: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Melding()
    not( $koppeling_keten_40 : RelationLink( relation == "strandmelding", first == $onderwerp, $overzijde_keten_41 : second ) and $stap_keten_39 : dev.uchar.regelspraak.facts.Strandrecht( this == $overzijde_keten_41 ) )
then
    insertLogical(new PathState($onderwerp, "Melding:gemeld strandrecht", ElementKey.of("strandrecht", "uitkering", false), null, null));
end

rule "stand Strandrecht.uitkering: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht()
    $waarde : Value( attribute == ElementKey.of("strandrecht", "uitkering", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandrecht", "uitkering", false), $v));
end

rule "stand Strandrecht.uitkering: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandrecht( $invoer : uitkering )
    not( $waarde : Value( attribute == ElementKey.of("strandrecht", "uitkering", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandrecht", "uitkering", false), $invoer));
end

