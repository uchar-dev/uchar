package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de som van zijn vondstgewicht over alle seizoenen
function Object waarde_jaargewichtVanEenJutter(Object $vondstgewicht) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsDimSom(ComputeHelpers.map($vondstgewicht), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar"))), Integer.valueOf(2), "jaargewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jaargewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstgewicht : vondstgewicht )
then
    Object v = waarde_jaargewichtVanEenJutter($vondstgewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jaargewicht van een jutter", ComputeHelpers.designate(v, "jaargewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "jaargewicht", false), v, "jaargewicht van een jutter"));
        }
    }
end

