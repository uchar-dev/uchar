// de som van zijn vondstgewicht over alle seizoenen of 0,50 kg als die er niet zijn
function Object waarde_basisgewichtVanEenJutter(Object $vondstgewicht) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.fallback(RegelSpraakRuntime.rsDimSom(ComputeHelpers.map($vondstgewicht), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar"))), new java.math.BigDecimal("0.5")), Integer.valueOf(2), "basisgewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "basisgewicht van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstgewicht : vondstgewicht )
then
    Object v = waarde_basisgewichtVanEenJutter($vondstgewicht);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "basisgewicht van een jutter", ComputeHelpers.designate(v, "basisgewicht van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "basisgewicht", false), v, "basisgewicht van een jutter"));
        }
    }
end

// (de som van zijn vondstgewicht over alle seizoenen of 0 als die er niet zijn) maal zijn kiloprijs
function Object waarde_vrachtprijsVanEenJutter(Object $vondstgewicht, Object $kiloprijs) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal(ComputeHelpers.fallback(RegelSpraakRuntime.rsDimSom(ComputeHelpers.map($vondstgewicht), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar"))), new java.math.BigDecimal("0")), $kiloprijs), Integer.valueOf(4), "vrachtprijs", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vrachtprijs van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstgewicht : vondstgewicht, $kiloprijs : kiloprijs )
then
    Object v = waarde_vrachtprijsVanEenJutter($vondstgewicht, $kiloprijs);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vrachtprijs van een jutter", ComputeHelpers.designate(v, "vrachtprijs van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vrachtprijs", false), v, "vrachtprijs van een jutter"));
        }
    }
end

