package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.BucketInput;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Period;
import dev.uchar.regelspraak.transpiler.tms.PeriodArithmetic;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het totaal van zijn wachtvergoeding per maand gedurende de tijd dat zijn peilstand gelijk is aan zijn drempelstand
function Object waarde_peilsomVanEenJutter(Object $tijdlijn_0, Object $onderwerp, Object $tijdlijn_2, Object $drempelstand) {
    try {
        return ComputeHelpers.fitTarget(PeriodArithmetic.total(RegelSpraakRuntime.rsTijdKnip(ComputeHelpers.complete($tijdlijn_0, "the gedurende clip of \"wachtvergoeding per maand\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar", "wachtvergoeding per maand", Boolean.TRUE), RegelSpraakRuntime.rsTijdConditie(ComputeHelpers.complete($tijdlijn_2, "the gedurende clip of \"wachtvergoeding per maand\" compares \"peilstand\" per segment and needs its full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.6, ch. 8.4)", "peilstand", Boolean.TRUE), Integer.valueOf(4), $drempelstand, ComputeHelpers.complete($tijdlijn_0, "the gedurende clip of \"wachtvergoeding per maand\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar", "wachtvergoeding per maand", Boolean.TRUE), Period.class), Period.class), "MAAND", null, null, "wachtvergoeding per maand", $onderwerp), Integer.valueOf(0), "peilsom", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "peilsom van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $drempelstand : drempelstand )
    $stand_0 : State( attribute == ElementKey.of("jutter", "wachtvergoeding per maand", false), subject == $onderwerp, $tijdlijn_0 : value )
    $stand_2 : State( attribute == ElementKey.of("jutter", "peilstand", false), subject == $onderwerp, $tijdlijn_2 : value )
then
    Object v = waarde_peilsomVanEenJutter($tijdlijn_0, $onderwerp, $tijdlijn_2, $drempelstand);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "peilsom van een jutter", ComputeHelpers.designate(v, "peilsom van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "peilsom", false), v, "peilsom van een jutter"));
        }
    }
end

// het totaal van zijn wachtvergoeding per maand gedurende de tijd dat zijn peilstand ongelijk is aan zijn drempelstand
function Object waarde_afwijksomVanEenJutter(Object $tijdlijn_0, Object $onderwerp, Object $tijdlijn_2, Object $drempelstand) {
    try {
        return ComputeHelpers.fitTarget(PeriodArithmetic.total(RegelSpraakRuntime.rsTijdKnip(ComputeHelpers.complete($tijdlijn_0, "the gedurende clip of \"wachtvergoeding per maand\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar", "wachtvergoeding per maand", Boolean.TRUE), RegelSpraakRuntime.rsTijdConditie(ComputeHelpers.complete($tijdlijn_2, "the gedurende clip of \"wachtvergoeding per maand\" compares \"peilstand\" per segment and needs its full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.6, ch. 8.4)", "peilstand", Boolean.TRUE), Integer.valueOf(5), $drempelstand, ComputeHelpers.complete($tijdlijn_0, "the gedurende clip of \"wachtvergoeding per maand\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar", "wachtvergoeding per maand", Boolean.TRUE), Period.class), Period.class), "MAAND", null, null, "wachtvergoeding per maand", $onderwerp), Integer.valueOf(0), "afwijksom", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "afwijksom van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $drempelstand : drempelstand )
    $stand_0 : State( attribute == ElementKey.of("jutter", "wachtvergoeding per maand", false), subject == $onderwerp, $tijdlijn_0 : value )
    $stand_2 : State( attribute == ElementKey.of("jutter", "peilstand", false), subject == $onderwerp, $tijdlijn_2 : value )
then
    Object v = waarde_afwijksomVanEenJutter($tijdlijn_0, $onderwerp, $tijdlijn_2, $drempelstand);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "afwijksom van een jutter", ComputeHelpers.designate(v, "afwijksom van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "afwijksom", false), v, "afwijksom van een jutter"));
        }
    }
end

rule "stand Jutter.wachtvergoeding per maand: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(wachtvergoedingPerMaand)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "wachtvergoeding per maand", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "wachtvergoeding per maand", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "wachtvergoeding per maand", false), $invoer));
end

rule "stand Jutter.wachtvergoeding per maand: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(wachtvergoedingPerMaand)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "wachtvergoeding per maand", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "wachtvergoeding per maand", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "wachtvergoeding per maand", false), ComputeHelpers.bucketScalarOf($invoer)));
end

rule "stand Jutter.peilstand: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(peilstand)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "peilstand", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "peilstand", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "peilstand", false), $invoer));
end

rule "stand Jutter.peilstand: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(peilstand)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "peilstand", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "peilstand", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "peilstand", false), ComputeHelpers.bucketScalarOf($invoer)));
end

