rule "wachttal van een ploeg"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg()
    accumulate( $bijdrage_vouw_22 : Contribution( fold == "wachttal van een ploeg: vouw 1", subject == $onderwerp ); $aantal_vouw_25 : count() )
then
    Object v = waarde_wachttalVanEenPloeg($aantal_vouw_25);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "wachttal van een ploeg", ComputeHelpers.designate(v, "wachttal van een ploeg")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("ploeg", "wachttal", false), v, "wachttal van een ploeg"));
        }
    }
end

