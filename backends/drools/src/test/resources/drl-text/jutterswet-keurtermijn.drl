    $rekendatum_4 : EvaluationDate( $rekendatumwaarde_4 : date )
then
    insertLogical(new Contribution("inzetbaar bij keurtermijn: vouw 0", $vouwonderwerp, $onderwerp, lidtoets_inzetbaarBijKeurtermijnBijdrageAanVouw0($onderwerp, $gekeurd, $keurdatum, $keurtermijn, $rekendatumwaarde_4, $lijstplaatsen_plaats_3, $plaats_plaats_4, rsDagsoort_Keurdag)));
end

