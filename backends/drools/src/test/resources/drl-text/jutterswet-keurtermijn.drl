    accumulate( $bijdrage_vouw_14 : Contribution( fold == "inzetbaar bij keurtermijn: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_18 : value ); $aantal_vouw_17 : count(), $vouw_vouw_19 : collectList($bijdragewaarde_vouw_18) )
