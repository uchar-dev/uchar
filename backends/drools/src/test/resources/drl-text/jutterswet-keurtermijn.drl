// hij aan alle volgende voorwaarden voldoet
function Object lidtoets_inzetbaarBijKeurtermijnBijdrageAanVouw0(Object $onderwerp, Object $gekeurd, Object $keurdatum, Object $keurtermijn, Object $rekendatumwaarde_4, Object $lijstplaatsen_plaats_3, Object $plaats_plaats_4, java.util.function.Predicate rsDagsoort_Keurdag) {
    java.util.List plaats = plaats_inzetbaarBijKeurtermijnBijdrageAanVouw0($onderwerp, $lijstplaatsen_plaats_3, $plaats_plaats_4);
    Boolean waar = null;
    RuntimeException fout = null;
    try {
        waar = Boolean.valueOf(samengesteld_inzetbaarBijKeurtermijnBijdrageAanVouw0($onderwerp, $gekeurd, $keurdatum, $keurtermijn, $rekendatumwaarde_4, $lijstplaatsen_plaats_3, $plaats_plaats_4, rsDagsoort_Keurdag));
    } catch (RuntimeException e) {
        fout = ComputeHelpers.caught(e);
    }
    return new MemberTest(plaats, waar, fout, ComputeHelpers.reported(null), ComputeHelpers.depositCodes(null));
}

function java.util.List plaats_inzetbaarBijKeurtermijnBijdrageAanVouw0(Object $onderwerp, Object $lijstplaatsen_plaats_3, Object $plaats_plaats_4) {
    return ComputeHelpers.foldPlace(dev.uchar.regelspraak.transpiler.tms.plan.Consequence.PlaceReason.QUANTIFIER, "inzetbaar bij keurtermijn: vouw 0", $onderwerp, 0, java.util.Arrays.asList("ploeg"), java.util.Arrays.asList($lijstplaatsen_plaats_3), java.util.Arrays.asList($plaats_plaats_4));
}

// hij aan alle volgende voorwaarden voldoet
function boolean samengesteld_inzetbaarBijKeurtermijnBijdrageAanVouw0(Object $onderwerp, Object $gekeurd, Object $keurdatum, Object $keurtermijn, Object $rekendatumwaarde_4, Object $lijstplaatsen_plaats_3, Object $plaats_plaats_4, java.util.function.Predicate rsDagsoort_Keurdag) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($gekeurd, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.dateCompare(ComputeHelpers.dayKindStep($keurdatum, $keurtermijn, rsDagsoort_Keurdag, Boolean.TRUE), ComputeHelpers.required($rekendatumwaarde_4, "the evaluationDate context value needs an evaluation date; the case carries asOfDate null"), dev.uchar.regelspraak.ir.Condition.Operator.LATER)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

