global OpenInput open_invoer;

// hij niet beloonbaar is
function Object oordeel_wachtpremie(Object $beloonbaar) {
    return ComputeHelpers.judge(() -> ComputeHelpers.characteristic(ComputeHelpers.read($beloonbaar), Boolean.FALSE), false);
}

// 3
function Object waarde_wachtpremie(Object $beloonbaar) {
    return ComputeHelpers.decided(oordeel_wachtpremie($beloonbaar), () -> ComputeHelpers.fitTarget(new java.math.BigDecimal("3"), Integer.valueOf(0), "wachtpremie", null), null);
}

rule "wachtpremie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "beloonbaar", true), subject == $onderwerp, $beloonbaar : holds )
    eval( ComputeHelpers.acts(oordeel_wachtpremie($beloonbaar)) )
then
    Object v = waarde_wachtpremie($beloonbaar);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "wachtpremie", ComputeHelpers.designate(v, "wachtpremie")));
    } else if (ComputeHelpers.isOpen(v)) {
        insertLogical(new LeftOpen($onderwerp, ElementKey.of("vondst", "wachtpremie", false), "wachtpremie"));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "wachtpremie", false), v, "wachtpremie"));
        }
    }
end

