// zijn strandloon plus zijn stormtoeslag
function Object waarde_aangesteldLoonVanEenJutter(Object $tijdlijn_0, Object $tijdlijn_1, Object $onderwerp, Object $tijdlijn_3) {
    try {
        return PeriodArithmetic.written(PeriodArithmetic.clipped(PeriodCondition.truePeriods($tijdlijn_0), PeriodArithmetic.plus(ComputeHelpers.complete($tijdlijn_1, "the period arithmetic of ch. 3.4/3.5 reads the temporal attribute \"strandloon\" of ", $onderwerp, "; the case supplies only the asOfDate-bucket scalar, which carries no period", "strandloon", Boolean.TRUE), ComputeHelpers.complete($tijdlijn_3, "the period arithmetic of ch. 3.4/3.5 reads the temporal attribute \"stormtoeslag\" of ", $onderwerp, "; the case supplies only the asOfDate-bucket scalar, which carries no period", "stormtoeslag", Boolean.TRUE))), Integer.valueOf(0), "aangestelde loon");
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aangesteld loon van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $tijdlijn_0 : (ComputeHelpers.periods(aangesteld)) )
    $stand_1 : State( attribute == ElementKey.of("jutter", "strandloon", false), subject == $onderwerp, $tijdlijn_1 : value )
    $stand_3 : State( attribute == ElementKey.of("jutter", "stormtoeslag", false), subject == $onderwerp, $tijdlijn_3 : value )
then
    Object v = waarde_aangesteldLoonVanEenJutter($tijdlijn_0, $tijdlijn_1, $onderwerp, $tijdlijn_3);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aangesteld loon van een jutter", ComputeHelpers.designate(v, "aangesteld loon van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aangestelde loon", false), v, "aangesteld loon van een jutter"));
        }
    }
end

