rule "stand Jutter.loonproduct: de vereniging van de schrijvers"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(loonproduct)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "loonproduct", false), subject == $onderwerp ) )
    exists( $schrijver : Value( attribute == ElementKey.of("jutter", "loonproduct", false), subject == $onderwerp ) )
    accumulate( $waarde : Value( attribute == ElementKey.of("jutter", "loonproduct", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("jutter", "loonproduct", false), $waarden, $invoer, ComputeHelpers.list2("loonproduct van een jutter", "jaarproduct van een jutter")));
end

rule "stand Jutter.loonproduct: de vereniging van de schrijvers, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "loonproduct", false), subject == $onderwerp ) )
    exists( $schrijver : Value( attribute == ElementKey.of("jutter", "loonproduct", false), subject == $onderwerp ) )
    accumulate( $waarde : Value( attribute == ElementKey.of("jutter", "loonproduct", false), subject == $onderwerp ); $waarden : collectList($waarde) )
then
    insertLogical(ComputeHelpers.writersUnion($onderwerp, ElementKey.of("jutter", "loonproduct", false), $waarden, null, ComputeHelpers.list2("loonproduct van een jutter", "jaarproduct van een jutter")));
end

