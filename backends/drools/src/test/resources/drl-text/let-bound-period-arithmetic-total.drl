when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(stormtoeslag)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "stormtoeslag", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "stormtoeslag", false), subject == $onderwerp ) )
