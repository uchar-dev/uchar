rule "stand Jutter.registratienummer: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(registratienummer)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "registratienummer", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "registratienummer", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "registratienummer", false), $invoer));
end

rule "stand Jutter.registratienummer: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : (ComputeHelpers.periods(registratienummer)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("jutter", "registratienummer", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "registratienummer", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "registratienummer", false), ComputeHelpers.bucketScalarOf($invoer)));
end

