// zijn registratienummer gedurende het gehele jaar numeriek is met exact 9 cijfers
function boolean toets_doorlopendGeregistreerd(Object $tijdlijn_0, Object $onderwerp) {
    try {
        return ComputeHelpers.wholePeriodDigits(ComputeHelpers.complete($tijdlijn_0, "the whole-period qualifier over \"registratienummer\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "registratienummer", Boolean.TRUE), "JAAR", Integer.valueOf(9), Boolean.TRUE, Boolean.FALSE);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "doorlopend geregistreerd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $stand_0 : State( attribute == ElementKey.of("jutter", "registratienummer", false), subject == $onderwerp, $tijdlijn_0 : value )
    eval( toets_doorlopendGeregistreerd($tijdlijn_0, $onderwerp) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "doorlopend geregistreerd", true)));
end

// zijn registratienummer gedurende het gehele jaar numeriek is met exact 9 cijfers
function boolean toets_doorlopendGeregistreerdFoutInDeVoorwaarde(Object $tijdlijn_0, Object $onderwerp) {
    try {
        boolean uitkomst = ComputeHelpers.wholePeriodDigits(ComputeHelpers.complete($tijdlijn_0, "the whole-period qualifier over \"registratienummer\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "registratienummer", Boolean.TRUE), "JAAR", Integer.valueOf(9), Boolean.TRUE, Boolean.FALSE);
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

// zijn registratienummer gedurende het gehele jaar numeriek is met exact 9 cijfers
function Object fout_doorlopendGeregistreerdFoutInDeVoorwaarde(Object $tijdlijn_0, Object $onderwerp) {
    try {
        boolean uitkomst = ComputeHelpers.wholePeriodDigits(ComputeHelpers.complete($tijdlijn_0, "the whole-period qualifier over \"registratienummer\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.9, ch. 8.4)", "registratienummer", Boolean.TRUE), "JAAR", Integer.valueOf(9), Boolean.TRUE, Boolean.FALSE);
        return null;
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
