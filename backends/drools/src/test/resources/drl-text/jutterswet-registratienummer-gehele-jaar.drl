rule "doorlopend geregistreerd: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $stand_0 : State( attribute == ElementKey.of("jutter", "registratienummer", false), subject == $onderwerp, $tijdlijn_0 : value )
    eval( toets_doorlopendGeregistreerdFoutInDeVoorwaarde($tijdlijn_0, $onderwerp) )
then
    Object f = fout_doorlopendGeregistreerdFoutInDeVoorwaarde($tijdlijn_0, $onderwerp);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("the condition of \"doorlopend geregistreerd\" failed in the test and not in the consequence, over the same bound values");
    }
    insertLogical(new Fault($onderwerp, "doorlopend geregistreerd", ComputeHelpers.designate(f, "doorlopend geregistreerd")));
end

