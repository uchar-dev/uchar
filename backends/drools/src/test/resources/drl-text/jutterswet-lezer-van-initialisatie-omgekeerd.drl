package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn opbrengst gedeeld door zijn bergloon rekenkundig afgerond op 0 decimalen
function Object waarde_aandeel(Object $opbrengst, Object $bergloon, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(ComputeHelpers.divided($opbrengst, $bergloon, sonde), Integer.valueOf(0), java.math.RoundingMode.HALF_UP), Integer.valueOf(0), "aandeel", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aandeel"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opbrengst : opbrengst )
    $stand_1 : State( attribute == ElementKey.of("vondst", "bergloon", false), subject == $onderwerp, $bergloon : value )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_aandeel($opbrengst, $bergloon, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aandeel", ComputeHelpers.designate(v, "aandeel")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("aandeel", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "aandeel", false), v, "aandeel"));
        }
    }
end

// 0
function Object waarde_standaardbergloon() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("0"), Integer.valueOf(0), "bergloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "standaardbergloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( bergloon == null )
    not( $andere_schrijver : Value( attribute == ElementKey.of("vondst", "bergloon", false) && writer != "standaardbergloon", subject == $onderwerp ) )
then
    Object v = waarde_standaardbergloon();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "standaardbergloon", ComputeHelpers.designate(v, "standaardbergloon")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), v, "standaardbergloon"));
        }
    }
end

// hij erkend is
function boolean toets_bergloon(Object $erkend) {
    return ComputeHelpers.characteristic($erkend, Boolean.TRUE);
}

// zijn taxatie
function Object waarde_bergloon(Object $taxatie) {
    try {
        return ComputeHelpers.fitTarget($taxatie, Integer.valueOf(0), "bergloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "bergloon"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $taxatie : taxatie )
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "erkend", true), subject == $onderwerp, $erkend : holds )
    eval( toets_bergloon($erkend) )
then
    Object v = waarde_bergloon($taxatie);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "bergloon", ComputeHelpers.designate(v, "bergloon")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "bergloon", false), v, "bergloon"));
        }
    }
end

// hij gemeld is
function boolean toets_erkenning(Object $gemeld) {
    return ComputeHelpers.characteristic($gemeld, Boolean.TRUE);
}

rule "erkenning"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $gemeld : (ComputeHelpers.holds(gemeld)) )
    eval( toets_erkenning($gemeld) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "erkend", true)));
end

rule "stand Vondst.bergloon: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "bergloon", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "bergloon", false), $v));
end

rule "stand Vondst.bergloon: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : bergloon )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "bergloon", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "bergloon", false), $invoer));
end

rule "kenmerkstand Vondst.erkend: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(erkend) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "erkend", true), true));
end

rule "kenmerkstand Vondst.erkend: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "erkend", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "erkend", true), true));
end

rule "kenmerkstand Vondst.erkend: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(erkend) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "erkend", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "erkend", true), false));
end

