rule "kenmerkstand Vondst.gedateerd: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(gedateerd) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "gedateerd", true), true));
end

rule "kenmerkstand Vondst.gedateerd: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "gedateerd", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "gedateerd", true), true));
end

rule "kenmerkstand Vondst.gedateerd: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(gedateerd) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "gedateerd", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "gedateerd", true), false));
end

