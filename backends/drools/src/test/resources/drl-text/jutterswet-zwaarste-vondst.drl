// aan de volgende voorwaarde voldoen: zijn afgeleide dag is leeg
function boolean toets_meldklasseBijdrageAanVouw3(Object $afgeleideDag) {
    return ComputeHelpers.emptyTest($afgeleideDag, Boolean.TRUE);
}

// het gewicht van ten minste één van de vondsten van de Berging die aan de volgende voorwaarde voldoen: zijn afgeleide dag is leeg groter is dan 15
function boolean matrix_meldklasseBijdrageAanVouw3(Object $onderwerp, Object $gewicht) {
    return RegelSpraakRuntime.rsAggVergelijk($gewicht, new java.math.BigDecimal("15"), ">");
}

rule "meldklasse: bijdrage aan vouw 3"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Berging()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( berging == $vouwonderwerp, $gewicht : gewicht )
    $stand_0 : State( attribute == ElementKey.of("vondst", "afgeleide dag", false), subject == $onderwerp, $afgeleideDag : value )
    eval( toets_meldklasseBijdrageAanVouw3($afgeleideDag) )
then
    insertLogical(new Contribution("meldklasse: vouw 3", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_meldklasseBijdrageAanVouw3($onderwerp, $gewicht))));
end

rule "stand Vondst.afgeleide dag: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "afgeleide dag", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "afgeleide dag", false), $v));
end

