    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : afgeleideDag )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "afgeleide dag", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "afgeleide dag", false), $invoer));
end

