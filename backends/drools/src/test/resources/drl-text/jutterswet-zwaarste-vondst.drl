// de maximale waarde van het gewicht van alle vondsten van de berging van de Vondst die aan de volgende voorwaarde voldoen: zijn afgeleide dag is leeg
function Object waarde_zwaarste(Object $aantal_vouw_7, Object $vouw_vouw_9) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_7, $vouw_vouw_9, null), Integer.valueOf(0), "zwaarste gewicht", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "zwaarste"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    accumulate( $bijdrage_vouw_4 : Contribution( fold == "zwaarste: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_8 : value ); $aantal_vouw_7 : count(), $vouw_vouw_9 : exactMax($bijdragewaarde_vouw_8) )
then
    Object v = waarde_zwaarste($aantal_vouw_7, $vouw_vouw_9);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zwaarste", ComputeHelpers.designate(v, "zwaarste")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "zwaarste gewicht", false), v, "zwaarste"));
        }
    }
end

