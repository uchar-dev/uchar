// het gewicht van ten minste één van de vondsten van de Berging die aan de volgende voorwaarde voldoen: zijn afgeleide dag is leeg groter is dan 15
function boolean toets_meldklasse(Object $aantal_vouw_37, Object $vouw_vouw_39) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_37, $vouw_vouw_39, dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, Integer.valueOf(1));
}

// 1
function Object waarde_meldklasse() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "meldklasse", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "meldklasse"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging()
    accumulate( $bijdrage_vouw_34 : Contribution( fold == "meldklasse: vouw 3", subject == $onderwerp, $bijdragewaarde_vouw_38 : value ); $aantal_vouw_37 : count(), $vouw_vouw_39 : exactSum($bijdragewaarde_vouw_38) )
    eval( toets_meldklasse($aantal_vouw_37, $vouw_vouw_39) )
then
    Object v = waarde_meldklasse();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldklasse", ComputeHelpers.designate(v, "meldklasse")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("berging", "meldklasse", false), v, "meldklasse"));
        }
    }
end

// zijn afgeleide dag gevuld is
function boolean toets_gedateerd(Object $afgeleideDag) {
    return ComputeHelpers.emptyTest($afgeleideDag, Boolean.FALSE);
}

rule "gedateerd"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "afgeleide dag", false), subject == $onderwerp, $afgeleideDag : value )
    eval( toets_gedateerd($afgeleideDag) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "gedateerd", true)));
end

rule "registratie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( registratiedag == null, $vinddag : vinddag )
    not( $andere_schrijver : Value( attribute == ElementKey.of("vondst", "registratiedag", false) && writer != "registratie", subject == $onderwerp ) )
then
    // zijn vinddag
    Object v = $vinddag;
    if (!ComputeHelpers.isEmpty(v)) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "registratiedag", false), v, "registratie"));
    }
end

// zijn opgegeven dag gevuld is
function boolean toets_opgave(Object $opgegevenDag) {
    return ComputeHelpers.emptyTest($opgegevenDag, Boolean.FALSE);
}

rule "opgave"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $opgegevenDag : opgegevenDag )
    eval( toets_opgave($opgegevenDag) )
then
    // zijn opgegeven dag
    Object v = $opgegevenDag;
    if (!ComputeHelpers.isEmpty(v)) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "registratiedag", false), v, "opgave"));
    }
end

// zijn opgegeven dag gevuld is
function boolean toets_defaultsAVondstAfgeleideDagDefault0(Object $opgegevenDag) {
    return ComputeHelpers.emptyTest($opgegevenDag, Boolean.FALSE);
}

rule "defaults A:Vondst.afgeleide dag: default 0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $opgegevenDag : opgegevenDag )
    eval( toets_defaultsAVondstAfgeleideDagDefault0($opgegevenDag) )
then
    // zijn opgegeven dag
    Object v = $opgegevenDag;
    if (v != null) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "afgeleide dag", false), v, "defaults A:Vondst.afgeleide dag"));
        insertLogical(new Decides($onderwerp, "defaults A:Vondst.afgeleide dag", 0));
    }
end

// zijn vinddag gevuld is
function boolean toets_defaultsAVondstAfgeleideDagDefault1(Object $vinddag) {
    return ComputeHelpers.emptyTest($vinddag, Boolean.FALSE);
}

rule "defaults A:Vondst.afgeleide dag: default 1"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $vinddag : vinddag )
    not( $hoger_51 : Decides( stack == "defaults A:Vondst.afgeleide dag" && index < 1, subject == $onderwerp ) )
    eval( toets_defaultsAVondstAfgeleideDagDefault1($vinddag) )
then
    // de vinddag van de Vondst
    Object v = $vinddag;
    if (v != null) {
        insertLogical(new Value($onderwerp, ElementKey.of("vondst", "afgeleide dag", false), v, "defaults A:Vondst.afgeleide dag"));
        insertLogical(new Decides($onderwerp, "defaults A:Vondst.afgeleide dag", 1));
    }
end

function boolean beta_zwaarsteBijdrageAanVouw0(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("berging"), java.util.Arrays.asList("berging"));
}

// aan de volgende voorwaarde voldoen: zijn afgeleide dag is leeg
function boolean toets_zwaarsteBijdrageAanVouw0(Object $afgeleideDag) {
    return ComputeHelpers.emptyTest($afgeleideDag, Boolean.TRUE);
}

rule "zwaarste: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Vondst()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( beta_zwaarsteBijdrageAanVouw0(this, $vouwonderwerp), $gewicht : gewicht )
    $stand_0 : State( attribute == ElementKey.of("vondst", "afgeleide dag", false), subject == $onderwerp, $afgeleideDag : value )
    eval( toets_zwaarsteBijdrageAanVouw0($afgeleideDag) )
then
    Object v = ComputeHelpers.contribution("zwaarste: vouw 0", $vouwonderwerp, $onderwerp, $gewicht, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

function boolean beta_zwaarsteLateBijdrageAanVouw1(Object eigen, Object ander) {
    return ComputeHelpers.meeting(eigen, ander, java.util.Arrays.asList("berging"), java.util.Arrays.asList("berging"));
}

// aan de volgende voorwaarde voldoen: zijn registratiedag is later dan 01-02-2026
function boolean toets_zwaarsteLateBijdrageAanVouw1(Object $registratiedag) {
    return ComputeHelpers.dateCompare($registratiedag, java.time.LocalDate.parse("2026-02-01"), dev.uchar.regelspraak.ir.Condition.Operator.LATER);
}

rule "zwaarste late: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Vondst()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( beta_zwaarsteLateBijdrageAanVouw1(this, $vouwonderwerp), $gewicht : gewicht )
    $stand_0 : State( attribute == ElementKey.of("vondst", "registratiedag", false), subject == $onderwerp, $registratiedag : value )
    eval( toets_zwaarsteLateBijdrageAanVouw1($registratiedag) )
then
    Object v = ComputeHelpers.contribution("zwaarste late: vouw 1", $vouwonderwerp, $onderwerp, $gewicht, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

// aan de volgende voorwaarde voldoen: hij is niet gedateerd
function boolean toets_losseGewichtBijdrageAanVouw2(Object $gedateerd) {
    return ComputeHelpers.characteristic($gedateerd, Boolean.FALSE);
}

rule "losse gewicht: bijdrage aan vouw 2"
    dialect "mvel"
when
