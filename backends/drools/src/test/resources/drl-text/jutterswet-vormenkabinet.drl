package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.EvaluationDate;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.time.LocalDate rekendatum;

// de opbrengst in het voorjaar
function Object waarde_vakcijferUitVoorjaarsopbrengst(Object $opbrengst) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.cell($opbrengst, java.util.Arrays.asList("voorjaar")), Integer.valueOf(0), "vakcijfer", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vakcijfer uit voorjaarsopbrengst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schouwveld( $opbrengst : opbrengst )
then
    Object v = waarde_vakcijferUitVoorjaarsopbrengst($opbrengst);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vakcijfer uit voorjaarsopbrengst", ComputeHelpers.designate(v, "vakcijfer uit voorjaarsopbrengst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schouwveld", "vakcijfer", false), v, "vakcijfer uit voorjaarsopbrengst"));
        }
    }
end

// de aanspoeling in het voorjaar uit zee
function Object waarde_zeecijferUitVoorjaarsaanspoeling(Object $aanspoeling) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.cell($aanspoeling, java.util.Arrays.asList("voorjaar", "zee")), Integer.valueOf(0), "zeecijfer", null);
