        }
    }
end

// bewaakt, omheind, en vanaf 1 januari 2026
function boolean toets_peilingBijDubbeleBorging(Object $bewaakt, Object $omheind, Object $rekendatumwaarde_2) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($bewaakt, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($omheind, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.timeWindow(java.time.LocalDate.parse("2026-01-01"), Boolean.TRUE, null, Boolean.FALSE, Boolean.FALSE, $rekendatumwaarde_2)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3);
}

// 1
function Object waarde_peilingBijDubbeleBorging() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "peiling", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "peiling bij dubbele borging"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Schouwveld( $bewaakt : (ComputeHelpers.holds(bewaakt)), $omheind : (ComputeHelpers.holds(omheind)) )
    $rekendatum_2 : EvaluationDate( $rekendatumwaarde_2 : date )
    eval( toets_peilingBijDubbeleBorging($bewaakt, $omheind, $rekendatumwaarde_2) )
then
    Object v = waarde_peilingBijDubbeleBorging();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "peiling bij dubbele borging", ComputeHelpers.designate(v, "peiling bij dubbele borging")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("schouwveld", "peiling", false), v, "peiling bij dubbele borging"));
        }
    }
end

rule "rekendatumstand"
    dialect "mvel"
when
then
    insertLogical(new EvaluationDate(rekendatum));
end

