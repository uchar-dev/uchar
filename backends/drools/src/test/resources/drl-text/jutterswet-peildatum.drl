    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.largest(ComputeHelpers.largest(null, $bergloon), $meldloon), Integer.valueOf(0), "hoogloon", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
