function java.util.List plaats_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0(Object $onderwerp, Object $lijstplaatsen_plaats_16, Object $plaats_plaats_17) {
    return ComputeHelpers.foldPlace(dev.uchar.regelspraak.transpiler.tms.plan.Consequence.PlaceReason.FILTER_FAULT, "eerste schone maand vanaf de eindmaand: vouw 0", $onderwerp, 0, java.util.Arrays.asList("schuit"), java.util.Arrays.asList($lijstplaatsen_plaats_16), java.util.Arrays.asList($plaats_plaats_17));
}

rule "eerste schone maand vanaf de eindmaand: filterfout in vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Schuit()
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand( schuit == $vouwonderwerp, $maand : maand )
    accumulate( $lijstplaats_plaats_14 : ListPlace( field == "schuit", beta_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0(this, $onderwerp), $lijstplaatswaarde_plaats_15 : place ); $lijstplaatsen_plaats_16 : count(), $plaats_plaats_17 : exactMin($lijstplaatswaarde_plaats_15) )
    $stand_2 : CharacteristicState( characteristic == ElementKey.of("lading in-een-maand", "overlading", true), subject == $onderwerp, $overlading : holds )
    accumulate( $bijdrage_vouw_22 : Contribution( fold == "eerste schone maand vanaf de eindmaand: vouw 1", subject == $vouwonderwerp, $bijdragewaarde_vouw_26 : value ); $aantal_vouw_25 : count(), $vouw_vouw_27 : exactMax($bijdragewaarde_vouw_26) )
    eval( toets_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0($overlading, $maand, $aantal_vouw_25, $vouw_vouw_27) )
then
    RuntimeException f = fout_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0($lijstplaatsen_plaats_16, $plaats_plaats_17, $overlading, $maand, $aantal_vouw_25, $vouw_vouw_27, $onderwerp);
    if (f == null) {
        ComputeHelpers.contractBreach("het filter van eerste schone maand vanaf de eindmaand: vouw 0 faalde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    insertLogical(new FilterFault("eerste schone maand vanaf de eindmaand: vouw 0", $vouwonderwerp, $onderwerp, f, plaats_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0($onderwerp, $lijstplaatsen_plaats_16, $plaats_plaats_17)));
end

// aan de volgende voorwaarde voldoen: zijn soort is gelijk aan 'Zwaar'
function boolean toets_eersteSchoneMaandVanafDeEindmaandBijdrageAanVouw1(Object $soort) {
    return ComputeHelpers.textEqual(RegelSpraakRuntime.rsEnumNaam($soort), RegelSpraakRuntime.rsEnumNaam("Zwaar"), Boolean.TRUE);
}

rule "eerste schone maand vanaf de eindmaand: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Schuit()
    $onderwerp : dev.uchar.regelspraak.facts.Klacht( beklaagdeSchuit == $vouwonderwerp, $soort : soort, $einddag : einddag )
    eval( toets_eersteSchoneMaandVanafDeEindmaandBijdrageAanVouw1($soort) )
then
    Object v = ComputeHelpers.contribution("eerste schone maand vanaf de eindmaand: vouw 1", $vouwonderwerp, $onderwerp, $einddag, null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

rule "kenmerkstand Lading in-een-maand.overlading: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand( ComputeHelpers.holds(overlading) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("lading in-een-maand", "overlading", true), true));
end

rule "kenmerkstand Lading in-een-maand.overlading: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("lading in-een-maand", "overlading", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("lading in-een-maand", "overlading", true), true));
end

rule "kenmerkstand Lading in-een-maand.overlading: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.LadingInEenMaand( ComputeHelpers.holds(overlading) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("lading in-een-maand", "overlading", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("lading in-een-maand", "overlading", true), false));
end

