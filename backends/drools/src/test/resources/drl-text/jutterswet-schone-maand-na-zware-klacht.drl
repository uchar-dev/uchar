function boolean samengesteld2_eersteSchoneMaandVanafDeEindmaandFilterfoutInVouw0(Object $lijstplaatsen_plaats_16, Object $plaats_plaats_17, Object $overlading, Object $maand, Object $aantal_vouw_25, Object $vouw_vouw_27, Object $onderwerp) {
