package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;

// ten minste 2 van de volgende gelden
function boolean toets_gemengdBijTenminsteTwee(Object $toegewezenWachtpostGezet, Object $actief) {
    var lezing = ComputeHelpers.composite(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 2, 3, null);
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.roleField($toegewezenWachtpostGezet, Boolean.FALSE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.roleField($toegewezenWachtpostGezet, Boolean.TRUE));
    if (lezing.stands()) {
        return lezing.verdict();
    }
    lezing.read(ComputeHelpers.characteristic($actief, Boolean.TRUE));
    return lezing.verdict();
}

rule "gemengd bij tenminste twee"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $toegewezenWachtpostGezet : (ComputeHelpers.isSet(toegewezenWachtpost, null)), $actief : (ComputeHelpers.holds(actief)) )
    eval( toets_gemengdBijTenminsteTwee($toegewezenWachtpostGezet, $actief) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("jutter", "gemengd", true)));
end

