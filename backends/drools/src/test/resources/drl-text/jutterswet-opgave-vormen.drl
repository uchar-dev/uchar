// de waarde van de Vondst maal 2
function Object waarde_premie(Object $waarde2) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal($waarde2, new java.math.BigDecimal("2")), Integer.valueOf(2), "premie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "premie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "waarde", false), subject == $onderwerp, $waarde2 : value )
then
    Object v = waarde_premie($waarde2);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "premie", ComputeHelpers.designate(v, "premie")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "premie", false), v, "premie"));
        }
    }
end

// zijn soort gelijk is aan "zeewier"
