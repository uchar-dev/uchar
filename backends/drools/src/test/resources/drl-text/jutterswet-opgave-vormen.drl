// de taxatie van de Vondst kleiner is dan 10,00 en hij museaal is
function boolean toets_defaultsAVondstBerekendeWaardeDefault000(Object $taxatie, Object $museaal) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($taxatie, new java.math.BigDecimal("10"), "<")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($museaal, Boolean.TRUE)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

rule "defaults A:Vondst.berekende waarde: default 0.0.0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Vondst"), $taxatie : taxatie, $museaal : (ComputeHelpers.holds(museaal)) )
    eval( toets_defaultsAVondstBerekendeWaardeDefault000($taxatie, $museaal) )
then
    // 100,00
    Object v = new java.math.BigDecimal("100");
    if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults A:Vondst.berekende waarde", 1, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

