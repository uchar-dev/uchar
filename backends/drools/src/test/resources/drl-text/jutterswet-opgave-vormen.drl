// hij heeft geen afwijkende opgave waarde
function boolean toets_controleOpgaveWaarde(Object $afwijkendeOpgaveWaarde) {
    return ComputeHelpers.not(ComputeHelpers.characteristic($afwijkendeOpgaveWaarde, Boolean.FALSE));
}

rule "controle opgave waarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "afwijkende opgave waarde", true), subject == $onderwerp, $afwijkendeOpgaveWaarde : holds )
    eval( toets_controleOpgaveWaarde($afwijkendeOpgaveWaarde) )
then
    insertLogical(ComputeHelpers.inconsistency("controle opgave waarde", $onderwerp, ComputeHelpers.list1("EF-025")));
end

