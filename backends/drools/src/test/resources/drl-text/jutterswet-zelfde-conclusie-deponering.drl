// zijn gewicht gedeeld door zijn aantal getuigen leeg is
function java.util.List deponering_defaultsAVondstMeldloonDefault1DeponeringInDeVoorwaarde(Object $gewicht, Object open_invoer, Object $onderwerp, Object $aantalGetuigen, Object sonde) {
