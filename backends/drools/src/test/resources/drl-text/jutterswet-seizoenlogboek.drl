package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn vondstsoort in zomer
function Object waarde_najaarssoortVanEenJutter(Object $vondstsoort) {
    try {
        return ComputeHelpers.cell($vondstsoort, java.util.Arrays.asList("zomer"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "najaarssoort van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstsoort : vondstsoort )
then
    Object v = waarde_najaarssoortVanEenJutter($vondstsoort);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "najaarssoort van een jutter", ComputeHelpers.designate(v, "najaarssoort van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vondstsoort[najaar]", false), v, "najaarssoort van een jutter"));
        }
    }
end

