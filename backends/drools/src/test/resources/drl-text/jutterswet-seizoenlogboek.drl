        }
    }
end

// zijn vergunning in zomer gelijk is aan waar
function boolean toets_zomertariefVanEenJutter(Object $vergunning) {
    return ComputeHelpers.textEqual(ComputeHelpers.cell($vergunning, java.util.Arrays.asList("zomer")), Boolean.TRUE, Boolean.TRUE);
}

// 2
function Object waarde_zomertariefVanEenJutter() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("2"), Integer.valueOf(0), "zomertarief", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "zomertarief van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vergunning : vergunning )
    eval( toets_zomertariefVanEenJutter($vergunning) )
then
    Object v = waarde_zomertariefVanEenJutter();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zomertarief van een jutter", ComputeHelpers.designate(v, "zomertarief van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "zomertarief", false), v, "zomertarief van een jutter"));
        }
    }
end

rule "stand Jutter.vondstsoort[najaar]: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $waarde : Value( attribute == ElementKey.of("jutter", "vondstsoort[najaar]", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "vondstsoort[najaar]", false), $v));
end

rule "stand Jutter.vondstsoort[najaar]: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $invoer : vondstsoort )
    not( $waarde : Value( attribute == ElementKey.of("jutter", "vondstsoort[najaar]", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("jutter", "vondstsoort[najaar]", false), ComputeHelpers.cell($invoer, java.util.Arrays.asList("najaar"))));
end

