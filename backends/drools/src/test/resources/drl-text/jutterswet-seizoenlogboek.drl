// de eerste van zijn vondstsoort over alle seizoenen
function Object waarde_eersteSoortVanEenJutter(Object $vondstsoort, Object $vondstsoort2) {
    try {
        return ComputeHelpers.firstCell(ComputeHelpers.map(ComputeHelpers.withCell($vondstsoort, java.util.Arrays.asList("najaar"), $vondstsoort2)), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar")));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "eerste soort van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstsoort : vondstsoort )
    $stand_1 : State( attribute == ElementKey.of("jutter", "vondstsoort[najaar]", false), subject == $onderwerp, $vondstsoort2 : value )
then
    Object v = waarde_eersteSoortVanEenJutter($vondstsoort, $vondstsoort2);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "eerste soort van een jutter", ComputeHelpers.designate(v, "eerste soort van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "eerste soort", false), v, "eerste soort van een jutter"));
        }
    }
end

// het aantal voorkomens van zijn vondstsoort over alle seizoenen
function Object waarde_aantalSoortseizoenenVanEenJutter(Object $vondstsoort, Object $vondstsoort2) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.filledCells(ComputeHelpers.map(ComputeHelpers.withCell($vondstsoort, java.util.Arrays.asList("najaar"), $vondstsoort2)), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar"))), Integer.valueOf(0), "aantal soortseizoenen", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aantal soortseizoenen van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $vondstsoort : vondstsoort )
    $stand_1 : State( attribute == ElementKey.of("jutter", "vondstsoort[najaar]", false), subject == $onderwerp, $vondstsoort2 : value )
then
    Object v = waarde_aantalSoortseizoenenVanEenJutter($vondstsoort, $vondstsoort2);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aantal soortseizoenen van een jutter", ComputeHelpers.designate(v, "aantal soortseizoenen van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aantal soortseizoenen", false), v, "aantal soortseizoenen van een jutter"));
        }
    }
end

