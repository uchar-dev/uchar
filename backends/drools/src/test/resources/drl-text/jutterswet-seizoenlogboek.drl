// de laatste van zijn meldingsdatum over alle seizoenen
function Object waarde_laatsteMeldingVanEenJutter(Object $meldingsdatum) {
    try {
        return ComputeHelpers.lastCell(ComputeHelpers.map($meldingsdatum), java.util.Arrays.asList(java.util.Arrays.asList("voorjaar"), java.util.Arrays.asList("zomer"), java.util.Arrays.asList("najaar")));
    } catch (RuntimeException e) {
