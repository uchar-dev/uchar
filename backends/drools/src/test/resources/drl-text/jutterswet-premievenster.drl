rule "bergloon van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $meldatum : meldatum )
    $rekendatum_1 : EvaluationDate( $rekendatumwaarde_1 : date )
    eval( toets_bergloonVanEenVondst($meldatum, $rekendatumwaarde_1) )
then
    Object v = waarde_bergloonVanEenVondst();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "bergloon van een vondst", ComputeHelpers.designate(v, "bergloon van een vondst")));
    } else {
