package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.EvaluationDate;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

global java.time.LocalDate rekendatum;

// 1
function Object waarde_basispremieVanEenVondst() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "basispremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "basispremie van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
then
    Object v = waarde_basispremieVanEenVondst();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "basispremie van een vondst", ComputeHelpers.designate(v, "basispremie van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "basispremie", false), v, "basispremie van een vondst"));
        }
    }
end

// van 1 januari 2024 tot 1 januari 2025
function boolean toets_vondstpremieVanEenVondst(Object $rekendatumwaarde_0) {
    return ComputeHelpers.timeWindow(java.time.LocalDate.parse("2024-01-01"), Boolean.TRUE, java.time.LocalDate.parse("2025-01-01"), Boolean.TRUE, Boolean.FALSE, $rekendatumwaarde_0);
}

// 50
function Object waarde_vondstpremieVanEenVondst() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("50"), Integer.valueOf(0), "vondstpremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vondstpremie van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $rekendatum_0 : EvaluationDate( $rekendatumwaarde_0 : date )
    eval( toets_vondstpremieVanEenVondst($rekendatumwaarde_0) )
then
    Object v = waarde_vondstpremieVanEenVondst();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vondstpremie van een vondst", ComputeHelpers.designate(v, "vondstpremie van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "vondstpremie", false), v, "vondstpremie van een vondst"));
        }
    }
end

