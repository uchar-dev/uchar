        }
    }
end

// de Vondst geborgen is, en van 1 januari 2024 tot 1 januari 2025
function boolean toets_borgpremieVanEenVondst(Object $geborgen, Object $rekendatumwaarde_1) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($geborgen, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.timeWindow(java.time.LocalDate.parse("2024-01-01"), Boolean.TRUE, java.time.LocalDate.parse("2025-01-01"), Boolean.TRUE, Boolean.FALSE, $rekendatumwaarde_1)) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
}

// 15
function Object waarde_borgpremieVanEenVondst() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("15"), Integer.valueOf(0), "borgpremie", null);
    } catch (RuntimeException e) {
