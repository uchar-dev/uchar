// vanaf de meldatum van de Vondst
function boolean toets_bergloonVanEenVondst(Object $meldatum, Object $rekendatumwaarde_1) {
    return ComputeHelpers.timeWindow($meldatum, Boolean.TRUE, null, Boolean.FALSE, Boolean.FALSE, $rekendatumwaarde_1);
}

