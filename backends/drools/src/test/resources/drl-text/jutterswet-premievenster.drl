    }
}

rule "borgpremie van een vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $geborgen : (ComputeHelpers.holds(geborgen)) )
    $rekendatum_1 : EvaluationDate( $rekendatumwaarde_1 : date )
    eval( toets_borgpremieVanEenVondst($geborgen, $rekendatumwaarde_1) )
then
    Object v = waarde_borgpremieVanEenVondst();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "borgpremie van een vondst", ComputeHelpers.designate(v, "borgpremie van een vondst")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "borgpremie", false), v, "borgpremie van een vondst"));
        }
    }
end

rule "rekendatumstand"
    dialect "mvel"
when
then
    insertLogical(new EvaluationDate(rekendatum));
end

