}

// 12,50
function Object creatie_getaxeerdeVondst(Object $fase, Object $herkomsten_creatie_43, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("getaxeerde vondst", 0, "Jutter", (java.util.List) $herkomsten_creatie_43, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.construct("waarde", new java.math.BigDecimal("12.5")));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Vondst");
    ComputeHelpers.set(nieuw, "taxatie", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("getaxeerde vondst", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("vangst", $onderwerp, nieuw, fase));
