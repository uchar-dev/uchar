}

rule "getaxeerde vondst"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $ervaren : (ComputeHelpers.holds(ervaren)) )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_42 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_43 : collectList($herkomst_creatie_42) )
    not( $gemaakt_creatie_45 : CreationStamp( rule == "getaxeerde vondst", subject == $onderwerp ) )
    not( $nieuw_creatie_46 : CreationStamp( object == $onderwerp, beta_getaxeerdeVondst(this, $fase) ) )
    eval( toets_getaxeerdeVondst($ervaren) )
    not( $eigen_fout : Fault( rule == "getaxeerde vondst", subject == $onderwerp ) )
then
    Object v = creatie_getaxeerdeVondst($fase, $herkomsten_creatie_43, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "getaxeerde vondst", ComputeHelpers.designate(v, "getaxeerde vondst")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

// een waarde hebben
function boolean toets_getaxeerdTotaalBijdrageAanVouw0(Object $taxatie) {
    return ComputeHelpers.emptyTest(ComputeHelpers.payload($taxatie, "waarde"), Boolean.FALSE);
}

rule "getaxeerd totaal: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    exists( $koppeling_bereik_4 : RelationLink( relation == "vangst", second == $onderwerp, first == $vouwonderwerp ) )
    $stand_0 : State( attribute == ElementKey.of("vondst", "taxatie", false), subject == $onderwerp, $taxatie : value )
    eval( toets_getaxeerdTotaalBijdrageAanVouw0($taxatie) )
then
    Object v = ComputeHelpers.contribution("getaxeerd totaal: vouw 0", $vouwonderwerp, $onderwerp, ComputeHelpers.payload($taxatie, "waarde"), null, null, false, false);
    if (v != null) {
        insertLogical(v);
    }
end

// ongetaxeerd zijn
function boolean toets_aantalOngetaxeerdeVondstenBijdrageAanVouw1(Object $ongetaxeerd) {
    return ComputeHelpers.characteristic($ongetaxeerd, Boolean.TRUE);
}

rule "aantal ongetaxeerde vondsten: bijdrage aan vouw 1"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Jutter()
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    exists( $koppeling_bereik_17 : RelationLink( relation == "vangst", second == $onderwerp, first == $vouwonderwerp ) )
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("vondst", "ongetaxeerd", true), subject == $onderwerp, $ongetaxeerd : holds )
    eval( toets_aantalOngetaxeerdeVondstenBijdrageAanVouw1($ongetaxeerd) )
then
    insertLogical(new Contribution("aantal ongetaxeerde vondsten: vouw 1", $vouwonderwerp, $onderwerp, null));
end

rule "koppeling vangst uit de invoer: Vondst.jutter"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Vondst( jutter != null, $ander : jutter )
then
    insertLogical(new RelationLink("vangst", $ander, $houder, 0));
end

function boolean beta_koppelingVangstTweedeVullingVanJutter(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling vangst: tweede vulling van jutter"
    dialect "mvel"
when
    $een : RelationLink( relation == "vangst", $nabij : second )
    $twee : RelationLink( relation == "vangst", second != null, second == $een.second, beta_koppelingVangstTweedeVullingVanJutter(this, $een) )
then
    insertLogical(new Fault($nabij, "vangst", new SecondFillingFault("jutter", $nabij)));
end

rule "stand Vondst.taxatie: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "taxatie", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "taxatie", false), $v));
end

rule "stand Vondst.taxatie: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : taxatie )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "taxatie", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "taxatie", false), $invoer));
end

rule "kenmerkstand Vondst.ongetaxeerd: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(ongetaxeerd) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "ongetaxeerd", true), true));
end

rule "kenmerkstand Vondst.ongetaxeerd: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "ongetaxeerd", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "ongetaxeerd", true), true));
end

rule "kenmerkstand Vondst.ongetaxeerd: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(ongetaxeerd) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "ongetaxeerd", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "ongetaxeerd", true), false));
end

