package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.CreationStamp;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// hij drijfhout is
function boolean toets_vasteTaxatie(Object $drijfhout) {
    return ComputeHelpers.characteristic($drijfhout, Boolean.TRUE);
}

// 5,00
function Object waarde_vasteTaxatie() {
    try {
        return ComputeHelpers.construct("waarde", new java.math.BigDecimal("5"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vaste taxatie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $drijfhout : (ComputeHelpers.holds(drijfhout)) )
    eval( toets_vasteTaxatie($drijfhout) )
then
    Object v = waarde_vasteTaxatie();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vaste taxatie", ComputeHelpers.designate(v, "vaste taxatie")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "taxatie", false), v, "vaste taxatie"));
        }
    }
end

// zijn taxatie onbekend is
function boolean toets_ongetaxeerdeVondst(Object $taxatie) {
    return ComputeHelpers.textEqual($taxatie, ComputeHelpers.constructorValue("onbekend"), Boolean.TRUE);
}

rule "ongetaxeerde vondst"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "taxatie", false), subject == $onderwerp, $taxatie : value )
    eval( toets_ongetaxeerdeVondst($taxatie) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vondst", "ongetaxeerd", true)));
end

// de som van de taxatie van alle vondsten van de Jutter die een waarde hebben
function Object waarde_getaxeerdTotaal(Object $aantal_vouw_14, Object $vouw_vouw_16) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.foldValue($aantal_vouw_14, $vouw_vouw_16, null), Integer.valueOf(2), "getaxeerd totaal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "getaxeerd totaal"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_11 : Contribution( fold == "getaxeerd totaal: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_15 : value ); $aantal_vouw_14 : count(), $vouw_vouw_16 : exactSum($bijdragewaarde_vouw_15) )
then
    Object v = waarde_getaxeerdTotaal($aantal_vouw_14, $vouw_vouw_16);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "getaxeerd totaal", ComputeHelpers.designate(v, "getaxeerd totaal")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "getaxeerd totaal", false), v, "getaxeerd totaal"));
        }
    }
end

// het aantal vondsten van de Jutter die ongetaxeerd zijn
function Object waarde_aantalOngetaxeerdeVondsten(Object $aantal_vouw_27) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_27), Integer.valueOf(0), "aantal ongetaxeerde vondsten", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "aantal ongetaxeerde vondsten"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_24 : Contribution( fold == "aantal ongetaxeerde vondsten: vouw 1", subject == $onderwerp ); $aantal_vouw_27 : count() )
then
    Object v = waarde_aantalOngetaxeerdeVondsten($aantal_vouw_27);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "aantal ongetaxeerde vondsten", ComputeHelpers.designate(v, "aantal ongetaxeerde vondsten")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "aantal ongetaxeerde vondsten", false), v, "aantal ongetaxeerde vondsten"));
        }
    }
end

function boolean beta_onbekendeVondst(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// hij actief is
function boolean toets_onbekendeVondst(Object $actief) {
    return ComputeHelpers.characteristic($actief, Boolean.TRUE);
}

// onbekend
function Object creatie_onbekendeVondst(Object $fase, Object $herkomsten_creatie_30, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("onbekende vondst", 0, "Jutter", (java.util.List) $herkomsten_creatie_30, 100);
    Object i0 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.constructorValue("onbekend"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Vondst");
    ComputeHelpers.set(nieuw, "taxatie", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("onbekende vondst", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("vangst", $onderwerp, nieuw, fase));
    return feiten;
}

rule "onbekende vondst"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $actief : (ComputeHelpers.holds(actief)) )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_29 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_30 : collectList($herkomst_creatie_29) )
    not( $gemaakt_creatie_32 : CreationStamp( rule == "onbekende vondst", subject == $onderwerp ) )
    not( $nieuw_creatie_33 : CreationStamp( object == $onderwerp, beta_onbekendeVondst(this, $fase) ) )
    eval( toets_onbekendeVondst($actief) )
    not( $eigen_fout : Fault( rule == "onbekende vondst", subject == $onderwerp ) )
then
    Object v = creatie_onbekendeVondst($fase, $herkomsten_creatie_30, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "onbekende vondst", ComputeHelpers.designate(v, "onbekende vondst")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

function boolean beta_getaxeerdeVondst(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// hij ervaren is
function boolean toets_getaxeerdeVondst(Object $ervaren) {
