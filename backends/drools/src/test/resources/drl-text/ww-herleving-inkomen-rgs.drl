rule "stand Werknemer.verstreken periode: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Werknemer()
    $waarde : Value( attribute == ElementKey.of("werknemer", "verstreken periode", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("werknemer", "verstreken periode", false), $v));
end

rule "stand Werknemer.verstreken periode: uit de invoer"
