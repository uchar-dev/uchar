// zijn maandloon maal 0,8750 rekenkundig afgerond op 2 decimalen
function Object waarde_inkomensgrensVanEenWerknemer(Object $maandloon) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsAfronding(RegelSpraakRuntime.rsMaal($maandloon, new java.math.BigDecimal("0.875")), Integer.valueOf(2), java.math.RoundingMode.HALF_UP), Integer.valueOf(2), "inkomensgrens", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "inkomensgrens van een werknemer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Werknemer( $maandloon : maandloon )
then
    Object v = waarde_inkomensgrensVanEenWerknemer($maandloon);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "inkomensgrens van een werknemer", ComputeHelpers.designate(v, "inkomensgrens van een werknemer")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("werknemer", "inkomensgrens", false), v, "inkomensgrens van een werknemer"));
        }
    }
end

// de tijdsduur van zijn eindigingsdatum tot zijn vervaldatum in hele dagen
function Object waarde_verstrekenPeriodeBijHerleving(Object $eindigingsdatum, Object $vervaldatum) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsTijdsduur(((java.time.temporal.Temporal) $eindigingsdatum), ((java.time.temporal.Temporal) $vervaldatum), "DAYS", Boolean.FALSE), Integer.valueOf(0), "verstreken periode", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "verstreken periode bij herleving"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Werknemer( $eindigingsdatum : eindigingsdatum, $vervaldatum : vervaldatum )
then
    Object v = waarde_verstrekenPeriodeBijHerleving($eindigingsdatum, $vervaldatum);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "verstreken periode bij herleving", ComputeHelpers.designate(v, "verstreken periode bij herleving")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("werknemer", "verstreken periode", false), v, "verstreken periode bij herleving"));
        }
    }
end

// zijn maxdatum plus zijn verstreken periode
function Object waarde_nieuweMaxdatumBijHerleving(Object $maxdatum, Object $verstrekenPeriode) {
    try {
        return ComputeHelpers.dateStep($maxdatum, $verstrekenPeriode, "DAYS", Boolean.TRUE);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "nieuwe maxdatum bij herleving"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Werknemer( $maxdatum : maxdatum )
    $stand_1 : State( attribute == ElementKey.of("werknemer", "verstreken periode", false), subject == $onderwerp, $verstrekenPeriode : value )
then
    Object v = waarde_nieuweMaxdatumBijHerleving($maxdatum, $verstrekenPeriode);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "nieuwe maxdatum bij herleving", ComputeHelpers.designate(v, "nieuwe maxdatum bij herleving")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("werknemer", "nieuwe maxdatum", false), v, "nieuwe maxdatum bij herleving"));
        }
    }
end

// hij werkloos is en zijn maandinkomen groter is dan zijn inkomensgrens en hij omstandigheid vervallen is en hij is nieuw recht ontstaan en zijn nieuw maandloon is groter dan zijn inkomensgrens
function boolean toets_defaultsKWerknemerRechtOpUitkeringDefault00000(Object $werkloos, Object $maandinkomen, Object $inkomensgrens, Object $omstandigheidVervallen, Object $nieuwRechtOntstaan, Object $nieuwMaandloon) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 5);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($werkloos, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 4);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($maandinkomen, $inkomensgrens, ">")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2, 3);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($omstandigheidVervallen, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 3, 2);
    if (vast != null) {
        return vast;
    }
    if (ComputeHelpers.characteristic($nieuwRechtOntstaan, Boolean.TRUE)) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 4, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($nieuwMaandloon, $inkomensgrens, ">")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 5);
}

rule "defaults K:Werknemer.recht op uitkering: default 0.0.0.0.0"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Werknemer( ComputeHelpers.classIs(this, "dev.uchar.regelspraak.facts.Werknemer"), $werkloos : (ComputeHelpers.holds(werkloos)), $maandinkomen : maandinkomen, $omstandigheidVervallen : (ComputeHelpers.holds(omstandigheidVervallen)), $nieuwRechtOntstaan : (ComputeHelpers.holds(nieuwRechtOntstaan)), $nieuwMaandloon : nieuwMaandloon )
    $stand_2 : State( attribute == ElementKey.of("werknemer", "inkomensgrens", false), subject == $onderwerp, $inkomensgrens : value )
    eval( toets_defaultsKWerknemerRechtOpUitkeringDefault00000($werkloos, $maandinkomen, $inkomensgrens, $omstandigheidVervallen, $nieuwRechtOntstaan, $nieuwMaandloon) )
then
    Object v = Boolean.FALSE;
    if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults K:Werknemer.recht op uitkering", 2, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

rule "defaults K:Werknemer.recht op uitkering: eens 0.0.0"
    dialect "mvel"
when
    $besluit : Outcome( stack == "defaults K:Werknemer.recht op uitkering" && kind == dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED && chain >= 2 && chain < 3, $onderwerp : subject, $waarde : value )
then
    Object v = $waarde;
    if (v != null) {
        insertLogical(new Outcome($onderwerp, "defaults K:Werknemer.recht op uitkering", 1, 0, dev.uchar.regelspraak.transpiler.tms.Outcome.Kind.DECIDED, v, null));
    }
end

// hij werkloos is en zijn maandinkomen groter is dan zijn inkomensgrens en hij omstandigheid vervallen is
function boolean toets_defaultsKWerknemerRechtOpUitkeringTerugval000(Object $werkloos, Object $maandinkomen, Object $inkomensgrens, Object $omstandigheidVervallen) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 3);
    if (vast != null) {
