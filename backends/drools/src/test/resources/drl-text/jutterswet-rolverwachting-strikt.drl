function Object pad_padstandVondstVinderNaarJutterBonusLinkAanwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("vinder"));
}

rule "padstand Vondst.vinder naar Jutter.bonus: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( pad_padstandVondstVinderNaarJutterBonusLinkAanwezig(this) != null, $bereikt : vinder )
    $stap_keten_15 : dev.uchar.regelspraak.facts.Jutter( this == $bereikt, $v : bonus )
then
    insertLogical(new PathState($onderwerp, "Vondst:vinder", ElementKey.of("jutter", "bonus", false), ComputeHelpers.input($v, open_invoer, $bereikt, ElementKey.of("jutter", "bonus", false)), $bereikt));
end

function Object pad_padstandVondstVinderNaarJutterBonusLinkAfwezig(Object o) {
    return ComputeHelpers.along(o, java.util.Arrays.asList("vinder"));
}

rule "padstand Vondst.vinder naar Jutter.bonus: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( pad_padstandVondstVinderNaarJutterBonusLinkAfwezig(this) == null )
then
    insertLogical(new PathState($onderwerp, "Vondst:vinder", ElementKey.of("jutter", "bonus", false), ComputeHelpers.missingLink($onderwerp, java.util.Arrays.asList("vinder"), java.util.Arrays.asList(ElementKey.role("vinding", 0, "vinder")), open_invoer), null));
end

