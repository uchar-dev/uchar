package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn aantal getuigen
function Object waarde_meldingsgetal(Object $aantalGetuigen) {
    try {
        return ComputeHelpers.fitTarget($aantalGetuigen, Integer.valueOf(0), "meldingsgetal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "meldingsgetal"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $aantalGetuigen : aantalGetuigen )
then
    Object v = waarde_meldingsgetal($aantalGetuigen);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldingsgetal", ComputeHelpers.designate(v, "meldingsgetal")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "meldingsgetal", false), v, "meldingsgetal"));
        }
    }
end

// zijn meldingsgetal groter is dan 20
function boolean toets_spoedpremieBijVeelMeldingen(Object $meldingsgetal) {
    return RegelSpraakRuntime.rsAggVergelijk($meldingsgetal, new java.math.BigDecimal("20"), ">");
}

// zijn boete
function Object waarde_spoedpremieBijVeelMeldingen(Object $boete) {
    try {
        return ComputeHelpers.fitTarget($boete, Integer.valueOf(0), "spoedpremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "spoedpremie bij veel meldingen"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $boete : boete )
    $stand_0 : State( attribute == ElementKey.of("vondst", "meldingsgetal", false), subject == $onderwerp, $meldingsgetal : value )
    eval( toets_spoedpremieBijVeelMeldingen($meldingsgetal) )
then
    Object v = waarde_spoedpremieBijVeelMeldingen($boete);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "spoedpremie bij veel meldingen", ComputeHelpers.designate(v, "spoedpremie bij veel meldingen")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "spoedpremie", false), v, "spoedpremie bij veel meldingen"));
        }
    }
end

// zijn meldingsgetal kleiner is dan 5
function boolean toets_spoedpremieBijWeinigMeldingen(Object $meldingsgetal) {
    return RegelSpraakRuntime.rsAggVergelijk($meldingsgetal, new java.math.BigDecimal("5"), "<");
}

// 1
function Object waarde_spoedpremieBijWeinigMeldingen() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "spoedpremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "spoedpremie bij weinig meldingen"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "meldingsgetal", false), subject == $onderwerp, $meldingsgetal : value )
    eval( toets_spoedpremieBijWeinigMeldingen($meldingsgetal) )
then
    Object v = waarde_spoedpremieBijWeinigMeldingen();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "spoedpremie bij weinig meldingen", ComputeHelpers.designate(v, "spoedpremie bij weinig meldingen")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "spoedpremie", false), v, "spoedpremie bij weinig meldingen"));
        }
    }
end

function boolean toets_schrijversVondstSpoedpremieVerschil(Object $waarden) {
    return ComputeHelpers.differ($waarden);
}

rule "schrijvers Vondst.spoedpremie: verschil"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    accumulate( $waarde : Value( attribute == ElementKey.of("vondst", "spoedpremie", false), subject == $onderwerp ); $waarden : collectList($waarde) )
    eval( toets_schrijversVondstSpoedpremieVerschil($waarden) )
then
    insertLogical(ComputeHelpers.writersConflict($onderwerp, $waarden, "spoedpremie", ComputeHelpers.list3("meldingsgetal", "spoedpremie bij veel meldingen", "spoedpremie bij weinig meldingen"), ComputeHelpers.list1("Vondst"), ComputeHelpers.list1("Vondst")));
end

rule "stand Vondst.meldingsgetal: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "meldingsgetal", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "meldingsgetal", false), $v));
end

rule "stand Vondst.meldingsgetal: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : meldingsgetal )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "meldingsgetal", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "meldingsgetal", false), $invoer));
end

