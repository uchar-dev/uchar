package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// zijn meldingsgetal kleiner is dan 5
function boolean toets_spoedpremie(Object $meldingsgetal) {
    return RegelSpraakRuntime.rsAggVergelijk($meldingsgetal, new java.math.BigDecimal("5"), "<");
}

// 1
function Object waarde_spoedpremie() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "spoedpremie", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "spoedpremie"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $stand_0 : State( attribute == ElementKey.of("vondst", "meldingsgetal", false), subject == $onderwerp, $meldingsgetal : value )
    eval( toets_spoedpremie($meldingsgetal) )
then
    Object v = waarde_spoedpremie();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "spoedpremie", ComputeHelpers.designate(v, "spoedpremie")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "spoedpremie", false), v, "spoedpremie"));
        }
    }
end

// zijn aantal getuigen
function Object waarde_meldingsgetal(Object $aantalGetuigen) {
    try {
        return ComputeHelpers.fitTarget($aantalGetuigen, Integer.valueOf(0), "meldingsgetal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "meldingsgetal"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $aantalGetuigen : aantalGetuigen )
then
    Object v = waarde_meldingsgetal($aantalGetuigen);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldingsgetal", ComputeHelpers.designate(v, "meldingsgetal")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vondst", "meldingsgetal", false), v, "meldingsgetal"));
        }
    }
end

rule "stand Vondst.meldingsgetal: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $waarde : Value( attribute == ElementKey.of("vondst", "meldingsgetal", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "meldingsgetal", false), $v));
end

rule "stand Vondst.meldingsgetal: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( $invoer : meldingsgetal )
    not( $waarde : Value( attribute == ElementKey.of("vondst", "meldingsgetal", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("vondst", "meldingsgetal", false), $invoer));
end

