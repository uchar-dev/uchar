rule "wachttal van een ploeg"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ploeg()
    accumulate( $bijdrage_vouw_29 : Contribution( fold == "wachttal van een ploeg: vouw 1", subject == $onderwerp ); $aantal_vouw_32 : count() )
then
