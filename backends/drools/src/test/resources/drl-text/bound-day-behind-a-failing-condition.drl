package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.Value;

// hij actief is
function boolean toets_jaartalVanEenBaken(Object $actief) {
    return ComputeHelpers.characteristic($actief, Boolean.TRUE);
}

// het jaar uit de dag
function Object waarde_jaartalVanEenBaken() {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsDatumDeel(ComputeHelpers.fail("a BoundDay is the bound day of a day-kind definition (ch. 3.7); outside a day-kind evaluation it denotes nothing"), java.time.temporal.ChronoField.YEAR), Integer.valueOf(0), "jaartal", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jaartal van een baken"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Baken( $actief : (ComputeHelpers.holds(actief)) )
    eval( toets_jaartalVanEenBaken($actief) )
then
    Object v = waarde_jaartalVanEenBaken();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jaartal van een baken", ComputeHelpers.designate(v, "jaartal van een baken")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("baken", "jaartal", false), v, "jaartal van een baken"));
        }
    }
end

// hij aan ten minste een van de volgende voorwaarden voldoet
function boolean toets_gemeldBaken(Object $actief) {
    try {
        int raak = 0;
        Boolean vast;
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 0, 2);
        if (vast != null) {
            return vast;
        }
        if (ComputeHelpers.characteristic($actief, Boolean.FALSE)) {
            raak++;
        }
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 1, 1);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk(RegelSpraakRuntime.rsDatumDeel(ComputeHelpers.fail("a BoundDay is the bound day of a day-kind definition (ch. 3.7); outside a day-kind evaluation it denotes nothing"), java.time.temporal.ChronoField.YEAR), new java.math.BigDecimal("2000"), ">")) {
            raak++;
        }
        return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 2);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

rule "gemeld baken"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Baken( $actief : (ComputeHelpers.holds(actief)) )
    eval( toets_gemeldBaken($actief) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("baken", "gemeld", true)));
end

// hij aan ten minste een van de volgende voorwaarden voldoet
function boolean toets_gemeldBakenFoutInDeVoorwaarde(Object $actief) {
    try {
        boolean uitkomst = samengesteld1_gemeldBakenFoutInDeVoorwaarde($actief);
        return false;
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return true;
    }
}

// hij aan ten minste een van de volgende voorwaarden voldoet
function boolean samengesteld1_gemeldBakenFoutInDeVoorwaarde(Object $actief) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 0, 2);
    if (vast != null) {
