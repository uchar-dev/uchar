package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.CharacteristicState;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.CreationStamp;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de Kamer is groot
function boolean toets_heffingVanEenGroteKamer(Object $groot) {
    return ComputeHelpers.characteristic($groot, Boolean.TRUE);
}

// de grondslag van de Kamer maal 2
function Object waarde_heffingVanEenGroteKamer(Object $grondslag) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsMaal($grondslag, new java.math.BigDecimal("2")), Integer.valueOf(0), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffing van een grote kamer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("kamer", "groot", true), subject == $onderwerp, $groot : holds )
    $stand_1 : State( attribute == ElementKey.of("kamer", "grondslag", false), subject == $onderwerp, $grondslag : value )
    eval( toets_heffingVanEenGroteKamer($groot) )
then
    Object v = waarde_heffingVanEenGroteKamer($grondslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing van een grote kamer", ComputeHelpers.designate(v, "heffing van een grote kamer")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("kamer", "heffing", false), v, "heffing van een grote kamer"));
        }
    }
end

// de Kamer is niet groot
function boolean toets_heffingVanEenGewoneKamer(Object $groot) {
    return ComputeHelpers.characteristic($groot, Boolean.FALSE);
}

// de grondslag van de Kamer
function Object waarde_heffingVanEenGewoneKamer(Object $grondslag) {
    try {
        return ComputeHelpers.fitTarget($grondslag, Integer.valueOf(0), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffing van een gewone kamer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer()
    $stand_0 : CharacteristicState( characteristic == ElementKey.of("kamer", "groot", true), subject == $onderwerp, $groot : holds )
    $stand_1 : State( attribute == ElementKey.of("kamer", "grondslag", false), subject == $onderwerp, $grondslag : value )
    eval( toets_heffingVanEenGewoneKamer($groot) )
then
    Object v = waarde_heffingVanEenGewoneKamer($grondslag);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing van een gewone kamer", ComputeHelpers.designate(v, "heffing van een gewone kamer")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("kamer", "heffing", false), v, "heffing van een gewone kamer"));
        }
    }
end

// de heffing van haar kamer
function Object waarde_heffingVanEenJutter(Object $kamerHeffing) {
    try {
        return ComputeHelpers.fitTarget($kamerHeffing, Integer.valueOf(0), "heffing", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffing van een jutter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $padstand_0 : PathState( path == "Jutter:kamer" && member == ElementKey.of("kamer", "heffing", false), subject == $onderwerp, $kamerHeffing : value )
then
    Object v = waarde_heffingVanEenJutter($kamerHeffing);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffing van een jutter", ComputeHelpers.designate(v, "heffing van een jutter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "heffing", false), v, "heffing van een jutter"));
        }
    }
end

function boolean beta_richtDeKamerOp(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// de grondslag van de Jutter; de omvangrijk van de Jutter
function Object creatie_richtDeKamerOp(Object $grondslag, Object $omvangrijk, Object $fase, Object $herkomsten_creatie_14, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("richt de kamer op", 0, "Jutter", (java.util.List) $herkomsten_creatie_14, 100);
    Object i0 = null;
    Object i1 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($grondslag, Integer.valueOf(0), "grondslag", "richt de kamer op"));
        i1 = ComputeHelpers.collapse($omvangrijk);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Kamer");
    ComputeHelpers.set(nieuw, "grondslag", i0);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("richt de kamer op", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("kamerbinding", $onderwerp, nieuw, fase));
    feiten.add(Boolean.TRUE.equals(i1) ? new HasCharacteristic(nieuw, ElementKey.of("kamer", "groot", true)) : null);
    return feiten;
}

rule "richt de kamer op"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( kamer == null, $grondslag : grondslag, $omvangrijk : omvangrijk )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    accumulate( $herkomst_creatie_13 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_14 : collectList($herkomst_creatie_13) )
    not( $gemaakt_creatie_16 : CreationStamp( rule == "richt de kamer op", subject == $onderwerp ) )
    not( $nieuw_creatie_17 : CreationStamp( object == $onderwerp, beta_richtDeKamerOp(this, $fase) ) )
    not( $eigen_fout : Fault( rule == "richt de kamer op", subject == $onderwerp ) )
then
    Object v = creatie_richtDeKamerOp($grondslag, $omvangrijk, $fase, $herkomsten_creatie_14, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "richt de kamer op", ComputeHelpers.designate(v, "richt de kamer op")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
        if (feiten.get(3) != null) {
            insert(feiten.get(3));
        }
    }
end

function boolean toets_schrijversKamerHeffingVerschil(Object $waarden) {
    return ComputeHelpers.differ($waarden);
}

rule "schrijvers Kamer.heffing: verschil"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer()
    accumulate( $waarde : Value( attribute == ElementKey.of("kamer", "heffing", false), subject == $onderwerp ); $waarden : collectList($waarde) )
    eval( toets_schrijversKamerHeffingVerschil($waarden) )
then
    insertLogical(ComputeHelpers.writersConflict($onderwerp, $waarden, "heffing", ComputeHelpers.list3("heffing van een grote kamer", "heffing van een gewone kamer", "heffing van een jutter"), ComputeHelpers.list2("Jutter", "Kamer"), ComputeHelpers.list2("Jutter", "Kamer")));
end

rule "koppeling kamerbinding uit de invoer: Jutter.kamer"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Jutter( kamer != null, $ander : kamer )
then
    insertLogical(new RelationLink("kamerbinding", $houder, $ander, 0));
end

rule "koppeling kamerbinding uit de invoer: Kamer.houder"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Kamer( houder != null, $ander : houder )
then
    insertLogical(new RelationLink("kamerbinding", $ander, $houder, 0));
end

function boolean beta_koppelingKamerbindingTweedeVullingVanKamer(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "second");
}

rule "koppeling kamerbinding: tweede vulling van kamer"
    dialect "mvel"
when
    $een : RelationLink( relation == "kamerbinding", $nabij : first )
    $twee : RelationLink( relation == "kamerbinding", first != null, first == $een.first, beta_koppelingKamerbindingTweedeVullingVanKamer(this, $een) )
then
    insertLogical(new Fault($nabij, "kamerbinding", new SecondFillingFault("kamer", $nabij)));
end

function boolean beta_koppelingKamerbindingTweedeVullingVanHouder(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling kamerbinding: tweede vulling van houder"
    dialect "mvel"
when
    $een : RelationLink( relation == "kamerbinding", $nabij : second )
    $twee : RelationLink( relation == "kamerbinding", second != null, second == $een.second, beta_koppelingKamerbindingTweedeVullingVanHouder(this, $een) )
then
    insertLogical(new Fault($nabij, "kamerbinding", new SecondFillingFault("houder", $nabij)));
end

rule "padstand Jutter.kamer naar Kamer.heffing: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    $koppeling_keten_39 : RelationLink( relation == "kamerbinding", first == $onderwerp, $overzijde_keten_40 : second )
    $stap_keten_38 : dev.uchar.regelspraak.facts.Kamer( this == $overzijde_keten_40 )
    $stand : State( attribute == ElementKey.of("kamer", "heffing", false), subject == $stap_keten_38, $v : value )
then
    insertLogical(new PathState($onderwerp, "Jutter:kamer", ElementKey.of("kamer", "heffing", false), $v, $stap_keten_38));
end

rule "padstand Jutter.kamer naar Kamer.heffing: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    not( $koppeling_keten_47 : RelationLink( relation == "kamerbinding", first == $onderwerp, $overzijde_keten_48 : second ) and $stap_keten_46 : dev.uchar.regelspraak.facts.Kamer( this == $overzijde_keten_48 ) )
then
    insertLogical(new PathState($onderwerp, "Jutter:kamer", ElementKey.of("kamer", "heffing", false), null, null));
end

rule "kenmerkstand Kamer.groot: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer( ComputeHelpers.holds(groot) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("kamer", "groot", true), true));
end

rule "kenmerkstand Kamer.groot: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("kamer", "groot", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("kamer", "groot", true), true));
end

rule "kenmerkstand Kamer.groot: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer( ComputeHelpers.holds(groot) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("kamer", "groot", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("kamer", "groot", true), false));
end

rule "stand Kamer.grondslag: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer()
    $waarde : Value( attribute == ElementKey.of("kamer", "grondslag", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("kamer", "grondslag", false), $v));
end

rule "stand Kamer.grondslag: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer( $invoer : grondslag )
    not( $waarde : Value( attribute == ElementKey.of("kamer", "grondslag", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("kamer", "grondslag", false), $invoer));
end

rule "stand Kamer.heffing: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer()
    $waarde : Value( attribute == ElementKey.of("kamer", "heffing", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("kamer", "heffing", false), $v));
end

rule "stand Kamer.heffing: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kamer( $invoer : heffing )
    not( $waarde : Value( attribute == ElementKey.of("kamer", "heffing", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("kamer", "heffing", false), $invoer));
end

