rule "kenmerkstand Vondst.gemerkt: waar uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(gemerkt) == true )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "gemerkt", true), true));
end

rule "kenmerkstand Vondst.gemerkt: waar uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst()
    $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "gemerkt", true), subject == $onderwerp )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "gemerkt", true), true));
end

rule "kenmerkstand Vondst.gemerkt: onwaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vondst( ComputeHelpers.holds(gemerkt) == false )
    not( $afgeleid : HasCharacteristic( characteristic == ElementKey.of("vondst", "gemerkt", true), subject == $onderwerp ) )
then
    insertLogical(new CharacteristicState($onderwerp, ElementKey.of("vondst", "gemerkt", true), false));
end

