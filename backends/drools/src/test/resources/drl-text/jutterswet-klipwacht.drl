// hij aan alle volgende voorwaarden voldoet: - zijn ploegomvang is ongelijk aan 0 - (het totaal van zijn wachtvergoeding per maand gedurende de tijd dat zijn wachtvergoeding per maand groter is dan 10) is groter dan 0
function boolean toets_kliptekenVanEenKustwacht(Object $ploegomvang, Object $tijdlijn_1, Object $onderwerp) {
    try {
        int raak = 0;
        Boolean vast;
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 0, 2);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk($ploegomvang, new java.math.BigDecimal("0"), "!=")) {
            raak++;
        }
        vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 1, 1);
        if (vast != null) {
            return vast;
        }
        if (RegelSpraakRuntime.rsAggVergelijk(PeriodArithmetic.total(RegelSpraakRuntime.rsTijdKnip(ComputeHelpers.complete($tijdlijn_1, "the gedurende clip of \"wachtvergoeding per maand\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar", "wachtvergoeding per maand", Boolean.TRUE), RegelSpraakRuntime.rsTijdConditie(ComputeHelpers.complete($tijdlijn_1, "the gedurende clip of \"wachtvergoeding per maand\" compares \"wachtvergoeding per maand\" per segment and needs its full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.6, ch. 8.4)", "wachtvergoeding per maand", Boolean.TRUE), Integer.valueOf(2), new java.math.BigDecimal("10"), ComputeHelpers.complete($tijdlijn_1, "the gedurende clip of \"wachtvergoeding per maand\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar", "wachtvergoeding per maand", Boolean.TRUE), Period.class), Period.class), "MAAND", null, null, "wachtvergoeding per maand", $onderwerp), new java.math.BigDecimal("0"), ">")) {
            raak++;
        }
        return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.ALLE, 0, raak, 2);
    } catch (RuntimeException e) {
        ComputeHelpers.caught(e);
        return false;
    }
}

// 1
function Object waarde_kliptekenVanEenKustwacht() {
    try {
        return ComputeHelpers.fitTarget(new java.math.BigDecimal("1"), Integer.valueOf(0), "klipteken", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "klipteken van een kustwacht"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kustwacht( $ploegomvang : ploegomvang )
    $stand_1 : State( attribute == ElementKey.of("kustwacht", "wachtvergoeding per maand", false), subject == $onderwerp, $tijdlijn_1 : value )
    eval( toets_kliptekenVanEenKustwacht($ploegomvang, $tijdlijn_1, $onderwerp) )
then
    Object v = waarde_kliptekenVanEenKustwacht();
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "klipteken van een kustwacht", ComputeHelpers.designate(v, "klipteken van een kustwacht")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("kustwacht", "klipteken", false), v, "klipteken van een kustwacht"));
        }
    }
end

