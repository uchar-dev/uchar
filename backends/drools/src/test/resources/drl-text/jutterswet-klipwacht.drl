rule "stand Kustwacht.wachtvergoeding per maand: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kustwacht( $invoer : (ComputeHelpers.periods(wachtvergoedingPerMaand)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("kustwacht", "wachtvergoeding per maand", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("kustwacht", "wachtvergoeding per maand", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("kustwacht", "wachtvergoeding per maand", false), $invoer));
end

rule "stand Kustwacht.wachtvergoeding per maand: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kustwacht( $invoer : (ComputeHelpers.periods(wachtvergoedingPerMaand)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("kustwacht", "wachtvergoeding per maand", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("kustwacht", "wachtvergoeding per maand", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("kustwacht", "wachtvergoeding per maand", false), ComputeHelpers.bucketScalarOf($invoer)));
end

