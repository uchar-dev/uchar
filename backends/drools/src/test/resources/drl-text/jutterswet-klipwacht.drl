rule "klipteken van een kustwacht: fout in de voorwaarde"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Kustwacht( $ploegomvang : ploegomvang )
    $stand_1 : State( attribute == ElementKey.of("kustwacht", "wachtvergoeding per maand", false), subject == $onderwerp, $tijdlijn_1 : value )
    eval( toets_kliptekenVanEenKustwachtFoutInDeVoorwaarde($ploegomvang, $tijdlijn_1, $onderwerp) )
then
    Object f = fout_kliptekenVanEenKustwachtFoutInDeVoorwaarde($ploegomvang, $tijdlijn_1, $onderwerp);
    if (!ComputeHelpers.isEvaluationFault(f)) {
        ComputeHelpers.contractBreach("de voorwaarde van \"klipteken van een kustwacht\" faalde in de toets en niet in het gevolg, over dezelfde gebonden waarden");
    }
    insertLogical(new Fault($onderwerp, "klipteken van een kustwacht", ComputeHelpers.designate(f, "klipteken van een kustwacht")));
