package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.BucketInput;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Period;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het tijdsevenredig deel per maand van haar jaarforfait gedurende de tijd dat zij bezet is
function Object waarde_ligdeelVanEenLigplaats(Object $tijdlijn_0, Object $tijdlijn_1, Object $onderwerp) {
    try {
        return Period.list(ComputeHelpers.proRata($tijdlijn_0, ComputeHelpers.complete($tijdlijn_1, "the pro-rata base \"jaarforfait\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.7, ch. 8.4)", "jaarforfait", Boolean.TRUE), "MAAND", Integer.valueOf(2), "ligdeel"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "ligdeel van een ligplaats"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ligplaats( $tijdlijn_0 : (ComputeHelpers.periods(bezet)) )
    $stand_1 : State( attribute == ElementKey.of("ligplaats", "jaarforfait", false), subject == $onderwerp, $tijdlijn_1 : value )
then
    Object v = waarde_ligdeelVanEenLigplaats($tijdlijn_0, $tijdlijn_1, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "ligdeel van een ligplaats", ComputeHelpers.designate(v, "ligdeel van een ligplaats")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("ligplaats", "ligdeel", false), v, "ligdeel van een ligplaats"));
        }
    }
end

// het tijdsevenredig deel per maand van haar staffelbasis gedurende de tijd dat zij bezet is
function Object waarde_heffingdeelVanEenLigplaats(Object $tijdlijn_0, Object $tijdlijn_1, Object $onderwerp) {
    try {
        return Period.list(ComputeHelpers.proRata($tijdlijn_0, ComputeHelpers.complete($tijdlijn_1, "the pro-rata base \"staffelbasis\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.7, ch. 8.4)", "staffelbasis", Boolean.TRUE), "MAAND", Integer.valueOf(0), "heffingdeel"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "heffingdeel van een ligplaats"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ligplaats( $tijdlijn_0 : (ComputeHelpers.periods(bezet)) )
    $stand_1 : State( attribute == ElementKey.of("ligplaats", "staffelbasis", false), subject == $onderwerp, $tijdlijn_1 : value )
then
    Object v = waarde_heffingdeelVanEenLigplaats($tijdlijn_0, $tijdlijn_1, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "heffingdeel van een ligplaats", ComputeHelpers.designate(v, "heffingdeel van een ligplaats")));
