        }
    }
end

// de lengte van de Ligplaats is groter of gelijk aan 15
function boolean toets_toeslagdeelVanEenLigplaats(Object $lengte) {
    return RegelSpraakRuntime.rsAggVergelijk($lengte, new java.math.BigDecimal("15"), ">=");
}

// het tijdsevenredig deel per maand van haar seizoenbasis gedurende de tijd dat zij bezet is
function Object waarde_toeslagdeelVanEenLigplaats(Object $tijdlijn_1, Object $tijdlijn_2, Object $onderwerp) {
    try {
        return Period.list(ComputeHelpers.proRata($tijdlijn_1, ComputeHelpers.complete($tijdlijn_2, "the pro-rata base \"seizoenbasis\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.7, ch. 8.4)", "seizoenbasis", Boolean.TRUE), "MAAND", Integer.valueOf(2), "toeslagdeel"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "toeslagdeel van een ligplaats"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ligplaats( $lengte : lengte, $tijdlijn_1 : (ComputeHelpers.periods(bezet)) )
    $stand_2 : State( attribute == ElementKey.of("ligplaats", "seizoenbasis", false), subject == $onderwerp, $tijdlijn_2 : value )
    eval( toets_toeslagdeelVanEenLigplaats($lengte) )
then
    Object v = waarde_toeslagdeelVanEenLigplaats($tijdlijn_1, $tijdlijn_2, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "toeslagdeel van een ligplaats", ComputeHelpers.designate(v, "toeslagdeel van een ligplaats")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("ligplaats", "toeslagdeel", false), v, "toeslagdeel van een ligplaats"));
        }
    }
end

rule "stand Ligplaats.jaarforfait: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ligplaats( $invoer : (ComputeHelpers.periods(jaarforfait)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("ligplaats", "jaarforfait", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("ligplaats", "jaarforfait", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("ligplaats", "jaarforfait", false), $invoer));
end

rule "stand Ligplaats.jaarforfait: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Ligplaats( $invoer : (ComputeHelpers.periods(jaarforfait)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("ligplaats", "jaarforfait", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("ligplaats", "jaarforfait", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("ligplaats", "jaarforfait", false), ComputeHelpers.bucketScalarOf($invoer)));
end

