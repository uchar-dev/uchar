        if (RegelSpraakRuntime.rsAggVergelijk(vouwlezing_drukte($actief, $aantal_vouw_46, $eerste_filterfout_vouw_51, $filterdeponeringen_vouw_55), new java.math.BigDecimal("0"), ">")) {
