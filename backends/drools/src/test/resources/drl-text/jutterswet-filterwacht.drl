// het aantal vondsten van de Jutter
function Object waarde_vondstental(Object $aantal_vouw_4) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_4), Integer.valueOf(0), "vondstental", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "vondstental"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "vondstental: vouw 0", subject == $onderwerp ); $aantal_vouw_4 : count() )
then
    Object v = waarde_vondstental($aantal_vouw_4);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "vondstental", ComputeHelpers.designate(v, "vondstental")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "vondstental", false), v, "vondstental"));
        }
    }
end

// hij actief is
function boolean toets_zwareVondsten(Object $actief) {
    return ComputeHelpers.characteristic($actief, Boolean.TRUE);
}

// het aantal vondsten van de Jutter die aan de volgende voorwaarde voldoen: zijn gewicht gedeeld door zijn deelnemers is groter dan 2
function Object waarde_zwareVondsten(Object $aantal_vouw_20, Object $eerste_filterfout_vouw_25, Object $filterdeponeringen_vouw_29, Object sonde) {
    try {
        return ComputeHelpers.fitTarget(vouwlezing_zwareVondsten($aantal_vouw_20, $eerste_filterfout_vouw_25, $filterdeponeringen_vouw_29, sonde), Integer.valueOf(0), "zware vondsten", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

// het aantal vondsten van de Jutter die aan de volgende voorwaarde voldoen: zijn gewicht gedeeld door zijn deelnemers is groter dan 2
function Object vouwlezing_zwareVondsten(Object $aantal_vouw_20, Object $eerste_filterfout_vouw_25, Object $filterdeponeringen_vouw_29, Object sonde) {
    ComputeHelpers.reportFilterDeposits(sonde, $filterdeponeringen_vouw_29);
    if ($eerste_filterfout_vouw_25 != null) {
        throw ((FilterFault) $eerste_filterfout_vouw_25).fault();
    }
    return ComputeHelpers.countOf($aantal_vouw_20);
}

rule "zware vondsten"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Jutter( $actief : (ComputeHelpers.holds(actief)) )
    accumulate( $bijdrage_vouw_17 : Contribution( fold == "zware vondsten: vouw 1", subject == $onderwerp ); $aantal_vouw_20 : count() )
    accumulate( $filterfout_vouw_21 : FilterFault( fold == "zware vondsten: vouw 1", subject == $onderwerp ); $filterfouten_vouw_24 : count(), $eerste_filterfout_vouw_25 : exactMin($filterfout_vouw_21) )
    accumulate( $filterdeponering_vouw_26 : FilterDeposit( fold == "zware vondsten: vouw 1", subject == $onderwerp ); $filterdeponeringen_vouw_29 : collectList($filterdeponering_vouw_26) )
    eval( toets_zwareVondsten($actief) )
then
    Object sonde = ComputeHelpers.depositFlag();
    Object v = waarde_zwareVondsten($aantal_vouw_20, $eerste_filterfout_vouw_25, $filterdeponeringen_vouw_29, sonde);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "zware vondsten", ComputeHelpers.designate(v, "zware vondsten")));
    } else {
        if (ComputeHelpers.reported(sonde)) {
            insertLogical(ComputeHelpers.inconsistency("zware vondsten", $onderwerp, ComputeHelpers.depositCodes(sonde)));
        }
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("jutter", "zware vondsten", false), v, "zware vondsten"));
        }
    }
end

