package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Recipient;

rule "verdeel de opbrengst naar rato: ontvanger"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Berging()
    $onderwerp : dev.uchar.regelspraak.facts.Berger( berging == $vouwonderwerp, $gewicht : gewicht, $maximum : maximum )
then
    insertLogical(new Recipient("verdeel de opbrengst naar rato", $vouwonderwerp, $onderwerp, $gewicht, null, $maximum));
end

rule "verdeel de opbrengst naar rato"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging( $opbrengst : opbrengst )
    accumulate( $ontvanger_verdeling_1 : Recipient( allocation == "verdeel de opbrengst naar rato", source == $onderwerp ); $ontvangers_verdeling_2 : collectList($ontvanger_verdeling_1) )
then
    for (Object feit : ComputeHelpers.payout("verdeel de opbrengst naar rato", $onderwerp, dev.uchar.regelspraak.ir.ResolvedAllocation.Method.NAAR_RATO, $opbrengst, $ontvangers_verdeling_2, true, true, false, Integer.valueOf(0), ElementKey.of("berger", "bergingsaandeel", false), ElementKey.of("berging", "onverdeelde rest", false), "verdeel de opbrengst naar rato", Integer.valueOf(0), Integer.valueOf(0), "verdeel de opbrengst naar rato")) {
        insertLogical(feit);
    }
end

rule "verdeel de opbrengst op jaar: ontvanger"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Berging()
    $onderwerp : dev.uchar.regelspraak.facts.Berger( berging == $vouwonderwerp, $gewicht : gewicht, $jaar : jaar, $maximum : maximum )
then
    insertLogical(new Recipient("verdeel de opbrengst op jaar", $vouwonderwerp, $onderwerp, $gewicht, $jaar, $maximum));
end

rule "verdeel de opbrengst op jaar"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Berging( $opbrengst : opbrengst )
    accumulate( $ontvanger_verdeling_6 : Recipient( allocation == "verdeel de opbrengst op jaar", source == $onderwerp ); $ontvangers_verdeling_7 : collectList($ontvanger_verdeling_6) )
then
    for (Object feit : ComputeHelpers.payout("verdeel de opbrengst op jaar", $onderwerp, dev.uchar.regelspraak.ir.ResolvedAllocation.Method.OP_VOLGORDE, $opbrengst, $ontvangers_verdeling_7, true, true, false, Integer.valueOf(0), ElementKey.of("berger", "rangaandeel", false), ElementKey.of("berging", "rangrest", false), "verdeel de opbrengst op jaar", Integer.valueOf(0), Integer.valueOf(0), "verdeel de opbrengst op jaar")) {
        insertLogical(feit);
    }
end

