package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.CreationPhase;
import dev.uchar.regelspraak.transpiler.tms.CreationStamp;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.PathState;
import dev.uchar.regelspraak.transpiler.tms.RelationLink;
import dev.uchar.regelspraak.transpiler.tms.SecondFillingFault;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de rang van de opvolger van de Wachter
function Object waarde_opvolgerrangVanEenWachter(Object $opvolgerRang) {
    try {
        return ComputeHelpers.fitTarget($opvolgerRang, Integer.valueOf(0), "opvolgerrang", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "opvolgerrang van een wachter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $padstand_0 : PathState( path == "Wachter:opvolger" && member == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $opvolgerRang : value )
then
    Object v = waarde_opvolgerrangVanEenWachter($opvolgerRang);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "opvolgerrang van een wachter", ComputeHelpers.designate(v, "opvolgerrang van een wachter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("wachter", "opvolgerrang", false), v, "opvolgerrang van een wachter"));
        }
    }
end

// De rang van een Wachter moet kleiner zijn dan 101
function boolean toets_rangplafond(Object $rang) {
    return ComputeHelpers.not(RegelSpraakRuntime.rsAggVergelijk($rang, new java.math.BigDecimal("101"), "<"));
}

rule "rangplafond"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $stand_0 : State( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $rang : value )
    eval( toets_rangplafond($rang) )
then
    insertLogical(ComputeHelpers.inconsistency("rangplafond", $onderwerp, ComputeHelpers.list1("EF-025")));
end

// Een Wachter moet voldoen aan ten minste één van de volgende criteria: - zijn rang is kleiner dan 101 - zijn ketennummer is ongelijk aan 1
function boolean toets_eersteKetenAanHetPlafond(Object $rang, Object $ketennummer) {
    return ComputeHelpers.not(Boolean.valueOf(samengesteld_eersteKetenAanHetPlafond($rang, $ketennummer)));
}

// Een Wachter moet voldoen aan ten minste één van de volgende criteria: - zijn rang is kleiner dan 101 - zijn ketennummer is ongelijk aan 1
function boolean samengesteld_eersteKetenAanHetPlafond(Object $rang, Object $ketennummer) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($rang, new java.math.BigDecimal("101"), "<")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($ketennummer, new java.math.BigDecimal("1"), "!=")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 2);
}

rule "eerste keten aan het plafond"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $stand_0 : State( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $rang : value )
    $stand_1 : State( attribute == ElementKey.of("wachter", "ketennummer", false), subject == $onderwerp, $ketennummer : value )
    eval( toets_eersteKetenAanHetPlafond($rang, $ketennummer) )
then
    insertLogical(ComputeHelpers.inconsistency("eerste keten aan het plafond", $onderwerp, ComputeHelpers.list1("EF-025")));
end

// Een Wachter moet voldoen aan ten minste één van de volgende criteria: - zijn rang is kleiner dan 101 - zijn ketennummer is ongelijk aan 2
function boolean toets_tweedeKetenAanHetPlafond(Object $rang, Object $ketennummer) {
    return ComputeHelpers.not(Boolean.valueOf(samengesteld_tweedeKetenAanHetPlafond($rang, $ketennummer)));
}

// Een Wachter moet voldoen aan ten minste één van de volgende criteria: - zijn rang is kleiner dan 101 - zijn ketennummer is ongelijk aan 2
function boolean samengesteld_tweedeKetenAanHetPlafond(Object $rang, Object $ketennummer) {
    int raak = 0;
    Boolean vast;
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 0, 2);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($rang, new java.math.BigDecimal("101"), "<")) {
        raak++;
    }
    vast = ComputeHelpers.established(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 1, 1);
    if (vast != null) {
        return vast;
    }
    if (RegelSpraakRuntime.rsAggVergelijk($ketennummer, new java.math.BigDecimal("2"), "!=")) {
        raak++;
    }
    return ComputeHelpers.endVerdict(dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, 1, raak, 2);
}

rule "tweede keten aan het plafond"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $stand_0 : State( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $rang : value )
    $stand_1 : State( attribute == ElementKey.of("wachter", "ketennummer", false), subject == $onderwerp, $ketennummer : value )
    eval( toets_tweedeKetenAanHetPlafond($rang, $ketennummer) )
then
    insertLogical(ComputeHelpers.inconsistency("tweede keten aan het plafond", $onderwerp, ComputeHelpers.list1("EF-025")));
end

function boolean beta_langeEstafetteWerfDeLangeKeten(Object eigen, Object ander) {
    return ComputeHelpers.inPhase(eigen, ander);
}

// de rang van de Wachter kleiner is dan 101
function boolean toets_langeEstafetteWerfDeLangeKeten(Object $rang) {
    return RegelSpraakRuntime.rsAggVergelijk($rang, new java.math.BigDecimal("101"), "<");
}

// de rang van de Wachter plus 1; het ketennummer van de Wachter
function Object creatie_langeEstafetteWerfDeLangeKeten(Object $rang, Object $ketennummer, Object $fase, Object $herkomsten_creatie_21, Object $onderwerp) {
    int diepte = ComputeHelpers.creationDepth("werf de lange keten", 0, "Wachter", (java.util.List) $herkomsten_creatie_21, 100);
    Object i0 = null;
    Object i1 = null;
    try {
        i0 = ComputeHelpers.collapse(ComputeHelpers.fitTarget(RegelSpraakRuntime.rsPlus($rang, new java.math.BigDecimal("1")), Integer.valueOf(0), "rang", "werf de lange keten"));
        i1 = ComputeHelpers.collapse(ComputeHelpers.fitTarget($ketennummer, Integer.valueOf(0), "ketennummer", "werf de lange keten"));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
    Object nieuw = ComputeHelpers.newObject($onderwerp, "dev.uchar.regelspraak.facts.Wachter");
    ComputeHelpers.set(nieuw, "rang", i0);
    ComputeHelpers.set(nieuw, "ketennummer", i1);
    int fase = ((Integer) $fase).intValue();
    java.util.List feiten = new java.util.ArrayList();
    feiten.add(nieuw);
    feiten.add(new CreationStamp("werf de lange keten", $onderwerp, nieuw, fase, 0, diepte));
    feiten.add(new RelationLink("opvolging", $onderwerp, nieuw, fase));
    return feiten;
}

rule "lange estafette: werf de lange keten"
    dialect "mvel"
    agenda-group "uchar-objectcreatie"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter( opvolger == null )
    $creatiefase : CreationPhase( stratum >= 0, $fase : number )
    $stand_0 : State( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $rang : value )
    $stand_1 : State( attribute == ElementKey.of("wachter", "ketennummer", false), subject == $onderwerp, $ketennummer : value )
    accumulate( $herkomst_creatie_20 : CreationStamp( object == $onderwerp ); $herkomsten_creatie_21 : collectList($herkomst_creatie_20) )
    not( $gemaakt_creatie_23 : CreationStamp( rule == "werf de lange keten", subject == $onderwerp ) )
    not( $nieuw_creatie_24 : CreationStamp( object == $onderwerp, beta_langeEstafetteWerfDeLangeKeten(this, $fase) ) )
    eval( toets_langeEstafetteWerfDeLangeKeten($rang) )
    not( $eigen_fout : Fault( rule == "werf de lange keten", subject == $onderwerp ) )
then
    Object v = creatie_langeEstafetteWerfDeLangeKeten($rang, $ketennummer, $fase, $herkomsten_creatie_21, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insert(new Fault($onderwerp, "werf de lange keten", ComputeHelpers.designate(v, "lange estafette: werf de lange keten")));
    } else {
        java.util.List feiten = (java.util.List) v;
        insert(feiten.get(0));
        insert(feiten.get(1));
        insert(feiten.get(2));
    }
end

rule "koppeling opvolging uit de invoer: Wachter.opvolger"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Wachter( opvolger != null, $ander : opvolger )
then
    insertLogical(new RelationLink("opvolging", $houder, $ander, 0));
end

rule "koppeling opvolging uit de invoer: Wachter.voorganger"
    dialect "mvel"
when
    $houder : dev.uchar.regelspraak.facts.Wachter( voorganger != null, $ander : voorganger )
then
    insertLogical(new RelationLink("opvolging", $ander, $houder, 0));
end

function boolean beta_koppelingOpvolgingTweedeVullingVanOpvolger(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "second");
}

rule "koppeling opvolging: tweede vulling van opvolger"
    dialect "mvel"
when
    $een : RelationLink( relation == "opvolging", $nabij : first )
    $twee : RelationLink( relation == "opvolging", first != null, first == $een.first, beta_koppelingOpvolgingTweedeVullingVanOpvolger(this, $een) )
then
    insertLogical(new Fault($nabij, "opvolging", new SecondFillingFault("opvolger", $nabij)));
end

function boolean beta_koppelingOpvolgingTweedeVullingVanVoorganger(Object eigen, Object ander) {
    return ComputeHelpers.otherFilling(eigen, ander, "first");
}

rule "koppeling opvolging: tweede vulling van voorganger"
    dialect "mvel"
when
    $een : RelationLink( relation == "opvolging", $nabij : second )
    $twee : RelationLink( relation == "opvolging", second != null, second == $een.second, beta_koppelingOpvolgingTweedeVullingVanVoorganger(this, $een) )
then
    insertLogical(new Fault($nabij, "opvolging", new SecondFillingFault("voorganger", $nabij)));
end

rule "padstand Wachter.opvolger naar Wachter.rang: link aanwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $koppeling_keten_44 : RelationLink( relation == "opvolging", first == $onderwerp, $overzijde_keten_45 : second )
    $stap_keten_43 : dev.uchar.regelspraak.facts.Wachter( this == $overzijde_keten_45 )
    $stand : State( attribute == ElementKey.of("wachter", "rang", false), subject == $stap_keten_43, $v : value )
then
    insertLogical(new PathState($onderwerp, "Wachter:opvolger", ElementKey.of("wachter", "rang", false), $v, $stap_keten_43));
end

rule "padstand Wachter.opvolger naar Wachter.rang: link afwezig"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    not( $koppeling_keten_52 : RelationLink( relation == "opvolging", first == $onderwerp, $overzijde_keten_53 : second ) and $stap_keten_51 : dev.uchar.regelspraak.facts.Wachter( this == $overzijde_keten_53 ) )
then
    insertLogical(new PathState($onderwerp, "Wachter:opvolger", ElementKey.of("wachter", "rang", false), null, null));
end

