    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $waarde : Value( attribute == ElementKey.of("wachter", "rang", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("wachter", "rang", false), $v));
end

