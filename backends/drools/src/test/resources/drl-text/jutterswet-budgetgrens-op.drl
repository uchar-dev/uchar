rule "stand Wachter.ketennummer: uit een afleiding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter()
    $waarde : Value( attribute == ElementKey.of("wachter", "ketennummer", false), subject == $onderwerp, $v : value )
then
    insertLogical(new State($onderwerp, ElementKey.of("wachter", "ketennummer", false), $v));
end

rule "stand Wachter.ketennummer: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Wachter( $invoer : ketennummer )
    not( $waarde : Value( attribute == ElementKey.of("wachter", "ketennummer", false), subject == $onderwerp ) )
then
