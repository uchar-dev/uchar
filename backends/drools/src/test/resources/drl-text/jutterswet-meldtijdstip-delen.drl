package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Value;

// het jaar uit zijn meldtijdstip
function Object waarde_meldjaarVanEenMelding(Object $meldtijdstip) {
    try {
        return ComputeHelpers.fitTarget(RegelSpraakRuntime.rsDatumDeel($meldtijdstip, java.time.temporal.ChronoField.YEAR), Integer.valueOf(0), "meldjaar", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "meldjaar van een melding"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Melding( $meldtijdstip : meldtijdstip )
then
    Object v = waarde_meldjaarVanEenMelding($meldtijdstip);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "meldjaar van een melding", ComputeHelpers.designate(v, "meldjaar van een melding")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("melding", "meldjaar", false), v, "meldjaar van een melding"));
        }
    }
end

