end

// de sterkte van ten minste 2 van de lampen van de Vuurtoren die gekeurd zijn groter is dan 5
function boolean toets_keurigBijSterkte(Object $aantal_vouw_29, Object $vouw_vouw_31) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_29, $vouw_vouw_31, dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, Integer.valueOf(2));
}

rule "keurig bij sterkte"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vuurtoren()
    accumulate( $bijdrage_vouw_26 : Contribution( fold == "keurig bij sterkte: vouw 3", subject == $onderwerp, $bijdragewaarde_vouw_30 : value ); $aantal_vouw_29 : count(), $vouw_vouw_31 : exactSum($bijdragewaarde_vouw_30) )
    eval( toets_keurigBijSterkte($aantal_vouw_29, $vouw_vouw_31) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vuurtoren", "keurig", true)));
end

// het aantal lampen van de Vuurtoren
function Object waarde_lampentalVanEenVuurtoren(Object $aantal_vouw_37) {
    try {
        return ComputeHelpers.fitTarget(ComputeHelpers.countOf($aantal_vouw_37), Integer.valueOf(0), "lampental", null);
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "lampental van een vuurtoren"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vuurtoren()
    accumulate( $bijdrage_vouw_34 : Contribution( fold == "lampental van een vuurtoren: vouw 4", subject == $onderwerp ); $aantal_vouw_37 : count() )
then
    Object v = waarde_lampentalVanEenVuurtoren($aantal_vouw_37);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "lampental van een vuurtoren", ComputeHelpers.designate(v, "lampental van een vuurtoren")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("vuurtoren", "lampental", false), v, "lampental van een vuurtoren"));
        }
    }
end

// de sterkte van ten minste 2 van de lampen van de Vuurtoren groter is dan 5
function boolean matrix_helderBijSterkteBijdrageAanVouw0(Object $onderwerp, Object $sterkte) {
    return RegelSpraakRuntime.rsAggVergelijk($sterkte, new java.math.BigDecimal("5"), ">");
}

rule "helder bij sterkte: bijdrage aan vouw 0"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Vuurtoren()
    $onderwerp : dev.uchar.regelspraak.facts.Lamp( toren == $vouwonderwerp, $sterkte : sterkte )
then
    insertLogical(new Contribution("helder bij sterkte: vouw 0", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_helderBijSterkteBijdrageAanVouw0($onderwerp, $sterkte))));
end

