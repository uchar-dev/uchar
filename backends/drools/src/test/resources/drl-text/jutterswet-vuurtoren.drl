// gekeurd zijn
function boolean toets_keurigBijSterkteBijdrageAanVouw3(Object $gekeurd) {
    return ComputeHelpers.characteristic($gekeurd, Boolean.TRUE);
}

// de sterkte van ten minste 2 van de lampen van de Vuurtoren die gekeurd zijn groter is dan 5
function boolean matrix_keurigBijSterkteBijdrageAanVouw3(Object $onderwerp, Object $sterkte) {
    return RegelSpraakRuntime.rsAggVergelijk($sterkte, new java.math.BigDecimal("5"), ">");
}

rule "keurig bij sterkte: bijdrage aan vouw 3"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Vuurtoren()
    $onderwerp : dev.uchar.regelspraak.facts.Lamp( toren == $vouwonderwerp, $gekeurd : (ComputeHelpers.holds(gekeurd)), $sterkte : sterkte )
    eval( toets_keurigBijSterkteBijdrageAanVouw3($gekeurd) )
then
    insertLogical(new Contribution("keurig bij sterkte: vouw 3", $vouwonderwerp, $onderwerp, ComputeHelpers.verdict(matrix_keurigBijSterkteBijdrageAanVouw3($onderwerp, $sterkte))));
end

rule "lampental van een vuurtoren: bijdrage aan vouw 4"
    dialect "mvel"
when
    $vouwonderwerp : dev.uchar.regelspraak.facts.Vuurtoren()
    $onderwerp : dev.uchar.regelspraak.facts.Lamp( toren == $vouwonderwerp )
then
    insertLogical(new Contribution("lampental van een vuurtoren: vouw 4", $vouwonderwerp, $onderwerp, null));
end

