package dev.uchar.regelspraak.tms;

import accumulate dev.uchar.regelspraak.transpiler.tms.ExactSumFunction exactSum;
import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Contribution;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.HasCharacteristic;
import dev.uchar.regelspraak.transpiler.tms.Value;

// de sterkte van ten minste 2 van de lampen van de Vuurtoren groter is dan 5
function boolean toets_helderBijSterkte(Object $aantal_vouw_4, Object $vouw_vouw_6) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_4, $vouw_vouw_6, dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_MINSTE, Integer.valueOf(2));
}

rule "helder bij sterkte"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vuurtoren()
    accumulate( $bijdrage_vouw_1 : Contribution( fold == "helder bij sterkte: vouw 0", subject == $onderwerp, $bijdragewaarde_vouw_5 : value ); $aantal_vouw_4 : count(), $vouw_vouw_6 : exactSum($bijdragewaarde_vouw_5) )
    eval( toets_helderBijSterkte($aantal_vouw_4, $vouw_vouw_6) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vuurtoren", "helder", true)));
end

// de sterkte van ten hoogste 1 van de lampen van de Vuurtoren groter is dan 5
function boolean toets_zuinigBijSterkte(Object $aantal_vouw_12, Object $vouw_vouw_14) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_12, $vouw_vouw_14, dev.uchar.regelspraak.ir.Condition.Quantifier.TEN_HOOGSTE, Integer.valueOf(1));
}

rule "zuinig bij sterkte"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vuurtoren()
    accumulate( $bijdrage_vouw_9 : Contribution( fold == "zuinig bij sterkte: vouw 1", subject == $onderwerp, $bijdragewaarde_vouw_13 : value ); $aantal_vouw_12 : count(), $vouw_vouw_14 : exactSum($bijdragewaarde_vouw_13) )
    eval( toets_zuinigBijSterkte($aantal_vouw_12, $vouw_vouw_14) )
then
    insertLogical(new HasCharacteristic($onderwerp, ElementKey.of("vuurtoren", "zuinig", true)));
end

// de sterkte van precies 1 van de lampen van de Vuurtoren groter is dan 5
function boolean toets_enkelvoudigBijSterkte(Object $aantal_vouw_20, Object $vouw_vouw_22) {
    return ComputeHelpers.quantifierVerdict($aantal_vouw_20, $vouw_vouw_22, dev.uchar.regelspraak.ir.Condition.Quantifier.PRECIES, Integer.valueOf(1));
