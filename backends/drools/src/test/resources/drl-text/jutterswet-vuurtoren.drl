rule "enkelvoudig bij sterkte"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Vuurtoren()
    accumulate( $bijdrage_vouw_17 : Contribution( fold == "enkelvoudig bij sterkte: vouw 2", subject == $onderwerp, $bijdragewaarde_vouw_21 : value ); $aantal_vouw_20 : count(), $vouw_vouw_22 : exactSum($bijdragewaarde_vouw_21) )
    eval( toets_enkelvoudigBijSterkte($aantal_vouw_20, $vouw_vouw_22) )
then
