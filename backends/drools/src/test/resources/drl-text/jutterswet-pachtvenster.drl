function Object waarde_zomerdagenVanEenStrandpachter(Object $ingangsdatum, Object $tijdlijn_1) {
    try {
        return PeriodArithmetic.clipped(PeriodCondition.window($ingangsdatum, Boolean.TRUE, java.time.LocalDate.parse("2025-09-01"), Boolean.TRUE, Boolean.FALSE), PeriodArithmetic.dayCount(RegelSpraakRuntime.rsAantalDagenIn(((java.util.List) $tijdlijn_1), "MAAND", Period.class)));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "zomerdagen van een strandpachter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandpachter( $ingangsdatum : ingangsdatum, $tijdlijn_1 : (ComputeHelpers.periods(aanwezig)) )
then
    Object v = waarde_zomerdagenVanEenStrandpachter($ingangsdatum, $tijdlijn_1);
    if (ComputeHelpers.isEvaluationFault(v)) {
