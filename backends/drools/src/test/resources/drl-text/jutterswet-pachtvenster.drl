package dev.uchar.regelspraak.tms;

import dev.uchar.regelspraak.graph.ProducerConsumer.ElementKey;
import dev.uchar.regelspraak.runtime.RegelSpraakRuntime;
import dev.uchar.regelspraak.transpiler.tms.BucketInput;
import dev.uchar.regelspraak.transpiler.tms.ComputeHelpers;
import dev.uchar.regelspraak.transpiler.tms.Fault;
import dev.uchar.regelspraak.transpiler.tms.Period;
import dev.uchar.regelspraak.transpiler.tms.PeriodArithmetic;
import dev.uchar.regelspraak.transpiler.tms.PeriodCondition;
import dev.uchar.regelspraak.transpiler.tms.State;
import dev.uchar.regelspraak.transpiler.tms.Value;

function Object waarde_jaarpachtVanEenStrandpachter(Object $tijdlijn_0, Object $tijdlijn_1, Object $onderwerp) {
    try {
        return PeriodArithmetic.clipped(PeriodCondition.window(java.time.LocalDate.parse("2025-01-01"), Boolean.TRUE, null, Boolean.FALSE, Boolean.FALSE), Period.list(ComputeHelpers.proRata($tijdlijn_0, ComputeHelpers.complete($tijdlijn_1, "the pro-rata base \"pachttarief\" needs the full timeline; ", $onderwerp, " supplies only the asOfDate-bucket scalar (ch. 3.7, ch. 8.4)", "pachttarief", Boolean.TRUE), "JAAR", Integer.valueOf(0), "jaarpacht")));
    } catch (RuntimeException e) {
        return ComputeHelpers.caught(e);
    }
}

rule "jaarpacht van een strandpachter"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandpachter( $tijdlijn_0 : (ComputeHelpers.periods(vergund)) )
    $stand_1 : State( attribute == ElementKey.of("strandpachter", "pachttarief", false), subject == $onderwerp, $tijdlijn_1 : value )
then
    Object v = waarde_jaarpachtVanEenStrandpachter($tijdlijn_0, $tijdlijn_1, $onderwerp);
    if (ComputeHelpers.isEvaluationFault(v)) {
        insertLogical(new Fault($onderwerp, "jaarpacht van een strandpachter", ComputeHelpers.designate(v, "jaarpacht van een strandpachter")));
    } else {
        if (!ComputeHelpers.isEmpty(v)) {
            insertLogical(new Value($onderwerp, ElementKey.of("strandpachter", "jaarpacht", false), v, "jaarpacht van een strandpachter"));
        }
    }
end

