rule "stand Strandpachter.pachttarief: uit de invoer"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandpachter( $invoer : (ComputeHelpers.periods(pachttarief)) )
    not( $emmerinvoer : BucketInput( attribute == ElementKey.of("strandpachter", "pachttarief", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("strandpachter", "pachttarief", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandpachter", "pachttarief", false), $invoer));
end

rule "stand Strandpachter.pachttarief: uit de invoer, een emmerscalair"
    dialect "mvel"
when
    $onderwerp : dev.uchar.regelspraak.facts.Strandpachter( $invoer : (ComputeHelpers.periods(pachttarief)) )
    exists( $emmerinvoer : BucketInput( attribute == ElementKey.of("strandpachter", "pachttarief", false), subject == $onderwerp ) )
    not( $waarde : Value( attribute == ElementKey.of("strandpachter", "pachttarief", false), subject == $onderwerp ) )
then
    insertLogical(new State($onderwerp, ElementKey.of("strandpachter", "pachttarief", false), ComputeHelpers.bucketScalarOf($invoer)));
end

