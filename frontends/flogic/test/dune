(executable
 (name suite)
 (libraries unix yojson uchar-ir-v0 flogic_frontend_lib))

; The end-to-end frontend suite. It drives the frontend plus the three
; workspace executors (verifier, reference runner, clingo runner) over the
; F-logic test programs and their cases. All four executables and the
; source/case fixtures are declared as deps so dune builds and sandboxes
; them; their paths are handed to the suite as argv.
; Gate 14 (scripts/check-flogic.sh) runs the suite with the argv it reads
; from the action below (run_suite, scripts/lib/ocaml-build.sh), so the
; argv is written here only.
(rule
 (alias runtest)
 (deps
  (glob_files *.flogic)
  (glob_files cases/*.json)
  (file ../bin/flogic_frontend.exe)
  (file ../../../spec/verifier/bin/verifier.exe)
  (file ../../../ref/bin/runner.exe)
  (file ../../../backends/clingo/bin/clingo_runner.exe))
 (action
  (run
   %{exe:suite.exe}
   ../bin/flogic_frontend.exe
   ../../../spec/verifier/bin/verifier.exe
   ../../../ref/bin/runner.exe
   ../../../backends/clingo/bin/clingo_runner.exe)))
