// A comprehension whose hop starts at a variable the rule never bound.
// The same refusal a comprehension in a VALUE position already gave: the
// range would otherwise be read off a name with no reading, and the wire
// would carry a sourceRole whose provenance quotes it.

Boot[|lengte => numeriek(onbepaald, geheel)|].
Reddingsstation[|sterk => kenmerk(bijvoeglijk)|].

stationsindeling : feittype.
stationsindeling[|station {1..1} => Reddingsstation|].
stationsindeling[|boten   {0..*} => Boot|].

@!{'sterk station'}
?S : sterk :- ?S : Reddingsstation,
    count{?V | ?V = ?Q.boten, ?V.lengte > 8} >= 2.
