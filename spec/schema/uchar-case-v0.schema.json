{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uchar.dev/schema/uchar-case-v0.schema.json",
  "title": "uchar corpus case, format uchar-case-v0",
  "description": "One golden-corpus evaluation case: the input world, the evaluation date, parameter values, and the expected outcomes. Engine-neutral; consumed by the reference interpreter and any conforming backend harness. Values are unit-normalised to the referenced declaration's unit; numbers are exact decimal or rational lexemes carried as strings, never JSON floats.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "asOfDate", "input", "expected"],
  "properties": {
    "format": { "const": "uchar-case-v0" },
    "asOfDate": {
      "description": "The single evaluation date (valuation = calculation = vintage selection); null for a time-free case.",
      "oneOf": [ { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, { "type": "null" } ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instances", "parameters"],
      "properties": {
        "instances": {
          "type": "array",
          "items": { "$ref": "#/$defs/instance" }
        },
        "parameters": {
          "description": "Parameter name (as declared) to value, in the parameter's declared unit.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/expectation" }
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "objectType", "attributes", "roles", "characteristics"],
      "properties": {
        "label": {
          "description": "Case-local instance name; unique within the case; the handle role links and expectations use.",
          "type": "string",
          "minLength": 1
        },
        "objectType": { "type": "string", "minLength": 1 },
        "attributes": {
          "description": "Attribute name (as declared) to value, in the attribute's declared unit. Absence means empty (leeg); an input never carries an explicit empty.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/value" }
        },
        "roles": {
          "description": "Role name (as declared) to the labels of the linked instances; a to-one role carries exactly one label.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "characteristics": {
          "description": "Characteristics asserted true on input; every other characteristic starts false.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "value": {
      "description": "A typed value; exactly one variant.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["number"],
          "properties": {
            "number": {
              "description": "Exact decimal (dot) or rational (a/b) lexeme.",
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$|^-?[0-9]+/[1-9][0-9]*$"
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["date"],
          "properties": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["dateTime"],
          "properties": { "dateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?$" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["boolean"],
          "properties": { "boolean": { "type": "boolean" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["text"],
          "properties": { "text": { "type": "string" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["enumeration"],
          "properties": { "enumeration": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "label", "attribute", "value"],
          "properties": {
            "kind": { "const": "attributeValue" },
            "label": { "type": "string", "minLength": 1 },
            "attribute": { "type": "string", "minLength": 1 },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "label", "attribute"],
          "properties": {
            "kind": { "const": "attributeEmpty" },
            "label": { "type": "string", "minLength": 1 },
            "attribute": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "label", "characteristic"],
          "properties": {
            "kind": { "const": "characteristicPresent" },
            "label": { "type": "string", "minLength": 1 },
            "characteristic": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "label", "characteristic"],
          "properties": {
            "kind": { "const": "characteristicAbsent" },
            "label": { "type": "string", "minLength": 1 },
            "characteristic": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "consistent" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "inconsistent" } }
        }
      ]
    }
  }
}
